BL_CAN_Init_Mailboxes:
        CALLA cc_UC,BL_CAN2_LoadMailboxCfg_EF00
        CALLA cc_UC,BL_CAN2_LoadMailboxCfg_EE00
        OR DP4,#DATA16 040H
        RETS

