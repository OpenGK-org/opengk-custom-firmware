        MOV R10,[R0+#04H]
        MOV R11,[R0+#06H]
        ADD R10,R4
        EXTP R11, #02H
        MOV R12,[R10+]
        MOV R13,[R10]
        CALLS 008H,BL_Flash_RunDriverAtAddr
        JB bl_mode_status_flags.08H,L_90FA
        MOVB RL6,#00H
L_90FA:              ; 0x890fa
        MOVB RL4,[R0+#08H]
        CMPB RL7,RL4
        JMPR cc_NC,L_9106
        CMPB RL6,#00H
        JMPR cc_NE,L_90D8
L_9106:              ; 0x89106
        MOVB RL4,RL6
        MOV R6,[R0+]
        MOV R7,[R0+]
        ADD R0,#06H
        RET

