; ======== CommObj_SetPendingByHandle  (@0x8a7cc) ========
        ; ?CommObj_SetPendingByHandle(handle): comm-object table family (shared tables at DAT_00c1a6 mgr /
        ; DAT_00c1ac ctrl-blocks). Resolves handle->ctrl block; if block free (+0xb==0) or (bits&3==1 AND
        ; stored tag+6 == handle), SETS pending bit 0x2 and stores tag=handle. Returns result code (0=ok; 1/2
        ; chosen by descriptor record[0] type). Acquire/arm counterpart of ?CommObj_ClearPendingFlagByHandle.
CommObj_SetPendingByHandle:
        MOV [-R0],R6
        MOV R4,_commobj_mgr_ctrl
        MOV R5,g_c1a8
        EXTP R5, #03H
        MOV R14,[R4+#04H]
        MOV R15,[R4+#06H]
        NOP
        MOV R4,R12
        MOVBZ R4,RL4
        MOV R2,R4
        SHL R2,#03H
        SUB R2,R4
        SHL R2,#02H
        ADD R14,R2
        EXTP R15, #02H
        MOVB RL4,[R14+#09H]
        NOP
        MOVBZ R4,RL4
        MOV R2,R4
        SHL R2,#02H
        SUB R2,R4
        SHL R2,#02H
        MOV R13,_commobj_ctrlblk_base
        ADD R13,R2
        EXTP R15, #01H
        MOVB RL4,[R14]
        JMPR cc_NE,L_A812
        MOVB RL6,#01H
        JMPR cc_UC,L_A814
L_A812:              ; 0x8a812
        MOVB RL6,#02H
L_A814:              ; 0x8a814
        MOVB RL4,[R13+#0BH]
        JMPR cc_EQ,L_A830
        MOVB RL4,[R13+#0BH]
        MOVBZ R4,RL4
        AND R4,#03H
        CMP R4,#01H
        JMPR cc_NE,L_A844
        MOVB RL4,[R13+#06H]
        MOV R5,R12
        CMPB RL4,RL5
        JMPR cc_NE,L_A844
L_A830:              ; 0x8a830
        MOV R4,R13
        ADD R4,#DATA16 0BH
        MOVB RL5,[R4]
        ORB RL5,#02H
        MOVB [R4],RL5
        MOV R4,R12
        MOVB [R13+#06H],RL4
        MOVB RL6,#00H
