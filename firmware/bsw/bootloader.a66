; ======== KWP_BL_SID_11_ECUReset  (@0x8dee0) ========
        ; KWP2000 SID 0x11 ECUReset (bootloader). sub-fn 0x01 (powerOn/hardReset) -> arms reset
        ; (sets kwp_comms_flags bit 0x2000) and schedules __software_reset on the next cycle. Other
        ; sub-fn -> NRC 0x12 subFunctionNotSupported; bad length -> NRC 0x79.
        JB bl_mode_status_flags.05H,L_DEF0
        MOVB RL4,bl_prog_session_state
        JMPR cc_EQ,L_DEF0
        CMPB RL4,#05H
        JMPA cc_NE,L_DF30
