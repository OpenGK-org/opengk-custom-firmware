SEG8    SECTION CODE AT 8000H

; ======== BL_validate_app_launch_or_download  (@0x88000) ========
        ; Bootloader decision routine (entered from cstart tail @0x882fa via jmpa 0x8000).
        ; App-launch gate -- ALL must pass:
        ;   1. Compare_start_of_PRG_zone... (0x88bca) == 1  (PRG-zone header matches)
        ;   2. BL_check_app_signature_09fff0 (0x88b9a) == 1 (app signature 0x2442/0x9048 present)
        ;   3. BL_load_verify_redundant_blocks (0x88a20) == 0x20 (all redundant blocks consistent)
        ; If all pass: load far app-entry vector from [0x445a]:[0x445c] into r5:r4 and
        ;   far-call it via rt_callfar_via_r5r4 (0x2000) -> jump into application.
        ; Otherwise (any check fails) -> enter download mode:
        ;   BL_Kline_ASC0_Init (0x895ba), KWP_SecAccess_SetPenaltyDelay(0) (0x8ef1a),
        ;   then BL_download_service_loop (0x893f2, never returns).
BL_validate_app_launch_or_download:
        CALLA cc_UC,Compare_start_of_PRG_zone_to_hardcoded_values_rets_bool_rl4
        CMPB RL4,#01H
        JMPR cc_NE,L_8030
        CALLA cc_UC,BL_check_app_signature_09fff0
        CMPB RL4,#01H
        JMPR cc_NE,L_8030
        MOV R12,#DATA16 0FE00H
        MOV R13,#DATA16 0FCC0H
        CALLA cc_UC,BL_load_verify_redundant_blocks
        CMPB RL4,#DATA16 020H
        JMPR cc_NE,L_8030
        MOV R4,0445AH
        MOV R5,0445CH
        CALLS 000H,rt_callfar_via_r5r4
        RET
L_8030:              ; 0x88030
        BSET bl_mode_status_flags.05H
        BCLR PSW.0BH
        CALLS 008H,BL_Kline_ASC0_Init
        MOV R12,#00H
        CALLS 008H,KWP_SecAccess_SetPenaltyDelay
        BSET bl_mode_status_flags.06H
        CALLA cc_UC,BL_download_service_loop
        RET

; ======== cstart_reset_selftest_ramtest  (@0x88046) ========
        ; Reset entry / Tasking C166 cstart (reached from reset vector @0x0: jmps 0x88046).
        ; Sequence:
        ;   - CPU/bus config: SYSCON, BUSCON0/ADDRSEL (0xfe18..), CP/SP/STKUN/STKOV, DPP regs, einit.
        ;   - Register self-test: loads all GPRs with 0x5555, folds them, verifies -> dead-loop @0x8814a on
        ; fail.
        ;   - Clock/ID sanity: checks 0x3ff0 for app magic 0xa55a/0xc956; on match jmps 0x48004 (seg4 app).
        ;   - Watchdog service (srvwdt), calls Compare_start_of_PRG_zone... (0x88bca).
        ;   - RAM march/pattern tests: inline worker @0x882fe, invoked per region (E000-E7DE, C000-D7FE, ...)
        ;     via jmpa/jmpr with return addr in r4, returning through `jmpi [r4]`; results OR'd into r15
        ; flags.
        ;   - Copies/validates init data, then tail @0x882fa: jmpa 0x8000 ->
        ; BL_validate_app_launch_or_download.
        MOV CP,#DATA16 0F206H
        NOP
        MOV DPP0,#DATA16 024H
        MOV DPP1,#DATA16 028H
        MOV DPP2,#DATA16 025H
        EXTR #01H
        MOV SFR_F024,#DATA16 0C03H
        BFLDH 0FF12H,#0FFH,#0E3H
        BFLDL 0FF12H,#0FFH,#0EH
        MOV ADDRSEL1,#DATA16 01008H
        MOV ADDRSEL2,#DATA16 0FFF0H
        MOV ADDRSEL3,#DATA16 0A0H
        MOV ADDRSEL4,#DATA16 0FFE0H
        BFLDH 0FF0CH,#0DFH,#045H
        BFLDL 0FF0CH,#0FFH,#0BFH
        BFLDH 0FF14H,#0DFH,#085H
        BFLDL 0FF14H,#0FFH,#08EH
        BFLDH 0FF16H,#0DFH,#05H
        BFLDL 0FF16H,#0FFH,#02EH
        BFLDH 0FF18H,#0DFH,#085H
        BFLDL 0FF18H,#0FFH,#0AFH
        BFLDH 0FF1AH,#0DFH,#01H
        BFLDL 0FF1AH,#0FFH,#03FH
        EXTR #01H
        MOV PICON,#DATA16 0CFH
        MOV STKOV,#DATA16 0F228H
        MOV STKUN,#DATA16 0F2C4H
        MOV SP,#DATA16 0F2C4H
        MOV R8,#DATA16 03BH
        MOV lv_iga_fd06,R8
        EXTP #02H, #01H
        MOV 02000H,R8
        EINIT
        MOV R0,#DATA16 05555H
        MOV R1,R0
        MOV R2,R0
        MOV R3,R0
        MOV R4,R0
        MOV R5,R0
        MOV R6,R0
        MOV R7,R0
        MOV R8,R0
        MOV R9,R0
        MOV R10,R0
        MOV R11,R0
        MOV R12,R0
        MOV R13,R0
        MOV R14,R0
        MOV R15,R0
        ADD R0,R15
        ADD R1,R15
        ADD R2,R15
        ADD R3,R15
        ADD R4,R15
        ADD R5,R15
        ADD R6,R15
        ADD R7,R15
        ADD R8,R15
        ADD R9,R15
        ADD R10,R15
        ADD R11,R15
        ADD R12,R15
        ADD R13,R15
        ADD R14,R15
        ADD R15,R15
        NEG R15
        ADD R0,R15
        JMPR cc_NE,L_814A
        ADD R1,R15
        JMPR cc_NE,L_814A
        ADD R2,R15
        JMPR cc_NE,L_814A
        ADD R3,R15
        JMPR cc_NE,L_814A
        ADD R4,R15
        JMPR cc_NE,L_814A
        ADD R5,R15
        JMPR cc_NE,L_814A
        ADD R6,R15
        JMPR cc_NE,L_814A
        ADD R7,R15
        JMPR cc_NE,L_814A
        ADD R8,R15
        JMPR cc_NE,L_814A
        ADD R9,R15
        JMPR cc_NE,L_814A
        ADD R10,R15
        JMPR cc_NE,L_814A
        ADD R11,R15
        JMPR cc_NE,L_814A
        ADD R12,R15
        JMPR cc_NE,L_814A
        ADD R13,R15
        JMPR cc_NE,L_814A
        ADD R14,R15
        JMPR cc_NE,L_814A
        ADD R15,#DATA16 0AAAAH
        JMPR cc_EQ,L_814C
L_814A:              ; 0x8814a
        JMPR cc_UC,L_814A
L_814C:              ; 0x8814c
        MOV R8,#DATA16 0E30EH
        CMP R8,0FF12H
        JMPR cc_EQ,L_816E
        MOV R8,#00H
        MOV g_f200,R8
        MOV g_f202,R8
        MOV g_f204,R8
        SRST
        NOP
        NOP
L_816C:              ; 0x8816c
        JMPR cc_UC,L_816C
L_816E:              ; 0x8816e
        BSET P4.05H
        BSET DP4.05H
        NOP
        BCLR P6.06H
        BCLR DP6.06H
        BSET DP6.06H
        NOP
        BCLR P8.06H
        BCLR DP8.06H
        BSET DP8.06H
        MOV R1,#DATA16 03FF0H
        EXTP #013H, #01H
        MOV R1,[R1]
        CMP R1,#DATA16 0A55AH
        JMPR cc_NE,L_81A8
        MOV R1,#DATA16 03FF0H
        ADD R1,#02H
        EXTP #013H, #01H
        MOV R1,[R1]
        CMP R1,#DATA16 0C956H
        JMPR cc_NE,L_81A8
        JMPS 004H,08004H
L_81A8:              ; 0x881a8
        JNB WDTCON.01H,L_81B0
        OR R15,#01H
        JMPR cc_UC,L_81B0
L_81B0:              ; 0x881b0
        MOV WDTCON,#DATA16 09201H
        SRVWDT
        MOV R8,#DATA16 081CCH
        PUSH R8
        MOVB RL4,#02H
        POP R8
        CMP R8,#DATA16 081CCH
        JMPR cc_NE,L_81CC
        CALLA cc_UC,Compare_start_of_PRG_zone_to_hardcoded_values_rets_bool_rl4
L_81CC:              ; 0x881cc
        CMPB RL4,#01H
        JMPR cc_EQ,L_81D4
        OR R15,#DATA16 08000H
L_81D4:              ; 0x881d4
        MOV R5,#DATA16 05555H
        MOV R6,#DATA16 05556H
        MOV R7,#DATA16 0AAAAH
        MOV R0,#DATA16 0F220H
        MOV R1,#DATA16 0FDFEH
        MOV R2,bl_4454
        MOV R3,#02H
        MOV R4,#DATA16 081F6H
        JMPA cc_UC,_BL_Cstart_StackFill

; ======== BL_Clear_Ram_E000  (@0x881f6) ========
        MOV R0,#DATA16 0E000H
        MOV R1,#DATA16 0E7DEH
        MOV R2,04456H
        MOV R3,#04H
        MOV R4,#DATA16 0820CH
        JMPA cc_UC,_BL_Cstart_StackFill
        MOV R0,#DATA16 0C000H
        MOV R1,#DATA16 0D7FEH
        MOV R2,04458H
        MOV R3,#08H
        MOV R4,#DATA16 08220H
        JMPR cc_UC,_BL_Cstart_StackFill
        MOV ADDRSEL2,#DATA16 0904H
        MOV R0,#DATA16 01000H
        MOV R1,#DATA16 03FFEH
        MOV R2,0FF1EH
        MOV R3,#DATA16 04000H
        MOV R4,#DATA16 0823AH
        JMPR cc_UC,_BL_Cstart_StackFill

; ======== BL_RamTest_March  (@0x8823a) ========
        MOV ADDRSEL2,#DATA16 0FFF0H
        MOV WDTCON,#DATA16 09201H
        SRVWDT
        MOV R0,#DATA16 0EF00H
        MOV R1,#DATA16 0EFFFH
        MOV R4,R0
        MOVB RH5,#DATA16 055H
L_8254:              ; 0x88254
        ADD R4,#DATA16 010H
        CMP R4,R1
        JMPR cc_UGT,L_82D0
        MOV R3,R4
        ADD R3,#07H
        MOV R2,R3
        ADD R2,#DATA16 08H
        ADD R2,#01H
L_8268:              ; 0x88268
        MOVB [-R2],RH5
        CMP R2,R3
        JMPR cc_UGT,L_8268
        MOV R2,R3
        ADD R2,#07H
L_8272:              ; 0x88272
        MOVB RL5,[R2]
        ADDB RL5,RH5
        MOVB [R2],RL5
        SUB R2,#01H
        CMP R2,R3
        JMPR cc_NC,L_8272
        MOV R2,R3
        ADD R2,#07H
L_8282:              ; 0x88282
        MOVB RL5,[R2]
        ADDB RL5,RH5
        MOVB [R2],RL5
        CMPB RL5,0FF1EH
        JMPR cc_NE,L_82AC
        SUB R2,#01H
        CMP R2,R3
        JMPR cc_NC,L_8282
        MOV R2,R3
        ADD R2,#07H
L_8298:              ; 0x88298
        MOVB RL5,[R2]
        ADDB RL5,#01H
        MOVB [R2],RL5
        NOP
        MOVB RL5,[R2]
        JMPR cc_NE,L_82AC
        SUB R2,#01H
        CMP R2,R3
        JMPR cc_NC,L_8298
        JMPR cc_UC,L_8254
L_82AC:              ; 0x882ac
        OR R15,#DATA16 010H
        MOV R4,R0
L_82B2:              ; 0x882b2
        ADD R4,#DATA16 010H
        CMP R4,R1
        JMPR cc_UGT,L_82D0
        MOV R3,R4
        ADD R3,#07H
        MOV R2,R3
        ADD R2,#DATA16 08H
        ADD R2,#01H
        MOVB RL5,#00H
L_82C8:              ; 0x882c8
        MOVB [-R2],RL5
        CMP R2,R3
        JMPR cc_UGT,L_82C8
        JMPR cc_UC,L_82B2
L_82D0:              ; 0x882d0
        MOV ccp_e79e,R15
        MOV g_e7b8,R15
        MOV R1,#00H
        MOV R2,#00H
        MOV R3,#00H
        MOV R4,#00H
        MOV R5,#00H
        MOV R6,#00H
        MOV R7,#00H
        MOV R8,#00H
        MOV R9,#00H
        MOV R10,#00H
        MOV R11,#00H
        MOV R12,#00H
        MOV R13,#00H
        MOV R14,#00H
        MOV R15,#00H
        MOV R0,#DATA16 0F37CH
        JMPA cc_UC,BL_validate_app_launch_or_download

; ======== ?BL_Cstart_StackFill  (@0x882fe) ========
_BL_Cstart_StackFill:
        MOV R8,R15
        AND R8,#DATA16 08000H
        JMPR cc_NE,L_8310
        BCLR R2.00H
        CMP R2,R1
        JMPR cc_UGT,L_8310
        CMP R0,R2
        JMPR cc_C,L_8312
L_8310:              ; 0x88310
        MOV R2,R1
L_8312:              ; 0x88312
        MOV R8,#01H
L_8314:              ; 0x88314
        MOV [R0],R8
        NOP
        CMP R8,[R0]
        JMPR cc_NE,L_835E
        SHL R8,#01H
        JMPR cc_NC,L_8314
        MOV R8,#DATA16 0FFFEH
L_8324:              ; 0x88324
        MOV [R0],R8
        NOP
        CMP R8,[R0]
        JMPR cc_NE,L_835E
        ROL R8,#01H
        JB R8.00H,L_8324
        MOV R9,R2
        ADD R9,#02H
L_8336:              ; 0x88336
        MOV [-R9],R5
        CMP R9,R0
        JMPR cc_UGT,L_8336
        MOV R9,R2
L_833E:              ; 0x8833e
        MOV R8,[R9]
        ADD R8,R5
        MOV [R9],R8
        CMP R8,R7
        JMPR cc_NE,L_835E
        MOV R8,[R9]
        ADD R8,R6
        MOV [R9],R8
        NOP
        MOV R8,[R9]
        JMPR cc_NE,L_835E
        SUB R9,#02H
        JMPR cc_C,L_836C
        CMP R9,R0
        JMPR cc_NC,L_833E
        JMPR cc_UC,L_836C
L_835E:              ; 0x8835e
        OR R15,R3
        MOV R8,#00H
        MOV R9,R2
        ADD R9,#02H
L_8366:              ; 0x88366
        MOV [-R9],R8
        CMP R9,R0
        JMPR cc_UGT,L_8366
L_836C:              ; 0x8836c
        JMPI cc_UC,[R4]

; ======== Elevated_Write_Routine  (@0x8836e) ========
Elevated_Write_Routine:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        SUB R0,#02H
        BCLR bl_mode_status_flags.07H
        MOVB RL4,bl_exec_arm_magic
        CMPB RL4,#DATA16 053H
        JMPR cc_EQ,L_838C
        CMPB RL4,#DATA16 065H
