        MOVBZ R12,kwp_commobj_handle_tx
        CALLS 008H,CommObj_SetPendingByHandle
        MOV R12,#02H
        CALLS 008H,CommObj_SetPendingByHandle
        JMPR cc_UC,L_EDD8
L_EDC6:              ; 0x8edc6
