; ======== BL_CheckRoutinePreconditions  (@0x8eddc) ========
        ; BL_CheckRoutinePreconditions(idx, p2, p3) - returns 1 (ok) iff the KWP session-state register
        ; kwp_session_state (0xe660) is in an active-service state AND idx matches the expected slot:
        ;   (kwp_session_state & 2) -> require idx == p2
        ;   else (kwp_session_state & 4) -> require idx == p3
        ;   else -> 0 (fail).
        ; For SID 0x31 routines 0x04/0x05 it is called as (kwp_session_type_idx,0,0), i.e. requires an
        ; active default session (kwp_session_type_idx==0, state bit2/bit4 set). kwp_session_state==2 is the
        ; normal active-session value set by the KWP service loop (FUN_08b9c4); ==1 transiently during
        ; re-init (FUN_08dafa); ==0 idle.
BL_CheckRoutinePreconditions:
        MOV [-R0],R6
        MOVB RL6,#00H
        MOVBZ R4,kwp_session_state
        AND R4,#02H
        JMPR cc_EQ,L_EDF4
        MOV R4,R12
        MOV R5,R13
        CMPB RL4,RL5
        JMPR cc_NE,L_EE06
        MOVB RL6,#01H
        JMPR cc_UC,L_EE06
L_EDF4:              ; 0x8edf4
        MOVBZ R4,kwp_session_state
        AND R4,#04H
        JMPR cc_EQ,L_EE06
        MOV R4,R12
        MOV R5,R14
        CMPB RL4,RL5
        JMPR cc_NE,L_EE06
        MOVB RL6,#01H
L_EE06:              ; 0x8ee06
        MOVB RL4,RL6
        MOV R6,[R0+]
        RETS

; ======== KWP_ServiceTable_Dispatch  (@0x8ee0c) ========
KWP_ServiceTable_Dispatch:
        MOV [-R0],R15
