; ======== KWP_BL_SID_23_ReadMemoryByAddress  (@0x8e10c) ========
        ; KWP2000 SID 0x23 ReadMemoryByAddress (bootloader) - AUTHORITATIVE router entry (both router
        ; tables point here). Expects addr (bl_addr_size wide) + 1-byte length; reads bl_mem_len bytes.
        ; Validates range via BL_Check_Address_Range_Access; copies memory from bl_mem_addr into the KWP
        ; response buffer. NRC 0x52/0x53 on range/length errors, 0x79 on bad length. (The similar routine
        ; at 0x08e1dc is a secondary/legacy copy loop, not reached from the router tables.)
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        SUB R0,#06H
        EXTP #03H, #01H
        MOVBZ R4,027D2H
        ADD R4,#02H
        CMP R4,kwp_msg_len
        JMPA cc_NE,L_E254
        MOV R9,kwp_buf_base
        EXTP #03H, #01H
        MOVBZ R4,027D2H
        MOV R5,kwp_req_ptr
        ADD R5,R4
        MOVB RL4,[R5]
        MOVBZ R10,RL4
        MOV R11,#00H
        EXTP #03H, #02H
        MOV 027CAH,R10
        MOV 027CCH,R11
        EXTP #03H, #02H
        MOV R4,027CAH
        OR R4,027CCH
        JMPA cc_EQ,L_E24A
        MOV R4,kwp_buf_limit
        SUB R4,#01H
        MOVBZ R10,RL4
        MOV R11,#00H
        EXTP #03H, #02H
        SUB R10,027CAH
        SUBC R11,027CCH
        JMPR cc_C,L_E24A
        JNB bl_mode_status_flags.05H,L_E196
        EXTP #00H, #02H
        MOV R4,kwp_4c2
        MOV R5,kwp_4c4
        MOV [R0],R4
        MOV [R0+#02H],R5
        EXTP #00H, #01H
        MOVB RL4,kwp_4c6
        MOVB [R0+#04H],RL4
        JMPR cc_UC,L_E1BE
L_E196:              ; 0x8e196
        MOV R4,04444H
        MOV R5,04446H
        EXTP R5, #02H
        MOV R10,[R4+]
        MOV R11,[R4]
        MOV [R0],R10
        MOV [R0+#02H],R11
        MOV R4,04444H
        MOV R5,04446H
        EXTP R5, #02H
        MOVB RL3,[R4+#04H]
        NOP
        MOVB [R0+#04H],RL3
L_E1BE:              ; 0x8e1be
        MOV R4,kwp_req_ptr
        EXTP #03H, #01H
        MOV 027C8H,R4
        MOV R12,#DATA16 027C8H
        MOV R13,#DATA16 03H
        MOV R14,R0
        AND R14,#DATA16 03FFFH
        MOV R15,#DATA16 03H

; ======== KWP_BL_SID_23_ReadMemory_Loop  (@0x8e1dc) ========
        ; KWP2000 ReadMemoryByAddress (SID 0x23) handler - BOOTLOADER / programming session.
        ; Calls BL_Check_Address_Range_Access (08dbea). Sets response length (e548 = length+1) and copies from
        ; the physical
        ; source address ((e7d0<<2)|(e7ce>>14))*0x4000 + (e7ce & 0x3FFF), length bl_mem_len(e7ca/e7cc), into
        ; the response buffer @ 0x90000.
        ; On range-check NRC 0x22 (conditionsNotCorrect) it echoes 0x52. Reached via pointer table - not a
        ; defined function; create one at 08e1dc.
        CALLS 008H,BL_Check_Address_Range_Access
        MOVB RL4,kwp_nrc
        JMPR cc_NE,L_E236
        EXTP #03H, #02H
        MOV R7,027CEH
        MOV R8,027D0H
        MOV [-R0],R7
        SHR R7,#0EH
        SHL R8,#02H
        OR R8,R7
        MOV R7,[R0+]
        AND R7,#DATA16 03FFFH
        EXTP #03H, #01H
        MOV R4,027CAH
        ADD R4,#01H
        MOV kwp_msg_len,R4
        JMPR cc_UC,L_E226
L_E210:              ; 0x8e210
        EXTP R8, #01H
        MOVB RL4,[R7+]
        MOV R5,R9
        ADD R9,#01H
        MOVB [R5],RL4
        EXTP #03H, #02H
        ADD 027CAH,ONES
        ADDC 027CCH,ONES
L_E226:              ; 0x8e226
        EXTP #03H, #02H
        MOV R4,027CAH
        OR R4,027CCH
        JMPR cc_NE,L_E210
        JMPR cc_UC,L_E25C
L_E236:              ; 0x8e236
        MOVB RL4,kwp_nrc
        CMPB RL4,#DATA16 022H
        JMPR cc_NE,L_E25C
        MOVB RL5,#DATA16 052H
        MOVB kwp_nrc,RL5
        JMPR cc_UC,L_E25C
L_E24A:              ; 0x8e24a
        MOVB RL4,#DATA16 053H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E25C
L_E254:              ; 0x8e254
        MOVB RL4,#DATA16 079H
        MOVB kwp_nrc,RL4
L_E25C:              ; 0x8e25c
        ADD R0,#06H
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== KWP_BL_SID_27_SecurityAccess  (@0x8e266) ========
        ; KWP2000 SID 0x27 SecurityAccess (bootloader/programming-session seed-key gate).
        ; Reached via BL router table @0x0500 (entry {ptr=0x08e266, sid=0x27}).
        ;
        ; Gate: KWP_BL_IsCommsUnlocked_e79d_b2() (secacc_lockout_flags bit2). If clear -> NRC 0x37.
        ;
        ; Two security levels, config in low flash:
        ;   secacc_seed_ptr_table @0x4c8 : per-level {u16 seedOffset, u16 page}
        ;      level0 (Siemens) = {0x3f5c, 0}   level1 (Hyundai) = {0x3e01, 0}
        ;   secacc_requestseed_subfn_tbl @0x4d0 : {0xFD, 0x01}  (requestSeed sub-fn per level)
        ;   secacc_seedkey_len_tbl       @0x4d2 : {0x04, 0x02}  (seed/key length per level)
        ;   Expected KEY is stored immediately after the seed: keyAddr = seedAddr + len.
        ;      Siemens: seed@0x3f5c len4 -> key@0x3f60 ;  Hyundai: seed@0x3e01 len2 -> key@0x3e03
        ;   These are STATIC values baked in flash (not a random challenge).
        ;
        ; requestSeed (sub-fn LSB=1, e.g. 0x01/0xFD; msg_len==2):
        ;   match req sub-fn against secacc_requestseed_subfn_tbl -> secacc_level_idx.
        ;   If level already unlocked -> grant (positive, 00 00). Else copy 'len' seed bytes
        ;   from flash into response -> tester. secacc_subfn_state=req sub-fn.
        ;
        ; sendKey (sub-fn LSB=0, e.g. 0x02/0xFE; msg_len==len+2):
        ;   verify sub-fn sequence (secacc_subfn_state+1), then byte-compare received key
        ;   against expected key (seedAddr+len). Mismatch -> NRC 0x35 (invalidKey); after
        ;   2 fails -> KWP_SecAccess_SetPenaltyDelay (secacc_penalty_delay=10, lockout).
        ;   Match -> KWP_SecAccess_GrantFromFlashFlags, set secacc_unlocked_bits |= 2<<level.
        ;
        ; KWP_SecAccess_GrantFromFlashFlags: if secacc_siemens_disabled_flag(0x3fbe)==0xFF ->
        ;   Siemens pre-unlocked; if secacc_hyundai_disabled_flag(0x3e00)==0xFF -> Hyundai
        ;   pre-unlocked. (0xFF = virgin/immo-off, so this image auto-grants those levels.)
        ;
        ; NRCs: 0x37 timeDelayNotExpired/gate, 0x22 conditionsNotCorrect, 0x33 securityAccessDenied,
        ;       0x35 invalidKey, 0x79 internal length/state reject.
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        CALLS 008H,KWP_BL_IsCommsUnlocked_e79d_b2
        CMPB RL4,#00H
        JMPR cc_NE,L_E280
        MOVB RL4,#DATA16 037H
        MOVB kwp_nrc,RL4
        JMPA cc_UC,L_E4AA
L_E280:              ; 0x8e280
        MOV R4,kwp_req_ptr
        MOVB RL5,[R4]
        MOVBZ R5,RL5
        AND R5,#01H
        JMPA cc_EQ,L_E38C
        MOV R5,kwp_msg_len
        CMP R5,#02H
        JMPR cc_NE,L_E37C
        MOVB secacc_seedkey_len,ZEROS
        MOVB secacc_subfn_state,ONES
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        MOVB secacc_level_idx,ZEROS
L_E2AA:              ; 0x8e2aa
        MOVBZ R4,secacc_level_idx
        EXTP #00H, #02H
        MOVB RL5,[R4+#04D0H]
        NOP
        MOV R2,kwp_req_ptr
        CMPB RL5,[R2]
        JMPR cc_NE,L_E36C
        MOVB secacc_subfn_state,[R2]
        MOVBZ R4,secacc_level_idx
        MOV R5,#02H
        SHL R5,R4
        MOVBZ R4,secacc_unlocked_bits
        AND R4,R5
        JMPR cc_EQ,L_E302
        CALLS 008H,KWP_SecAccess_GrantFromFlashFlags
        MOVBZ R4,secacc_level_idx
        MOV R5,#02H
        SHL R5,R4
        ORB secacc_unlocked_bits,RL5
        MOVB RL4,#00H
        MOV R5,kwp_req_ptr
        MOVB [R5+#01H],RL4
        MOV R5,kwp_req_ptr
        MOVB [R5+#02H],RL4
        MOVB secacc_subfn_state,ZEROS
        MOV R4,#04H
        MOV kwp_msg_len,R4
        JMPR cc_UC,L_E364
L_E302:              ; 0x8e302
        MOVBZ R4,secacc_level_idx
        EXTP #00H, #02H
        MOVB RL5,[R4+#04D2H]
        NOP
        MOVB secacc_seedkey_len,RL5
        MOVBZ R4,RL5
        MOV kwp_msg_len,R4
        MOVBZ R4,secacc_level_idx
        SHL R4,#02H
        EXTP #00H, #03H
        MOV R7,[R4+#04C8H]
        MOV R8,[R4+#04CAH]
        NOP
        MOV [-R0],R7
        SHR R7,#0EH
        SHL R8,#02H
        OR R8,R7
        MOV R7,[R0+]
        AND R7,#DATA16 03FFFH
        MOV R9,#00H
        JMPR cc_UC,L_E356
L_E340:              ; 0x8e340
        MOV R4,R7
        MOV R5,R8
        ADD R4,R9
        EXTP R5, #01H
        MOVB RL3,[R4]
        MOV R4,kwp_req_ptr
        ADD R4,#01H
        ADD R4,R9
        MOVB [R4],RL3
        ADD R9,#01H
L_E356:              ; 0x8e356
        MOVBZ R4,secacc_seedkey_len
        CMP R9,R4
        JMPR cc_C,L_E340
        MOV R4,#02H
        ADD kwp_msg_len,R4
L_E364:              ; 0x8e364
        MOVB kwp_nrc,ZEROS
        JMPA cc_UC,L_E4AA
L_E36C:              ; 0x8e36c
        SUBB secacc_level_idx,ONES
        MOVB RL4,secacc_level_idx
        CMPB RL4,#02H
        JMPR cc_C,L_E2AA
        JMPA cc_UC,L_E4AA
L_E37C:              ; 0x8e37c
        MOVB secacc_subfn_state,ONES
        MOVB RL4,#DATA16 079H
        MOVB kwp_nrc,RL4
        JMPA cc_UC,L_E4AA
L_E38C:              ; 0x8e38c
        MOVBZ R4,secacc_seedkey_len
        ADD R4,#02H
        CMP R4,kwp_msg_len
        JMPA cc_NE,L_E4A2
        MOV R4,kwp_msg_len
        CMP R4,#04H
        JMPA cc_C,L_E4A2
        MOVB RL4,secacc_subfn_state
        JMPR cc_EQ,L_E3B8
        MOVBZ R4,secacc_level_idx
        MOV R5,#02H
        SHL R5,R4
        ANDB RL5,secacc_unlocked_bits
        JMPR cc_EQ,L_E3D0
L_E3B8:              ; 0x8e3b8
        MOVB RL4,#DATA16 034H
        MOV R5,kwp_req_ptr
        MOVB [R5+#01H],RL4
        MOV R4,#03H
        MOV kwp_msg_len,R4
        MOVB kwp_nrc,ZEROS
        JMPR cc_UC,L_E4AA
L_E3D0:              ; 0x8e3d0
        MOVB RL4,secacc_subfn_state
        CMPB RL4,#DATA16 0FFH
        JMPR cc_NE,L_E3E4
        MOVB RL5,#DATA16 022H
        MOVB kwp_nrc,RL5
        JMPR cc_UC,L_E4AA
L_E3E4:              ; 0x8e3e4
        SUBB secacc_subfn_state,ONES
        MOV R4,kwp_req_ptr
        MOVB RL5,[R4]
        CMPB RL5,secacc_subfn_state
        JMPR cc_NE,L_E494
        MOVB kwp_nrc,ZEROS
        MOVBZ R5,secacc_level_idx
        SHL R5,#02H
        EXTP #00H, #03H
        MOV R7,[R5+#04C8H]
        MOV R8,[R5+#04CAH]
        NOP
        MOV [-R0],R7
        SHR R7,#0EH
        SHL R8,#02H
        OR R8,R7
