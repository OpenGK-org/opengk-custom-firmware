; ======== BL_Routine_ProgramLevelFlag  (@0x8e4b2) ========
        ; BL_Routine_ProgramLevelFlag(fuseAddr, page) - SID 0x31 routines 0x04 / 0x05 handler.
        ; Burns a per-level auto-grant fuse in flash from 0xFF -> 0x00, i.e. REMOVES the SecurityAccess
        ; bypass for that level so future sessions must authenticate via SID 0x27 (see
        ; KWP_SecAccess_GrantFromFlashFlags). ONE-WAY (NOR 1->0 program; only an erase of this config
        ; sector restores 0xFF).
        ;   routine 0x04 -> fuseAddr=0x3e00 (secacc_hyundai_autogrant_fuse, Hyundai level)
        ;   routine 0x05 -> fuseAddr=0x3fbe (secacc_siemens_autogrant_fuse, Siemens level)
        ; Flow: requires BL_CheckRoutinePreconditions(kwp_session_type_idx,0,0) == true (active default
        ; session) else NRC 0x22. If the fuse is ALREADY 0x00 -> no-op success (returns 0, no write).
        ; Otherwise arms the flash-write exec magic (bl_exec_arm_magic=0x65, b1=AC b2=CA b3=35), programs
        ; 0x00 via Elevated_Write_Routine_Wrapper, re-reads; 0x00 -> success, else NRC 0x22.
        ; NOTE: the 0x31 dispatcher does NOT require secacc_unlocked_bits for 0x04/0x05 (only session gate +
        ; precondition) - so the lockdown can be applied without first unlocking.
BL_Routine_ProgramLevelFlag:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV R8,R12
        MOV R9,R13
        MOVB RL4,#DATA16 065H
        MOVB bl_exec_arm_magic,RL4
        MOVB RL5,#DATA16 0ACH
        MOVB bl_exec_magic_b1,RL5
        MOVBZ R12,kwp_session_type_idx
        MOV R13,#00H
        MOV R14,#00H
        CALLS 008H,BL_CheckRoutinePreconditions
        CMPB RL4,#00H
        JMPR cc_EQ,L_E51A
        EXTS R9, #01H
        MOVB RL4,[R8]
        JMPR cc_EQ,L_E522
        MOVB RL4,#00H
        MOV R5,kwp_req_ptr
        MOVB [R5+#01H],RL4
        MOVB RL4,#DATA16 0CAH
        MOVB bl_exec_magic_b2,RL4
        MOVB RL5,#DATA16 035H
        MOVB bl_exec_magic_b3,RL5
        MOV R12,kwp_req_ptr
        ADD R12,#01H
        MOV R13,R8
        MOV R14,R9
        MOV R15,#01H
        CALLS 008H,Elevated_Write_Routine_Wrapper
        EXTS R9, #01H
        MOVB RL4,[R8]
        JMPR cc_EQ,L_E522
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E522
L_E51A:              ; 0x8e51a
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
L_E522:              ; 0x8e522
        MOVB bl_exec_magic_b3,ZEROS
        MOVB bl_exec_magic_b2,ZEROS
        MOVB bl_exec_magic_b1,ZEROS
        MOVB bl_exec_arm_magic,ZEROS
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== KWP_BL_SID_31_StartRoutineByAddress  (@0x8e538) ========
        ; KWP2000 SID 0x31 StartRoutineByLocalId (bootloader flash/MTOS routine controller). Gated by
        ; programming session (bl_prog_session_state in {0,5}) or routine-in-progress bit
        ; (kwp_comms_flags 0x800). Uses NRC 0x78 responsePending across multiple calls. Routine id
        ; (req[0]):
        ;   0x00/0x01 = erase/program a flash region via the loaded MTOS driver (BL_Routine_EraseOrInit);
        ;              needs mtos_driver_state 2 (0x00) or 1 (0x01). Requires secacc_unlocked_bits&4
        ;              (Hyundai level) + BL_CheckRoutinePreconditions.
        ;   0x02      = start checksum/verify (BL_Routine_ComputeChecksum); crc_status|=0x84.
        ;   0x03      = read checksum result -> 2 bytes in response.
        ;   0x04      = burn Hyundai auto-grant fuse 0x3e00 -> 0x00 (BL_Routine_ProgramLevelFlag):
        ;              REMOVES the SecurityAccess bypass for the Hyundai level (one-way lockdown).
        ;   0x05      = burn Siemens auto-grant fuse 0x3fbe -> 0x00 (BL_Routine_ProgramLevelFlag):
        ;              REMOVES the bypass for the Siemens level (one-way lockdown).
        ;   0xFA      = VERIFY + EXECUTE the MTOS image uploaded to RAM (BL_Routine_VerifyAndRunMTOS):
        ;              "MT" signature + CRC check, then jump to MTOS_RamEntry (RAM 0xc014). Requires
        ;              secacc_unlocked_bits&2 (Siemens level).
        ; Precondition fail -> NRC 0x33 securityAccessDenied; bad id -> NRC 0x12; errors -> NRC 0x22/0x40.
        ; Note: routines 0x04/0x05 are NOT gated on secacc_unlocked_bits, only the session + precondition.
        SUB R0,#02H
        MOV R4,kwp_msg_len
        CMP R4,#02H
        JMPR cc_NE,L_E54C
        MOVB RL4,bl_prog_session_state
        JMPR cc_EQ,L_E554
        CMPB RL4,#05H
        JMPR cc_EQ,L_E554
L_E54C:              ; 0x8e54c
        JB kwp_comms_flags.0BH,L_E554
        JMPA cc_UC,L_E7C4
L_E554:              ; 0x8e554
        MOVB kwp_nrc,ZEROS
        MOV R4,kwp_req_ptr
        MOVB RL5,[R4]
        CMPB RL5,#01H
        JMPR cc_UGT,L_E644
        MOVB RL4,secacc_unlocked_bits
        ANDB RL4,#04H
        JMPR cc_EQ,L_E638
        MOVBZ R12,kwp_session_type_idx
        MOV R13,#01H
        MOV R14,#01H
        CALLS 008H,BL_CheckRoutinePreconditions
        CMPB RL4,#00H
        JMPR cc_EQ,L_E638
        JNB kwp_comms_flags.0BH,L_E622
        JNB bl_mode_status_flags.05H,L_E5EE
        BCLR kwp_comms_flags.0BH
        MOVB RL4,#02H
        MOVB bl_prog_state,RL4
        MOV R4,kwp_req_ptr
        MOVB RL5,[R4]
        JMPR cc_NE,L_E5C2
        MOV R4,#DATA16 010H
        MOV R5,#0AH
        MOV bl_op_addr_lo,R4
        MOV bl_op_addr_bank,R5
        MOV R2,#02H
        MOV bl_op_size_lo,R2
        MOV bl_op_size_hi,ZEROS
        MOV R12,#01H
        CALLA cc_UC,BL_Routine_EraseOrInit
        CMPB RL4,#00H
        JMPA cc_NE,L_E7CC
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPA cc_UC,L_E7CC
L_E5C2:              ; 0x8e5c2
        MOV bl_op_addr_lo,ZEROS
        MOV R4,#09H
        MOV bl_op_addr_bank,R4
        MOV R5,#02H
        MOV bl_op_size_lo,R5
        MOV bl_op_size_hi,ZEROS
        MOV R12,#00H
        CALLA cc_UC,BL_Routine_EraseOrInit
        CMPB RL4,#00H
        JMPA cc_NE,L_E7CC
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPA cc_UC,L_E7CC
L_E5EE:              ; 0x8e5ee
        MOV R4,0445EH
        MOV R5,04460H
        CALLS 000H,rt_callfar_via_r5r4
        MOVB RL4,kwp_e7c3
        JMPR cc_NE,L_E614
        EXTP #00H, #02H
        MOV R4,kwp_27a
        MOV R5,kwp_27c
        CALLS 000H,rt_callfar_via_r5r4
        JMPA cc_UC,L_E7CC
L_E614:              ; 0x8e614
        BCLR kwp_comms_flags.0BH
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPA cc_UC,L_E7CC
L_E622:              ; 0x8e622
        BSET kwp_comms_flags.0BH
        MOVB RL4,#DATA16 078H
        MOVB kwp_nrc,RL4
        MOV R4,kwp_msg_len
        ADD kwp_buf_base,R4
        JMPA cc_UC,L_E7CC
L_E638:              ; 0x8e638
        MOVB RL4,#DATA16 033H
        MOVB kwp_nrc,RL4
        JMPA cc_UC,L_E7CC
L_E644:              ; 0x8e644
        MOV R4,kwp_req_ptr
        MOVB RL5,[R4]
        CMPB RL5,#02H
        JMPR cc_EQ,L_E664
        CMPB RL5,#03H
        JMPR cc_EQ,L_E6D8
        CMPB RL5,#04H
        JMPR cc_EQ,L_E71E
        CMPB RL5,#05H
        JMPR cc_EQ,L_E72C
        CMPB RL5,#DATA16 0FAH
        JMPR cc_EQ,L_E73A
        JMPA cc_UC,L_E7BA
L_E664:              ; 0x8e664
        MOVB RL4,secacc_unlocked_bits
        ANDB RL4,#04H
        JMPR cc_EQ,L_E6CC
        MOVBZ R12,kwp_session_type_idx
        MOV R13,#01H
        MOV R14,#01H
        CALLS 008H,BL_CheckRoutinePreconditions
        CMPB RL4,#00H
        JMPR cc_EQ,L_E6CC
        JNB kwp_comms_flags.0BH,L_E6AE
        MOV R4,0E7B6H
        AND R4,#DATA16 0108H
        CMP R4,#DATA16 0108H
        JMPR cc_NE,L_E6A8
        BCLR kwp_comms_flags.0BH
        CALLA cc_UC,BL_Routine_ComputeChecksum
        AND R4,#DATA16 080H
        JMPA cc_NE,L_E7CC
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPA cc_UC,L_E7CC
L_E6A8:              ; 0x8e6a8
        BSET kwp_comms_flags.0AH
        JMPA cc_UC,L_E7CC
L_E6AE:              ; 0x8e6ae
        MOV R4,#DATA16 084H
        OR 0E7B6H,R4
        BSET kwp_comms_flags.0BH
        MOVB RL4,#DATA16 078H
        MOVB kwp_nrc,RL4
        MOV R4,kwp_msg_len
        ADD kwp_buf_base,R4
        JMPA cc_UC,L_E7CC
L_E6CC:              ; 0x8e6cc
        MOVB RL4,#DATA16 033H
        MOVB kwp_nrc,RL4
        JMPA cc_UC,L_E7CC
L_E6D8:              ; 0x8e6d8
        MOVB RL4,secacc_unlocked_bits
        ANDB RL4,#04H
        JMPR cc_EQ,L_E714
        MOVBZ R12,kwp_session_type_idx
        MOV R13,#01H
        MOV R14,#01H
        CALLS 008H,BL_CheckRoutinePreconditions
        CMPB RL4,#00H
        JMPR cc_EQ,L_E714
        CALLA cc_UC,BL_Routine_ComputeChecksum
        MOV [R0],R4
        MOVB RL4,[R0+#01H]
        MOV R5,kwp_req_ptr
        MOVB [R5+#01H],RL4
        MOVB RL4,[R0]
        MOV R5,kwp_req_ptr
        MOVB [R5+#02H],RL4
        MOV R4,#04H
        MOV kwp_msg_len,R4
        JMPR cc_UC,L_E7CC
L_E714:              ; 0x8e714
        MOVB RL4,#DATA16 033H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E7CC
L_E71E:              ; 0x8e71e
        MOV R12,#DATA16 03E00H
        MOV R13,#DATA16 00H
        CALLS 008H,BL_Routine_ProgramLevelFlag
        JMPR cc_UC,L_E7CC
L_E72C:              ; 0x8e72c
        MOV R12,#DATA16 03FBEH
        MOV R13,#DATA16 00H
        CALLS 008H,BL_Routine_ProgramLevelFlag
        JMPR cc_UC,L_E7CC
L_E73A:              ; 0x8e73a
        MOVB RL4,secacc_unlocked_bits
        ANDB RL4,#02H
        JMPR cc_EQ,L_E7B0
        MOVBZ R12,kwp_session_type_idx
        MOV R13,#01H
        MOV R14,#01H
        CALLS 008H,BL_CheckRoutinePreconditions
        CMPB RL4,#00H
        JMPR cc_EQ,L_E7B0
        JB bl_mode_status_flags.05H,L_E75A
        JNB kwp_comms_flags.0BH,L_E78A
L_E75A:              ; 0x8e75a
        BCLR kwp_comms_flags.0BH
        CALLS 008H,BL_Routine_VerifyAndRunMTOS
        CMPB RL4,#01H
        JMPR cc_EQ,L_E76E
        CMPB RL4,#02H
        JMPR cc_EQ,L_E778
        CMPB RL4,#00H
        JMPR cc_EQ,L_E782
        JMPR cc_UC,L_E786
L_E76E:              ; 0x8e76e
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E7CC
L_E778:              ; 0x8e778
        MOVB RL4,#DATA16 040H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E7CC
L_E782:              ; 0x8e782
        BSET kwp_comms_flags.0AH
        JMPR cc_UC,L_E7CC
L_E786:              ; 0x8e786
        BSET kwp_comms_flags.0AH
        JMPR cc_UC,L_E7CC
L_E78A:              ; 0x8e78a
        MOV R4,kwp_msg_len
        CMP R4,#02H
        JMPR cc_NE,L_E7A6
        BSET kwp_comms_flags.0BH
        MOVB RL4,#DATA16 078H
        MOVB kwp_nrc,RL4
