        ; ------------------------------------------------------------
        ; Bootloader K-line (ASC0) init: S0BG=0xc34, S0CON=0x8011 (8N1 async), and MASKS all ASC0 interrupts
        ; (S0TIC/S0TBIC/S0RIC/S0EIC enable bits cleared). The BL K-line transport is POLLED, not
        ; interrupt-driven -- which is why an MTOS payload running with interrupts off can keep doing UART I/O
        ; on this same line.
        ; ------------------------------------------------------------
BL_Kline_ASC0_Init:
        BCLR S0CON.0DH
        MOV S0BG,#DATA16 0C34H
        MOV S0CON,#DATA16 08011H
        MOV S0TBUF,#DATA16 00H
        BCLR S0TIC.07H
        EXTR #01H
        BCLR S0TBIC.07H
        BCLR S0RIC.07H
        BCLR S0EIC.07H
        BCLR S0TIC.06H
        EXTR #01H
        BCLR S0TBIC.06H
        BCLR S0RIC.06H
        BCLR S0EIC.06H
        RETS

