; ======== KWP_BL_SID_3D_WriteMemoryByAddress  (@0x8eb00) ========
        ; KWP2000 SID 0x3D WriteMemoryByAddress (bootloader). Length check: req[addr_size] (count
        ; byte) + 5 == msg_len else NRC 0x79. Parses addr (bl_addr_size wide) + 1-byte length,
        ; validates via BL_Check_Address_Range_Access(0x27c8). dataFormat req[0]:
        ;   (req[0]&0xe0)==0x80 in programming session -> EXEC-ARM path: writes magic
        ;     bl_exec_arm_magic/b1/b2/b3 = 53 AC CA 35, sets bl_exec_addr_lo/hi + bl_exec_len +
        ;     bl_exec_src_ptr, pushes to system stack and JUMPS into the uploaded RAM routine
        ;     (GKFlasher loader exec path). NRC 0x40 if post-exec flag (fd0a&0x80) not set; NRC 0x22
        ;     if not in programming session.
        ;   else -> plain byte-copy loop writing bl_mem_len bytes from KWP buffer to bl_mem_addr.
        ; Range-denied -> NRC 0x42 (was 0x22).
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R6
        SUB R0,#06H
        EXTP #03H, #01H
        MOVBZ R4,027D2H
        MOV R5,kwp_req_ptr
        ADD R5,R4
        MOVB RL4,[R5]
        MOVBZ R4,RL4
        ADD R4,#05H
        CMP R4,kwp_msg_len
        JMPA cc_NE,L_ECE4
        MOV R4,kwp_req_ptr
        EXTP #03H, #01H
        MOV 027C8H,R4
        MOV R5,kwp_req_ptr
        MOVB RL6,[R5]
        ANDB RL6,#DATA16 0E0H
        EXTP #03H, #01H
        MOVBZ R2,027D2H
        ADD R5,R2
        MOVB RL4,[R5]
        MOVBZ R10,RL4
        MOV R11,#00H
        EXTP #03H, #02H
        MOV 027CAH,R10
        MOV 027CCH,R11
        JNB bl_mode_status_flags.05H,L_EB7A
        EXTP #00H, #02H
        MOV R4,kwp_4de
        MOV R5,kwp_4e0
        MOV [R0],R4
        MOV [R0+#02H],R5
        EXTP #00H, #01H
        MOVB RL4,kwp_4e2
        MOVB [R0+#04H],RL4
        JMPR cc_UC,L_EBA2
L_EB7A:              ; 0x8eb7a
        MOV R4,04448H
        MOV R5,0444AH
        EXTP R5, #02H
        MOV R10,[R4+]
        MOV R11,[R4]
        MOV [R0],R10
        MOV [R0+#02H],R11
        MOV R4,04448H
        MOV R5,0444AH
        EXTP R5, #02H
        MOVB RL3,[R4+#04H]
        NOP
        MOVB [R0+#04H],RL3
L_EBA2:              ; 0x8eba2
        MOV R12,#DATA16 027C8H
        MOV R13,#DATA16 03H
        MOV R14,R0
        AND R14,#DATA16 03FFFH
        MOV R15,#DATA16 03H

; ======== KWP_BL_SID_3D_WriteMemory_Loop  (@0x8ebb4) ========
        ; KWP2000 WriteMemoryByAddress (SID 0x3D) handler - BOOTLOADER / programming session.
        ; Calls BL_Check_Address_Range_Access (08dbea). If the sub-byte RL6 == 0x80 -> arms code execution
        ; (Push_To_System_Stack_Program x3, i.e. jump to uploaded routine). Otherwise copies the request
        ; payload from the
        ; response/work buffer @ 0x90000 to the target address bl_mem_addr(e7ce):bl_mem_addr_hi(e7d0), length
        ; bl_mem_len(e7ca/e7cc).
        ; On range-check NRC 0x22 (conditionsNotCorrect) it echoes 0x42. This is the path GKFlasher uses to
        ; upload the MTOS
        ; loader into the 0xC000 RAM window. Reached via pointer table - not a defined function; create one at
        ; 08ebb4.
        CALLS 008H,BL_Check_Address_Range_Access
        MOVB RL4,kwp_nrc
        JMPA cc_NE,L_ECD0
        EXTP #03H, #01H
        MOVBZ R4,027D2H
        ADD R4,#01H
        ADD kwp_req_ptr,R4
        MOVB RL4,#DATA16 053H
        MOVB bl_exec_arm_magic,RL4
        MOVB RL5,#DATA16 0ACH
        MOVB bl_exec_magic_b1,RL5
        CMPB RL6,#DATA16 080H
        JMPR cc_NE,L_EC72
        MOVB RL3,bl_prog_session_state
        JMPR cc_EQ,L_EBEE
        CMPB RL3,#05H
        JMPR cc_NE,L_EC68
L_EBEE:              ; 0x8ebee
        MOVB RL4,#DATA16 0CAH
        MOVB bl_exec_magic_b2,RL4
        MOVB RL5,#DATA16 035H
        MOVB bl_exec_magic_b3,RL5
        EXTP #03H, #02H
        MOV R4,027CEH
        MOV R5,027D0H
        MOV bl_exec_addr_lo,R4
        MOV bl_exec_addr_hi,R5
        MOV R2,kwp_req_ptr
        MOV bl_exec_src_ptr,R2
        EXTP #03H, #01H
        MOV R3,027CAH
        MOV bl_exec_len,R3
        BCLR PSW.0BH
        MOV R4,0446AH
        MOV R5,0446CH
        CALLS 000H,rt_callfar_via_r5r4
        EXTP #00H, #02H
        MOV R4,kwp_286
        MOV R5,kwp_288
        CALLS 000H,rt_callfar_via_r5r4
        BSET PSW.0BH
        MOV R4,04476H
        MOV R5,04478H
        CALLS 000H,rt_callfar_via_r5r4
        JNB bl_mode_status_flags.07H,L_EC5E
        MOV R4,#01H
        MOV kwp_msg_len,R4
        JMPR cc_UC,L_ECB6
L_EC5E:              ; 0x8ec5e
        MOVB RL4,#DATA16 040H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_ECB6
L_EC68:              ; 0x8ec68
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_ECB6
L_EC72:              ; 0x8ec72
        EXTP #03H, #02H
        MOV R8,027CEH
        MOV R9,027D0H
        JMPR cc_UC,L_ECA2
L_EC80:              ; 0x8ec80
        MOV R4,kwp_req_ptr
        SUB kwp_req_ptr,ONES
        MOVB RL5,[R4]
        MOV R10,R8
        MOV R11,R9
        ADD R8,#01H
        ADDC R9,#00H
        EXTS R11, #01H
        MOVB [R10],RL5
        EXTP #03H, #02H
        ADD 027CAH,ONES
        ADDC 027CCH,ONES
L_ECA2:              ; 0x8eca2
        EXTP #03H, #02H
        MOV R4,027CAH
        OR R4,027CCH
        JMPR cc_NE,L_EC80
        MOV R4,#01H
        MOV kwp_msg_len,R4
L_ECB6:              ; 0x8ecb6
        MOVB bl_exec_magic_b3,ZEROS
        MOVB bl_exec_magic_b2,ZEROS
        MOVB bl_exec_magic_b1,ZEROS
        MOVB bl_exec_arm_magic,ZEROS
        MOV R4,kwp_buf_base
        MOV kwp_req_ptr,R4
        JMPR cc_UC,L_ECEC
L_ECD0:              ; 0x8ecd0
        MOVB RL4,kwp_nrc
        CMPB RL4,#DATA16 022H
        JMPR cc_NE,L_ECEC
        MOVB RL5,#DATA16 042H
        MOVB kwp_nrc,RL5
        JMPR cc_UC,L_ECEC
L_ECE4:              ; 0x8ece4
        MOVB RL4,#DATA16 079H
        MOVB kwp_nrc,RL4
L_ECEC:              ; 0x8ecec
        ADD R0,#06H
        MOV R6,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

