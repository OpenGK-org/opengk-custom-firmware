; ======== KWP_SecAccess_GrantFromFlashFlags  (@0x8dbb8) ========
        ; KWP_SecAccess_GrantFromFlashFlags - recomputes secacc_unlocked_bits from the two per-level
        ; auto-grant fuses in flash (called on every session start/reinit). Polarity:
        ;   secacc_siemens_autogrant_fuse (0x3fbe) == 0xFF -> secacc_unlocked_bits = 3 (bit0 base + bit1
        ;       Siemens auto-unlocked); != 0xFF -> = 1 (only base bit0).
        ;   secacc_hyundai_autogrant_fuse (0x3e00) == 0xFF -> secacc_unlocked_bits |= 4 (bit2 Hyundai
        ;       auto-unlocked).
        ; So fuse 0xFF = that SecurityAccess level is BYPASSED (granted for free); fuse 0x00 = ENFORCED
        ; (must pass SID 0x27 seed/key, which sets the same bit via |= 2<<level). bit1(=2) gates MTOS exec
        ; (0x31/0xFA); bit2(=4) gates flash erase/program (0x31/0x00,0x01). In THIS image both fuses are
        ; 0x00 -> both levels enforced.
KWP_SecAccess_GrantFromFlashFlags:
        EXTP #00H, #01H
        MOVB RL4,secacc_siemens_autogrant_fuse
        CMPB RL4,#DATA16 0FFH
        JMPR cc_NE,L_DBCE
        MOVB RL5,#03H
        MOVB secacc_unlocked_bits,RL5
        JMPR cc_UC,L_DBD4
L_DBCE:              ; 0x8dbce
        MOVB RL4,#01H
        MOVB secacc_unlocked_bits,RL4
L_DBD4:              ; 0x8dbd4
        EXTP #00H, #01H
        MOVB RL4,secacc_hyundai_autogrant_fuse
        CMPB RL4,#DATA16 0FFH
        JMPR cc_NE,L_DBE8
        MOVB RL5,#04H
        ORB secacc_unlocked_bits,RL5
L_DBE8:              ; 0x8dbe8
        RETS

