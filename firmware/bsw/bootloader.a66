; ======== BL_Routine_EraseOrInit  (@0x88bfa) ========
        ; BL_Routine_EraseOrInit - SID 0x31 routine 0x00/0x01 handler. Real flash erase/program-prep,
        ; but executed THROUGH the already-running MTOS driver: requires DAT_00e7c1==2, DAT_00fd0a&0x20,
        ; and mtos_driver_state (0xc18d) == 2 (routine 0) or == 1 (routine 1). Arms a secondary exec magic
        ; (bl_exec_arm_magic=0x65, b1=AC b2=CA b3=35), verifies the target PRG-zone start against hardcoded
        ; values, then performs the elevated flash write/erase via Elevated_Write_Routine_Wrapper
        ; (region param 0 -> bank 9 @0xfff0; region param 1 -> bank 10 @0x0) and FUN_0890c8(0x318/0x300).
        ; Completion gated by DAT_00fd0a&0x80 (driver-done flag).
BL_Routine_EraseOrInit:
        MOV [-R0],R7
        MOV [-R0],R6
        SUB R0,#04H
        MOV R7,R12
        MOVB RL6,#00H
        MOVB RL4,#DATA16 065H
        MOVB bl_exec_arm_magic,RL4
        MOVB RL5,bl_prog_state
        CMPB RL5,#02H
        JMPA cc_NE,L_8D0C
        JB bl_mode_status_flags.05H,L_8C1E
        JMPA cc_UC,L_8D0C
L_8C1E:              ; 0x88c1e
        MOVB RL3,#DATA16 0ACH
        MOVB bl_exec_magic_b1,RL3
        MOVB RL2,bl_download_substate
        JMPA cc_NE,L_8D0C
        MOVB RL1,#DATA16 0CAH
        MOVB bl_exec_magic_b2,RL1
        CALLA cc_UC,BL_Flash_ClassifyOpAddrRange
        MOV R4,#00H
        MOV R5,#00H
        MOV [R0],R4
        MOV [R0+#02H],R5
        CMPB RL7,#00H
        JMPR cc_NE,L_8C98
        MOVB RL4,mtos_driver_state
        CMPB RL4,#02H
        JMPR cc_NE,L_8C98
        MOVB RL5,#DATA16 035H
        MOVB bl_exec_magic_b3,RL5
        CALLA cc_UC,BL_check_app_signature_09fff0
        CMPB RL4,#01H
        JMPR cc_NE,L_8C86
        CALLS 008H,BL_Flash_Guard_Bank9_Pre_RetOk
        CMPB RL4,#00H
        JMPR cc_EQ,L_8D0C
        CALLS 008H,BL_Flash_Guard_Bank9_Post_RetOk
        CMPB RL4,#00H
        JMPR cc_EQ,L_8D0C
        MOV R12,R0
        MOV R13,#DATA16 0FFF0H
        MOV R14,#DATA16 09H
        MOV R15,#04H
        CALLS 008H,Elevated_Write_Routine_Wrapper
        JNB bl_mode_status_flags.07H,L_8D0C
        JMPR cc_UC,L_8CFC
L_8C86:              ; 0x88c86
        MOV R12,#DATA16 0318H
        MOV R13,#DATA16 00H
        MOV R14,#01H
        CALLA cc_UC,BL_Flash_RunDriverOverAddrTable
        MOVB RL6,RL4
        JMPR cc_UC,L_8D0C
L_8C98:              ; 0x88c98
        CMPB RL7,#01H
        JMPR cc_NE,L_8D0C
        MOVB RL4,mtos_driver_state
        CMPB RL4,#01H
        JMPR cc_NE,L_8D0C
        MOVB RL5,#DATA16 035H
        MOVB bl_exec_magic_b3,RL5
        CALLA cc_UC,Compare_start_of_PRG_zone_to_hardcoded_values_rets_bool_rl4
        CMPB RL4,#01H
        JMPR cc_NE,L_8CEA
        CALLS 008H,BL_Flash_Guard_Bank10_Pre_RetOk
        CMPB RL4,#00H
        JMPR cc_EQ,L_8D0C
        CALLS 008H,BL_Flash_Guard_Bank10_Post_RetOk
        CMPB RL4,#00H
        JMPR cc_EQ,L_8D0C
        MOV R12,R0
        MOV R13,#DATA16 00H
        MOV R14,#DATA16 0AH
        MOV R15,#04H
        CALLS 008H,Elevated_Write_Routine_Wrapper
        JNB bl_mode_status_flags.07H,L_8D0C
        MOV R12,#DATA16 0300H
        MOV R13,#DATA16 00H
        MOV R14,#06H
        CALLA cc_UC,BL_Flash_RunDriverOverAddrTable
        MOVB RL6,RL4
        JMPR cc_UC,L_8D0C
L_8CEA:              ; 0x88cea
        MOV R12,#DATA16 0300H
        MOV R13,#DATA16 00H
        MOV R14,#06H
        CALLA cc_UC,BL_Flash_RunDriverOverAddrTable
        MOVB RL6,RL4
        JMPR cc_UC,L_8D0C
L_8CFC:              ; 0x88cfc
        MOV R12,#DATA16 0318H
        MOV R13,#DATA16 00H
        MOV R14,#01H
        CALLA cc_UC,BL_Flash_RunDriverOverAddrTable
        MOVB RL6,RL4
L_8D0C:              ; 0x88d0c
        MOVB bl_exec_arm_magic,ZEROS
