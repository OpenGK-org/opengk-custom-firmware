; ======== KWP_Init_ProgrammingSession  (@0x8dafa) ========
        ; KWP_Init_ProgrammingSession: (re)initializes the KWP2000 programming session. Guard: runs only if
        ; DAT_00fd0a & 0x20 (programming allowed), else Push_To_System_Stack_Program and return. Resets
        ; kwp_session_state=1/flags=0, grants security via KWP_SecAccess_GrantFromFlashFlags, P3 timeout=5000
        ; ms, RX buffer base 0xe559 (limit 0xff), bl_addr_size=3; then BL_EnterProgrammingSession + FUN_08be0c
        ; + FUN_08b596 (comm-object reset); finally clears busy bit and session_state=0.
KWP_Init_ProgrammingSession:
        JNB bl_mode_status_flags.05H,L_DB84
        BSET kwp_comms_flags.09H
        MOV kwp_timing_counter,ZEROS
        MOVB RL4,#01H
        MOVB kwp_session_state,RL4
        MOV kwp_comms_flags,ZEROS
        CALLS 008H,KWP_SecAccess_GrantFromFlashFlags
        MOVB kwp_session_type_idx,ZEROS
        MOVB kwp_e765,ZEROS
        MOVB RL4,#DATA16 019H
        MOVB kwp_timing_thr_a,RL4
        MOVB RL4,#DATA16 037H
        MOVB kwp_timing_thr_b,RL4
        MOV R4,#DATA16 01388H
        MOV kwp_session_p3_timeout,R4
        MOV R4,#DATA16 0E559H
        MOV kwp_req_ptr,R4
        MOV R5,#DATA16 0E559H
        MOV kwp_buf_base,R5
        MOV R2,#DATA16 0FFH
        MOV kwp_buf_limit,R2
        MOV kwp_dyndef_len,ZEROS
        MOV R2,#DATA16 0E65DH
        EXTP #03H, #01H
        MOV 027D4H,R2
        MOV R3,#DATA16 0E661H
        EXTP #03H, #01H
        MOV 027D6H,R3
        MOVB RL4,#03H
        EXTP #03H, #01H
        MOVB 027D2H,RL4
        CALLS 008H,BL_EnterProgrammingSession
        CALLS 008H,BL_Kline_InitBaud_Default
        CALLS 008H,KWP_Rx_Buffers_Reset
        BCLR kwp_comms_flags.08H
        MOVB kwp_session_state,ZEROS
        RETS
L_DB84:              ; 0x8db84
        MOV R4,04414H
        MOV R5,04416H
        CALLS 000H,rt_callfar_via_r5r4
        RETS

