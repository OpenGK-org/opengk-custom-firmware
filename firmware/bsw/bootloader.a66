L_EFA0:              ; 0x8efa0
        MOVB RL4,RL6
        MOV R6,[R0+]
        RETS

; ======== KWP_BL_IsCommsUnlocked_e79d_b2  (@0x8efa6) ========
        ; Returns bit2 of status byte DAT_00e79d. Used as the entry gate of KWP_BL_SID_27_SecurityAccess
        ; (0x08e266): security-access/seed-key exchange only proceeds when this comms/session flag is set.
