; ======== KWP_BL_SID_10_StartDiagnosticSession  (@0x8b5d2) ========
        ; KWP2000 SID 0x10 StartDiagnosticSession (bootloader, comms-layer table A). Validates req[0]
        ; session type against the session descriptor table at flash 0x604 (ptr) / 0x608 (page). Per
        ; session type: 0x81 -> P3 timeout 0xffee; 0x85 -> 60000ms + BL_EnterProgrammingSession
        ; (FUN_0890b2) i.e. ENTER PROGRAMMING SESSION; else -> 5000ms. Stores kwp_session_type_idx,
        ; calls KWP_SecAccess_GrantFromFlashFlags, sets kwp_comms_flags bit 0x2000 (session active).
        ; NRC 0x12 unsupported session, 0x22 conditions.
        MOV [-R0],R6
        JB kwp_comms_flags.0DH,L_B66C
        MOV R4,kwp_msg_len
        CMP R4,#02H
        JMPR cc_NE,L_B662
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        MOVB RL6,#00H
        JMPR cc_UC,L_B656
L_B5EC:              ; 0x8b5ec
        EXTP #00H, #02H
        MOV R4,kwp_608
        MOV R5,kwp_60a
        MOVBZ R2,RL6
        ADD R4,R2
        EXTP R5, #01H
        MOVB RL3,[R4]
        MOV R2,kwp_req_ptr
        CMPB RL3,[R2]
        JMPR cc_NE,L_B654
        MOVB kwp_nrc,ZEROS
        MOVB kwp_session_type_idx,RL6
        MOVB RL4,[R2]
        CMPB RL4,#DATA16 081H
        JMPR cc_EQ,L_B620
        CMPB RL4,#DATA16 085H
        JMPR cc_EQ,L_B62E
        JMPR cc_UC,L_B640
L_B620:              ; 0x8b620
        MOV R4,#DATA16 0FFEEH
        MOV kwp_session_p3_timeout,R4
        MOVB kwp_timing_thr_b,ZEROS
        JMPR cc_UC,L_B64C
