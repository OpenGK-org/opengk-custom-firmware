; ======== KWP_BL_SID_34_RequestDownload  (@0x8e7d0) ========
        ; KWP2000 SID 0x34 RequestDownload (bootloader). Gated by programming session
        ; (bl_prog_session_state in {0,5}). Parses dataFormatId req[0] ((req[0]&0xe0) must be 0x80 or
        ; 0x00); bank = req[0]&0x1f -> bl_op_addr_bank; 2-byte address req[1..2] -> bl_op_addr_mid/lo;
        ; 3-byte (24-bit) uncompressed size req[4..6] -> bl_op_size_hi:bl_op_size_lo. Calls
        ; BL_Download_Setup (FUN_088d26) and responds with maxBlockLength = kwp_buf_limit-1. Prepares
        ; for the following TransferData (0x36) sequence.
        MOV [-R0],R9
        MOVB RL4,bl_prog_session_state
        JMPR cc_EQ,L_E7DC
        CMPB RL4,#05H
        JMPR cc_NE,L_E88A
L_E7DC:              ; 0x8e7dc
        EXTP #03H, #01H
        MOVBZ R4,027D2H
        ADD R4,#05H
        CMP R4,kwp_msg_len
        JMPR cc_NE,L_E880
        MOV R9,kwp_req_ptr
        MOVB RL4,[R9]
        MOVBZ R4,RL4
        AND R4,#DATA16 0E0H
        CMP R4,#DATA16 080H
        JMPR cc_EQ,L_E808
        MOVB RL4,[R9]
        MOVBZ R4,RL4
        AND R4,#DATA16 0E0H
        JMPR cc_NE,L_E876
L_E808:              ; 0x8e808
        MOVB RL4,[R9+#03H]
        JMPR cc_NE,L_E86C
        MOVB bl_op_block_seq,ZEROS
        MOVB RL4,[R9]
        ANDB RL4,#DATA16 01FH
        MOVB bl_op_addr_bank,RL4
        ADD R9,#01H
        MOVB bl_op_addr_mid,[R9]
        ADD R9,#01H
        MOVB bl_op_addr_lo,[R9]
        ADD R9,#01H
        ADD R9,#01H
        MOVB kwp_e7b5,ZEROS
        MOVB bl_op_size_hi,[R9]
        ADD R9,#01H
        MOVB kwp_e7b3,[R9]
        ADD R9,#01H
        MOVB bl_op_size_lo,[R9]
        CALLA cc_UC,BL_Download_Setup
        MOVBZ R4,RL4
        CMP R4,#01H
        JMPR cc_NE,L_E862
        MOV R4,kwp_buf_limit
        SUB R4,#01H
        MOV R5,kwp_req_ptr
        MOVB [R5],RL4
        MOVB kwp_nrc,ZEROS
        MOV R4,#02H
        MOV kwp_msg_len,R4
        JMPR cc_UC,L_E892
L_E862:              ; 0x8e862
        MOVB RL4,#DATA16 040H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E892
L_E86C:              ; 0x8e86c
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E892
L_E876:              ; 0x8e876
        MOVB RL4,#DATA16 041H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E892
L_E880:              ; 0x8e880
        MOVB RL4,#DATA16 079H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E892
L_E88A:              ; 0x8e88a
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
L_E892:              ; 0x8e892
        MOV R9,[R0+]
        RETS

; ======== KWP_BL_SID_36_TransferData  (@0x8e896) ========
        ; KWP2000 SID 0x36 TransferData (bootloader). Writes the received data block to the target via
        ; BL_Program_TransferBlock (FUN_088d64, ptr+len); decrements the 24-bit remaining counter
        ; (bl_op_size_hi:bl_op_size_lo); tracks block sequence (bl_op_block_seq). NRC 0x42
        ; (programming/transfer failed) on write error. Must follow a RequestDownload (0x34).
        MOV [-R0],R6
        MOVB RL4,bl_prog_session_state
        JMPR cc_EQ,L_E8A2
        CMPB RL4,#05H
        JMPR cc_NE,L_E8FA
L_E8A2:              ; 0x8e8a2
        ADD kwp_msg_len,ONES
        MOV R4,kwp_msg_len
        MOV R5,#00H
        SUB R4,bl_op_size_lo
        SUBC R5,bl_op_size_hi
        JMPR cc_ULE,L_E8C0
        MOVB RL4,#DATA16 079H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E902
L_E8C0:              ; 0x8e8c0
        MOV R12,kwp_req_ptr
        MOV R13,kwp_msg_len
        CALLA cc_UC,BL_Program_TransferBlock
        MOVB RL6,RL4
        CMPB RL6,#01H
        JMPR cc_NE,L_E8DE
        MOV R4,#01H
        MOV kwp_msg_len,R4
        MOVB kwp_nrc,ZEROS
        JMPR cc_UC,L_E902
L_E8DE:              ; 0x8e8de
        CMPB RL6,#03H
        JMPR cc_EQ,L_E8E6
        CMPB RL6,#02H
        JMPR cc_NE,L_E8F0
L_E8E6:              ; 0x8e8e6
        MOVB RL4,#DATA16 042H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E902
L_E8F0:              ; 0x8e8f0
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_E902
L_E8FA:              ; 0x8e8fa
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
L_E902:              ; 0x8e902
        MOV R6,[R0+]
        RETS

; ======== KWP_BL_SID_37_RequestTransferExit  (@0x8e906) ========
        ; KWP2000 SID 0x37 RequestTransferExit (bootloader). Finalizes the download via
        ; BL_Transfer_Finalize (FUN_088e1a); requires the 24-bit remaining counter == 0 (entire block
        ; transferred). Closes the RequestDownload/TransferData sequence.
        MOVB RL4,bl_prog_session_state
        JMPR cc_EQ,L_E910
        CMPB RL4,#05H
        JMPR cc_NE,L_E94E
L_E910:              ; 0x8e910
        MOV R4,kwp_msg_len
        CMP R4,#01H
        JMPR cc_NE,L_E944
