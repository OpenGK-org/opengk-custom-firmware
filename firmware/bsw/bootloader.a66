        JMPR cc_NE,L_B6FC
        MOVB RL5,kwp_record_fmt
        CMPB RL5,#DATA16 028H
        JMPR cc_NE,L_B6FA
        BSET kwp_prog_flags.08H
        RETS
L_B6FA:              ; 0x8b6fa
        BCLR kwp_prog_flags.08H
L_B6FC:              ; 0x8b6fc
        RETS

; ======== KWP_BL_SID_3E_TesterPresent  (@0x8b6fe) ========
        ; KWP2000 SID 0x3E TesterPresent (bootloader router). 1-byte form -> plain ack. 2-byte
        ; form: sub-fn 0x00 -> responseRequired (len=2); sub-fn 0x80 -> responseNotRequired, set
        ; kwp_comms_flags bit 0x400; else NRC 0x12 (subFunctionNotSupported). Wrong length -> NRC 0x79.
