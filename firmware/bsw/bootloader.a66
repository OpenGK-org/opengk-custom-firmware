        JMPR cc_UC,L_EDB2
L_ED90:              ; 0x8ed90
        MOV R12,#02H
        MOV R13,#00H
        MOV R4,04418H
        MOV R5,0441AH
        CALLS 000H,rt_callfar_via_r5r4
        MOVBZ R10,kwp_commobj_handle_rx
