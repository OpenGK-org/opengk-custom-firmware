        RETS

; ======== KWP_Check_ServicePermission  (@0x8eee0) ========
        ; ------------------------------------------------------------
        ; KWP service-permission check: indexes a per-session permission table[kwp_session_type_idx], masks
        ; low 3 bits, compares to secacc_unlocked_bits. Sets kwp_nrc = 0x80 (no entry) / 0x33
        ; securityAccessDenied (not unlocked) / 0x00 (allowed).
        ; ------------------------------------------------------------
        MOV [-R0],R6
        MOVBZ R4,kwp_session_type_idx
        MOV R10,R12
        MOV R11,R13
        ADD R10,R4
        EXTP R11, #01H
        MOVB RL6,[R10]
        ANDB RL6,#07H
        JMPR cc_NE,L_EEFE
        MOVB RL4,#DATA16 080H
        MOVB kwp_nrc,RL4
        JMPR cc_UC,L_EF16
L_EEFE:              ; 0x8eefe
        MOVBZ R4,secacc_unlocked_bits
        MOVBZ R5,RL6
        AND R5,R4
        JMPR cc_EQ,L_EF0E
