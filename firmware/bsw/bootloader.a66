; ======== BL_Flash_RunDriverOverAddrTable  (@0x890c8) ========
        ; ------------------------------------------------------------
        ; BL flash sector-erase loop: iterates a table of param_3 4-byte {addr_lo,addr_hi} entries at seg-0
        ; offset param_1 (e.g. 0x318 bank9, 0x300 bank10), calling BL_Flash_RunDriverAtAddr per entry; aborts
        ; if the BL-mode bit (DAT_00fd0a & 0x100) drops. Returns success bool.
        ; ------------------------------------------------------------
BL_Flash_RunDriverOverAddrTable:
        MOV [-R0],R14
        MOV [-R0],R13
        MOV [-R0],R12
        MOV [-R0],R7
        MOV [-R0],R6
        MOVB RL7,#00H
        MOVB RL6,#01H
