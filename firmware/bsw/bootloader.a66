        BCLR kwp_comms_flags.0CH
        MOVB kwp_timing_thr_a,ZEROS
        BCLR kwp_comms_flags.0DH
        RETS

; ======== KWP_BL_SID_28_29_CommunicationControl  (@0x8b6b4) ========
        ; KWP2000 SID 0x28/0x29 CommunicationControl (bootloader router). Requires 2-byte request.
        ; sub-fn 0x01 -> ack (len=1, NRC=0). sub-fn 0x02 -> set kwp_comms_flags bit 0x400
        ; (suppress/queue normal comms), NRC=0. Otherwise NRC 0x22. On success, if request format
        ; == 0x28 sets kwp_comms_flags(0xfd04) bit 0x100, else clears it.
        MOVB RL4,#DATA16 022H
        MOVB kwp_nrc,RL4
        MOV R4,kwp_msg_len
        CMP R4,#02H
        JMPR cc_NE,L_B6E6
        MOV R4,kwp_req_ptr
        MOVB RL5,[R4]
        CMPB RL5,#01H
        JMPR cc_EQ,L_B6D4
        CMPB RL5,#02H
        JMPR cc_EQ,L_B6E0
        JMPR cc_UC,L_B6E6
L_B6D4:              ; 0x8b6d4
        MOV R4,#01H
        MOV kwp_msg_len,R4
        MOVB kwp_nrc,ZEROS
        JMPR cc_UC,L_B6E6
