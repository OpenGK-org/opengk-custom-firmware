        MOV R7,#00H
        JMPR cc_UC,L_EEB4
L_EE5C:              ; 0x8ee5c
        EXTP R9, #02H
        MOVB RL4,[R8+#04H]
        NOP
        CMPB RL4,kwp_record_fmt
        JMPR cc_NE,L_EE96
        MOV R12,R8
        MOV R13,R9
        ADD R12,#05H
        EXTP #00H, #02H
        MOV R4,kwp_216
        MOV R5,kwp_218
        CALLS 000H,rt_callfar_via_r5r4
        MOVB RL4,kwp_nrc
        JMPR cc_NE,L_EE92
        EXTP R9, #02H
        MOV R5,[R8+#02H]
        MOV R4,[R8]
        CALLS 000H,rt_callfar_via_r5r4
L_EE92:              ; 0x8ee92
        MOVB RL6,#01H
        JMPR cc_UC,L_EEB2
L_EE96:              ; 0x8ee96
        MOV R4,[R0+#08H]
        MOV R5,[R0+#0AH]
        EXTP R5, #02H
        MOVB RL3,[R4+#02H]
        NOP
        MOVBZ R2,RL3
        MOV R4,R8
        MOV R5,R9
        ADD R4,R2
        MOV R8,R4
        MOV R9,R5
L_EEB2:              ; 0x8eeb2
        ADD R7,#01H
L_EEB4:              ; 0x8eeb4
