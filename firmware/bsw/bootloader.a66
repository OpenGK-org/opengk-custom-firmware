; SIMK43 seg-8 bootloader (phys 0x88000-0x8FFFF), symbolicated from Ghidra.
; '#DATA16 n' keeps the 4-byte immediate form where a short form would fit:
; it keeps code size, and so every address, unchanged (see README).
$MOD167
$INCLUDE (REG167.INC)

; --- SFRs not in REG167.INC ---
SFR_F024               DEFR 0F024H

; --- external call/jump targets (other segments) ---
rt_callfar_via_r5r4    EQU  02000H
rt_read_dword_far_r5r4 EQU  02006H
q_rt_udiv32            EQU  02014H
g_c000                 EQU  0C000H
MTOS_RamEntry          EQU  0C014H
