; ======== BL_CAN2_Init_CommObjects_0xEE00  (@0x8f276) ========
        ; Bootloader CAN2 (0xEE00) bring-up. Copies 0x10 control bytes from flash template @0x61c into
        ; C2CSR/C2BTR/global-masks, then 0xF0 bytes from template @0x71c into the 15 message objects
        ; (0xEE10..0xEEFF) - these define the KWP-over-CAN / flashing diagnostic IDs. 0xEE00 (CAN2) is the
        ; diagnostic/comms controller shared with CCP; 0xEF00 (CAN1) is the separate powertrain bus.
BL_CAN2_Init_CommObjects_0xEE00:
        MOV [-R0],R9
        MOV R14,#DATA16 061CH
        MOV R15,#DATA16 00H
        MOV R12,#DATA16 0EE00H
        MOV R13,#00H
L_F286:              ; 0x8f286
        EXTP R15, #01H
        MOVB RL4,[R14]
        MOVB [R12],RL4
        ADD R14,#01H
        ADD R12,#01H
        CMPI1 R13,#0FH
        JMPR cc_SLT,L_F286
        MOV R14,#DATA16 071CH
        MOV R15,#DATA16 00H
        MOV R12,#DATA16 0EE10H
        MOV R13,#00H
L_F2A2:              ; 0x8f2a2
        EXTP R15, #01H
        MOVB RL4,[R14]
        MOVB [R12],RL4
        ADD R14,#01H
        ADD R12,#01H
        CMPI1 R13,#DATA16 0EFH
        JMPR cc_SLT,L_F2A2
        MOV R9,#DATA16 0EE00H
        MOV R4,#00H
        MOV [R9],R4
        MOV R9,[R0+]
        RET

