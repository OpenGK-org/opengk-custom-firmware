        MOV R4,R14
        OR R4,R15
        JMPR cc_EQ,L_EE40
        MOV R12,[R0+#0CH]
        MOV R13,[R0+#0EH]
        MOV R4,04410H
        MOV R5,04412H
        CALLS 000H,rt_callfar_via_r5r4
L_EE40:              ; 0x8ee40
        JB kwp_comms_flags.0FH,L_EED0
        MOV R4,[R0+#08H]
        MOV R5,[R0+#0AH]
        EXTP R5, #03H
        MOV R8,[R4+#08H]
