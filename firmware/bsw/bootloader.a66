        MOV R6,[R0+]
        RETS

; ======== CommObj_ClearPendingFlagByHandle  (@0x8a84a) ========
        ; ?CommObj_ClearPendingFlagByHandle(handle): resolves a logical comm-object handle (param_1 low byte)
        ; through two RAM descriptor tables -- base ptr @DAT_00c1a6+4, 0x1c(28)-byte records (+9 = sub-index),
        ; then 0xc(12)-byte control blocks based @DAT_00c1ac -- to a control block. If block+0xb bit 0x2
        ; ('pending') is set AND block+6 (stored tag) == handle, it clears bit 0x2 (acknowledge/release) and
        ; writes back. Returns {flag_state, block_ptr/handle}. Used e.g. by FUN_08b596 which resets the KWP RX
        ; buffer (kwp_req_ptr=0xe559) then releases handles 0,1,2 (the 3 CAN comm mailboxes). Name uncertain
        ; (?): bit 0x2 semantics (pending vs busy) not fully confirmed.
