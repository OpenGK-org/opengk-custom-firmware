; ======== KWP_BL_SID_3E_TesterPresent_progB  (@0x8c398) ========
        ; KWP2000 SID 0x3E TesterPresent - programming-session-B variant. Minimal keep-alive: NRC=0
        ; (positive ack), no side effects.
        MOVB kwp_nrc,ZEROS
        RETS

; ======== KWP_BL_SID_81_StartCommunication  (@0x8c39e) ========
        ; KWP2000 SID 0x81 StartCommunication (bootloader, init). Sets kwp(0xfd02) comms-active bit,
        ; writes the KWP2000 key bytes 0xEF 0x8F into the response, msg_len=3, NRC=0. This is the
        ; fast-init/StartComms positive response the tester sees when opening a session.
        BCLR bl_prog_comm_flags.03H
        BSET bl_prog_comm_flags.02H
        MOVB RL4,#DATA16 0EFH
        MOV R5,kwp_req_ptr
        MOVB [R5],RL4
        MOVB RL4,#DATA16 08FH
        MOV R5,kwp_req_ptr
        MOVB [R5+#01H],RL4
        MOV R4,#03H
        MOV kwp_msg_len,R4
        MOVB kwp_nrc,ZEROS
        RETS

; ======== KWP_BL_SID_82_StopCommunication  (@0x8c3c4) ========
        ; KWP2000 SID 0x82 StopCommunication (bootloader). If session active (kwp_comms_flags 0x2000):
        ; clear bl_flash_driver_ready, call FUN_08dafa (teardown) + BL_EnterProgrammingSession, clear
        ; session bit. Else set session bit and ack. Terminates the comms layer.
        JB kwp_comms_flags.0DH,L_C3D0
        BSET kwp_comms_flags.0DH
        MOVB kwp_nrc,ZEROS
        RETS
L_C3D0:              ; 0x8c3d0
        MOVB bl_flash_driver_ready,ZEROS
        CALLS 008H,KWP_Init_ProgrammingSession
        CALLS 008H,BL_EnterProgrammingSession
        BCLR kwp_comms_flags.0DH
        RETS

