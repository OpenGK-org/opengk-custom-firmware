; ======== BL_Flash_ClassifyOpAddrRange  (@0x88f7a) ========
        ; ------------------------------------------------------------
        ; BL download range validator/classifier. Reads bl_op_addr_bank/lo + bl_op_size_lo/hi, checks
        ; [addr,addr+size) against flash bank bounds (bank0<=0x3FFF, bank9<=0xFFEF/0xFFFF high flash, bank10,
        ; 0x0F). Sets mtos_driver_state to the region class: 0=REJECT(out of range), 1/2/3=valid region types.
        ; Return value == mtos_driver_state.
        ; ------------------------------------------------------------
BL_Flash_ClassifyOpAddrRange:
        MOV R12,bl_op_addr_lo
        MOV R13,bl_op_addr_bank
        MOV R14,bl_op_addr_lo
