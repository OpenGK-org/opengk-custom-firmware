; ======== NMITRAP_handler  (@0x8f43e) ========
NMITRAP_handler:
        MOV DPP3,#DATA16 03H
        MOV MDH,0FFACH
        MOV lv_maf_e7fc,MDH
        XOR MDH,0FF1EH
        MOV lv_maf_e7fe,MDH
        MOV WDTCON,#DATA16 0FF00H
        SRVWDT
        MOV MDH,#DATA16 0FFH
L_F45E:              ; 0x8f45e
        ADD MDH,0FF1EH
        JMPR cc_NE,L_F45E
        SRST

        ; 0xFF flash pad to end of segment
        DB      0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
