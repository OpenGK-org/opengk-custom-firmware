; ======== rt_callfar_via_r5r4  (@0x2000) ========
        ; ------------------------------------------------------------
        ; Runtime helper: indirect FAR CALL via pointer in r5:r4. 'calls 0x2000' pushes the real return; this
        ; pushes r5(seg)+r4(off) and RETS -> transfers to r5:r4, whose own RETS returns to the original
        ; caller. (Was mislabeled Push_To_System_Stack_Program.)
        ; ------------------------------------------------------------
        PUSH R5
        PUSH R4
        RETS

; ======== rt_read_dword_far_r5r4  (@0x2006) ========
        ; ------------------------------------------------------------
        ; Runtime helper: far 32-bit read. EXTS r5; r10=[r5:r4]; r4+=2; r11=[r5:r4]. Loads a dword from the
        ; far pointer r5:r4 into r11:r10 (used e.g. by BL_Routine_VerifyAndRunMTOS to read the MTOS CRC
        ; range).
        ; ------------------------------------------------------------
        EXTS R5, #01H
        MOV R10,[R4]
        ADD R4,#02H
        ADDC R5,#00H
        EXTS R5, #01H
        MOV R11,[R4]
        RETS

; ======== q_rt_udiv32  (@0x2014) ========
        ; ------------------------------------------------------------
        ; ? Runtime helper: 32-bit unsigned divide (divlu/divu + normalization shifts + mulu back-multiply).
        ; Classic Tasking/Keil C166 __udiv32-style long-division helper. Exact div-vs-divmod semantics
        ; unconfirmed.
        ; ------------------------------------------------------------
        OR R11,R11
        JMPR cc_NE,L_202E
        MOV 0FE0EH,R5
        DIVU R10
        MOV R5,0FE0EH
        MOV 0FE0EH,R4
        DIVLU R10
        MOV R4,0FE0EH
        RETS
L_202E:              ; 0x202e
        MOV [-R0],R4
        MOV [-R0],R5
        MOV [-R0],R10
        MOV [-R0],R11
L_2036:              ; 0x2036
        SHR R10,#01H
        BMOV R10.0FH,R11.00H
        SHR R11,#01H
        SHR R4,#01H
        BMOV R4.0FH,R5.00H
        SHR R5,#01H
        OR R11,R11
        JMPR cc_NE,L_2036
        MOV 0FE0CH,R5
        MOV 0FE0EH,R4
        DIVLU R10
