; asw/noise.a66
; EVAP tank-pressure noise rate-based monitor (IUMPR).
; 0xD12C2-0xD134C  (138 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_RBM_DTP_Noise, ClrBits_state_rbm_dtp_noise_2c8, Set_state_rbm_dtp_noise_2c2
EXTERN  Div_U32_U16_Round32:NEAR

S_D12C2 SECTION CODE AT 0D12C2H

; ======== Set_state_rbm_dtp_noise_2c2  (@0xd12c2) ========
Set_state_rbm_dtp_noise_2c2:
        MOVB state_rbm_dtp_noise,ZEROS
        RETS

; ======== ClrBits_state_rbm_dtp_noise_2c8  (@0xd12c8) ========
ClrBits_state_rbm_dtp_noise_2c8:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_dtp_noise,RL4
        RETS

; ======== Calc_RBM_DTP_Noise  (@0xd12d2) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for DTP Noise:
        ; updates state_rbm_dtp_noise / rate_rbm_dtp_noise (in-use completion ratio = numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_DTP_Noise:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB obd_sf.0DH,L_D1346
        MOVB RL4,state_rbm_dtp_noise
        ANDB RL4,#01H
        JMPR cc_NE,L_D12F6
        MOVB RL4,state_diagcp
        CMPB RL4,#05H
        JMPR cc_C,L_D12F6
        CMPB RL4,#DATA16 0000BH
        JMPR cc_EQ,L_D12F6
        MOVB RL5,#01H
        ORB state_rbm_dtp_noise,RL5
L_D12F6:                 ; 0xd12f6
        MOVB RL4,state_rbm_dtp_noise
        ANDB RL4,#02H
        JMPR cc_NE,L_D1308
        JNB lv_err_maf_tps_ratio_2.0DH,L_D1308
        MOVB RL4,#02H
        ORB state_rbm_dtp_noise,RL4
L_D1308:                 ; 0xd1308
        MOVB RL4,#04H
        ORB state_rbm_dtp_noise,RL4
        MOV R12,ctr_comp_rbm_dtp_noise
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_dtp_noise
        CALLS 00FH,Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_D1338
        CMP R8,#DATA16 0FFFFH
L_D1338:                 ; 0xd1338
        JMPR cc_C,L_D1340
        MOV rate_rbm_dtp_noise,ONES
        JMPR cc_UC,L_D1346
L_D1340:                 ; 0xd1340
        MOV R4,R8
        MOV rate_rbm_dtp_noise,R4
L_D1346:                 ; 0xd1346
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_D12C2 ENDS
        END
