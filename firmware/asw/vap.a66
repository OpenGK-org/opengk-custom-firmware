        ; dtp_mv_dyw / dtp_dif_dyw.
        ; ------------------------------------------------------------
DiagCP_Calc_DtpDyw:
        MOV [-R0],R12
        MOV R4,dtp_sword
        ASHR R4,#01H
        MOV R5,g_cfba
        ASHR R5,#01H
        ADD R4,R5
        MOV dtp_mv_dyw,R4
        MOV R12,R4
        MOV R13,dtp_sword
        CALLS SEG Sat_Sub_S16, SOF Sat_Sub_S16
        MOV dtp_dif_dyw,R4
        MOV R12,R4
        CALLS SEG Abs_S16, SOF Abs_S16
        MOV R5,[R0]
        CMP R4,R5
        JMPR cc_C,L_D35C0
        BCLR lv_err_maf_tps_ratio_2.0FH
        MOVB RL4,#00H
        JMPR cc_UC,L_D35C4
L_D35C0:                 ; 0xd35c0
        BSET lv_err_maf_tps_ratio_2.0FH
        MOVB RL4,#01H
L_D35C4:                 ; 0xd35c4
        ADD R0,#02H
        RET

