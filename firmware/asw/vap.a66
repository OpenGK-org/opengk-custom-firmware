; ======== DiagCP_Noise_Abort  (@0xd3572) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by cp/evap/dtp/diagcp output signals + DTC): Abort EVAP diag on pressure noise:
        ; intr_state_diagcp + cdn_dtp_noise_state_diag.
        ; ------------------------------------------------------------
DiagCP_Noise_Abort:
        MOV R4,#DATA16 00020H
        OR intr_state_diagcp,R4
        MOV R12,#00H
        CALLA cc_UC,DiagCP_SetFaultState
        MOVB RL4,#02H
        MOVB cdn_dtp_noise_state_diag,RL4
L_D3586:                 ; 0xd3586
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

