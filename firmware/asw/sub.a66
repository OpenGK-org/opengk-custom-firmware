; ======== Reset_TCO_Diag  (@0xc9bda) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by tco/tia/crank output signals): Reset coolant-temp diagnosis min/max:
        ; tco_mes_max/min_diag, tco_st, tco_sub_word (DTC 0xd1a2 path).
        ; ------------------------------------------------------------
Reset_TCO_Diag:
        JNB lv_pl.04H,L_C9C06
        JNB lv_pl.08H,L_C9C06
        MOVB RL4,tco
        MOVB tco_st,RL4
        MOVB tco_mes_max_diag,RL4
        MOVB tco_mes_min_diag,RL4
        MOVBZ R4,tco_st
        SHL R4,#08H
        MOV tco_sub_word,R4
        MOV tco_sub_max_diag,R4
        MOV tco_sub_min_diag,R4
        JMPR cc_UC,L_C9C12
L_C9C06:                 ; 0xc9c06
        JNB lv_cdn_diag_maf_dif_ch_int.0BH,L_C9C12
        MOVB RL4,tco
