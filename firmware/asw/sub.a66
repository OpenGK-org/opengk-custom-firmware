; asw/sub.a66
; Coolant temperature substitute value: intermittent-failure state machine and rationality
; diagnosis.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_tco_sub_tol_diag                   EQU  0903A1H
c_t_tco_sub_is_1                     EQU  09073AH
c_t_tco_sub_is_2                     EQU  09073CH
c_t_tco_sub_puc                      EQU  09073EH
c_tco_st_tco_sub_min                 EQU  090758H
c_tia_tco_dif_min_tco_sub            EQU  0907A6H
ldpm_tco_st__ip_tco_dif_diag                      EQU  090E4DH
ip_tco_sub_dif_min_diag__tco_st      EQU  094090H
ip_tco_mes_dif_min_diag__tco_st      EQU  096608H

PUBLIC  Diag_DTC_dd1a2b, Diag_TCO_Sub, L_C99C8, Reset_TCO_Diag, tco_sub_St0_Idle, tco_sub_St1_IS1_Deb
PUBLIC  tco_sub_St2_IS2_Deb, tco_sub_St3_Hold, tco_sub_St4_PUC_Wait, tco_sub_St5_PUC_Subst
EXTERN  Abs_Diff_U16:NEAR, Add_r12_r13_Return_r4:NEAR, DTC_Update_Imm_V2:NEAR, DTC_Update_Immediate:NEAR
EXTERN  Get_IP_Byte_2D_Table:NEAR, Get_IP_Byte_3D_Table_DWord_XWord_YWord:NEAR, Get_IP_Byte_Y_Axis:NEAR, Get_IP_Word_2D_Table:NEAR
EXTERN  Get_IP_Word_2D_Table_DWord_YWord:NEAR, Read_MulDiv_MD:NEAR, sub_r12_r13_rets_r4:NEAR

S_SUB SECTION CODE

; ======== tco_sub_St0_Idle  (@0xc97c2) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (EMS2000, verified): Intermittent failure monitoring (tco_sub, c_t_tco_sub_is_1)
        ; ------------------------------------------------------------
        ; tco_sub state-machine ARM (state 0), NOT an independent routine. Reached via
        ; switch(tco_sub_state@f4b0) jump-table tco_sub_SM_jmptab@0xa0c88 inside Acq_TCO_Mes(0xc951c); falls
        ; through into the shared tco_sub diagnostic tail. State0=idle/integrate; on fault
        ; (maf_dif_ch_int.4000) arm IS_1 timer->state1; on pl-cut load PUC timer->state4. (Supersedes earlier
        ; Diag_TCO_Sub_IFM1 label.)
tco_sub_St0_Idle:
        JB lv_pl.02H,L_C97CA
        JB can_fd58.09H,L_C97DC
L_C97CA:                 ; 0xc97ca
        MOV R4,DPP0:c_t_tco_sub_puc
        MOV tco_sub_deb_ctr,R4
        MOVB RL4,#04H
        MOVB tco_sub_state,RL4
        JMPA cc_UC,L_C99B6
L_C97DC:                 ; 0xc97dc
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV tco_sub_word,R4
        JB lv_cdn_diag_maf_dif_ch_int.0EH,L_C97F2
        JMPA cc_UC,L_C99B6
L_C97F2:                 ; 0xc97f2
        MOV R4,DPP0:c_t_tco_sub_is_1
        MOV tco_sub_deb_ctr,R4
        MOVB RL4,#01H
        MOVB tco_sub_state,RL4
        JMPA cc_UC,L_C99B6

; ======== tco_sub_St1_IS1_Deb  (@0xc9804) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (EMS2000, verified): Intermittent failure monitoring (tco_sub, c_t_tco_sub_is_2)
        ; ------------------------------------------------------------
        ; tco_sub state-machine ARM (state 1 = IS_1 debounce). Switch arm of Acq_TCO_Mes@0xc951c via
        ; tco_sub_SM_jmptab@0xa0c88. Fault cleared->integrate,state0; else decrement tco_sub_deb_ctr, on
        ; expiry arm IS_2 timer->state2. (Supersedes Diag_TCO_Sub_IFM2.)
tco_sub_St1_IS1_Deb:
        JB lv_pl.02H,L_C980C
        JB can_fd58.09H,L_C981E
L_C980C:                 ; 0xc980c
        MOV R4,DPP0:c_t_tco_sub_puc
        MOV tco_sub_deb_ctr,R4
        MOVB RL4,#04H
        MOVB tco_sub_state,RL4
        JMPA cc_UC,L_C99B6
L_C981E:                 ; 0xc981e
        JNB lv_cdn_diag_maf_dif_ch_int.0EH,L_C9850
        ADD tco_sub_deb_ctr,ONES
        MOV R4,tco_sub_deb_ctr
        JMPR cc_EQ,L_C983E
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV tco_sub_word,R4
        JMPA cc_UC,L_C99B6
L_C983E:                 ; 0xc983e
        MOV R4,DPP0:c_t_tco_sub_is_2
        MOV tco_sub_deb_ctr,R4
        MOVB RL4,#02H
        MOVB tco_sub_state,RL4
        JMPA cc_UC,L_C99B6
L_C9850:                 ; 0xc9850
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV tco_sub_word,R4
        MOVB tco_sub_state,ZEROS
        JMPA cc_UC,L_C99B6

; ======== tco_sub_St2_IS2_Deb  (@0xc9866) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Intermittent failure monitoring tco_sub twin
        ; (c_t_tco_sub_puc)
        ; ------------------------------------------------------------
        ; tco_sub state-machine ARM (state 2 = IS_2 debounce). Switch arm of Acq_TCO_Mes@0xc951c. Fault
        ; cleared->integrate,state0; else decrement tco_sub_deb_ctr, on expiry integrate once->state3
        ; (confirmed, no timer reload). (Supersedes Diag_TCO_Sub_IFM3.)
tco_sub_St2_IS2_Deb:
        JB lv_pl.02H,L_C986E
        JB can_fd58.09H,L_C9880
L_C986E:                 ; 0xc986e
        MOV R4,DPP0:c_t_tco_sub_puc
        MOV tco_sub_deb_ctr,R4
        MOVB RL4,#04H
        MOVB tco_sub_state,RL4
        JMPA cc_UC,L_C99B6
L_C9880:                 ; 0xc9880
        JNB lv_cdn_diag_maf_dif_ch_int.0EH,L_C98A8
        ADD tco_sub_deb_ctr,ONES
        MOV R4,tco_sub_deb_ctr
        JMPA cc_NE,L_C99B6
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV tco_sub_word,R4
        MOVB RL4,#03H
        MOVB tco_sub_state,RL4
        JMPA cc_UC,L_C99B6
L_C98A8:                 ; 0xc98a8
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV tco_sub_word,R4
        MOVB tco_sub_state,ZEROS
        JMPA cc_UC,L_C99B6

; ======== tco_sub_St3_Hold  (@0xc98be) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Intermittent failure monitoring tco_sub twin
        ; (c_t_tco_sub_puc)
        ; ------------------------------------------------------------
        ; tco_sub state-machine ARM (state 3 = fault-confirmed hold). Switch arm of Acq_TCO_Mes@0xc951c.
        ; Always integrate; drop to state0 only when fault condition clears. (Supersedes Diag_TCO_Sub_IFM4.)
tco_sub_St3_Hold:
        JB lv_pl.02H,L_C98C6
        JB can_fd58.09H,L_C98D8
L_C98C6:                 ; 0xc98c6
        MOV R4,DPP0:c_t_tco_sub_puc
        MOV tco_sub_deb_ctr,R4
        MOVB RL4,#04H
        MOVB tco_sub_state,RL4
        JMPA cc_UC,L_C99B6
L_C98D8:                 ; 0xc98d8
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV tco_sub_word,R4
        JNB lv_cdn_diag_maf_dif_ch_int.0EH,L_C98EE
        JMPA cc_UC,L_C99B6
L_C98EE:                 ; 0xc98ee
        MOVB tco_sub_state,ZEROS
        JMPR cc_UC,L_C99B6

; ======== tco_sub_St4_PUC_Wait  (@0xc98f4) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Intermittent failure monitoring tco_sub twin
        ; (c_t_tco_sub_is_1, tco_st subst)
        ; ------------------------------------------------------------
        ; tco_sub state-machine ARM (state 4 = PUC/power-up-check wait). Switch arm of Acq_TCO_Mes@0xc951c.
        ; Active&!pl-cut: integrate, fault->IS_1/state1 else state0. Else decrement tco_sub_deb_ctr; on expiry
        ; SUBTRACT (decay) tco_sub_word, clamp to tco_st floor->state5. (Supersedes Diag_TCO_Sub_IFM5.)
tco_sub_St4_PUC_Wait:
        JB lv_pl.02H,L_C98FC
        JB can_fd58.09H,L_C9930
L_C98FC:                 ; 0xc98fc
        ADD tco_sub_deb_ctr,ONES
        MOV R4,tco_sub_deb_ctr
        JMPR cc_NE,L_C99B6
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV tco_sub_word,R4
        MOVBZ R5,tco_st
        SHL R5,#08H
        CMP R4,R5
        JMPR cc_NC,L_C9928
        MOVBZ R4,tco_st
        SHL R4,#08H
        MOV tco_sub_word,R4
L_C9928:                 ; 0xc9928
        MOVB RL4,#05H
        MOVB tco_sub_state,RL4
        JMPR cc_UC,L_C99B6
L_C9930:                 ; 0xc9930
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV tco_sub_word,R4
        JNB lv_cdn_diag_maf_dif_ch_int.0EH,L_C9952
        MOV R4,DPP0:c_t_tco_sub_is_1
        MOV tco_sub_deb_ctr,R4
        MOVB RL4,#01H
        MOVB tco_sub_state,RL4
        JMPR cc_UC,L_C99B6
L_C9952:                 ; 0xc9952
        MOVB tco_sub_state,ZEROS
        JMPR cc_UC,L_C99B6

; ======== tco_sub_St5_PUC_Subst  (@0xc9958) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Intermittent failure monitoring tco_sub twin
        ; (c_t_tco_sub_is_1, tco_st subst)
        ; ------------------------------------------------------------
        ; tco_sub state-machine ARM (state 5 = PUC substitute active). Switch arm of Acq_TCO_Mes@0xc951c.
        ; Active&!pl-cut: integrate, fault->IS_1/state1 else state0. Else decay tco_sub_word immediately (no
        ; timer), clamp to tco_st floor. (Supersedes Diag_TCO_Sub_IFM6.)
tco_sub_St5_PUC_Subst:
        JB lv_pl.02H,L_C9960
        JB can_fd58.09H,L_C9984
L_C9960:                 ; 0xc9960
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV tco_sub_word,R4
        MOVBZ R5,tco_st
        SHL R5,#08H
        CMP R4,R5
        JMPR cc_NC,L_C99B6
        MOVBZ R4,tco_st
        SHL R4,#08H
        MOV tco_sub_word,R4
        JMPR cc_UC,L_C99B6
L_C9984:                 ; 0xc9984
        MOV R12,tco_sub_word
        MOV R13,R9
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV tco_sub_word,R4
        JNB lv_cdn_diag_maf_dif_ch_int.0EH,L_C99A6
        MOV R4,DPP0:c_t_tco_sub_is_1
        MOV tco_sub_deb_ctr,R4
        MOVB RL4,#01H
        MOVB tco_sub_state,RL4
        JMPR cc_UC,L_C99B6
L_C99A6:                 ; 0xc99a6
        MOVB tco_sub_state,ZEROS
        JMPR cc_UC,L_C99B6

; ======== Diag_DTC_dd1a2b  (@0xc99ac) ========
        ; ------------------------------------------------------------
        ; Per-fault DTC setter: sets dtc_test_result and updates the DTC at status-address 0xd1a2. Name = DTC
        ; status RAM address (unique per fault).
        ; ------------------------------------------------------------
Diag_DTC_dd1a2b:
        MOVB tco_sub_state,ZEROS
        JMPR cc_UC,L_C99B6

; ======== Diag_TCO_Sub  (@0xc99b2) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (MS42, verified): coolant-temp substitute rationality diag (tco_sub min/max/dif, DTC)
        ; (was FUN_0c99b2)
        ; ------------------------------------------------------------
Diag_TCO_Sub:
        ADDB t_dly_tco_sub,ONES
L_C99B6:                 ; 0xc99b6
        MOV R4,tco_sub_word
        CMP R4,#DATA16 0FE00H
        JMPR cc_ULE,L_C99C8
        MOV R4,#DATA16 0FE00H
        MOV tco_sub_word,R4
L_C99C8:                 ; 0xc99c8
        JB can_fd58.09H,L_C99D0
        JMPA cc_UC,L_C9AF0
L_C99D0:                 ; 0xc99d0
        JB sched_flags2.0EH,L_C99D8
        JMPA cc_UC,L_C9AF0
L_C99D8:                 ; 0xc99d8
        JNB lv_n_max_isa_err.09H,L_C99E0
        JMPA cc_UC,L_C9AF0
L_C99E0:                 ; 0xc99e0
        JNB lv_cam_err.0CH,L_C99E8
        JMPA cc_UC,L_C9AE8
L_C99E8:                 ; 0xc99e8
        JNB lv_cam_err.0EH,L_C99F0
        JMPA cc_UC,L_C9AE8
L_C99F0:                 ; 0xc99f0
        JNB lv_lam_lim_1_err.01H,L_C99F8
        JMPA cc_UC,L_C9AE8
L_C99F8:                 ; 0xc99f8
        JNB lv_lam_lim_1_err.00H,L_C9A00
        JMPA cc_UC,L_C9AE8
L_C9A00:                 ; 0xc9a00
        MOVB RL4,tco_mes
        CMPB RL4,tco_mes_min_diag
        JMPR cc_NC,L_C9A10
        MOVB tco_mes_min_diag,RL4
        JMPR cc_UC,L_C9A1E
L_C9A10:                 ; 0xc9a10
        MOVB RL4,tco_mes
        CMPB RL4,tco_mes_max_diag
        JMPR cc_ULE,L_C9A1E
        MOVB tco_mes_max_diag,RL4
L_C9A1E:                 ; 0xc9a1e
        MOVB RL4,tco_mes_max_diag
        SUBB RL4,tco_mes_min_diag
        MOVB tco_mes_dif_diag,RL4
        MOV R4,tco_sub_word
        CMP R4,tco_sub_min_diag
        JMPR cc_NC,L_C9A3E
        MOV R4,tco_sub_word
        MOV tco_sub_min_diag,R4
        JMPR cc_UC,L_C9A50
L_C9A3E:                 ; 0xc9a3e
        MOV R4,tco_sub_word
        CMP R4,tco_sub_max_diag
        JMPR cc_ULE,L_C9A50
        MOV R4,tco_sub_word
        MOV tco_sub_max_diag,R4
L_C9A50:                 ; 0xc9a50
        MOV R4,tco_sub_max_diag
        SUB R4,tco_sub_min_diag
        MOV tco_sub_dif_diag,R4
        MOV R12,#DATA16 POF ldpm_tco_st__ip_tco_dif_diag
        MOV R13,#DATA16 PAG ldpm_tco_st__ip_tco_dif_diag
        MOVBZ R14,tco_st
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_tco_sub_dif_min_diag__tco_st
        MOV R13,#DATA16 PAG ip_tco_sub_dif_min_diag__tco_st
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        CMP R4,tco_sub_dif_diag
        JMPR cc_NC,L_C9AF0
        MOV R12,#DATA16 POF ip_tco_mes_dif_min_diag__tco_st
        MOV R13,#DATA16 PAG ip_tco_mes_dif_min_diag__tco_st
        CALLS SEG Get_IP_Byte_2D_Table, SOF Get_IP_Byte_2D_Table
        CMPB RL4,tco_mes_dif_diag
        JMPR cc_ULE,L_C9A96
        MOVB RL4,#02H
        MOVB dtc_test_result,RL4
L_C9A96:                 ; 0xc9a96
        MOV R12,#DATA16 0D186H
        MOV R13,#DATA16 0534CH
        CALLS SEG DTC_Update_Imm_V2, SOF DTC_Update_Imm_V2
        BMOV lv_cam_err.0DH,dtc_status_work.06H
        MOVBZ R4,dtc_done_tco_sub
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_C9AB8
        MOV R4,#DATA16 0DFFFH
        AND dtc_grp_maf_dif,R4
L_C9AB8:                 ; 0xc9ab8
        JNB lv_cam_err.0DH,L_C9AE4
        MOVB RL4,#02H
        MOVB dtc_test_result,RL4
        MOV R12,#DATA16 0D1A2H
        MOV R13,#DATA16 05378H
        CALLS SEG DTC_Update_Immediate, SOF DTC_Update_Immediate
        BMOV lv_cam_err.0FH,dtc_status_work.06H
        MOVBZ R4,dtc_done_tco_rat
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_C9AE4
        MOV R4,#DATA16 07FFFH
        AND dtc_grp_maf_dif,R4
L_C9AE4:                 ; 0xc9ae4
        BSET lv_n_max_isa_err.09H
        JMPR cc_UC,L_C9AF0
L_C9AE8:                 ; 0xc9ae8
        MOV R4,#DATA16 0DFFFH
        AND dtc_grp_tco,R4
L_C9AF0:                 ; 0xc9af0
        JB lv_cam_err.0CH,L_C9B18
        JB lv_lam_lim_1_err.00H,L_C9B18
        JNB lv_cam_err.0DH,L_C9B00
        JB lv_n_max_isa_err.09H,L_C9B18
L_C9B00:                 ; 0xc9b00
        JNB lv_cam_err.0EH,L_C9B08
        JB lv_n_max_isa_err.0DH,L_C9B18
L_C9B08:                 ; 0xc9b08
        JB lv_lam_lim_1_err.01H,L_C9B10
        JMPA cc_UC,L_C9C12
L_C9B10:                 ; 0xc9b10
        JB lv_inh_fsd_cp.09H,L_C9B18
        JMPA cc_UC,L_C9C12
L_C9B18:                 ; 0xc9b18
        MOVB RL4,tco
        CMPB RL4,DPP0:c_tco_sub_tol_diag
        JMPR cc_NC,L_C9BC6
        MOVB tco_sub_byte_1_,RL4
        MOVBZ R4,tia_st
        SHL R4,#08H
        CMP R4,DPP0:c_tco_st_tco_sub_min
        JMPR cc_ULE,L_C9B72
        MOVBZ R12,tco_st
        SHL R12,#08H
        MOVBZ R13,tia_st
        SHL R13,#08H
        CALLS SEG Abs_Diff_U16, SOF Abs_Diff_U16
        CMP R4,DPP0:c_tia_tco_dif_min_tco_sub
        JMPR cc_NC,L_C9B72
        MOV R12,#DATA16 04C46H
        MOV R13,maf_kgh
        CALLS SEG Get_IP_Word_2D_Table_DWord_YWord, SOF Get_IP_Word_2D_Table_DWord_YWord
        MOV R8,R4
        MOV R12,#DATA16 04C56H
        MOV R13,tco_sub_word
        MOV R14,maf_kgh
        CALLS SEG Get_IP_Byte_3D_Table_DWord_XWord_YWord, SOF Get_IP_Byte_3D_Table_DWord_XWord_YWord
        MOVBZ R13,RL4
        MOV R12,R8
        CALLS SEG Read_MulDiv_MD, SOF Read_MulDiv_MD
        MOV R9,R4
        JMPR cc_UC,L_C9B9A
L_C9B72:                 ; 0xc9b72
        MOV R12,#DATA16 04C4EH
        MOV R13,maf_kgh
        CALLS SEG Get_IP_Word_2D_Table_DWord_YWord, SOF Get_IP_Word_2D_Table_DWord_YWord
        MOV R8,R4
        MOV R12,#DATA16 04C62H
        MOV R13,tco_sub_word
        MOV R14,maf_kgh
        CALLS SEG Get_IP_Byte_3D_Table_DWord_XWord_YWord, SOF Get_IP_Byte_3D_Table_DWord_XWord_YWord
        MOVBZ R13,RL4
