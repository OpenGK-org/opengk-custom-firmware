; ======== Reset_TI_IS  (@0xb9a78) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Full Load Enrichment (ti_is/ti_is_mmv reset)
        ; ------------------------------------------------------------
Reset_TI_IS:
        MOVB ti_is_mmv,ZEROS
        MOVB st_ti_is,ZEROS
        MOVB ti_is,ZEROS
        RETS

