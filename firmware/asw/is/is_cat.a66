; ======== Init_N_SP_IS  (@0xc4ab0) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by idle/ISA output signals): Idle-speed setpoint init/reset: loads n_sp_is base
        ; from tco 3D map (abs_def-gated), n_max_tol_st, and seeds n_sp_is_cor / n_dif_st / vb_mmv and the
        ; idle-governor working vars. Sibling of Calc_N_SP_IS_Sel.
        ; ------------------------------------------------------------
Init_N_SP_IS:
        MOV R12,#DATA16 POF ldpm_tco_9
        MOV R13,#DATA16 PAG ldpm_tco_9
        MOVBZ R14,tco
        CALLS 00FH,Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_n_max_tol_st
        MOV R13,#DATA16 PAG ip_n_max_tol_st
        CALLS 00FH,Get_IP_Byte_2D_Table
        MOVB n_max_tol_st,RL4
        MOV R12,#DATA16 POF ldpm_tco_4
        MOV R13,#DATA16 PAG ldpm_tco_4
        MOVBZ R14,tco
        CALLS 00FH,Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ldpm_tco_st_n_sp_is
        MOV R13,#DATA16 PAG ldpm_tco_st_n_sp_is
        MOVBZ R14,tco_st
        CALLS 00FH,Get_IP_Byte_X_Axis
        JB abs_def.04H,L_C4B0E
        MOV R12,#DATA16 POF ip_n_sp_is_mt
        MOV R13,#DATA16 PAG ip_n_sp_is_mt
        CALLS 00FH,Get_IP_Word_3D_Table
        MOV lv_n_sp_is_sel,R4
        MOV n_sp_is_base_sel,R4
        MOV n_sp_is,R4
        JMPR cc_UC,L_C4B26
L_C4B0E:                 ; 0xc4b0e
        MOV R12,#DATA16 POF ip_n_sp_is_at
        MOV R13,#DATA16 PAG ip_n_sp_is_at
        CALLS 00FH,Get_IP_Word_3D_Table
        MOV lv_n_sp_is_sel,R4
        MOV n_sp_is_base_sel,R4
        MOV n_sp_is,R4
L_C4B26:                 ; 0xc4b26
        MOV n_sp_is_dif,ZEROS
        MOV n_sp_is_add_cfa,ZEROS
        MOV n_sp_is_min_vs,ZEROS
        MOV n_sp_is_add_vb,ZEROS
        MOV R4,n_sp_is
        SHL R4,#02H
        MOV n_sp_is_ramp,R4
        MOV R5,n_sp_is
        MOV n_sp_is_prev,R5
        MOVBZ R2,n_max_tol_st
        SHL R2,#05H
        MOV n_dif_st,R2
        MOV R3,n_sp_is
        MOV n_sp_is_cor,R3
        MOVB RL4,#DATA16 00089H
        MOVB vb_mmv,RL4
        MOV R4,#DATA16 089D8H
        MOV vb_filt_idle,R4
        MOV t_dly_vb_off,ZEROS
        MOV t_dly_vb_on,ZEROS
        BCLR lv_maf_puls.05H
        BCLR lv_maf_puls.0CH
        BMOV lv_maf_puls.0BH,lv_diag_trip_avl_ivvt.02H
        MOV n_sp_is_ramp_rate,ZEROS
        MOV t_hys_n_sp_dif,ZEROS
        MOVB RL4,tco
        MOVB tco_prev_idle,RL4
        BMOV lv_maf_puls.07H,abs_def.02H
        BCLR lv_maf_puls.08H
        RETS

