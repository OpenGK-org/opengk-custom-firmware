; asw/is/is_s5b2.a66
; Idle speed set point maximum and idle torque adaptation NVM restore/save (block 0x5B2).
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_n_dif_fac                          EQU  090299H
c_n_dif_max_is                       EQU  090636H

PUBLIC  Calc_N_SP_IS_MAX, NVM_Save_s5b2, Restore_TQ_Dif_IS_Ad
EXTERN  Elevated_Write_Routine_prg_zone_wrapper:NEAR, Mul_S16_Hi:NEAR, Reset_TQ_Dif_IS_Ad:NEAR, Sub_Floor0_S16:NEAR
EXTERN  xor_routine:NEAR

S_IS_S5B2 SECTION CODE

; ======== Calc_N_SP_IS_MAX  (@0xc0e64) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (MS42, verified): n_sp_is_max = n_sp_is + c_n_dif_max_is (+ n_dif_mmv*c_n_dif_fac corr)
        ; (was FUN_0c0e64)
        ; ------------------------------------------------------------
Calc_N_SP_IS_MAX:
        MOV R4,n_sp_is
        ADD R4,DPP0:c_n_dif_max_is
        MOV n_sp_is_max,R4
        JNB lv_cdn_diag_maf_dif_ch_int.0EH,L_C0E90
        MOV R12,n_dif_mmv
        MOVBZ R13,DPP0:c_n_dif_fac
        SHL R13,#08H
        CALLS SEG Mul_S16_Hi, SOF Mul_S16_Hi
        MOV R13,R4
        MOV R12,n_sp_is_max
        CALLS SEG Sub_Floor0_S16, SOF Sub_Floor0_S16
        MOV n_sp_is_max,R4
L_C0E90:                 ; 0xc0e90
        RETS

; ======== NVM_Save_s5b2  (@0xc0e92) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: saves RAM-> validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Save_s5b2:
        SUB R0,#02H
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005B2H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F694H
        MOV R15,#02H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005B4H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F696H
        MOV R15,#02H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005B6H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F698H
        MOV R15,#02H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005B8H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F69AH
        MOV R15,#04H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005BCH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F69EH
        MOV R15,#04H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005C0H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F6A2H
        MOV R15,#04H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005B2H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#DATA16 00012H
        CALLS SEG xor_routine, SOF xor_routine
        MOV [R0],R4
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005C4H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,R0
        MOV R15,#02H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        ADD R0,#02H
        RETS

; ======== Restore_TQ_Dif_IS_Ad  (@0xc0fd4) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (EMS2000, verified): Adaptation Algorithm (tq_dif_is_ad NVM restore)
        ; ------------------------------------------------------------
Restore_TQ_Dif_IS_Ad:
        JNB lv_pl.0CH,L_C0FDE
        MOVB RL4,conf_ad_rst
        JMPR cc_NE,L_C108A
L_C0FDE:                 ; 0xc0fde
        JB can_fd58.02H,L_C108A
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005B2H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#DATA16 00012H
        CALLS SEG xor_routine, SOF xor_routine
        MOV R10,diag_f890
        MOV R11,diag_f892
        EXTP R11, #02H
        MOV R5,[R10+#05C4H]
        NOP
        CMP R5,R4
        JMPR cc_NE,L_C108A
        EXTP R11, #02H
        MOV R4,[R10+#05B2H]
        NOP
        MOV tq_dif_is_ad,R4
        EXTP R11, #02H
        MOV R5,[R10+#05B4H]
        NOP
        MOV tq_dif_is_ad_conv,R5
        EXTP R11, #02H
        MOV R2,[R10+#05B6H]
        NOP
        MOV tq_dif_is_ad_acc,R2
        EXTP R11, #03H
        MOV R4,[R10+#05B8H]
        MOV R5,[R10+#05BAH]
        NOP
        MOV tq_dif_is_ad_inter,R4
        MOV lv_tq_f69c,R5
        EXTP R11, #03H
        MOV R4,[R10+#05BCH]
        MOV R5,[R10+#05BEH]
        NOP
        MOV tq_dif_is_ad_acc_1_inter,R4
        MOV lv_tq_f6a0,R5
        EXTP R11, #03H
        MOV R4,[R10+#05C0H]
        MOV R5,[R10+#05C2H]
        NOP
        MOV tq_dif_is_ad_acc_conv_inter,R4
        MOV lv_tq_f6a4,R5
        RETS
L_C108A:                 ; 0xc108a
        CALLS SEG Reset_TQ_Dif_IS_Ad, SOF Reset_TQ_Dif_IS_Ad
        RETS

S_IS_S5B2 ENDS
        END
