        ; ------------------------------------------------------------
AcComp_AccIn_OffDelay:
        JNB lv_conf_mis.0DH,L_C7908
        MOVB RL4,lv_tps_f4b6
        CMPB RL4,DPP0:c_tps_grd_accin_off
        JMPR cc_ULE,L_C7908
        JB lv_ct.00H,L_C7908
        MOVB RL5,vs
        CMPB RL5,DPP0:c_vs_accin_off
        JMPR cc_NC,L_C7908
        MOVB RL3,n_32
        CMPB RL3,DPP0:c_n_accin_off
        JMPR cc_NC,L_C7908
        MOV R4,t_accin_off_dly
        JMPR cc_NE,L_C7908
        MOVBZ R12,DPP0:c_accin_dly_6
        CALLS 00CH,AccInDelay_SetIfLonger
        JNB PSW.06H,L_C7908
        MOVB RL4,#08H
        MOVB state_acc_dly,RL4
        MOV R4,DPP0:c_t_accin_off_dly
