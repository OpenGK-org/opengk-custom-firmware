; ======== AcComp_AccIn_VS  (@0xc7882) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): A/C compressor control: accin delay vs vehicle speed
        ; (c_accin_vs_max)
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): A/C-compressor accin-delay state machine -- ENTRY arm
        ; (state_acc_dly=1, vehicle-speed gate, c_accin_dly_1). NOT a duplicate: this is one of 5 distinct
        ; arms of the state_acc_dly machine, all guarded by lv_conf_mis&0x2000 and sharing helper
        ; AccInDelay_SetIfLonger -- AccIn_VS(0xc7882)=st1 vs, AccIn_Alt(0xc780c)=st2 altitude ip_accin_dly_4,
        ; AccIn_Dly5(0xc7a88)=st4 c_accin_dly_5, AccIn_Tick(0xc7aaa)=timer decrement/expiry->st0
        ; ip_accin_dly_2, AccIn_Reset(0xc799e)=clear t_accin_dly/state.
AcComp_AccIn_VS:
        JNB lv_conf_mis.0DH,L_C78B6
        MOVB RL4,vs
        CMPB RL4,DPP0:c_accin_vs_max
        JMPR cc_NC,L_C78B6
        JB lv_asr_req.05H,L_C789C
        JNB lv_crk_tooth_err.01H,L_C78A0
        JB lv_crk_tooth_err.02H,L_C78A0
L_C789C:                 ; 0xc789c
        BSET lv_crk_tooth_err.01H
        RETS
L_C78A0:                 ; 0xc78a0
        BCLR lv_crk_tooth_err.01H
        MOVBZ R12,DPP0:c_accin_dly_1
        CALLS 00CH,AccInDelay_SetIfLonger
        JNB PSW.06H,L_C78B8
        MOVB RL4,#01H
        MOVB state_acc_dly,RL4
        RETS
L_C78B6:                 ; 0xc78b6
        BCLR lv_crk_tooth_err.01H
L_C78B8:                 ; 0xc78b8
        RETS

; ======== AcComp_AccIn_OffDelay  (@0xc78ba) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (MS42, verified): A/C compressor accin off-delay: vs<c_vs_accin_off & n_32<c_n_accin_off
        ; -> state_acc_dly
