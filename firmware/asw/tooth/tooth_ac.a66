        MOVB g_f99d,ZEROS
        RETS

; ======== NVM_Save_s640  (@0xc76d2) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: saves RAM-> validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Save_s640:
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 00640H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F99DH
        MOV R15,#01H
        CALLS 00DH,Elevated_Write_Routine_prg_zone_wrapper
        RETS

