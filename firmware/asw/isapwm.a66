L_CD90A:                 ; 0xcd90a
        RETS
        ; ------------------------------------------------------------
        ; (unclassified) on-chip RAM global @0xcd90c  W:{-}  R:{-}
        ; ------------------------------------------------------------
        RETS

; ======== Calc_ISA_CatHeat  (@0xcd90e) ========
