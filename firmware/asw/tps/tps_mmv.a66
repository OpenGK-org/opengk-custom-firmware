; asw/tps/tps_mmv.a66
; Throttle idle position adaptation and NVM restore/save (block 0x1B0).
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_tps_ad_crlc                        EQU  0903D8H
c_tps_add                            EQU  0903D9H
c_tps_is                             EQU  0903E5H
c_tps_max_is                         EQU  0903E8H
c_tps_mes_min_diag                   EQU  0903EBH

PUBLIC  Calc_TPS_AD_MMV_IS, Learn_TPS_AdMmv_IS, NVM_Save_s1b0, Restore_TPS_AdMmv_IS
EXTERN  Add_r12_r13_Return_r4:NEAR, Elevated_Write_Routine_prg_zone_wrapper:NEAR, Interp_U16:NEAR, Sat_Add_U8:NEAR
EXTERN  xor_routine:NEAR

S_TPS_MMV SECTION CODE

; ======== Learn_TPS_AdMmv_IS  (@0xc9ebe) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Throttle idle adaptation learn (tps_ad_mmv_is slow interp)
        ; ------------------------------------------------------------
Learn_TPS_AdMmv_IS:
        MOV [-R0],R9
        JB lv_cam_err.00H,L_C9F36
        MOVB RL4,tps
        CMPB RL4,DPP0:c_tps_is
        JMPR cc_NC,L_C9F48
        JB lv_cam_err.01H,L_C9F48
        MOV R9,lv_tps_f798
        MOV R12,tps_ad_mmv_is
        MOVBZ R13,tps_mes_diag
        SHL R13,#08H
        MOVBZ R14,DPP0:c_tps_ad_crlc
        SHL R14,#08H
        CALLS SEG Interp_U16, SOF Interp_U16
        MOV tps_ad_mmv_is,R4
        MOVB RL4,vs
        JMPR cc_EQ,L_C9EFC
        JB lv_cam_err.07H,L_C9EFC
        JNB lv_cam_err.08H,L_C9F16
L_C9EFC:                 ; 0xc9efc
        MOV R12,R9
        MOVBZ R13,DPP0:c_tps_add
        SHL R13,#08H
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV R9,R4
        CMP R9,tps_ad_mmv_is
        JMPR cc_NC,L_C9F20
        MOV tps_ad_mmv_is,R9
        JMPR cc_UC,L_C9F20
L_C9F16:                 ; 0xc9f16
        CMP R9,tps_ad_mmv_is
        JMPR cc_NC,L_C9F20
        MOV tps_ad_mmv_is,R9
L_C9F20:                 ; 0xc9f20
        MOVB RL4,lv_tps_f78f
        CMPB RL4,DPP0:c_tps_max_is
        JMPR cc_C,L_C9F48
        MOVBZ R4,DPP0:c_tps_max_is
        SHL R4,#08H
        MOV tps_ad_mmv_is,R4
        JMPR cc_UC,L_C9F48
L_C9F36:                 ; 0xc9f36
        MOVBZ R4,DPP0:c_tps_max_is
        SHL R4,#08H
        MOV tps_ad_mmv_is,R4
        MOV R4,tps_ad_mmv_is
        MOV lv_tps_f798,R4
L_C9F48:                 ; 0xc9f48
        MOV R9,[R0+]
        RETS

; ======== Restore_TPS_AdMmv_IS  (@0xc9f4c) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Throttle angle variables (tps_ad_mmv_is NVM restore)
        ; ------------------------------------------------------------
Restore_TPS_AdMmv_IS:
        MOV R4,lv_tps_fa7e
        AND R4,#DATA16 003FFH
        SHR R4,#02H
        MOVB tps_mes,RL4
        JNB lv_pl.0CH,L_C9F64
        MOVB RL5,conf_ad_rst
        JMPR cc_NE,L_C9FFC
L_C9F64:                 ; 0xc9f64
        JB can_fd58.02H,L_C9FFC
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 001B0H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS SEG xor_routine, SOF xor_routine
        MOV R10,diag_f890
        MOV R11,diag_f892
        EXTP R11, #02H
        MOV R5,[R10+#01B2H]
        NOP
        CMP R5,R4
        JMPR cc_NE,L_C9FFC
        EXTP R11, #02H
        MOVB RL4,[R10+#01B0H]
        NOP
        MOVB tps_ad_mmv_is,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#01B1H]
        NOP
        MOVB lv_tps_f78f,RL4
        MOVB RL4,tps_mes
        CMPB RL4,lv_tps_f78f
        JMPR cc_ULE,L_C9FDE
        MOVBZ R12,lv_tps_f78f
        MOVBZ R13,DPP0:c_tps_add
        CALLS SEG Sat_Add_U8, SOF Sat_Add_U8
        MOVB lv_tps_f78f,RL4
L_C9FDE:                 ; 0xc9fde
        MOVB RL4,lv_tps_f78f
        CMPB RL4,DPP0:c_tps_max_is
        JMPR cc_C,L_C9FF2
        MOVBZ R4,DPP0:c_tps_max_is
        SHL R4,#08H
        MOV tps_ad_mmv_is,R4
L_C9FF2:                 ; 0xc9ff2
        MOV R4,tps_ad_mmv_is
        MOV lv_tps_f798,R4
        RETS
L_C9FFC:                 ; 0xc9ffc
        CALLS SEG Calc_TPS_AD_MMV_IS, SOF Calc_TPS_AD_MMV_IS
        RETS

; ======== Calc_TPS_AD_MMV_IS  (@0xca002) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (MS42, verified): tps_ad_mmv_is = clamp(Sat_Add(tps_mes,c_tps_add), c_tps_max_is)
        ; (was FUN_0ca002)
        ; ------------------------------------------------------------
Calc_TPS_AD_MMV_IS:
        MOVB RL4,lv_sched_diag_inh
        ANDB RL4,#01H
        JMPR cc_NE,L_CA04A
        MOVB RL4,tps_mes
        CMPB RL4,DPP0:c_tps_mes_min_diag
        JMPR cc_NC,L_CA020
        MOVBZ R4,DPP0:c_tps_max_is
        SHL R4,#08H
        MOV tps_ad_mmv_is,R4
        JMPR cc_UC,L_CA052
L_CA020:                 ; 0xca020
        MOVBZ R12,tps_mes
        MOVBZ R13,DPP0:c_tps_add
        CALLS SEG Sat_Add_U8, SOF Sat_Add_U8
        MOVBZ R4,RL4
        SHL R4,#08H
        MOV tps_ad_mmv_is,R4
        MOVB RL4,lv_tps_f78f
        CMPB RL4,DPP0:c_tps_max_is
        JMPR cc_C,L_CA052
        MOVBZ R4,DPP0:c_tps_max_is
        SHL R4,#08H
        MOV tps_ad_mmv_is,R4
        JMPR cc_UC,L_CA052
L_CA04A:                 ; 0xca04a
        MOV R4,#DATA16 08000H
        MOV tps_ad_mmv_is,R4
L_CA052:                 ; 0xca052
        MOV R4,tps_ad_mmv_is
        MOV lv_tps_f798,R4
        RETS

; ======== NVM_Save_s1b0  (@0xca05c) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: saves RAM-> validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Save_s1b0:
        SUB R0,#02H
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 001B0H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F78EH
        MOV R15,#02H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 001B0H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS SEG xor_routine, SOF xor_routine
        MOV [R0],R4
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 001B2H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,R0
        MOV R15,#02H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        ADD R0,#02H
        RETS

S_TPS_MMV ENDS
        END
