        ; ------------------------------------------------------------
Calc_VS:
        MOV [-R0],R9
        MOV [-R0],R6
        MOV R4,#DATA16 0CDE0H
        MOV p_vs_meas,R4
        MOVB vs_cap_ctr0,ZEROS
        MOVB vs_cap_ctr1,ZEROS
