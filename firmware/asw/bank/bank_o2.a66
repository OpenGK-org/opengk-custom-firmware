; asw/bank/bank_o2.a66
; OBD-II Mode 01 PIDs 0x13-0x19: O2 sensors present and per-sensor voltage / trim.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  OBD_M01_PID13_O2SensorsPresent, OBD_M01_PID14_O2_B1S1_V_STFT, OBD_M01_PID15_O2_B1S2_V, OBD_M01_PID18_O2_B2S1_Unsupported, OBD_M01_PID19_O2_B2S2_Unsupported
EXTERN  L_E0940:NEAR, Mul_U16_SatByte:NEAR, OBD_Scale_FuelTrim:NEAR

S_BANK_O2 SECTION CODE

; ======== OBD_M01_PID13_O2SensorsPresent  (@0xe044a) ========
        ; ------------------------------------------------------------
        ; OBD-II Mode 01 PID 0x13 handler arm. Dispatched from KWP_OBD_Svc01_ReadPID(0xe0000) via PID
        ; jump-table @0xa1afe (index=PID, bound<=0x4e). Named from OBD-II std + verified decompile.
        ; ------------------------------------------------------------
OBD_M01_PID13_O2SensorsPresent:
        MOVB RL4,conf_lam
        CMPB RL4,#01H
        JMPR cc_NE,L_E045C
        MOVB RL6,#01H
        JNB lv_conf_mis.01H,L_E045E
        MOVB RL6,#03H
        JMPR cc_UC,L_E045E
L_E045C:                 ; 0xe045c
        MOVB RL6,#00H
L_E045E:                 ; 0xe045e
        MOVB [R9],RL6
        MOVB RL7,#01H
        JMPA cc_UC,L_E0940

; ======== OBD_M01_PID14_O2_B1S1_V_STFT  (@0xe0466) ========
        ; ------------------------------------------------------------
        ; OBD-II Mode 01 PID 0x14 handler arm. Dispatched from KWP_OBD_Svc01_ReadPID(0xe0000) via PID
        ; jump-table @0xa1afe (index=PID, bound<=0x4e). Named from OBD-II std + verified decompile.
        ; ------------------------------------------------------------
OBD_M01_PID14_O2_B1S1_V_STFT:
        JNB lv_conf_mis.00H,L_E0490
        MOV R4,lam_bank_1_ls_up_vls_up
        SHR R4,#02H
        MOVBZ R12,RL4
        MOV R13,#DATA16 003ECH
        CALLS SEG Mul_U16_SatByte, SOF Mul_U16_SatByte
        MOV R5,R9
        ADD R9,#01H
        MOVB [R5],RL4
        MOV R12,lam_bank_1_lam_up_ti_lam
        CALLS SEG OBD_Scale_FuelTrim, SOF OBD_Scale_FuelTrim
        MOVB [R9],RL4
        MOVB RL7,#02H
        JMPA cc_UC,L_E0940
L_E0490:                 ; 0xe0490
        MOVB RL7,#DATA16 000FEH
        JMPA cc_UC,L_E0940

; ======== OBD_M01_PID15_O2_B1S2_V  (@0xe0498) ========
        ; ------------------------------------------------------------
        ; OBD-II Mode 01 PID 0x15 handler arm. Dispatched from KWP_OBD_Svc01_ReadPID(0xe0000) via PID
        ; jump-table @0xa1afe (index=PID, bound<=0x4e). Named from OBD-II std + verified decompile.
        ; ------------------------------------------------------------
OBD_M01_PID15_O2_B1S2_V:
        JNB lv_conf_mis.00H,L_E04BE
        MOV R4,lam_bank_1_ls_down_struct_vls_down
        SHR R4,#02H
        MOVBZ R12,RL4
        MOV R13,#DATA16 003ECH
        CALLS SEG Mul_U16_SatByte, SOF Mul_U16_SatByte
        MOV R5,R9
        ADD R9,#01H
        MOVB [R5],RL4
        MOVB RL4,#DATA16 000FFH
        MOVB [R9],RL4
        MOVB RL7,#02H
        JMPA cc_UC,L_E0940
L_E04BE:                 ; 0xe04be
        MOVB RL7,#DATA16 000FEH
        JMPA cc_UC,L_E0940

; ======== OBD_M01_PID18_O2_B2S1_Unsupported  (@0xe04c6) ========
        ; ------------------------------------------------------------
        ; OBD-II Mode 01 PID 0x18 handler arm. Dispatched from KWP_OBD_Svc01_ReadPID(0xe0000) via PID
        ; jump-table @0xa1afe (index=PID, bound<=0x4e). Named from OBD-II std + verified decompile.
        ; ------------------------------------------------------------
OBD_M01_PID18_O2_B2S1_Unsupported:
        MOVB RL7,#DATA16 000FEH
        JMPA cc_UC,L_E0940

; ======== OBD_M01_PID19_O2_B2S2_Unsupported  (@0xe04ce) ========
        ; ------------------------------------------------------------
        ; OBD-II Mode 01 PID 0x19 handler arm. Dispatched from KWP_OBD_Svc01_ReadPID(0xe0000) via PID
        ; jump-table @0xa1afe (index=PID, bound<=0x4e). Named from OBD-II std + verified decompile.
        ; ------------------------------------------------------------
OBD_M01_PID19_O2_B2S2_Unsupported:
        MOVB RL7,#DATA16 000FEH
        JMPA cc_UC,L_E0940

S_BANK_O2 ENDS
        END
