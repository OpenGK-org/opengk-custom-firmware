        MOVB RL4,tq_lo_wr
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_lo_wr,RL4
        MOVB RL4,tq_lo_wr
        CMPB RL4,tq_lo_rd
        JMPR cc_NE,L_B6810
        BSET sched_flags.03H
        MOVB RL4,tq_lo_rd
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_lo_rd,RL4
L_B6810:                 ; 0xb6810
        MOVB RL4,DPP0:c_t_lshpwm_up_fast_vb_cor
