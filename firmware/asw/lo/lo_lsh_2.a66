        ; ------------------------------------------------------------
        ; OEM-chain (verified by lsh/ls_cur/n_grd/mtv output signals): Front O2 heater state/timing: lsh_up
        ; state, t_lsh_up(_lim/_tol).
        ; ------------------------------------------------------------
Calc_LSH_Up_State:
        MOV g_f98a,ZEROS
        MOV lsh_up_bank_1_state_lsh_up,ZEROS
        MOVB lsh_up_bank_1_t_lsh_up,ZEROS
        MOVB lsh_up_bank_1_t_lsh_up_lim,ZEROS
        MOVB lsh_up_bank_1_t_lsh_up_tol,ZEROS
        MOVB lsh_up_bank_1_v_efc_lsh_up,ZEROS
        MOVB lsh_up_bank_1_lshpwm_up,ZEROS
        MOVBZ R4,lsh_up_bank_1_lshpwm_up
        SHL R4,#08H
        MOV R2,#DATA16 0493EH
