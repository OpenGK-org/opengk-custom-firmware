; asw/ch.a66
; Catalyst heating: coordination, heating state and MAF integral during heating.
; 0xBF294-0xBF3F8  (356 bytes, 5 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_iga_vs_max_ch                      EQU  0901E2H
c_tco_acin_min_ch                    EQU  090369H
c_tco_dri_min_ch                     EQU  090372H
c_tia_st_min_ch                      EQU  0903BFH
c_amp_ad_min_ch                      EQU  0904ACH
c_maf_int_ch_max                     EQU  0905CEH
ldpm_tco_7                      EQU  090A8BH
id_t_cat_iga__tco_st                 EQU  091DA4H
id_t_cat_ti__tco_st                  EQU  091DB4H

PUBLIC  Calc_CatHeat_State_2, Calc_MAF_Int_CH, CatHeat_Coord, Log_Event_f96a, Reset_lv_ch_294
EXTERN  Add_r12_r13_Return_r4:NEAR, Get_Byte_Y_Axis:NEAR, Read_Word_Far:NEAR

S_BF294 SECTION CODE AT 0BF294H

; ======== Reset_lv_ch_294  (@0xbf294) ========
Reset_lv_ch_294:
        BCLR lv_ch.03H
        BCLR lv_ch.04H
        MOV lv_cat_f6fc,ZEROS
        MOV lv_cat_f6fe,ZEROS
        MOV maf_int_ch,ZEROS
        RETS

; ======== CatHeat_Coord  (@0xbf2a6) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (ThetaII, verified): catalyst heating coordination: maf_int_ch, cat-heat time maps
        ; (id_t_cat_ti/iga__tco_st)
        ; (was FUN_0bf2a6)
        ; ------------------------------------------------------------
CatHeat_Coord:
        MOV maf_int_ch,ZEROS
        MOV R4,amp_ad
        CMP R4,DPP0:c_amp_ad_min_ch
        JMPR cc_ULE,L_BF31E
        MOVB RL4,tia_st
        CMPB RL4,DPP0:c_tia_st_min_ch
        JMPR cc_ULE,L_BF31E
        MOV R12,#DATA16 POF ldpm_tco_7
        MOV R13,#DATA16 PAG ldpm_tco_7
        MOVBZ R14,tco_st
        CALLS 00FH,Get_Byte_Y_Axis
        MOV R12,#DATA16 POF id_t_cat_ti__tco_st
        MOV R13,#DATA16 PAG id_t_cat_ti__tco_st
        CALLS 00FH,Read_Word_Far
        MOV lv_cat_f6fc,R4
        MOV R12,#DATA16 POF ldpm_tco_7
        MOV R13,#DATA16 PAG ldpm_tco_7
        MOVBZ R14,tco_st
        CALLS 00FH,Get_Byte_Y_Axis
        MOV R12,#DATA16 POF id_t_cat_iga__tco_st
        MOV R13,#DATA16 PAG id_t_cat_iga__tco_st
        CALLS 00FH,Read_Word_Far
        MOV lv_cat_f6fe,R4
        CMP R4,#00H
        JMPR cc_UGT,L_BF30A
        BCLR lv_lam_fd2c.0FH
        BCLR lv_ch.04H
        BCLR lv_ch.03H
        RETS
L_BF30A:                 ; 0xbf30a
        BSET lv_lam_fd2c.0FH
        BSET lv_ch.03H
        MOV R4,lv_cat_f6fc
        CMP R4,#00H
        JMPR cc_ULE,L_BF318
        BSET lv_ch.04H
L_BF318:                 ; 0xbf318
        MOV R4,#01H
        MOV lv_cat_f96a,R4
L_BF31E:                 ; 0xbf31e
        RETS

; ======== Log_Event_f96a  (@0xbf320) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Log_Event_f96a:
        MOV R4,#01H
        MOV lv_cat_f96a,R4
        MOVB RL4,#DATA16 0002DH
        MOVBZ R5,tq_lo_wr
        MOVB [R5+#0F66EH],RL4
        MOVB RL4,tq_lo_wr
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_lo_wr,RL4
        MOVB RL4,tq_lo_wr
        CMPB RL4,tq_lo_rd
        JMPR cc_NE,L_BF35A
        BSET sched_flags.03H
        MOVB RL4,tq_lo_rd
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_lo_rd,RL4
L_BF35A:                 ; 0xbf35a
        RETS

; ======== Calc_CatHeat_State_2  (@0xbf35c) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by vs/mwss/lv_ch output signals): Catalyst-heating state lv_ch (variant).
        ; ------------------------------------------------------------
Calc_CatHeat_State_2:
        MOV R4,lv_cat_f6fe
        JMPR cc_EQ,L_BF368
        SUB R4,#01H
        MOV lv_cat_f6fe,R4
L_BF368:                 ; 0xbf368
        MOV R4,lv_cat_f6fe
        JMPR cc_EQ,L_BF3AC
        JB lv_ch.05H,L_BF3AC
        MOVB RL4,vs
        CMPB RL4,DPP0:c_iga_vs_max_ch
        JMPR cc_UGT,L_BF3AC
        JNB abs_def.02H,L_BF38A
        MOVB RL5,tco
        CMPB RL5,DPP0:c_tco_dri_min_ch
        JMPR cc_UGT,L_BF3AC
L_BF38A:                 ; 0xbf38a
        JNB lv_im_acin.04H,L_BF398
        MOVB RL4,tco
        CMPB RL4,DPP0:c_tco_acin_min_ch
        JMPR cc_UGT,L_BF3AC
L_BF398:                 ; 0xbf398
        JB lv_cam_err.02H,L_BF3AC
        JB lv_cam_err.03H,L_BF3AC
        JB lv_dur_igc_0_err.0DH,L_BF3AC
        JB lv_dur_igc_0_err.0EH,L_BF3AC
        JNB lv_cam_err.05H,L_BF3AE
L_BF3AC:                 ; 0xbf3ac
        BCLR lv_ch.03H
L_BF3AE:                 ; 0xbf3ae
        MOV R4,lv_cat_f6fc
        JMPR cc_EQ,L_BF3BA
        SUB R4,#01H
        MOV lv_cat_f6fc,R4
L_BF3BA:                 ; 0xbf3ba
        MOV R4,lv_cat_f6fc
        JMPR cc_EQ,L_BF3C4
        JB lv_ch.03H,L_BF3C6
L_BF3C4:                 ; 0xbf3c4
        BCLR lv_ch.04H
L_BF3C6:                 ; 0xbf3c6
        JB lv_ch.03H,L_BF3CE
        MOV lv_cat_f96a,ZEROS
L_BF3CE:                 ; 0xbf3ce
        RETS

; ======== Calc_MAF_Int_CH  (@0xbf3d0) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by maf/tps output signals + DTC): MAF integral during catalyst heating
        ; maf_int_ch.
        ; ------------------------------------------------------------
Calc_MAF_Int_CH:
        JB lv_ch.05H,L_BF3F6
        JB lv_cdn_diag_maf_dif_ch_int.0BH,L_BF3F6
        JB lv_pl.04H,L_BF3F6
        MOV R12,maf_int_ch
        MOV R13,maf_kgh
        SHR R13,#04H
        CALLS 00FH,Add_r12_r13_Return_r4
        MOV maf_int_ch,R4
        CMP R4,DPP0:c_maf_int_ch_max
        JMPR cc_ULE,L_BF3F6
        BSET lv_ch.05H
L_BF3F6:                 ; 0xbf3f6
        RETS

S_BF294 ENDS
        END
