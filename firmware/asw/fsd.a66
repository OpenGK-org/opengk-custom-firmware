; ======== Calc_Ctr_Stop_FSD  (@0xb8748) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by fsd/rbm/obd2 output signals): Fuel-system-diagnosis engine-stop counter
        ; ctr_stop_fsd.
        ; ------------------------------------------------------------
Calc_Ctr_Stop_FSD:
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B877E
        JB lv_cps_err.04H,L_B877E
        MOV R12,#DATA16 POF sst_tkw_st
        MOV R13,#DATA16 PAG sst_tkw_st
        MOVBZ R14,tco_st
        CALLS SEG Get_Byte_Y_Axis, SOF Get_Byte_Y_Axis
        MOV R12,#DATA16 POF id_stop_inc_fsd__tco_st
        MOV R13,#DATA16 PAG id_stop_inc_fsd__tco_st
        CALLS SEG Read_Byte_Far, SOF Read_Byte_Far
        MOVBZ R13,RL4
        MOVBZ R12,ctr_stop_fsd
        CALLS SEG Sat_Add_U8, SOF Sat_Add_U8
        MOVB ctr_stop_fsd,RL4
L_B877E:                 ; 0xb877e
        RETS

; ======== Calc_FSD_OBD2_Ratio  (@0xb8780) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by fsd/rbm/obd2 output signals): Fuel-system-diag OBD2 completion ratio:
        ; fsd_obd2_carrier / t_sum_rst/max_fsd + lv_inh_fsd_cp.
        ; ------------------------------------------------------------
Calc_FSD_OBD2_Ratio:
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B87A6
        BCLR lv_inh_fsd_cp.07H
        MOV lam_bank_1_fsd_obd2_struct_fsd_obd2_carrier,ZEROS
        MOV R4,state_cat_diag
        AND R4,#DATA16 0E1FFH
        MOV state_cat_diag,R4
        MOV lam_bank_1_fsd_obd2_struct_t_sum_rst_fsd,ZEROS
        MOV lam_bank_1_fsd_obd2_struct_t_sum_max_fsd,ZEROS
        MOV lam_bank_1_fsd_obd2_struct_t_sum_min_fsd,ZEROS
L_B87A6:                 ; 0xb87a6
        RETS

