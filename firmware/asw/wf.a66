        MOV R4,DPP0:c_seg_ctr_inh_neg_wf
        MOV seg_ctr_inh_wf,R4
        MOV R12,#DATA16 POF ldpm_tco_2_wf
        MOV R13,#DATA16 PAG ldpm_tco_2_wf
