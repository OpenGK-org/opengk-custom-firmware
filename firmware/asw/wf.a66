        CALLS 00FH,Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_ti_dif_fast_wf_thd__tco
        MOV R13,#DATA16 PAG ip_ti_dif_fast_wf_thd__tco
        CALLS 00FH,Get_IP_Word_2D_Table
        MOV thd_dif_fast_wf,R4
        MOV R12,#DATA16 POF ip_ti_dif_slow_wf_thd__tco
        MOV R13,#DATA16 PAG ip_ti_dif_slow_wf_thd__tco
        CALLS 00FH,Get_IP_Word_2D_Table
        MOV thd_dif_slow_wf,R4
        RETS

