S_B1D1A SECTION CODE AT 0B1D1AH

; ======== CanPurge_Deac_State  (@0xb1d1a) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): Canister-purge normal-deactivation state:
        ; cp_state/cp_tra_state/cp_norm_deac_state.
        ; ------------------------------------------------------------
CanPurge_Deac_State:
        MOVB RL4,conf_cp
        JMPR cc_EQ,L_B1D30
        MOV cp_state,ZEROS
        MOV cp_tra_state,ZEROS
        MOV cp_norm_deac_state,ZEROS
        MOV state_cp_ctl,ZEROS
L_B1D30:                 ; 0xb1d30
        RETS

; ======== CanPurge_Reset_Gated  (@0xb1d32) ========
        ; ------------------------------------------------------------
