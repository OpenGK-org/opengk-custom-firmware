        JNB lv_cp_act.05H,L_B1D5A
        CALLA cc_UC,CanPurge_Control_SM
        CALLA cc_UC,CanPurge_Calc_RelFlow
        RETS
L_B1D5A:                 ; 0xb1d5a
        CALLA cc_UC,CanPurge_Reset
L_B1D5E:                 ; 0xb1d5e
        RETS

; ======== CanPurge_Lookup_State  (@0xb1d60) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
CanPurge_Lookup_State:
        MOV R4,cp_state
        CMP R4,#06H
        JMPA cc_UGT,Set_cp_state_fe8
        SHL R4,#01H
        ADD R4,#DATA16 046A6H
        MOV R4,[R4]
        JMPI cc_UC,[R4]

; ======== Reset_cp_norm_deac_state_d74  (@0xb1d74) ========
Reset_cp_norm_deac_state_d74:
        MOV cp_norm_deac_state,ZEROS
        MOV state_cp_ctl,ZEROS
        MOV cp_tra_state,ZEROS
        RET

