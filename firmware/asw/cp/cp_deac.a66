        ; ------------------------------------------------------------
CanPurge_Reset_Gated:
        MOVB RL4,conf_cp
        JMPR cc_EQ,L_B1D3C
        CALLA cc_UC,CanPurge_Reset
L_B1D3C:                 ; 0xb1d3c
        RETS

; ======== CanPurge_Ctl_Entry  (@0xb1d3e) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
