; asw/diagcp/diagcp_cp_2.a66
; EVAP leak diagnosis: tank pressure scaling, leak volume and closed-loop model value.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_fac_ti_diagcp                      EQU  0901B8H
