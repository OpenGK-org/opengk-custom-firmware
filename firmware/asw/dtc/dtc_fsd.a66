        BMOV lv_cps_err.02H,dtc_status_work.06H
        MOVBZ R4,dtc_done_o2_1
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_CF6E0
        MOV R4,#DATA16 0FFFBH
        AND dtc_st_grp_cp,R4
L_CF6E0:                 ; 0xcf6e0
        RETS

