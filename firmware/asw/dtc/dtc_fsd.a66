; ======== Diag_DTC_dd1be  (@0xcf682) ========
        ; ------------------------------------------------------------
        ; Per-fault DTC setter: sets dtc_test_result and updates the DTC at status-address 0xd1be. Name = DTC
        ; status RAM address (unique per fault).
        ; ------------------------------------------------------------
Diag_DTC_dd1be:
        JNB lv_inh_fsd_cp.08H,L_CF68C
        MOVB RL4,#08H
        MOVB dtc_test_result,RL4
L_CF68C:                 ; 0xcf68c
        MOV R12,#DATA16 0D1BEH
        MOV R13,#DATA16 053A4H
        CALLS SEG DTC_Update_Immediate, SOF DTC_Update_Immediate
        BMOV lv_lam_lim_1_err.01H,dtc_status_work.06H
        MOVBZ R4,g_d1c8
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_CF6AE
        MOV R4,#DATA16 0FFFDH
        AND diag_f864,R4
L_CF6AE:                 ; 0xcf6ae
        RETS

; ======== Diag_Cat_Eff_SetDTC  (@0xcf6b0) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified: DTC codes / state vars / output signals): Catalyst-efficiency DTC update
