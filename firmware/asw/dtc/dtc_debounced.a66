; ======== DTC_Update_Debounced  (@0xd8bb8) ========
        ; DTC_Update_Debounced(recordPtr, cfgPtr, step, threshold): counter-debounced fault update.
        ; recordPtr/cfgPtr are offsets into the 0x90000 fault-RAM window; cfg index = (cfgPtr+0xadd2)/0x16
        ; into the DTC definition table (22-byte stride) @0xA1230 (+0/+2/+4 select code by dtc_test_result
        ; 0/2/4). If dtc_test_result!=0 (fault present) increments debounce counter field[1] by 'step' until
        ; >= 'threshold', then confirms: records DTC (dtc_act), captures freeze frame
        ; (DTC_Capture_FreezeFrame), sets status field[0], calls DTC_Update_Status_MIL. If dtc_test_result==0
        ; it heals. Field map: [0]=status(0xf=type,0x20=failed,0x40=this-cycle,0x80), [1]=debounce ctr,
        ; [2]=occurrence ctr, [3]=0x28 aging init, [4..7]=freeze frame, [8..9]=trt_word, [0xa]=flags,
        ; [0xb]=accum, [0xd]=type snapshot.
DTC_Update_Debounced:
        MOV [-R0],R15
        MOV [-R0],R14
        MOV [-R0],R13
        MOV [-R0],R12
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        MOVB RL4,[R12]
        MOVBZ R4,RL4
        MOV dtc_status_work,R4
        MOVB RL4,[R12+#01H]
        MOVBZ R9,RL4
