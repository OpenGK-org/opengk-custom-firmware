; asw/th/th_det.a66
; Thermostat detection rate-based monitor (IUMPR).
; 0xB9702-0xB97DC  (218 bytes, 5 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_tco_th_open                        EQU  0903A2H

PUBLIC  Calc_RBM_Th_Det, ClrBits_state_rbm_th_det_750, Log_Event_f97e, Reset_state_rbm_th_det_746, Set_Df97e_702
EXTERN  Div_U32_U16_Round32:NEAR

S_B9702 SECTION CODE AT 0B9702H

; ======== Set_Df97e_702  (@0xb9702) ========
Set_Df97e_702:
        MOV R4,#05H
        MOV diag_f97e,R4
        RETS

; ======== Log_Event_f97e  (@0xb970a) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Log_Event_f97e:
        MOV R4,#05H
        MOV diag_f97e,R4
        MOVB RL4,#DATA16 0003FH
        MOVBZ R5,tq_lo_wr
        MOVB [R5+#0F66EH],RL4
        MOVB RL4,tq_lo_wr
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_lo_wr,RL4
        MOVB RL4,tq_lo_wr
        CMPB RL4,tq_lo_rd
        JMPR cc_NE,L_B9744
        BSET sched_flags.03H
        MOVB RL4,tq_lo_rd
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_lo_rd,RL4
L_B9744:                 ; 0xb9744
        RETS

; ======== Reset_state_rbm_th_det_746  (@0xb9746) ========
Reset_state_rbm_th_det_746:
        MOVB state_rbm_th_det,ZEROS
        MOV rate_rbm_th_det,ONES
        RETS

; ======== ClrBits_state_rbm_th_det_750  (@0xb9750) ========
ClrBits_state_rbm_th_det_750:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_th_det,RL4
        RETS

; ======== Calc_RBM_Th_Det  (@0xb975a) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for Th Det:
        ; updates state_rbm_th_det / rate_rbm_th_det (in-use completion ratio = numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_Th_Det:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB obd_sf.0DH,L_B97D6
        MOVBZ R4,state_rbm_th_det
        AND R4,#01H
        JMPR cc_NE,L_B977E
        MOVB RL4,tco_sub_byte_1_
        CMPB RL4,DPP0:c_tco_th_open
        JMPR cc_ULE,L_B977E
        JB lv_err_pres_mwss.07H,L_B977E
        MOVB RL4,#01H
        ORB state_rbm_th_det,RL4
L_B977E:                 ; 0xb977e
        MOVBZ R4,state_rbm_th_det
        AND R4,#02H
        JMPR cc_NE,L_B9790
        JNB lv_er_carb_b4.0FH,L_B9790
        MOVB RL4,#02H
        ORB state_rbm_th_det,RL4
L_B9790:                 ; 0xb9790
        MOVBZ R4,state_rbm_th_det
        AND R4,#04H
        JMPR cc_NE,L_B979E
        MOVB RL4,#04H
        ORB state_rbm_th_det,RL4
L_B979E:                 ; 0xb979e
        MOV R12,ctr_comp_rbm_th_det
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_th_det
        CALLS 00FH,Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_B97C8
        CMP R8,#DATA16 0FFFFH
L_B97C8:                 ; 0xb97c8
        JMPR cc_C,L_B97D0
        MOV rate_rbm_th_det,ONES
        JMPR cc_UC,L_B97D6
L_B97D0:                 ; 0xb97d0
        MOV R4,R8
        MOV rate_rbm_th_det,R4
L_B97D6:                 ; 0xb97d6
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_B9702 ENDS
        END
