S_D648A SECTION CODE AT 0D648AH

; ======== Sched_Diag_Tasks  (@0xd648a) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified: DTC codes / state vars / output signals): Periodic diagnostic/calc task
        ; scheduler: runs ~40 subsystem functions each cycle (MAF trim, TEG model+hys, cat/evap/TOIL diags,
        ; TPS learn, etc.). Top of the slow diagnostic task group.
        ; ------------------------------------------------------------
Sched_Diag_Tasks:
        CALLS SEG Calc_TI_AS, SOF Calc_TI_AS
        CALLS SEG Calc_MAF_Trim_EOL, SOF Calc_MAF_Trim_EOL
        CALLS SEG Calc_MAF_Model_Const, SOF Calc_MAF_Model_Const
        CALLS SEG Calc_maf_fac_alti_mmv, SOF Calc_maf_fac_alti_mmv
        CALLS SEG Lookup_Dc204_Tco, SOF Lookup_Dc204_Tco
        CALLS SEG Lookup_Lamb_ER_Ad_Fac, SOF Lookup_Lamb_ER_Ad_Fac
        CALLS SEG Learn_TPS_AdMmv_IS, SOF Learn_TPS_AdMmv_IS
        CALLS SEG Calc_FAC_WF_VO_Fdout, SOF Calc_FAC_WF_VO_Fdout
        JNB lv_conf_mis.04H,L_D64B2
        CALLS SEG Diag_Coding_MAF_TPS_Plaus, SOF Diag_Coding_MAF_TPS_Plaus
L_D64B2:                 ; 0xd64b2
        JNB lv_conf_mis.00H,L_D64BA
        CALLS SEG Calc_LS_Up_OBD2_CycNr, SOF Calc_LS_Up_OBD2_CycNr
L_D64BA:                 ; 0xd64ba
        CALLS SEG Calc_TOil_Model, SOF Calc_TOil_Model
        CALLS SEG Acq_TOIL_2, SOF Acq_TOIL_2
        CALLS SEG Diag_TOIL, SOF Diag_TOIL
        CALLS SEG Calc_lamb_sp, SOF Calc_lamb_sp
        CALLS SEG Calc_MAF_Trim_State, SOF Calc_MAF_Trim_State
        CALLS SEG Calc_Fcut_State, SOF Calc_Fcut_State
        CALLS SEG Set_lv_maf_trim_e31a, SOF Set_lv_maf_trim_e31a
        CALLS SEG IVVT_Task_Group_2, SOF IVVT_Task_Group_2
        CALLS SEG Diag_DTC_dd63a, SOF Diag_DTC_dd63a
        CALLS SEG Calc_MAF_Int_CH, SOF Calc_MAF_Int_CH
        CALLS SEG Calc_TEG_Cor, SOF Calc_TEG_Cor
        CALLS SEG Calc_TEG_Model, SOF Calc_TEG_Model
        CALLS SEG Calc_TEG_Dyn_Hys, SOF Calc_TEG_Dyn_Hys
        CALLS SEG Calc_RBM_Cat_Diag, SOF Calc_RBM_Cat_Diag
        CALLS SEG Calc_Evap_RBM_Cond, SOF Calc_Evap_RBM_Cond
        CALLS SEG Calc_RBM_DTP_Noise, SOF Calc_RBM_DTP_Noise
        CALLS SEG Calc_RBM_CPS_Mecha, SOF Calc_RBM_CPS_Mecha
        CALLS SEG Calc_RBM_Leak_Small, SOF Calc_RBM_Leak_Small
        CALLS SEG Calc_RBM_Leak_Large, SOF Calc_RBM_Leak_Large
        CALLS SEG Calc_RBM_TCO_Stuck, SOF Calc_RBM_TCO_Stuck
        CALLS SEG Calc_RBM_TCO_Stuck_Rng, SOF Calc_RBM_TCO_Stuck_Rng
        CALLS SEG Calc_RBM_TCO_Plaus, SOF Calc_RBM_TCO_Plaus
        CALLS SEG Calc_RBM_Th_Det, SOF Calc_RBM_Th_Det
        CALLS SEG Calc_RBM_TOil_Stuck, SOF Calc_RBM_TOil_Stuck
        CALLS SEG Calc_RBM_MAF_Dif_CH, SOF Calc_RBM_MAF_Dif_CH
        CALLS SEG Calc_RBM_TIA_Plaus, SOF Calc_RBM_TIA_Plaus
        CALLS SEG RBM_Inc_IgnCyc_Ctr, SOF RBM_Inc_IgnCyc_Ctr
        CALLS SEG Set_Conf_VIN_Diag, SOF Set_Conf_VIN_Diag
        CALLS SEG Calc_TAst_OBD, SOF Calc_TAst_OBD
        RETS

