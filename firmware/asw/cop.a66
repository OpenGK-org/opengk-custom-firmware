        JMPR cc_ULE,L_D6644
L_D6620:                 ; 0xd6620
        BSET lv_iga_dif_max_er.0BH
        BSET lv_iga_dif_max_er.0DH
        BSET lv_iga_dif_max_er.0CH
        JMPR cc_UC,L_D6644
L_D6628:                 ; 0xd6628
        JB lv_cdn_diag_maf_dif_ch_int.0BH,L_D6634
        JB lv_pl.04H,L_D6634
