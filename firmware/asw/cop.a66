; ======== Calc_ECU_Diag_SF  (@0xd6722) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): ECU self-diagnosis status flags: ecu_diag_sf_word /
        ; lv_ecu_err.
        ; ------------------------------------------------------------
Calc_ECU_Diag_SF:
        MOVB RL4,DPP0:diag_90008
        CMPB RL4,DPP1:0A0056H
        JMPR cc_NE,L_D6770
        MOVB RL5,DPP0:diag_90009
        CMPB RL5,DPP1:0A0057H
        JMPR cc_NE,L_D6770
        MOVB RL3,DPP0:diag_9000a
        CMPB RL3,DPP1:0A0058H
        JMPR cc_NE,L_D6770
        MOVB RL2,DPP0:diag_9000b
        CMPB RL2,DPP1:0A0059H
        JMPR cc_NE,L_D6770
        MOVB RL1,DPP0:diag_9000c
        CMPB RL1,DPP1:0A005AH
        JMPR cc_NE,L_D6770
        MOVB RL4,DPP0:diag_9000d
        CMPB RL4,DPP1:0A005BH
        JMPR cc_NE,L_D6770
        MOVB RL4,#DATA16 000FEH
        ANDB lv_sched_diag_inh,RL4
        MOV R4,#DATA16 0FFDFH
        AND ecu_diag_sf_word,R4
        JMPR cc_UC,L_D6792
L_D6770:                 ; 0xd6770
        MOV R4,#DATA16 00020H
        OR ecu_diag_sf_word,R4
        MOVB RL4,DPP1:0A004CH
        CMPB RL4,#DATA16 000A8H
        JMPR cc_EQ,L_D678C
        MOVB RL5,#DATA16 000FEH
        ANDB lv_sched_diag_inh,RL5
        JMPR cc_UC,L_D6792
L_D678C:                 ; 0xd678c
        MOVB RL4,#01H
        ORB lv_sched_diag_inh,RL4
L_D6792:                 ; 0xd6792
        MOV R12,#DATA16 00020H
        CALLS SEG DTC_Calc_Activation_MIL, SOF DTC_Calc_Activation_MIL
        BMOV lv_ecu_err.03H,dtc_status_work.06H
        MOVBZ R4,dtc_ecu_flags
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_D67B0
        MOV R4,#DATA16 0FFF7H
        AND dtc_st_grp_ecu,R4
L_D67B0:                 ; 0xd67b0
        RETS

; ======== Set_Conf_VS  (@0xd67b2) ========
Set_Conf_VS:
        CALLS SEG Calc_Conf_Lam, SOF Calc_Conf_Lam
        CALLS SEG Calc_Conf_CatEff, SOF Calc_Conf_CatEff
        CALLS SEG Set_Conf_MIL_FMY, SOF Set_Conf_MIL_FMY
        MOVB RL4,DPP0:c_conf_mis
        CMPB RL4,#01H
        JMPR cc_NE,L_D67C8
        BSET lv_conf_mis.02H
L_D67C8:                 ; 0xd67c8
        CALLS SEG Calc_Conf_CP, SOF Calc_Conf_CP
        CALLS SEG DiagCP_Set_Config, SOF DiagCP_Set_Config
        CALLS SEG Set_lv_conf_mis, SOF Set_lv_conf_mis
        CALLS SEG Set_Conf_ACP, SOF Set_Conf_ACP
        CALLS SEG NVM_Restore_s5aa, SOF NVM_Restore_s5aa
        CALLS SEG NVM_Restore_s5ae, SOF NVM_Restore_s5ae
        BSET lv_conf_mis.09H
        JB can_fd58.02H,L_D67FC
        MOV R4,diag_f890
        MOV R5,diag_f892
        EXTP R5, #02H
        MOVB RL3,[R4+#0641H]
        NOP
        MOVB conf_vs,RL3
        JMPR cc_UC,L_D6802
L_D67FC:                 ; 0xd67fc
        MOVB RL4,#03H
        MOVB conf_vs,RL4
L_D6802:                 ; 0xd6802
        CALLS SEG Calc_VS, SOF Calc_VS
        CALLS SEG Calc_Conf_Mis, SOF Calc_Conf_Mis
        CALLS SEG Set_PL_Flags, SOF Set_PL_Flags
        CALLS SEG Calc_MAF_Dif_CH_Upd, SOF Calc_MAF_Dif_CH_Upd
        CALLS SEG Set_Conf_MTV, SOF Set_Conf_MTV
        CALLS SEG Set_lv_maf_trim_e2d7, SOF Set_lv_maf_trim_e2d7
        CALLS SEG Set_lv_pl, SOF Set_lv_pl
        CALLS SEG Set_Conf_Ad_Rst, SOF Set_Conf_Ad_Rst
