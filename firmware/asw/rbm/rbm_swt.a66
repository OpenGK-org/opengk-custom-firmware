; asw/rbm/rbm_swt.a66
; Rear O2 switching and voltage plausibility rate-based monitors (IUMPR).
; 0xB8EF0-0xB901E  (302 bytes, 6 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_sum_vls_down_diag_min              EQU  09030EH

PUBLIC  Calc_RBM_LS_Down_Swt, Calc_RBM_VLS_Down_Plaus, ClrBits_state_rbm_ls_down_swt_efa, ClrBits_state_rbm_vls_down_plaus_f94, Reset_state_rbm_ls_down_swt_ef0, Reset_state_rbm_vls_down_plaus_f8a
EXTERN  Div_U32_U16_Round32:NEAR

S_B8EF0 SECTION CODE AT 0B8EF0H

; ======== Reset_state_rbm_ls_down_swt_ef0  (@0xb8ef0) ========
Reset_state_rbm_ls_down_swt_ef0:
        MOVB state_rbm_ls_down_swt,ZEROS
        MOV rate_rbm_ls_down_swt,ONES
        RETS

; ======== ClrBits_state_rbm_ls_down_swt_efa  (@0xb8efa) ========
ClrBits_state_rbm_ls_down_swt_efa:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_ls_down_swt,RL4
        RETS

; ======== Calc_RBM_LS_Down_Swt  (@0xb8f04) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for LS Down
        ; Swt: updates state_rbm_ls_down_swt / rate_rbm_ls_down_swt (in-use completion ratio =
        ; numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_LS_Down_Swt:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV R7,p_lam_bank1
        JNB obd_sf.0DH,L_B8F82
        MOVBZ R4,state_rbm_ls_down_swt
        AND R4,#01H
        JMPR cc_NE,L_B8F2A
        MOVB RL4,[R7+#018AH]
        CMPB RL4,DPP0:c_sum_vls_down_diag_min
        JMPR cc_C,L_B8F2A
        MOVB RL4,#01H
        ORB state_rbm_ls_down_swt,RL4
L_B8F2A:                 ; 0xb8f2a
        MOVBZ R4,state_rbm_ls_down_swt
        AND R4,#02H
        JMPR cc_NE,L_B8F3C
        JNB lv_cat_diag_inh_1.07H,L_B8F3C
        MOVB RL4,#02H
        ORB state_rbm_ls_down_swt,RL4
L_B8F3C:                 ; 0xb8f3c
        MOVBZ R4,state_rbm_ls_down_swt
        AND R4,#04H
        JMPR cc_NE,L_B8F4A
        MOVB RL4,#04H
        ORB state_rbm_ls_down_swt,RL4
L_B8F4A:                 ; 0xb8f4a
        MOV R12,ctr_comp_rbm_ls_down_swt
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_ls_down_swt
        CALLS 00FH,Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_B8F74
        CMP R8,#DATA16 0FFFFH
L_B8F74:                 ; 0xb8f74
        JMPR cc_C,L_B8F7C
        MOV rate_rbm_ls_down_swt,ONES
        JMPR cc_UC,L_B8F82
L_B8F7C:                 ; 0xb8f7c
        MOV R4,R8
        MOV rate_rbm_ls_down_swt,R4
L_B8F82:                 ; 0xb8f82
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== Reset_state_rbm_vls_down_plaus_f8a  (@0xb8f8a) ========
Reset_state_rbm_vls_down_plaus_f8a:
        MOVB state_rbm_vls_down_plaus,ZEROS
        MOV rate_rbm_vls_down_plaus,ONES
        RETS

; ======== ClrBits_state_rbm_vls_down_plaus_f94  (@0xb8f94) ========
ClrBits_state_rbm_vls_down_plaus_f94:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_vls_down_plaus,RL4
        RETS

; ======== Calc_RBM_VLS_Down_Plaus  (@0xb8f9e) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for VLS Down
        ; Plaus: updates state_rbm_vls_down_plaus / rate_rbm_vls_down_plaus (in-use completion ratio =
        ; numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_VLS_Down_Plaus:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV R7,p_lam_bank1
        JNB obd_sf.0DH,L_B9016
        MOVBZ R4,state_rbm_vls_down_plaus
        AND R4,#01H
        JMPR cc_NE,L_B8FBE
        JNB lv_cp_set_close.08H,L_B8FBE
        MOVB RL4,#01H
        ORB state_rbm_vls_down_plaus,RL4
L_B8FBE:                 ; 0xb8fbe
        MOVBZ R4,state_rbm_vls_down_plaus
        AND R4,#02H
        JMPR cc_NE,L_B8FD0
        JNB lv_cat_diag_inh_1.07H,L_B8FD0
        MOVB RL4,#02H
        ORB state_rbm_vls_down_plaus,RL4
L_B8FD0:                 ; 0xb8fd0
        MOVBZ R4,state_rbm_vls_down_plaus
        AND R4,#04H
        JMPR cc_NE,L_B8FDE
        MOVB RL4,#04H
        ORB state_rbm_vls_down_plaus,RL4
L_B8FDE:                 ; 0xb8fde
        MOV R12,ctr_comp_rbm_vls_down_plaus
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_vls_down_plaus
        CALLS 00FH,Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_B9008
        CMP R8,#DATA16 0FFFFH
L_B9008:                 ; 0xb9008
        JMPR cc_C,L_B9010
        MOV rate_rbm_vls_down_plaus,ONES
        JMPR cc_UC,L_B9016
L_B9010:                 ; 0xb9010
        MOV R4,R8
        MOV rate_rbm_vls_down_plaus,R4
L_B9016:                 ; 0xb9016
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_B8EF0 ENDS
        END
