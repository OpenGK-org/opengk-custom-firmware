; ======== Reset_RBM_Full  (@0xb317c) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (EMS31, verified): Rate base monitoring (reset, zero denominators)
        ; ------------------------------------------------------------
Reset_RBM_Full:
        MOV [-R0],R9
        CALLS 00CH,NVM_Restore_s5dc
        BCLR lv_dc_rbm.01H
        BCLR lv_dc_rbm.00H
        MOVB state_dc_rbm,ZEROS
        MOV t_ast_rbm,ZEROS
        MOV t_vs_rbm,ZEROS
        MOV t_is_rbm,ZEROS
        MOV R9,#00H
L_B3198:                 ; 0xb3198
        MOVB RL4,#00H
        MOV R5,R9
        SHL R5,#02H
        MOV R2,[R5+#046C0H]
        MOVB [R2+#04H],RL4
        ADD R9,#01H
        CMP R9,#DATA16 00013H
        JMPR cc_C,L_B3198
        MOV R9,[R0+]
        RETS

