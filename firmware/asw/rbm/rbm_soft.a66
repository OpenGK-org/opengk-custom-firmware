        JMPR cc_NC,L_B31EC
        MOV R4,[R9]
        CMP R4,#DATA16 0FFFFH
        JMPR cc_C,L_B31FC
L_B31EC:                 ; 0xb31ec
        MOV R4,[R9+#02H]
        SHR R4,#01H
        MOV [R9+#02H],R4
        MOV R4,[R9]
        SHR R4,#01H
