; asw/stuck/stuck_toil.a66
; Oil temperature stuck rate-based monitor (IUMPR).
; 0xBA37E-0xBA410  (146 bytes, 2 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_RBM_TOil_Stuck, ClrBits_state_rbm_toil_stuck_37e
EXTERN  Div_U32_U16_Round32:NEAR

S_BA37E SECTION CODE AT 0BA37EH

; ======== ClrBits_state_rbm_toil_stuck_37e  (@0xba37e) ========
ClrBits_state_rbm_toil_stuck_37e:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_toil_stuck,RL4
        RETS

; ======== Calc_RBM_TOil_Stuck  (@0xba388) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by tq/tqi output signals): Oil-temperature stuck-sensor rate-based monitor:
        ; state_rbm_toil_stuck / rate_rbm_toil_stuck (IUMPR).
        ; ------------------------------------------------------------
Calc_RBM_TOil_Stuck:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB obd_sf.0DH,L_BA40A
        MOVBZ R4,state_rbm_toil_stuck
        AND R4,#01H
        JMPR cc_NE,L_BA3A2
        JNB lv_err_pres_mwss.0DH,L_BA3A2
        MOVB RL4,#01H
        ORB state_rbm_toil_stuck,RL4
L_BA3A2:                 ; 0xba3a2
        MOVBZ R4,state_rbm_toil_stuck
        AND R4,#02H
        JMPR cc_NE,L_BA3C4
        JB lv_cam_err.0CH,L_BA3BE
        JB lv_lam_lim_1_err.01H,L_BA3BE
        JB lv_lam_lim_1_err.00H,L_BA3BE
        JB lv_can_bus_off_err.09H,L_BA3BE
        JNB lv_can_bus_off_err.0DH,L_BA3C4
L_BA3BE:                 ; 0xba3be
        MOVB RL4,#02H
        ORB state_rbm_toil_stuck,RL4
L_BA3C4:                 ; 0xba3c4
        MOVBZ R4,state_rbm_toil_stuck
        AND R4,#04H
        JMPR cc_NE,L_BA3D2
        MOVB RL4,#04H
        ORB state_rbm_toil_stuck,RL4
L_BA3D2:                 ; 0xba3d2
        MOV R12,ctr_comp_rbm_toil_stuck
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_toil_stuck
        CALLS SEG Div_U32_U16_Round32, SOF Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_BA3FC
        CMP R8,#DATA16 0FFFFH
L_BA3FC:                 ; 0xba3fc
        JMPR cc_C,L_BA404
        MOV rate_rbm_toil_stuck,ONES
        JMPR cc_UC,L_BA40A
L_BA404:                 ; 0xba404
        MOV R4,R8
        MOV rate_rbm_toil_stuck,R4
L_BA40A:                 ; 0xba40a
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_BA37E ENDS
        END
