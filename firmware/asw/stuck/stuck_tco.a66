; asw/stuck/stuck_tco.a66
; Coolant temperature stuck rate-based monitor (IUMPR).
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_RBM_TCO_Stuck, ClrBits_state_rbm_tco_stuck_054, Reset_state_rbm_tco_stuck_04a, Set_lv_n_max_isa_err_c903
EXTERN  Div_U32_U16_Round32:NEAR

S_STUCK_TCO SECTION CODE

; ======== Set_lv_n_max_isa_err_c903  (@0xc9032) ========
        ; ------------------------------------------------------------
        ; Named from single dominant output signal (auto-derived, lower confidence than hand-verified).
        ; ------------------------------------------------------------
Set_lv_n_max_isa_err_c903:
        JNB lv_pl.04H,L_C9048
        JB lv_err_pres_mwss.0EH,L_C9042
        JB lv_n_max_isa_err.0EH,L_C9042
        JNB lv_n_max_isa_err.0FH,L_C9046
L_C9042:                 ; 0xc9042
        BSET lv_n_max_isa_err.0CH
        RETS
L_C9046:                 ; 0xc9046
        BCLR lv_n_max_isa_err.0CH
L_C9048:                 ; 0xc9048
        RETS

; ======== Reset_state_rbm_tco_stuck_04a  (@0xc904a) ========
Reset_state_rbm_tco_stuck_04a:
        MOVB state_rbm_tco_stuck,ZEROS
        MOV rate_rbm_tco_stuck,ONES
        RETS

; ======== ClrBits_state_rbm_tco_stuck_054  (@0xc9054) ========
ClrBits_state_rbm_tco_stuck_054:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_tco_stuck,RL4
        RETS

; ======== Calc_RBM_TCO_Stuck  (@0xc905e) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for TCO Stuck:
        ; updates state_rbm_tco_stuck / rate_rbm_tco_stuck (in-use completion ratio = numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_TCO_Stuck:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB obd_sf.0DH,L_C90DC
        MOVB RL4,state_rbm_tco_stuck
        ANDB RL4,#01H
        JMPR cc_NE,L_C9078
        JNB lv_n_max_isa_err.09H,L_C9078
        MOVB RL4,#01H
        ORB state_rbm_tco_stuck,RL4
L_C9078:                 ; 0xc9078
        MOVB RL4,state_rbm_tco_stuck
        ANDB RL4,#02H
        JMPR cc_NE,L_C9096
        JB lv_cam_err.0CH,L_C9090
        JB lv_cam_err.0EH,L_C9090
        JB lv_lam_lim_1_err.01H,L_C9090
        JNB lv_lam_lim_1_err.00H,L_C9096
L_C9090:                 ; 0xc9090
        MOVB RL4,#02H
        ORB state_rbm_tco_stuck,RL4
L_C9096:                 ; 0xc9096
        MOVB RL4,state_rbm_tco_stuck
        ANDB RL4,#04H
        JMPR cc_NE,L_C90A4
        MOVB RL4,#04H
        ORB state_rbm_tco_stuck,RL4
L_C90A4:                 ; 0xc90a4
        MOV R12,ctr_comp_rbm_tco_stuck
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_tco_stuck
        CALLS SEG Div_U32_U16_Round32, SOF Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_C90CE
        CMP R8,#DATA16 0FFFFH
L_C90CE:                 ; 0xc90ce
        JMPR cc_C,L_C90D6
        MOV rate_rbm_tco_stuck,ONES
        JMPR cc_UC,L_C90DC
L_C90D6:                 ; 0xc90d6
        MOV R4,R8
        MOV rate_rbm_tco_stuck,R4
L_C90DC:                 ; 0xc90dc
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_STUCK_TCO ENDS
        END
