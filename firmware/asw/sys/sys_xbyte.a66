; asw/sys/sys_xbyte.a66
; Runtime: 3D byte-table read, byte X / byte Y axes, 32-bit table pointer.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Get_Byte_3D_Table_DWord_XByte_YByte

S_SYS_XBYTE SECTION CODE

; ======== Get_Byte_3D_Table_DWord_XByte_YByte  (@0xffdee) ========
Get_Byte_3D_Table_DWord_XByte_YByte:
        MOV R10,[R12]
        MOV R2,[R12+#04H]
        MOV R3,[R12+#08H]
        MOV R5,[R12+#06H]
        MOV R11,[R12+#0AH]
        MOV R12,[R12+#02H]
        MOV DPP0_FE00,R11
        NOP
        MOVB RL4,[R3]
        MOVBZ R15,RL4
        MOV DPP0_FE00,R5
        MOV R4,R13
        MOVB RL1,[R2]
        MOVBZ R1,RL1
        ADD R1,R2
        ADD R2,#01H
        CMPB RL4,[R1]
        JMPR cc_NC,L_FFE2A
        CMPB RL4,[R2]
        JMPR cc_ULE,L_FFE32
L_FFE24:                 ; 0xffe24
        SUB R1,#01H
        CMPB RL4,[R1]
        JMPR cc_C,L_FFE24
L_FFE2A:                 ; 0xffe2a
        SUB R1,R2
        MULU R1,R15
        ADD R10,0FE0EH
L_FFE32:                 ; 0xffe32
        MOV DPP0_FE00,R11
        MOV R4,R14
        MOV R1,R15
        ADD R1,R3
        ADD R3,#01H
        CMPB RL4,[R1]
        JMPR cc_NC,L_FFE4C
        CMPB RL4,[R3]
        JMPR cc_ULE,L_FFE50
L_FFE46:                 ; 0xffe46
        SUB R1,#01H
        CMPB RL4,[R1]
        JMPR cc_C,L_FFE46
L_FFE4C:                 ; 0xffe4c
        SUB R1,R3
        ADD R10,R1
L_FFE50:                 ; 0xffe50
        EXTP R12, #01H
        MOVB RL4,[R10]
        MOV DPP0,#DATA16 00024H
        RETS

S_SYS_XBYTE ENDS
        END
