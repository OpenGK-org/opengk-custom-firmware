; asw/sys/data_0xa0500.a66
; Constant tables at 0xA0500 (page 28h, reached through DPP1 = 28h): jump tables,
; far-pointer task/handler tables, KWP/OBD descriptor tables, CAN message-object
; templates and other ROM data.  Code pointers are symbolic (SOF/SEG), so the code
; they point at can move; calibration pointers use POF/PAG.  Jump-table entries are
; offsets in the segment of the code that dispatches through them (noted per table).
; 0xA0500-0xA2A66  (9574 bytes)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

