$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  CC16INT_handler
PUBLIC  L_AB34C, L_AB39A, L_AB406

S_AB32C SECTION CODE AT 0AB32CH

; ======== CC16INT_handler  (@0xab32c) ========
CC16INT_handler:
        SCXT CP,#DATA16 0FC3AH
