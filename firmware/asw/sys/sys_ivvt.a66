        JMPR cc_UC,L_AB3E8
L_AB3CE:                 ; 0xab3ce
        MOV R2,ivvt_epwm_sum
        MOV R4,ivvt_epwm_div
        MOV R1,R3
        MOV R0,R2
        SUB R0,R1
        JMPR cc_UGT,L_AB3E6
        MOV R1,R2
        MOV R2,0FF1CH
        JMPR cc_UC,L_AB3E8
L_AB3E6:                 ; 0xab3e6
        MOV R2,R0
L_AB3E8:                 ; 0xab3e8
        MOV R0,CC16_FE60
        ADD CC16_FE60,R1
        BFLDL 0FF22H,#0FH,#0EH
        NEG R0
        ADD R0,T8_F052
        CMP R0,R1
        JMPR cc_C,L_AB490
        EXTR #01H
        BFLDL 0F160H,#0FFH,#0CEH
        JMPR cc_UC,L_AB490
L_AB406:                 ; 0xab406  (pointer target)
        JMPR cc_UC,L_AB490
L_AB408:                 ; 0xab408
        CMP R2,0FF1CH
        JMPR cc_EQ,L_AB44E
        JNB P7.03H,L_AB418
        BCLR P7.03H
        MOV R1,R3
        JMPR cc_UC,L_AB420
L_AB418:                 ; 0xab418
        BSET P7.03H
        MOV R1,R3
        NEG R1
