L_AB420:                 ; 0xab420
        MOV R0,R2
        SUB R0,R1
        JMPR cc_UGT,L_AB42E
        MOV R1,R2
        MOV R2,0FF1CH
        JMPR cc_UC,L_AB430
L_AB42E:                 ; 0xab42e
        MOV R2,R0
L_AB430:                 ; 0xab430
        MOV R0,CC16_FE60
        ADD CC16_FE60,R1
        BFLDL 0FF22H,#0FH,#0EH
        NEG R0
        ADD R0,T8_F052
        CMP R0,R1
        JMPR cc_C,L_AB490
        EXTR #01H
        BFLDL 0F160H,#0FFH,#0CEH
        JMPR cc_UC,L_AB490
L_AB44E:                 ; 0xab44e
        BCLR P7.03H
        BSET PWMCON1.03H
        BSET PWMCON0.03H
