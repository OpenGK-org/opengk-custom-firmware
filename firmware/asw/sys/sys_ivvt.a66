        JMPA cc_UC,L_AB490
L_AB39A:                 ; 0xab39a  (pointer target)
        ATOMIC #02H
        BCLR PWMCON0.03H
        MOV CC16,T8_F052
        BCLR PWMCON1.03H
        BCLR PWMCON0.0FH
        MOV ivvt_hpwm_cmp,PW3
        MOV R3,ivvt_epwm_duty
        JMPR cc_NE,L_AB3BC
        BSET P7.03H
        MOV R1,ivvt_epwm_sum
        MOV R2,0FF1CH
        JMPR cc_UC,L_AB3E8
L_AB3BC:                 ; 0xab3bc
        BCLR P7.03H
        CMP R3,#DATA16 0FF00H
        JMPR cc_NE,L_AB3CE
        MOV R1,ivvt_epwm_sum
