$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  CC25INT_handler, CC8INT_handler, CapCom_CC0_Ch0_Drv, CapCom_CC1_Ch1_Drv, CapCom_CC2_Ch2_Drv, CapCom_CC3_Ch3_Drv_ImobGated
