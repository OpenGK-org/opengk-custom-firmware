        MOVB RL2,#00H
        MOVB inj_ic_cyl0,RL2
        MOV CC0,#DATA16 0006EH
        BFLDL 0FF52H,#0FH,#06H
        MOVB RL0,#DATA16 00028H
        MOVB RH0,#DATA16 00046H
        SUBB RH0,T0_FE50
        NEGB RH0
        CMPB RH0,#00H
        JMPR cc_SGE,L_A92B2
        ADDB RH0,#DATA16 00078H
L_A92B2:                 ; 0xa92b2
        CMPB RH0,RL0
        JMPR cc_C,L_A92C6
        BSET CC0IC.07H
