; asw/sys/sys_far.a66
; Runtime: far (paged) byte/word table reads and byte axis lookup.
; 0xFF16C-0xFF1D8  (108 bytes, 4 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Get_Byte_Y_Axis, Read_Byte_Far, Read_Byte_Far_Scaled, Read_Word_Far

S_FF16C SECTION CODE AT 0FF16CH

; ======== Read_Byte_Far  (@0xff16c) ========
        ; ubyte Read_Byte_Far(short off, u16 page): read byte at (DAT_00f516 + off) within 0x4000 page 'page'
        ; (phys = page*0x4000 + base + off). Paged calibration/table byte fetch.
Read_Byte_Far:
        MOVBZ R2,ip_idx
        ADD R12,R2
        EXTP R13, #01H
        MOVB RL4,[R12]
        RETS

; ======== Read_Byte_Far_Scaled  (@0xff178) ========
        ; ubyte Read_Byte_Far_Scaled(short off, u16 page): like Read_Byte_Far but base = DAT_00f516*DAT_00f518
        ; + DAT_00f517 + off, page*0x4000. Row-scaled 2D table byte fetch.
Read_Byte_Far_Scaled:
        MOVBZ R3,ip_idx
        MOVBZ R2,knk_idx_base
        MOVBZ R5,g_f518
        MULU R3,R5
        ADD R12,0FE0EH
        ADD R12,R2
        EXTP R13, #01H
        MOVB RL4,[R12]
        RETS

; ======== Read_Word_Far  (@0xff192) ========
        ; Read_Word_Far(idx, page): far 16-bit table read. returns *(u16*)(idx + DAT_00f516*2 + page*0x4000).
        ; Word analog of Read_Byte_Far.
Read_Word_Far:
        MOVBZ R2,ip_idx
        SHL R2,#01H
        ADD R12,R2
        EXTP R13, #01H
        MOV R4,[R12]
        RETS

; ======== Get_Byte_Y_Axis  (@0xff1a0) ========
Get_Byte_Y_Axis:
        MOV DPP0_FE00,R13
        MOV R1,R12
        MOV R4,R14
        MOV R2,R1
        MOVB RL5,[R1+]
        MOVBZ R5,RL5
        ADD R2,R5
        CMPB RL4,[R2]
        JMPR cc_NC,L_FF1CC
        CMPB RL4,[R1]
        JMPR cc_ULE,L_FF1CA
L_FF1B8:                 ; 0xff1b8
        SUB R2,#01H
        CMPB RL4,[R2]
        JMPR cc_C,L_FF1B8
        SUB R2,R1
        MOVB ip_idx,RL2
        MOV DPP0,#DATA16 00024H
        RETS
L_FF1CA:                 ; 0xff1ca
        MOV R2,R1
L_FF1CC:                 ; 0xff1cc
        SUB R2,R1
        MOVB ip_idx,RL2
        MOV DPP0,#DATA16 00024H
        RETS

S_FF16C ENDS
        END
