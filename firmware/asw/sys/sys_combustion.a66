; ======== Output_CC12_P2_12_Disable  (@0xa5224) ========
        ; ?Output_CC12_P2_12_Disable: masks CAPCOM channel CC12 (CC12IC=0, CCM3 |= 0xf mode) and drives P2.12
        ; low (P2 & ~0x1000). Single-channel output disable; exact load on P2.12 not yet identified.
Output_CC12_P2_12_Disable:
        MOV CC12IC,#DATA16 00000H
        BFLDL 0FF58H,#0FH,#00H
        BCLR P2.0CH
        RETS

S_SYS_COMBUSTION ENDS
        END
