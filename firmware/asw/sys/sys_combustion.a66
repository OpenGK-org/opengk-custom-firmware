; asw/sys/sys_combustion.a66
; Injector/combustion diagnosis, programming session manager and CC12 output disable.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_vb_max_diag                        EQU  090407H
c_vb_min_jump                        EQU  090412H
c_vb_min_obd1                        EQU  090417H
c_vb_min_obd2                        EQU  090418H

PUBLIC  Diag_IV_Combustion, Output_CC12_P2_12_Disable, ProgSession_StateMachine_VbGated, Reset_CC28IC_e22
EXTERN  Calc_Crank_Err_LIH:NEAR, Clr_Diag_fd62_RetStatus:NEAR, Ctl_FuelPump:NEAR, Diag_Output_EGR:NEAR
EXTERN  Diag_Output_SecAir:NEAR, Diag_Output_Stage:NEAR, EngCrank_ArmTimingCapture:NEAR, EngCrank_StopTimingCapture:NEAR
EXTERN  EngIgn_ArmOutputs:NEAR, EngIgn_DisableOutputs:NEAR, EngInj_ArmOutputs:NEAR, EngInj_DisableOutputs:NEAR
EXTERN  FuelCut_TrailThrottle:NEAR, FuelPump_Out_1:NEAR, FuelPump_Out_2:NEAR, FuelPump_Out_3:NEAR
EXTERN  FuelPump_Out_4:NEAR, FuelPump_Out_5:NEAR, FuelPump_Out_6:NEAR, Nop_e5d32:NEAR
EXTERN  Nop_e5d34:NEAR, SMARTRA_Phase_Sync:NEAR, Set_FuelPump_Latch:NEAR, Set_FuelPump_Latch_2:NEAR
EXTERN  Set_FuelPump_RunOn:NEAR, Set_Out_FuelReq_4:NEAR, Tail_f0a52cc_b26:NEAR, Tail_f0c7b8c_d2c:NEAR
EXTERN  c_t_max_ecu_sub:NEAR, vb_sub:NEAR, write_eeprom_ti_co_is:NEAR
PUBLIC  L_A4FC6, L_A500C, L_A50B2, L_A513E, L_A519A, L_A51DA

S_SYS_COMBUSTION SECTION CODE

; ======== Reset_CC28IC_e22  (@0xa4e22) ========
Reset_CC28IC_e22:
        EXTR #01H
        BFLDL 0F178H,#0FFH,#00H
        BFLDL 0FF28H,#0FH,#00H
        RETS

; ======== Diag_IV_Combustion  (@0xa4e2e) ========
        ; ------------------------------------------------------------
        ; OEM (verified by ccp_/bl_/cpu output signals): Injector/combustion diagnosis: diag_iv / iv_diag_mis.
        ; ------------------------------------------------------------
Diag_IV_Combustion:
        MOV [-R0],R9
        MOV [-R0],R8
        CALLS SEG Diag_Output_Stage, SOF Diag_Output_Stage
        CALLS SEG Diag_Output_SecAir, SOF Diag_Output_SecAir
        CALLS SEG Diag_Output_EGR, SOF Diag_Output_EGR
        MOVBZ R9,diag_f59a
        MOV R8,#00H
L_A4E44:                 ; 0xa4e44
        MOV R4,#01H
        SHL R4,R8
        AND R4,R9
        JMPR cc_EQ,L_A4E72
        MOV R4,R8
        SHL R4,#01H
        MOV R5,[R4+#06344H]
        MOV R4,diag_fbaa
        AND R4,diag_fba8
        AND R4,R5
        JMPR cc_EQ,L_A4E68
        MOV R4,#01H
        ; ------------------------------------------------------------
        ; (unclassified) RAM/paged global @0xa4e62 [dpp]  W:{-}  R:{-}
        ; ------------------------------------------------------------
        SHL R4,R8
        ORB diag_iv,RL4
L_A4E68:                 ; 0xa4e68
        MOV R4,#01H
        SHL R4,R8
        CPLB RL4
        ANDB inj_cc_5,RL4
L_A4E72:                 ; 0xa4e72
        ADD R8,#01H
        CMP R8,#04H
        JMPR cc_C,L_A4E44
        MOVB RL4,inj_cc_5
        MOVB diag_f59a,RL4
        ; ------------------------------------------------------------
        ; (unclassified) RAM/paged global @0xa4e80 [dpp]  W:{-}  R:{-}
        ; ------------------------------------------------------------
        MOV R9,#00H
        JB dtc_cond_s1.01H,L_A4E8E
        JB dtc_cond_s2.01H,L_A4E8E
        JNB dtc_cond_s3.01H,L_A4E90
L_A4E8E:                 ; 0xa4e8e
        MOV R9,#01H
L_A4E90:                 ; 0xa4e90
        JB dtc_cond_s1.03H,L_A4E9C
        JB dtc_cond_s2.03H,L_A4E9C
        JNB dtc_cond_s3.03H,L_A4E9E
L_A4E9C:                 ; 0xa4e9c
        OR R9,#02H
L_A4E9E:                 ; 0xa4e9e
        JB dtc_cond_s1.05H,diag_a4eaa
        JB dtc_cond_s2.05H,diag_a4eaa
        JNB dtc_cond_s3.05H,L_A4EAC
        ; ------------------------------------------------------------
        ; (likely) RAM/paged global @0xa4eaa [dpp]  W:{-}  R:{Diag_IV_Combustion}
        ; ------------------------------------------------------------
diag_a4eaa:              ; 0xa4eaa
        OR R9,#04H
L_A4EAC:                 ; 0xa4eac
        JB dtc_cond_s1.07H,L_A4EB8
        JB dtc_cond_s2.07H,L_A4EB8
        JNB dtc_cond_s3.07H,L_A4EBC
L_A4EB8:                 ; 0xa4eb8
        OR R9,#DATA16 00008H
L_A4EBC:                 ; 0xa4ebc
        MOV R4,R9
        ORB iv_diag_mis,RL4
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== ProgSession_StateMachine_VbGated  (@0xa4ec8) ========
        ; ProgSession_StateMachine_VbGated: main programming/diagnostic session manager, gated on supply
        ; voltage. Computes vb / v_igk (battery & ignition-key volts from DAT_00f9bc/0f9ba >>2) and sets
        ; voltage-window flags in DAT_00fd58: 0x400 jump-start, 0x800 OBD1 window, 0x1000 OBD2 window, 0x200
        ; session-active (vs calibrations c_vb_min_jump/obd1/obd2, c_vb_max_diag). Drives
        ; bl_prog_session_state (0..5). On entering the quiet/programming state it calls the engine-STOP trio
        ; (EngCrank_StopTimingCapture / EngInj_DisableOutputs / EngIgn_DisableOutputs); on resume it calls the
        ; ARM group (EngInj_ArmOutputs / EngIgn_ArmOutputs / EngCrank_ArmTimingCapture) so the engine is off
        ; during reflash. Persists via write_eeprom_ti_co_is on the 0x4000 path.
ProgSession_StateMachine_VbGated:
        MOV R4,maf_avg2
        SHR R4,#02H
        MOVB vb,RL4
        MOV R4,maf_avg
        SHR R4,#02H
        ; ------------------------------------------------------------
        ; (unclassified) RAM/paged global @0xa4ed8 [dpp]  W:{-}  R:{-}
        ; ------------------------------------------------------------
        MOVB v_igk,RL4
        MOVB RL5,lv_sched_diag_inh
        ANDB RL5,#01H
        JMPR cc_NE,L_A4EFC
        MOVB RL5,vb
        ; ------------------------------------------------------------
        ; (unclassified) RAM/paged global @0xa4ee8 [dpp]  W:{-}  R:{-}
        ; ------------------------------------------------------------
        CMPB RL5,DPP0:c_vb_min_jump
        JMPR cc_UGT,L_A4EF4
        CMPB RL4,DPP0:c_vb_min_jump
        JMPR cc_ULE,g_a4ef8
L_A4EF4:                 ; 0xa4ef4
        BSET can_fd58.0AH
        JMPR cc_UC,L_A4F16
        ; ------------------------------------------------------------
        ; (unclassified) RAM/paged global @0xa4ef8 [dpp]  W:{-}  R:{ProgSession_StateMachine_VbGated}
        ; ------------------------------------------------------------
g_a4ef8:                 ; 0xa4ef8
        BCLR can_fd58.0AH
        JMPR cc_UC,L_A4F16
L_A4EFC:                 ; 0xa4efc
        MOVB RL4,vb
        CMPB RL4,#DATA16 0000EH
        JMPR cc_UGT,L_A4F10
        MOVB RL5,v_igk
        CMPB RL5,#DATA16 0000EH
        JMPR cc_ULE,L_A4F14
L_A4F10:                 ; 0xa4f10
        BSET can_fd58.0AH
        JMPR cc_UC,L_A4F16
L_A4F14:                 ; 0xa4f14
        BCLR can_fd58.0AH
L_A4F16:                 ; 0xa4f16
        JNB can_fd58.0EH,L_A4F2E
        BCLR can_fd58.0BH
        BCLR can_fd58.0CH
        JNB can_fd58.09H,L_A4F28
        BCLR can_fd58.09H
        CALLS SEG write_eeprom_ti_co_is, SOF write_eeprom_ti_co_is
L_A4F28:                 ; 0xa4f28
        CALLS SEG Clr_Diag_fd62_RetStatus, SOF Clr_Diag_fd62_RetStatus
        JMPR cc_UC,L_A4FB0
L_A4F2E:                 ; 0xa4f2e
        MOVB RL4,lv_sched_diag_inh
        ANDB RL4,#01H
        JMPR cc_NE,L_A4F84
        MOVB RL4,vb
        CMPB RL4,DPP0:c_vb_min_obd1
        JMPR cc_C,L_A4F56
        MOVB RL5,v_igk
        CMPB RL5,DPP0:c_vb_min_obd1
        JMPR cc_C,L_A4F56
        CMPB RL4,DPP0:c_vb_max_diag
        JMPR cc_UGT,L_A4F56
        CMPB RL5,DPP0:c_vb_max_diag
        JMPR cc_ULE,L_A4F5A
L_A4F56:                 ; 0xa4f56
        BCLR can_fd58.0BH
        JMPR cc_UC,L_A4F5C
L_A4F5A:                 ; 0xa4f5a
        BSET can_fd58.0BH
L_A4F5C:                 ; 0xa4f5c
        MOVB RL4,vb
        CMPB RL4,DPP0:c_vb_min_obd2
        JMPR cc_C,L_A4F7C
        MOVB RL5,v_igk
        CMPB RL5,DPP0:c_vb_min_obd2
        JMPR cc_C,L_A4F7C
        CMPB RL4,DPP0:c_vb_max_diag
        ; ------------------------------------------------------------
        ; (unclassified) RAM/paged global @0xa4f74 [dpp]  W:{-}  R:{-}
        ; ------------------------------------------------------------
        JMPR cc_UGT,L_A4F7C
        CMPB RL5,DPP0:c_vb_max_diag
        JMPR cc_ULE,L_A4F80
L_A4F7C:                 ; 0xa4f7c
        BCLR can_fd58.0CH
        JMPR cc_UC,L_A4FA2
L_A4F80:                 ; 0xa4f80
        BSET can_fd58.0CH
        JMPR cc_UC,L_A4FA2
L_A4F84:                 ; 0xa4f84
        MOVB RL4,vb
        CMPB RL4,#DATA16 00009H
        JMPR cc_C,L_A4F98
        MOVB RL5,v_igk
        CMPB RL5,#DATA16 00009H
        JMPR cc_NC,L_A4F9E
L_A4F98:                 ; 0xa4f98
        BCLR can_fd58.0BH
        BCLR can_fd58.0CH
        JMPR cc_UC,L_A4FA2
L_A4F9E:                 ; 0xa4f9e
        BSET can_fd58.0BH
        BSET can_fd58.0CH
L_A4FA2:                 ; 0xa4fa2
        JB can_fd58.09H,L_A4FAC
        BSET can_fd58.09H
        CALLS SEG SMARTRA_Phase_Sync, SOF SMARTRA_Phase_Sync
L_A4FAC:                 ; 0xa4fac
        CALLS SEG vb_sub, SOF vb_sub
L_A4FB0:                 ; 0xa4fb0
        MOVB RL4,bl_prog_session_state
        CMPB RL4,#05H
        JMPA cc_UGT,L_A520A
        MOVBZ R4,RL4
        SHL R4,#01H
        ADD R4,#DATA16 0634CH
        MOV R4,[R4]
        JMPI cc_UC,[R4]
        ; ------------------------------------------------------------
        ; (unclassified) RAM/paged global @0xa4fc6 [dpp]  W:{-}  R:{-}
        ; ------------------------------------------------------------
L_A4FC6:                 ; 0xa4fc6  (pointer target)
        CALLS SEG Nop_e5d34, SOF Nop_e5d34
        JB can_fd58.09H,L_A4FE4
        CALLS SEG EngInj_DisableOutputs, SOF EngInj_DisableOutputs
        CALLS SEG EngIgn_DisableOutputs, SOF EngIgn_DisableOutputs
        CALLS SEG c_t_max_ecu_sub, SOF c_t_max_ecu_sub
        MOVB RL4,#04H
        MOVB bl_prog_session_state,RL4
        JMPA cc_UC,L_A5220
L_A4FE4:                 ; 0xa4fe4
        MOVB RL4,lv_sched_diag_inh
        JMPA cc_NE,L_A5220
        CALLS SEG EngInj_DisableOutputs, SOF EngInj_DisableOutputs
        CALLS SEG EngIgn_DisableOutputs, SOF EngIgn_DisableOutputs
