; asw/sys/sys_spin.a66
; Halt stub (endless loop).
; 0xA040C-0xA04C2  (182 bytes, 1 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  SpinHalt_a040c
EXTERN  BL_Exit_ProgSession:NEAR, BL_Set_Mode_Status:NEAR, CC26INT_Imob_Reset:NEAR, CCP_Main_Task:NEAR
EXTERN  FuelPump_Out_Init:NEAR, KWP_CommObj_SetPending:NEAR, KWP_Session_Setup:NEAR, KWP_Svc_Permission_Gate:NEAR
EXTERN  L_A58FA:NEAR, L_A5990:NEAR, L_A5A5A:NEAR, L_AFFFE:NEAR
EXTERN  L_DEC96:NEAR, Nop_dec94:NEAR, Nop_dfc02:NEAR, Nop_dfc04:NEAR
EXTERN  Normalize_S32:NEAR, Reset_ADCIC_4da:NEAR, Set_lv_err_com_resp_imob:NEAR

S_A040C SECTION CODE AT 0A040CH

; ======== SpinHalt_a040c  (@0xa040c) ========
SpinHalt_a040c:
        JMPS SEG SpinHalt_a040c, SOF SpinHalt_a040c

        ; far pointers to service and helper routines (KWP permission gate, session setup,
        ; NVM/CRC helpers called through Push_To_System_Stack, ...)
        DW      SOF KWP_Svc_Permission_Gate, SEG KWP_Svc_Permission_Gate          ; 0xA0410
        DW      SOF KWP_Session_Setup, SEG KWP_Session_Setup          ; 0xA0414
        DW      SOF Normalize_S32, SEG Normalize_S32          ; 0xA0418
        DW      SOF KWP_CommObj_SetPending, SEG KWP_CommObj_SetPending          ; 0xA041C
        DW      SOF Nop_dfc02, SEG Nop_dfc02          ; 0xA0420
        DW      SOF Nop_dfc04, SEG Nop_dfc04          ; 0xA0424
        DB      0BEH,0A4H,008H,000H,0CCH,0A7H,008H,000H
        DB      0C0H,0A6H,008H,000H,098H,0A5H,008H,000H,04AH,0A8H,008H,000H,0F6H,0A4H,008H,000H
        DW      SOF BL_Exit_ProgSession, SEG BL_Exit_ProgSession          ; 0xA0440
        DB      0FAH,028H,028H,000H,00AH,029H,028H,000H
        ; KWP BL ReadEcuId descriptor-table pointer 0
        DB      0B6H,01BH
        ; KWP BL ReadEcuId descriptor-table pointer 1
        DB      00AH,000H
        DB      0DAH,01BH,00AH,000H,0FEH,0FDH,0DEH,0E7H,0FEH,0D7H
        DW      SOF CCP_Main_Task, SEG CCP_Main_Task          ; 0xA045A
        DW      SOF BL_Exit_ProgSession, SEG BL_Exit_ProgSession          ; 0xA045E
        DW      SOF Nop_dec94, SEG Nop_dec94          ; 0xA0462
        DW      SOF L_DEC96, SEG L_DEC96          ; 0xA0466
        DW      SOF Reset_ADCIC_4da, SEG Reset_ADCIC_4da          ; 0xA046A
        DW      SOF Set_lv_err_com_resp_imob, SEG Set_lv_err_com_resp_imob          ; 0xA046E
        DW      SOF BL_Set_Mode_Status, SEG BL_Set_Mode_Status          ; 0xA0472
        DW      SOF CC26INT_Imob_Reset, SEG CC26INT_Imob_Reset          ; 0xA0476
        DW      SOF FuelPump_Out_Init, SEG FuelPump_Out_Init          ; 0xA047A
        DW      SOF L_A5990, SEG L_A5990          ; 0xA047E
        DW      SOF L_A58FA, SEG L_A58FA          ; 0xA0482
        DW      SOF L_A5A5A, SEG L_A5A5A          ; 0xA0486
        DW      SOF L_AFFFE, SEG L_AFFFE          ; 0xA048A
        DW      SOF L_AFFFE, SEG L_AFFFE          ; 0xA048E
        DW      SOF L_AFFFE, SEG L_AFFFE          ; 0xA0492
        DB      052H,000H,00AH,000H,068H,000H,00AH,000H,0FFH,0FFH
        DB      0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
        DB      0FFH,0FFH,000H,000H,009H,000H,04CH,000H,009H,000H,00CH,000H,009H,000H,010H,000H
        DB      009H,000H

S_A040C ENDS
        END
