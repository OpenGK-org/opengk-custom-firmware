; ======== CC15INT_handler  (@0xa832c) ========
CC15INT_handler:
        SCXT CP,#DATA16 0FBEAH
        NOP
        MOV R10,#DATA16 0FAB4H
        MOV DSTP7_FCFE,R10
        MOV R10,#DATA16 0FAD4H
        MOV g_fab0,[R10]
        ADD R10,#02H
        MOV g_fab2,[R10]
        MOV PECC7,#DATA16 00212H
        POP CP
        RETI

; ======== Get_Status_Marker_a8350  (@0xa8350) ========
        ; ------------------------------------------------------------
        ; Seg-A helper (verified): Return status marker word (0x7370 / 0x7a3a) per DAT_00f5d1.
        ; ------------------------------------------------------------
Get_Status_Marker_a8350:
        SCXT CP,#DATA16 0FBEAH
        CMPB ZEROS,crank_tim_6
        JMPR cc_EQ,L_A8360
        MOV R4,#SOF L_A7A3A
        JMPR cc_UC,L_A8364
L_A8360:                 ; 0xa8360
        MOV R4,#SOF L_A7370
L_A8364:                 ; 0xa8364
        POP CP
        RETI

