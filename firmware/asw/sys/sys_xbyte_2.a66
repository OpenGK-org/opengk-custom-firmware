; asw/sys/sys_xbyte_2.a66
; Runtime: 3D word-table read, byte X / byte Y axes, 32-bit table pointer.
; 0xFFE5A-0xFFECA  (112 bytes, 1 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Get_Word_3D_Table_DWord_XByte_YByte

S_FFE5A SECTION CODE AT 0FFE5AH

; ======== Get_Word_3D_Table_DWord_XByte_YByte  (@0xffe5a) ========
Get_Word_3D_Table_DWord_XByte_YByte:
        MOV R10,[R12]
        MOV R2,[R12+#04H]
        MOV R3,[R12+#08H]
        MOV R5,[R12+#06H]
        MOV R11,[R12+#0AH]
        MOV R12,[R12+#02H]
        MOV DPP0_FE00,R11
        NOP
        MOVB RL4,[R3]
        MOVBZ R15,RL4
        MOV DPP0_FE00,R5
        MOV R4,R13
        MOVB RL1,[R2]
        MOVBZ R1,RL1
        ADD R1,R2
        ADD R2,#01H
        CMPB RL4,[R1]
        JMPR cc_NC,L_FFE96
        CMPB RL4,[R2]
        JMPR cc_ULE,L_FFEA0
L_FFE90:                 ; 0xffe90
        SUB R1,#01H
        CMPB RL4,[R1]
        JMPR cc_C,L_FFE90
L_FFE96:                 ; 0xffe96
        SUB R1,R2
        SHL R1,#01H
        MULU R1,R15
        ADD R10,0FE0EH
L_FFEA0:                 ; 0xffea0
        MOV DPP0_FE00,R11
        MOV R4,R14
        MOV R1,R15
        ADD R1,R3
        ADD R3,#01H
        CMPB RL4,[R1]
        JMPR cc_NC,L_FFEBA
        CMPB RL4,[R3]
        JMPR cc_ULE,L_FFEC0
L_FFEB4:                 ; 0xffeb4
        SUB R1,#01H
        CMPB RL4,[R1]
        JMPR cc_C,L_FFEB4
L_FFEBA:                 ; 0xffeba
        SUB R1,R3
        SHL R1,#01H
        ADD R10,R1
L_FFEC0:                 ; 0xffec0
        EXTP R12, #01H
        MOV R4,[R10]
        MOV DPP0,#DATA16 00024H
        RETS

S_FFE5A ENDS
        END
