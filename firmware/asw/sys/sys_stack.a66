; asw/sys/sys_stack.a66
; Lambda / canister-purge variant coding, roughness ignition-difference diagnosis and system
; stack push.
; 0xCFDC8-0xD0000  (568 bytes, 4 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_clr_ad_all                         EQU  090139H
c_clr_ad_ch                          EQU  09013AH
c_clr_ad_cps                         EQU  09013BH
c_clr_ad_isa                         EQU  09013CH
c_clr_ad_ivvt                        EQU  09013DH
c_clr_ad_knk                         EQU  09013EH
c_clr_ad_lam                         EQU  09013FH
c_clr_ad_maf                         EQU  090140H
c_clr_ad_mis                         EQU  090141H
c_clr_ad_tco_stop                    EQU  090142H
c_clr_ad_toil_stop                   EQU  090143H
c_clr_ad_tps                         EQU  090144H
c_clr_fmy                            EQU  090145H
c_conf_cp                            EQU  09014BH
c_conf_lam                           EQU  090151H

PUBLIC  Calc_Conf_CP, Calc_Conf_Lam, Diag_IGA_Dif_Max_ER, Push_To_System_Stack
EXTERN  BL_Set_ExecMagic_NVM:NEAR, CCP_Arm_BL_Exec:NEAR, Calc_Cam_Ref_Edges:NEAR, Calc_ER_Thd_Adapt:NEAR
EXTERN  Calc_TPS_AD_MMV_IS:NEAR, FuelPump_Out_Init:NEAR, Init_IGA_Knk_Adapt:NEAR, OBD_Readiness_Grp4:NEAR
EXTERN  Reset_Adaptive_LearnedValues:NEAR, Reset_CC10IC_514:NEAR, Reset_CC26IC_f1a:NEAR, Reset_TQ_Dif_IS_Ad:NEAR
EXTERN  Reset_cppwm_ad_mem_ee0:NEAR, Reset_ctr_cold_st_b96:NEAR, Reset_iga_er_ad_mem_142:NEAR, Set_lv_err_com_resp_imob:NEAR
EXTERN  Set_maf_fac_alti_mmv_7a6:NEAR, Tail_f0c400c_918:NEAR

S_CFDC8 SECTION CODE AT 0CFDC8H

; ======== Calc_Conf_Lam  (@0xcfdc8) ========
Calc_Conf_Lam:
        MOVB RL4,DPP0:c_conf_lam
        JMPR cc_EQ,L_CFDD8
        CMPB RL4,#01H
        JMPR cc_EQ,L_CFDE0
        CMPB RL4,#02H
        JMPR cc_EQ,L_CFDEA
        JMPR cc_UC,L_CFDF4
L_CFDD8:                 ; 0xcfdd8
        BCLR lv_conf_mis.00H
        MOVB conf_lam,ZEROS
        RETS
L_CFDE0:                 ; 0xcfde0
        BSET lv_conf_mis.00H
        MOVB RL4,#01H
        MOVB conf_lam,RL4
        RETS
L_CFDEA:                 ; 0xcfdea
        BSET lv_conf_mis.00H
        MOVB RL4,#01H
        MOVB conf_lam,RL4
        RETS
L_CFDF4:                 ; 0xcfdf4
        BCLR lv_conf_mis.00H
        MOVB conf_lam,ZEROS
        RETS

; ======== Calc_Conf_CP  (@0xcfdfc) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Variant and Version Coding (conf_cp vs conf_lam)
        ; ------------------------------------------------------------
Calc_Conf_CP:
        MOVB RL4,DPP0:c_conf_cp
        CMPB RL4,#01H
        JMPR cc_EQ,L_CFE0E
        CMPB RL4,#02H
        JMPR cc_EQ,L_CFE16
        CMPB RL4,#03H
        JMPR cc_EQ,L_CFE2C
        JMPR cc_UC,L_CFE54
L_CFE0E:                 ; 0xcfe0e
        MOVB RL4,#01H
        MOVB conf_cp,RL4
        RETS
L_CFE16:                 ; 0xcfe16
        MOVB RL4,conf_lam
        JMPR cc_NE,L_CFE24
        MOVB RL5,#01H
        MOVB conf_cp,RL5
        RETS
L_CFE24:                 ; 0xcfe24
        MOVB RL4,#02H
        MOVB conf_cp,RL4
        RETS
L_CFE2C:                 ; 0xcfe2c
        MOVB RL4,conf_lam
        CMPB RL4,#02H
        JMPR cc_NE,L_CFE3C
        MOVB RL5,#03H
        MOVB conf_cp,RL5
        RETS
L_CFE3C:                 ; 0xcfe3c
        MOVB RL4,conf_lam
        CMPB RL4,#01H
        JMPR cc_NE,L_CFE4C
        MOVB RL5,#02H
        MOVB conf_cp,RL5
        RETS
L_CFE4C:                 ; 0xcfe4c
        MOVB RL4,#01H
        MOVB conf_cp,RL4
        RETS
L_CFE54:                 ; 0xcfe54
        MOVB conf_cp,ZEROS
        RETS

; ======== Diag_IGA_Dif_Max_ER  (@0xcfe5a) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by er_ad/mis/diag output signals + DTC): Roughness ignition-diff max limit
        ; diagnosis: lv_iga_dif_max_er.
        ; ------------------------------------------------------------
Diag_IGA_Dif_Max_ER:
        MOV [-R0],R9
        BSET lv_iga_dif_max_er.06H
        MOVB RL4,pwl_dly_ctr
        JMPR cc_EQ,L_CFE6E
        MOVB RL5,imob_ca2a
        CMPB RL5,#01H
        JMPA cc_NE,L_CFFF0
L_CFE6E:                 ; 0xcfe6e
        CALLS SEG OBD_Readiness_Grp4, SOF OBD_Readiness_Grp4
        MOVB RL4,DPP0:c_clr_fmy
        CMPB RL4,#01H
        JMPR cc_NE,L_CFE7E
        CALLS SEG Reset_Adaptive_LearnedValues, SOF Reset_Adaptive_LearnedValues
L_CFE7E:                 ; 0xcfe7e
        MOVB RL4,DPP0:c_clr_ad_maf
        JMPR cc_NE,L_CFE8A
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFE92
L_CFE8A:                 ; 0xcfe8a
        CALLS SEG Tail_f0c400c_918, SOF Tail_f0c400c_918
        CALLS SEG Set_maf_fac_alti_mmv_7a6, SOF Set_maf_fac_alti_mmv_7a6
L_CFE92:                 ; 0xcfe92
        MOVB RL4,DPP0:c_clr_ad_knk
        JMPR cc_NE,L_CFE9E
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFEA2
L_CFE9E:                 ; 0xcfe9e
        CALLS SEG Init_IGA_Knk_Adapt, SOF Init_IGA_Knk_Adapt
L_CFEA2:                 ; 0xcfea2
        MOVB RL4,DPP0:c_clr_ad_tps
        JMPR cc_NE,L_CFEAE
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFEB2
L_CFEAE:                 ; 0xcfeae
        CALLS SEG Calc_TPS_AD_MMV_IS, SOF Calc_TPS_AD_MMV_IS
L_CFEB2:                 ; 0xcfeb2
        MOVB RL4,DPP0:c_clr_ad_isa
        JMPR cc_NE,L_CFEBE
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFEC2
L_CFEBE:                 ; 0xcfebe
        CALLS SEG Reset_TQ_Dif_IS_Ad, SOF Reset_TQ_Dif_IS_Ad
L_CFEC2:                 ; 0xcfec2
        MOVB RL4,DPP0:c_clr_ad_lam
        JMPR cc_NE,L_CFECE
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFED2
L_CFECE:                 ; 0xcfece
        CALLS SEG Reset_ctr_cold_st_b96, SOF Reset_ctr_cold_st_b96
L_CFED2:                 ; 0xcfed2
        MOVB RL4,DPP0:c_clr_ad_ivvt
        JMPR cc_NE,L_CFEDE
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFEE2
L_CFEDE:                 ; 0xcfede
        CALLS SEG Calc_Cam_Ref_Edges, SOF Calc_Cam_Ref_Edges
L_CFEE2:                 ; 0xcfee2
        MOVB RL4,DPP0:c_clr_ad_mis
        JMPR cc_NE,L_CFEEE
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFEF6
L_CFEEE:                 ; 0xcfeee
        JNB lv_conf_mis.02H,L_CFEF6
        CALLS SEG Calc_ER_Thd_Adapt, SOF Calc_ER_Thd_Adapt
L_CFEF6:                 ; 0xcfef6
        MOVB RL4,DPP0:c_clr_ad_ch
        JMPR cc_NE,L_CFF02
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFF06
L_CFF02:                 ; 0xcff02
        CALLS SEG Reset_iga_er_ad_mem_142, SOF Reset_iga_er_ad_mem_142
L_CFF06:                 ; 0xcff06
        MOVB RL4,DPP0:c_clr_ad_cps
        JMPR cc_NE,L_CFF12
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFF16
L_CFF12:                 ; 0xcff12
        CALLS SEG Reset_cppwm_ad_mem_ee0, SOF Reset_cppwm_ad_mem_ee0
L_CFF16:                 ; 0xcff16
        MOVB RL4,DPP0:c_clr_ad_knk
        JMPR cc_NE,L_CFF22
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFF2A
L_CFF22:                 ; 0xcff22
        MOV R4,#DATA16 08000H
        MOV ratio_tqi_bas_max_stnd_2,R4
L_CFF2A:                 ; 0xcff2a
        MOVB RL4,DPP0:c_clr_ad_tco_stop
        JMPR cc_NE,L_CFF36
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFF3A
L_CFF36:                 ; 0xcff36
        MOVB tco_stop,ZEROS
L_CFF3A:                 ; 0xcff3a
        MOVB RL4,DPP0:c_clr_ad_toil_stop
        JMPR cc_NE,L_CFF46
        MOVB RL5,DPP0:c_clr_ad_all
        JMPR cc_EQ,L_CFF4A
L_CFF46:                 ; 0xcff46
        MOVB toil_stop,ZEROS
L_CFF4A:                 ; 0xcff4a
        CALLS SEG FuelPump_Out_Init, SOF FuelPump_Out_Init
        CALLS SEG Reset_CC10IC_514, SOF Reset_CC10IC_514
        BCLR can_fd9e.06H
        JB state_out_req.00H,L_CFF5A
        BSET P6.06H
L_CFF5A:                 ; 0xcff5a
        MOVB RL4,lv_sched_diag_inh
        ANDB RL4,#01H
        JMPR cc_NE,L_CFF72
        MOV R12,#DATA16 0005CH
        MOV R13,#DATA16 00028H
        MOV R14,#DATA16 053ACH
        CALLS SEG BL_Set_ExecMagic_NVM, SOF BL_Set_ExecMagic_NVM
L_CFF72:                 ; 0xcff72
        CALLS SEG CCP_Arm_BL_Exec, SOF CCP_Arm_BL_Exec
        BSET PSW.0BH
        CALLS SEG Set_lv_err_com_resp_imob, SOF Set_lv_err_com_resp_imob
        CALLS SEG Reset_CC26IC_f1a, SOF Reset_CC26IC_f1a
        BSET lv_iga_fd92.06H
        BSET lv_iga_fd06.06H
        ATOMIC #03H
        MOV R4,lv_iga_fd06
        EXTP #02H, #01H
        MOV DPP0:g_a000,R4
        MOV R9,T1_FE52
        JMPR cc_UC,L_CFFA0
L_CFF98:                 ; 0xcff98
        MOV WDTCON,#DATA16 0EA01H
        SRVWDT
L_CFFA0:                 ; 0xcffa0
        MOV R4,T1_FE52
        SUB R4,R9
        CMP R4,#DATA16 0249FH
        JMPR cc_ULE,L_CFF98
        BCLR lv_iga_fd92.06H
        BCLR lv_iga_fd06.06H
        ATOMIC #03H
        MOV R4,lv_iga_fd06
        EXTP #02H, #01H
        MOV DPP0:g_a000,R4
        BCLR can_fd9e.0DH
        BCLR P4.05H
        MOV R9,T1_FE52
        JMPR cc_UC,L_CFFD0
L_CFFC8:                 ; 0xcffc8
        MOV WDTCON,#DATA16 0EA01H
        SRVWDT
L_CFFD0:                 ; 0xcffd0
        MOV R4,T1_FE52
        SUB R4,R9
        CMP R4,#DATA16 00753H
        JMPR cc_ULE,L_CFFC8
        JMPR cc_UC,L_CFFE6
L_CFFDE:                 ; 0xcffde
        MOV WDTCON,#DATA16 0EA01H
        SRVWDT
L_CFFE6:                 ; 0xcffe6
        JB can_fd58.0EH,L_CFFDE
        SRST
        JMPR cc_UC,L_CFFF6
L_CFFF0:                 ; 0xcfff0
        MOV R4,#01H
        MOV sw_timer_c,R4
L_CFFF6:                 ; 0xcfff6
        MOV R9,[R0+]
        RETS

; ======== Push_To_System_Stack  (@0xcfffa) ========
Push_To_System_Stack:
        PUSH R5
        PUSH R4
        RETS

S_CFDC8 ENDS
        END
