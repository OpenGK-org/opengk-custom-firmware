; ======== Calc_ER_Adapt_Mem  (@0xbbfc2) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by er_ad/mis/diag output signals + DTC): Roughness adaptation memory update:
        ; iga_er_ad_mem / lamb_er_ad_mem (per-op-point learned smoothness).
        ; ------------------------------------------------------------
Calc_ER_Adapt_Mem:
        CALLS 00BH,Calc_ER_Adapt_Precond
        BMOV lv_carb_err.0BH,PSW.06H
        CALLS 00BH,Check_ER_Adapt_State
        BMOV lv_carb_err.0CH,PSW.06H
        MOVB RL4,iga_er_ad_clc
        MOVB iga_er_ad_mem,RL4
        MOV R4,lamb_er_ad_clc
        MOV lamb_er_ad_mem,R4
        JB lv_carb_err.0CH,L_BBFEC
        BCLR lv_carb_err.0DH
        BCLR lv_carb_err.0EH
        BCLR lv_carb_err.0BH
L_BBFEC:                 ; 0xbbfec
        JB lv_carb_err.0CH,L_BBFFC
        JB lv_carb_err.0DH,L_BBFFC
        JB lv_carb_err.0EH,L_BBFFC
        MOV g_f96c,ZEROS
L_BBFFC:                 ; 0xbbffc
        RETS

; ======== Calc_ER_Adapt_State  (@0xbbffe) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by er_ad/mis/diag output signals + DTC): Engine-roughness (misfire-threshold)
        ; adaptation state machine: er_ad_state/_lst drives iga_er_ad_mem / lamb_er_ad_mem learning.
        ; ------------------------------------------------------------
Calc_ER_Adapt_State:
        MOV R4,#01H
        MOV g_f96c,R4
        MOVB RL4,er_ad_state
        MOVB er_ad_state_lst,RL4
        BSET lv_carb_err.0CH
        CALLS 00BH,Calc_ER_Adapt_Precond
        BMOV lv_carb_err.0BH,PSW.06H
        JB lv_lam_fd2c.0FH,L_BC02C
        JB lv_ch.04H,L_BC02C
        JB lv_carb_err.0BH,L_BC02C
        MOVB er_ad_state,ZEROS
        BCLR lv_carb_err.0DH
        BCLR lv_carb_err.0EH
        JMPR cc_UC,L_BC06A
L_BC02C:                 ; 0xbc02c
        JB lv_lam_fd2c.0FH,L_BC044
        JB lv_ch.04H,L_BC044
        JNB lv_carb_err.0BH,L_BC044
        MOVB RL4,#03H
        MOVB er_ad_state,RL4
        BCLR lv_carb_err.0DH
        BSET lv_carb_err.0EH
        JMPR cc_UC,L_BC06A
L_BC044:                 ; 0xbc044
        JNB lv_lam_fd2c.0FH,L_BC058
        JB lv_ch.04H,L_BC058
        MOVB RL4,#01H
        MOVB er_ad_state,RL4
        BSET lv_carb_err.0DH
        BCLR lv_carb_err.0EH
        JMPR cc_UC,L_BC06A
L_BC058:                 ; 0xbc058
        JNB lv_lam_fd2c.0FH,L_BC06A
        JNB lv_ch.04H,L_BC06A
        MOVB RL4,#02H
        MOVB er_ad_state,RL4
        BSET lv_carb_err.0DH
        BSET lv_carb_err.0EH
L_BC06A:                 ; 0xbc06a
        MOVB RL4,er_ad_state_lst
        CMPB RL4,er_ad_state
        JMPR cc_EQ,L_BC07C
        MOVB iga_er_ad_mem,ZEROS
        MOV lamb_er_ad_mem,ZEROS
L_BC07C:                 ; 0xbc07c
        RETS

