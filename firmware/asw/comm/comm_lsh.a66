; asw/comm/comm_lsh.a66
; Rear O2 heater OBD temperature diagnosis and its rate-based monitor; catalyst-diagnosis
; enable conditions.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_pwm_max_lsh_down_obd2              EQU  0902E3H
c_pwm_min_lsh_down_obd2              EQU  0902E5H
c_t_dly_lsh_down_obd2                EQU  090326H
c_tco_min_cat                        EQU  090383H
c_temp_cat_min_ls_down_diag          EQU  0903A9H
c_vb_max_lsh_down_obd2               EQU  09040AH
c_vb_min_lsh_down_obd2               EQU  090414H
c_vs_max_cat                         EQU  09042DH
c_vs_min_cat                         EQU  090436H
c_egy_min_lsh_down_obd2              EQU  090538H
c_frc_stc_lsh_down_obd2              EQU  09055CH
c_r_thd_lsh_down_obd2                EQU  09068AH
c_tcc_stc_lsh_down_obd2              EQU  090754H
c_temp_min_lsh_down_obd2             EQU  09077CH
c_temp_set_lsh_down_obd2             EQU  090780H
ldp_maf_kgh__fac_maf_lsh_down                EQU  09134EH
ip_fac_maf_lsh_down                  EQU  095675H

PUBLIC  Calc_LSH_Down_OBD2_Temp, Calc_RBM_LSH_Down_OBD2, ClrBits_state_rbm_lsh_down_obd2_0b6, Diag_Cat_Eff_Ena, Reset_state_rbm_lsh_down_obd2_0ac, Reset_temp_dif_lsh_down_obd2_08e
EXTERN  Add_r12_r13_Return_r4:NEAR, Diag_DTC_dd274:NEAR, Div_U32_U16_Round32:NEAR, Get_IP_Byte_2D_Table:NEAR
EXTERN  Get_IP_Word_Y_Axis:NEAR, Mul_Frac_U16_Sat:NEAR, sub_r12_r13_rets_r4:NEAR

S_COMM_LSH SECTION CODE

; ======== Diag_Cat_Eff_Ena  (@0xb901e) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (EMS31, verified): Catalyst efficiency diagnosis enable conditions
        ; ------------------------------------------------------------
Diag_Cat_Eff_Ena:
        MOV [-R0],R6
        MOV R12,p_lam_bank1
        JNB diag_fd68.00H,L_B9084
        MOVB RL4,tco
        CMPB RL4,DPP0:c_tco_min_cat
        JMPR cc_ULE,L_B9084
        MOV R4,[R12+#0106H]
        CMP R4,#04H
        JMPR cc_NE,L_B9084
        MOVB RL4,vs
        CMPB RL4,DPP0:c_vs_min_cat
        JMPR cc_C,L_B9084
        CMPB RL4,DPP0:c_vs_max_cat
        JMPR cc_UGT,L_B9084
        MOVB RL5,lv_cat_diag_cond
        CMPB RL5,DPP0:c_temp_cat_min_ls_down_diag
        JMPR cc_ULE,L_B9084
        JB lv_cat_diag_inh_1.06H,L_B905E
        BSET state_cat_diag.07H
        MOVB RL6,#01H
        JMPR cc_UC,L_B9088
L_B905E:                 ; 0xb905e
        JNB can_fd58.0CH,L_B907E
        JB lv_cam_ad_di_ivvt.09H,L_B907E
        MOV R4,#DATA16 0FFF7H
        AND lv_cat_f874,R4
        MOV R4,#DATA16 0FBFFH
        AND g_f872,R4
        MOV R4,#DATA16 0FFFBH
        AND lv_cat_f874,R4
L_B907E:                 ; 0xb907e
        BCLR state_cat_diag.07H
        MOVB RL6,#00H
        JMPR cc_UC,L_B9088
L_B9084:                 ; 0xb9084
        BCLR state_cat_diag.07H
        MOVB RL6,#00H
L_B9088:                 ; 0xb9088
        MOVB RL4,RL6
        MOV R6,[R0+]
        RET

; ======== Reset_temp_dif_lsh_down_obd2_08e  (@0xb908e) ========
Reset_temp_dif_lsh_down_obd2_08e:
        MOV temp_dif_lsh_down_obd2,ZEROS
        MOVB obd_c904,ZEROS
        MOV lam_bank_1_lsh_down_obd2_struct_frc_stc_lsh_down_obd2,ZEROS
        MOV lam_bank_1_lsh_down_obd2_struct_tcc_stc_lsh_down_obd2,ZEROS
        MOV lam_bank_1_lsh_down_obd2_struct_pow_int_lsh_down_obd2,ZEROS
        MOV lam_bank_1_lsh_down_obd2_struct_ctr_cycnr_r_lsh_down_obd2,ZEROS
        MOV lam_bank_1_lsh_down_obd2_struct_state_lsh_down_obd2,ZEROS
        RETS

; ======== Reset_state_rbm_lsh_down_obd2_0ac  (@0xb90ac) ========
Reset_state_rbm_lsh_down_obd2_0ac:
        MOVB state_rbm_lsh_down_obd2,ZEROS
        MOV rate_rbm_lsh_down_obd2,ONES
        RETS

; ======== ClrBits_state_rbm_lsh_down_obd2_0b6  (@0xb90b6) ========
ClrBits_state_rbm_lsh_down_obd2_0b6:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_lsh_down_obd2,RL4
        RETS

; ======== Calc_LSH_Down_OBD2_Temp  (@0xb90c0) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by tam/toil/teg/th output signals): Rear-O2 heater OBD2 temperature-diff
        ; diagnosis: temp_dif_lsh_down_obd2.
        ; ------------------------------------------------------------
Calc_LSH_Down_OBD2_Temp:
        MOV [-R0],R9
        MOV R9,p_lam_bank1
        MOV R4,[R9+#01B6H]
        CMP R4,#07H
        JMPA cc_EQ,L_B928C
        JB can_fd58.09H,L_B90D8
        JMPA cc_UC,L_B926A
L_B90D8:                 ; 0xb90d8
        JNB lv_pl.04H,L_B90E0
        JMPA cc_UC,L_B926A
L_B90E0:                 ; 0xb90e0
        JNB lv_cdn_diag_maf_dif_ch_int.0BH,L_B90E8
        JMPA cc_UC,L_B926A
L_B90E8:                 ; 0xb90e8
        JNB lv_cat_diag_inh_1.0BH,L_B90F0
        JMPA cc_UC,L_B926A
L_B90F0:                 ; 0xb90f0
        JB diag_fd68.00H,L_B90F8
        JMPA cc_UC,L_B9256
L_B90F8:                 ; 0xb90f8
        MOV R4,[R9+#0106H]
        CMP R4,#04H
        JMPA cc_NE,L_B9256
        MOVB RL4,vb
        CMPB RL4,DPP0:c_vb_min_lsh_down_obd2
        JMPA cc_ULE,L_B9256
        CMPB RL4,DPP0:c_vb_max_lsh_down_obd2
        JMPA cc_NC,L_B9256
        MOVB RL5,[R9+#0108H]
        CMPB RL5,DPP0:c_pwm_min_lsh_down_obd2
        JMPA cc_ULE,L_B9256
        MOVB RL5,[R9+#0108H]
        CMPB RL5,DPP0:c_pwm_max_lsh_down_obd2
        JMPA cc_NC,L_B9256
        MOVB RL5,[R9+#01B8H]
        CMPB RL5,DPP0:c_t_dly_lsh_down_obd2
        JMPA cc_C,L_B9242
        JNB lv_cat_diag_inh_1.0AH,L_B9142
        JMPA cc_UC,L_B9222
L_B9142:                 ; 0xb9142
        MOV R4,temp_cat_word
        CMP R4,DPP0:c_temp_min_lsh_down_obd2
        JMPR cc_UGT,L_B9214
        MOV R4,[R9+#01AEH]
        CMP R4,DPP0:c_egy_min_lsh_down_obd2
        JMPR cc_C,L_B91C4
        MOV R4,[R9+#0E6H]
        MOV R5,[R9+#01ACH]
        CMP R4,R5
        JMPR cc_EQ,L_B91C4
        MOV R4,#06H
        MOV [R9+#01B6H],R4
        MOV R4,[R9+#0E6H]
        MOV [R9+#01ACH],R4
        MOV R4,[R9+#01B0H]
        CMP R4,#DATA16 003FFH
        JMPR cc_NC,L_B9186
        MOV R4,R9
        ADD R4,#DATA16 001B0H
        MOV R5,[R4]
        ADD R5,#01H
        MOV [R4],R5
L_B9186:                 ; 0xb9186
        MOV R4,[R9+#0E8H]
        CMP R4,DPP0:c_r_thd_lsh_down_obd2
        JMPR cc_C,L_B91A6
        MOV R4,[R9+#01B2H]
        CMP R4,#DATA16 003FFH
        JMPR cc_NC,L_B91A6
        MOV R4,R9
        ADD R4,#DATA16 001B2H
        MOV R5,[R4]
        ADD R5,#01H
        MOV [R4],R5
L_B91A6:                 ; 0xb91a6
        MOV R4,[R9+#01B0H]
        CMP R4,DPP0:c_tcc_stc_lsh_down_obd2
        JMPR cc_C,L_B928C
        MOV R4,#07H
        MOV [R9+#01B6H],R4
        MOV R4,[R9+#01B2H]
        CMP R4,DPP0:c_frc_stc_lsh_down_obd2
        JMPR cc_ULE,L_B927E
        BSET lv_err_pres_mwss.02H
        JMPR cc_UC,L_B9280
L_B91C4:                 ; 0xb91c4
        MOV R4,#05H
        MOV [R9+#01B6H],R4
        MOV R12,DPP0:c_temp_set_lsh_down_obd2
        MOV R13,temp_cat_word
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        SHR R4,#06H
        MOV temp_dif_lsh_down_obd2,R4
        MOV R12,#DATA16 POF ldp_maf_kgh__fac_maf_lsh_down
        MOV R13,#DATA16 PAG ldp_maf_kgh__fac_maf_lsh_down
        MOV R14,maf_kgh
        CALLS SEG Get_IP_Word_Y_Axis, SOF Get_IP_Word_Y_Axis
        MOV R12,#DATA16 POF ip_fac_maf_lsh_down
        MOV R13,#DATA16 PAG ip_fac_maf_lsh_down
        CALLS SEG Get_IP_Byte_2D_Table, SOF Get_IP_Byte_2D_Table
        MOVBZ R13,RL4
        SHL R13,#04H
        MOV R12,temp_dif_lsh_down_obd2
        CALLS SEG Mul_Frac_U16_Sat, SOF Mul_Frac_U16_Sat
        MOV R13,R4
        MOV R12,[R9+#01AEH]
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV [R9+#01AEH],R4
        JMPR cc_UC,L_B928C
L_B9214:                 ; 0xb9214
        MOV R4,#04H
        MOV [R9+#01B6H],R4
        MOV R4,#00H
        MOV [R9+#01AEH],R4
        JMPR cc_UC,L_B928C
L_B9222:                 ; 0xb9222
        MOV R4,#03H
        MOV [R9+#01B6H],R4
        MOVB RL4,#00H
        MOVB [R9+#01B8H],RL4
        MOV R4,#00H
        MOV [R9+#01AEH],R4
        JB lv_cam_ad_di_ivvt.09H,L_B928C
        MOV R4,#DATA16 0BFFFH
        AND g_f872,R4
        JMPR cc_UC,L_B928C
L_B9242:                 ; 0xb9242
        MOV R4,R9
        ADD R4,#DATA16 001B8H
        MOVB RL5,[R4]
        ADDB RL5,#01H
        MOVB [R4],RL5
        MOV R4,#02H
        MOV [R9+#01B6H],R4
        JMPR cc_UC,L_B928C
L_B9256:                 ; 0xb9256
        MOV R4,#01H
        MOV [R9+#01B6H],R4
        MOVB RL4,#00H
        MOVB [R9+#01B8H],RL4
        MOV R4,#00H
        MOV [R9+#01AEH],R4
        JMPR cc_UC,L_B928C
L_B926A:                 ; 0xb926a
        MOV R4,#00H
        MOV [R9+#01B6H],R4
        MOVB RL4,#00H
        MOVB [R9+#01B8H],RL4
        MOV R4,#00H
        MOV [R9+#01AEH],R4
        JMPR cc_UC,L_B928C
L_B927E:                 ; 0xb927e
        BCLR lv_err_pres_mwss.02H
L_B9280:                 ; 0xb9280
        MOV R4,[R9+#01B2H]
        MOV [R9+#01B4H],R4
        CALLS SEG Diag_DTC_dd274, SOF Diag_DTC_dd274
L_B928C:                 ; 0xb928c
        MOV R9,[R0+]
        RETS

; ======== Calc_RBM_LSH_Down_OBD2  (@0xb9290) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for LSH Down
        ; OBD2: updates state_rbm_lsh_down_obd2 / rate_rbm_lsh_down_obd2 (in-use completion ratio =
        ; numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_LSH_Down_OBD2:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV R7,p_lam_bank1
        JNB obd_sf.0DH,L_B9310
        MOVBZ R4,state_rbm_lsh_down_obd2
        AND R4,#01H
        JMPR cc_NE,L_B92B4
        MOV R4,[R7+#01B6H]
        CMP R4,#07H
        JMPR cc_NE,L_B92B4
        MOVB RL4,#01H
        ORB state_rbm_lsh_down_obd2,RL4
L_B92B4:                 ; 0xb92b4
        MOVBZ R4,state_rbm_lsh_down_obd2
        AND R4,#02H
        JMPR cc_NE,L_B92CA
        JB lv_lam_lim_1_err.08H,L_B92C4
        JNB lv_lam_lim_1_err.0CH,L_B92CA
L_B92C4:                 ; 0xb92c4
        MOVB RL4,#02H
        ORB state_rbm_lsh_down_obd2,RL4
L_B92CA:                 ; 0xb92ca
        MOVBZ R4,state_rbm_lsh_down_obd2
        AND R4,#04H
        JMPR cc_NE,L_B92D8
        MOVB RL4,#04H
        ORB state_rbm_lsh_down_obd2,RL4
L_B92D8:                 ; 0xb92d8
        MOV R12,ctr_comp_rbm_lsh_down_obd2
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_lsh_down_obd2
        CALLS SEG Div_U32_U16_Round32, SOF Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_B9302
        CMP R8,#DATA16 0FFFFH
L_B9302:                 ; 0xb9302
        JMPR cc_C,L_B930A
        MOV rate_rbm_lsh_down_obd2,ONES
        JMPR cc_UC,L_B9310
L_B930A:                 ; 0xb930a
        MOV R4,R8
        MOV rate_rbm_lsh_down_obd2,R4
L_B9310:                 ; 0xb9310
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_COMM_LSH ENDS
        END
