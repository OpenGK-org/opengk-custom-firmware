; ======== KWP_P3_Timeout_Check  (@0xdef28) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
KWP_P3_Timeout_Check:
        JNB kwp_comms_flags.08H,L_DEF62
        JB bl_mode_status_flags.05H,L_DEF3C
        MOV R4,DPP1:0A0420H
        MOV R5,DPP1:0A0422H
