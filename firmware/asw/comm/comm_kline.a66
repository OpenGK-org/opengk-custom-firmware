PUBLIC  App_SecAccess_GrantFromFlashFlags, BL_KLine_ProtoInit, KWP_P3_Timeout_Check, KWP_Session_Setup, KWP_Set_CommsFlags, Tail_rt_callfar_via_r5r4_f0e
EXTERN  KWP_Set_Buffer:NEAR, Reset_kwp_req_ptr_c98:NEAR, Reset_kwp_req_ptr_e34:NEAR

S_DEE52 SECTION CODE AT 0DEE52H

