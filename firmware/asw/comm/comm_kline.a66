        JMPR cc_C,L_DEF52
        CALLS SEG KWP_Session_Setup, SOF KWP_Session_Setup
        MOV R4,#DATA16 0FFEEH
        MOV c_p3_max_kwp,R4
L_DEF52:                 ; 0xdef52
        JB bl_mode_status_flags.05H,L_DEF62
        MOV R4,DPP1:0A0424H
        MOV R5,DPP1:0A0426H
        CALLS SEG rt_callfar_via_r5r4, SOF rt_callfar_via_r5r4
L_DEF62:                 ; 0xdef62
        RETS

; ======== KWP_Session_Setup  (@0xdef64) ========
        ; ------------------------------------------------------------
        ; OEM (verified by bl_/kwp_ output signals): KWP diagnostic session setup: kwp_session_state /
        ; kwp_comms_flags / kwp_timing_counter.
        ; ------------------------------------------------------------
KWP_Session_Setup:
        BSET kwp_comms_flags.09H
        MOV kwp_timing_counter,ZEROS
        MOVB RL4,#01H
        MOVB kwp_session_state,RL4
        MOV kwp_comms_flags,ZEROS
        CALLS SEG App_SecAccess_GrantFromFlashFlags, SOF App_SecAccess_GrantFromFlashFlags
        MOVB kwp_session_type_idx,ZEROS
        MOVB kwp_e765,ZEROS
        MOVB RL4,#DATA16 00019H
        MOVB kwp_timing_thr_a,RL4
        MOVB RL4,#DATA16 00037H
        MOVB kwp_timing_thr_b,RL4
        MOV R4,#DATA16 01388H
        MOV kwp_session_p3_timeout,R4
        MOV R4,#DATA16 0E559H
        MOV kwp_req_ptr,R4
        MOV R5,#DATA16 0E559H
        MOV kwp_buf_base,R5
        MOV R2,#DATA16 000FFH
        MOV kwp_buf_limit,R2
        MOV kwp_dyndef_len,ZEROS
        MOV R2,#DATA16 0E65DH
        EXTP #03H, #01H
        MOV DPP0:kwp_e7d4,R2
        MOV R3,#DATA16 0E661H
        EXTP #03H, #01H
        MOV DPP0:kwp_e7d6,R3
        MOVB RL4,#03H
        EXTP #03H, #01H
        MOVB DPP0:bl_addr_size,RL4
        EXTP #00H, #02H
        MOV R4,kwp_21a
        MOV R5,kwp_21c
        CALLS SEG rt_callfar_via_r5r4, SOF rt_callfar_via_r5r4
        CALLS SEG BL_KLine_ProtoInit, SOF BL_KLine_ProtoInit
        CALLS SEG KWP_Set_Buffer, SOF KWP_Set_Buffer
        BCLR kwp_comms_flags.08H
        MOVB kwp_session_state,ZEROS
        RETS

; ======== KWP_Set_CommsFlags  (@0xdeff6) ========
        ; ------------------------------------------------------------
        ; OEM (verified by bl_/kwp_ output signals): Set KWP comms flags kwp_comms_flags.
        ; ------------------------------------------------------------
KWP_Set_CommsFlags:
        BSET kwp_comms_flags.09H
        BSET kwp_comms_flags.08H
        MOVB RL4,kwp_session_state
        JMPR cc_NE,L_DF006
        CALLS SEG Reset_kwp_req_ptr_c98, SOF Reset_kwp_req_ptr_c98
        RETS
L_DF006:                 ; 0xdf006
        MOVBZ R4,kwp_session_state
        AND R4,#04H
        JMPR cc_EQ,L_DF012
        CALLS SEG Reset_kwp_req_ptr_e34, SOF Reset_kwp_req_ptr_e34
L_DF012:                 ; 0xdf012
        MOVBZ R4,kwp_session_state
        AND R4,#02H
        JMPR cc_EQ,L_DF01E
        CALLS SEG Reset_kwp_req_ptr_c98, SOF Reset_kwp_req_ptr_c98
L_DF01E:                 ; 0xdf01e
        RETS

; ======== App_SecAccess_GrantFromFlashFlags  (@0xdf020) ========
App_SecAccess_GrantFromFlashFlags:
        EXTP #00H, #01H
        MOVB RL4,secacc_siemens_autogrant_fuse
        CMPB RL4,#DATA16 000FFH
        JMPR cc_NE,L_DF036
        MOVB RL5,#03H
        MOVB secacc_unlocked_bits,RL5
        JMPR cc_UC,L_DF03C
L_DF036:                 ; 0xdf036
        MOVB RL4,#01H
        MOVB secacc_unlocked_bits,RL4
L_DF03C:                 ; 0xdf03c
        EXTP #00H, #01H
        MOVB RL4,secacc_hyundai_autogrant_fuse
        CMPB RL4,#DATA16 000FFH
        JMPR cc_NE,L_DF050
        MOVB RL5,#04H
