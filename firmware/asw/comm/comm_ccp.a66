; ======== CCP_Init  (@0xa53a0) ========
        ; CCP_Init(): CCP slave init - calls flush helpers (0a5efa, 0a5eaa) then CCP_Reset_State.
CCP_Init:
        CALLS 00AH,CCP_Prog_State
        CALLS 00AH,CCP_DAQ_Security
        CALLS 00AH,CCP_Reset_State
        RETS
        ; ------------------------------------------------------------
        ; (unclassified) RAM/paged global @0xa53ae [dpp]  W:{-}  R:{-}
        ; ------------------------------------------------------------
        MOV R12,#DATA16 0FAF4H
        CALLS 00AH,CCP_Svc_Conn_Security
        RETS

