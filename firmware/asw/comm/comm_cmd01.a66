; asw/comm/comm_cmd01.a66
; KWP flash-reprogramming service dispatcher and command 0x01 (session check).
; 0xCB6CC-0xCB850  (388 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  KWP_Flash_Cmd01_SessionChk, KWP_Flash_Svc_Dispatch, KWP_Init_Resp
EXTERN  KWP_Flash_Svc_Default:NEAR, L_CC708:NEAR

S_CB6CC SECTION CODE AT 0CB6CCH

; ======== KWP_Init_Resp  (@0xcb6cc) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
KWP_Init_Resp:
        MOV R4,ccp_e79e
        AND R4,#DATA16 04000H
        JMPR cc_NE,L_CB6E0
        MOVB RL4,#DATA16 00043H
        MOVB kwp_c368,RL4
        JMPR cc_UC,L_CB6E6
L_CB6E0:                 ; 0xcb6e0
        MOVB RL4,#02H
        MOVB kwp_c368,RL4
L_CB6E6:                 ; 0xcb6e6
        MOVB RL4,kwp_c365
        JMPR cc_EQ,L_CB77A
        MOVB RL5,#04H
        MOVB kwp_c36c,RL5
        MOV R12,#00H
L_CB6F4:                 ; 0xcb6f4
        MOV R4,R12
        SHL R4,#03H
        MOVB RL5,[R4+#0E50CH]
        CMPB RL5,#03H
        JMPR cc_NE,L_CB70A
        MOVB RL4,#01H
        MOV R5,R12
        SHL R5,#03H
        MOVB [R5+#0E50CH],RL4
L_CB70A:                 ; 0xcb70a
        ADD R12,#01H
        CMP R12,#06H
        JMPR cc_C,L_CB6F4
        MOVB RL4,#03H
        MOVB kwp_resp_status,RL4
        MOVB RL5,#DATA16 000FEH
        MOVB kwp_resp_pad,RL5
        MOVB RL3,#DATA16 00020H
        MOVB kwp_nrc_D78B,RL3
        MOVB kwp_resp_cmd_echo,ZEROS
        MOVB RL2,#DATA16 00055H
        MOVB kwp_resp_cnt_hi,RL2
        MOVB kwp_resp_cnt_lo,RL2
        MOVB kwp_resp_addr_hi,RL2
        MOVB kwp_resp_addr_lo,RL2
        MOVB kwp_resp_status2,RL2
        JB kwp_prog_flags.08H,L_CB77A
        MOVB RL1,#DATA16 00026H
        MOVBZ R4,tq_hi_wr
        MOVB [R4+#0F62EH],RL1
        MOVB RL4,tq_hi_wr
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_hi_wr,RL4
        MOVB RL4,tq_hi_wr
        CMPB RL4,tq_hi_rd
        JMPR cc_NE,L_CB77A
        BSET sched_flags.01H
        MOVB RL4,tq_hi_rd
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_hi_rd,RL4
L_CB77A:                 ; 0xcb77a
        BCLR lv_cp_act.03H
        BCLR lv_cp_act.04H
        RETS

; ======== KWP_Flash_Svc_Dispatch  (@0xcb780) ========
        ; ------------------------------------------------------------
        ; KWP-2000 FLASH-REPROGRAMMING service dispatcher. Reads command byte kwp_cmd_id@d780, (cmd-1)
        ; bounds-checked <=0x22, jmpi via KWP_Flash_Svc_jmptab@0xa0fa8 (seg c). Session/security level in
        ; kwp_sec_level@d788 (arms require >=4/>=8); subfn/routine in kwp_subfn@d782; download addr/len
        ; latched to kwp_dl_addr@cf02 / kwp_dl_len@cf06 from params d784-787; negative-response code ->
        ; kwp_nrc@d78b ('1'/'2'/'3'); response status -> kwp_resp_status@d792 (3=neg,5=routine result). Flash
        ; erase/program/checksum run via call_to_RSW_from_prog_zone. Arms KWP_Flash_Cmd01..35.
        ; ------------------------------------------------------------
KWP_Flash_Svc_Dispatch:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        SUB R0,#DATA16 00008H
        MOV R8,#00H
L_CB78E:                 ; 0xcb78e
        MOVB RL4,#DATA16 00055H
        MOVB [R8+#0D78DH],RL4
        ADD R8,#01H
        CMP R8,#05H
        JMPR cc_C,L_CB78E
        MOVB kwp_resp_status,ZEROS
        MOVB kwp_nrc_D78B,ZEROS
        MOVB RL4,kwp_c36b
        JMPR cc_EQ,L_CB7B2
        CMPB RL4,#01H
        JMPR cc_EQ,L_CB80A
        JMPA cc_UC,L_CC708
L_CB7B2:                 ; 0xcb7b2
        MOVBZ R9,kwp_dl_data1
        SHL R9,#08H
        MOVBZ R4,kwp_dl_buf
        OR R9,R4
        MOVB RL4,kwp_cmd_id
        CMPB RL4,#01H
        JMPR cc_EQ,L_CB7CE
        CMPB RL4,#05H
        JMPR cc_EQ,L_CB7E0
        JMPA cc_UC,L_CC708
L_CB7CE:                 ; 0xcb7ce
        MOVB RL4,kwp_sec_level
        CMPB RL4,#04H
        JMPA cc_C,L_CC708
        CMP R9,#01H
        JMPA cc_NE,L_CC708
        JMPR cc_UC,L_CB7FA
L_CB7E0:                 ; 0xcb7e0
        MOVB RL4,kwp_sec_level
        CMPB RL4,#04H
        JMPA cc_C,L_CC708
        CMP R9,#01H
        JMPA cc_NE,L_CC708
        MOVB RL5,#03H
        MOVB kwp_resp_status,RL5
        JMPA cc_UC,L_CC708
L_CB7FA:                 ; 0xcb7fa
        MOVB RL4,#03H
        MOVB kwp_resp_status,RL4
        MOVB RL5,#01H
        MOVB kwp_c36b,RL5
        JMPA cc_UC,L_CC708
L_CB80A:                 ; 0xcb80a
        MOVB RL4,kwp_cmd_id
        SUBB RL4,#01H
        CMPB RL4,#DATA16 00022H
        JMPA cc_UGT,KWP_Flash_Svc_Default
        MOVBZ R4,RL4
        SHL R4,#01H
        ADD R4,#DATA16 04FA8H
        MOV R4,[R4]
        JMPI cc_UC,[R4]

; ======== KWP_Flash_Cmd01_SessionChk  (@0xcb824) ========
        ; ------------------------------------------------------------
        ; KWP flash-service dispatcher arm, command id 0x01 (kwp_cmd_id@d780) via
        ; KWP_Flash_Svc_jmptab@0xa0fa8.
        ; ------------------------------------------------------------
KWP_Flash_Cmd01_SessionChk:
        MOVB RL4,kwp_sec_level
        CMPB RL4,#04H
        JMPA cc_C,L_CC708
        MOVBZ R4,kwp_dl_data1
        SHL R4,#08H
        MOVBZ R5,kwp_dl_buf
        OR R4,R5
        CMP R4,#01H
        JMPR cc_NE,L_CB848
        MOVB RL4,#03H
        MOVB kwp_resp_status,RL4
        JMPA cc_UC,L_CC708
L_CB848:                 ; 0xcb848
        MOVB kwp_c36b,ZEROS
        JMPA cc_UC,L_CC708

S_CB6CC ENDS
        END
