; asw/comm/comm_flash_4.a66
; KWP flash-reprogramming commands 0x0E-0x10.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  KWP_Flash_Cmd14_arm, KWP_Flash_Cmd15_arm, KWP_Flash_Cmd16_arm
EXTERN  Calc_CRC16_Flash:NEAR, CanPurge_SetAct_2:NEAR, L_CC708:NEAR

S_COMM_FLASH_4 SECTION CODE

; ======== KWP_Flash_Cmd14_arm  (@0xcbe36) ========
        ; ------------------------------------------------------------
        ; KWP flash-service dispatcher arm, command id 0x0E (kwp_cmd_id@d780) via
        ; KWP_Flash_Svc_jmptab@0xa0fa8.
        ; ------------------------------------------------------------
KWP_Flash_Cmd14_arm:
        MOVB RL4,kwp_sec_level
        CMPB RL4,#06H
        JMPR cc_C,L_CBED2
        MOVB RL5,kwp_dl_data3
        MOVB [R0+#07H],RL5
        MOVB RL3,kwp_dl_data2
        MOVB [R0+#06H],RL3
        MOVB RL2,kwp_dl_data1
        MOVB [R0+#05H],RL2
        MOVB RL1,kwp_dl_buf
        MOVB [R0+#04H],RL1
        MOV R4,[R0+#04H]
        MOV R5,[R0+#06H]
        SUB R4,#DATA16 00080H
        SUBC R5,#00H
        JMPR cc_UGT,L_CBEC6
        MOV R12,kwp_dl_addr
        MOV R13,kwp_dl_count
        MOV R14,[R0+#04H]
        MOV R15,#00H
        CALLS SEG CanPurge_SetAct_2, SOF CanPurge_SetAct_2
        MOVBZ R4,RL4
        MOVBZ R5,kwp_dl_mask
        AND R5,R4
        JMPR cc_EQ,L_CBEBA
        MOV R12,kwp_dl_addr
        MOV R13,kwp_dl_count
        MOV R14,[R0+#04H]
        CALLS SEG Calc_CRC16_Flash, SOF Calc_CRC16_Flash
        MOV R9,R4
        MOVB RL4,#02H
        MOVB kwp_resp_status2,RL4
        MOV R5,R9
        MOVB kwp_resp_addr_lo,RL5
        MOV R4,R9
        SHR R4,#08H
        MOVB kwp_resp_addr_hi,RL4
        MOVB RL3,#06H
        MOVB kwp_resp_status,RL3
        JMPA cc_UC,L_CC708
L_CBEBA:                 ; 0xcbeba
        MOVB RL4,#DATA16 00033H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708
L_CBEC6:                 ; 0xcbec6
        MOVB RL4,#DATA16 00032H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708
L_CBED2:                 ; 0xcbed2
        MOVB RL4,#DATA16 00031H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708

; ======== KWP_Flash_Cmd15_arm  (@0xcbede) ========
        ; ------------------------------------------------------------
        ; KWP flash-service dispatcher arm, command id 0x0F (kwp_cmd_id@d780) via
        ; KWP_Flash_Svc_jmptab@0xa0fa8.
        ; ------------------------------------------------------------
KWP_Flash_Cmd15_arm:
        MOVB RL4,kwp_sec_level
        CMPB RL4,#DATA16 00008H
        JMPR cc_NE,L_CBF7E
        MOVB RL5,kwp_dl_data5
        MOVB [R0+#03H],RL5
        MOVB RL3,kwp_dl_data4
        MOVB [R0+#02H],RL3
        MOVB RL2,kwp_dl_data3
        MOVB [R0+#01H],RL2
        MOVB [R0],kwp_dl_data2
        MOV R12,[R0]
        MOV R13,[R0+#02H]
        MOVBZ R14,kwp_dl_buf
        MOV R15,#00H
        CALLS SEG CanPurge_SetAct_2, SOF CanPurge_SetAct_2
        MOVBZ R9,RL4
        JMPR cc_EQ,L_CBF20
        MOVBZ R4,kwp_dl_mask
        AND R4,R9
        JMPR cc_EQ,L_CBF72
L_CBF20:                 ; 0xcbf20
        MOVBZ R9,kwp_dl_buf
        MOVB RL4,kwp_dl_data1
        JMPR cc_NE,L_CBF66
        CMP R9,#05H
        JMPR cc_UGT,L_CBF66
        CMP R9,#00H
        JMPR cc_EQ,L_CBF66
        MOV R8,#00H
        JMPR cc_UC,L_CBF56
L_CBF36:                 ; 0xcbf36
        MOV R4,[R0]
        MOV R5,[R0+#02H]
        EXTS R5, #01H
        MOVB RL3,[R4]
        MOVB [R8+#0D78DH],RL3
        MOV R4,[R0]
        MOV R5,[R0+#02H]
        ADD R4,#01H
        ADDC R5,#00H
        MOV [R0],R4
        MOV [R0+#02H],R5
        ADD R8,#01H
L_CBF56:                 ; 0xcbf56
        CMP R8,R9
        JMPR cc_C,L_CBF36
        MOV R4,#03H
        ADD R4,R9
        MOVB kwp_resp_status,RL4
        JMPA cc_UC,L_CC708
L_CBF66:                 ; 0xcbf66
        MOVB RL4,#DATA16 00032H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708
L_CBF72:                 ; 0xcbf72
        MOVB RL4,#DATA16 00033H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708
L_CBF7E:                 ; 0xcbf7e
        MOVB RL4,#DATA16 00031H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708

; ======== KWP_Flash_Cmd16_arm  (@0xcbf8a) ========
        ; ------------------------------------------------------------
        ; KWP flash-service dispatcher arm, command id 0x10 (kwp_cmd_id@d780) via
        ; KWP_Flash_Svc_jmptab@0xa0fa8.
        ; ------------------------------------------------------------
KWP_Flash_Cmd16_arm:
        MOVB RL4,#DATA16 00036H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708

S_COMM_FLASH_4 ENDS
        END
