        ADD R0,#03H
        MOVB [R1],[R0+]
        ADD R1,#01H
        MOV [R1],[R0+]
        ADD R1,#02H
        MOV [R1],[R0+]
        ADD R1,#02H
        MOV [R1],[R0+]
        ADD R1,#02H
        MOVB [R1],[R0+]
