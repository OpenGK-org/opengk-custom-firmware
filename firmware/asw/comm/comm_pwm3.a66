; ======== Ctl_PWM3_Output  (@0xac034) ========
        ; ------------------------------------------------------------
        ; Seg-A ISR helper (verified by SFR/CCP usage): PWM channel-3 output control (PWMCON0/PT3/PP3/PW3)
        ; gated by DAT_00f5f2.
        ; ------------------------------------------------------------
Ctl_PWM3_Output:
        SCXT CP,#DATA16 0FC88H
        NOP
        JNB PWMCON0.0FH,L_AC064
        BCLR PWMCON0.0FH
        MOVBZ R0,ivvt_hpwm_rdy
        JMPR cc_EQ,L_AC064
        BCLR PWMCON0.03H
        MOVBZ R0,ivvt_hpwm_rng
        BMOV PWMCON0.07H,R0.00H
        EXTR #02H
        MOV PW3,0FF1CH
        MOV SFR_FE3E,ivvt_hpwm_div
        MOV PW3,ivvt_hpwm_cmp_hold
        MOVB ivvt_hpwm_rdy,ZEROS
        BSET PWMCON0.03H
L_AC064:                 ; 0xac064
        POP CP
        RETI

