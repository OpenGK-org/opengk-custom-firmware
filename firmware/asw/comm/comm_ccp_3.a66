; ======== CCP_Cmd_Entry  (@0xa5f4a) ========
        ; CCP_Cmd_Entry(channel): CCP command receive entry. channel 0 -> writes cmd 0x2c, channel 1 -> 0x2d
        ; into work buffer ccp_cmd_buf(0xd770), then invokes CCP_Cmd_StateMachine. Called from the CAN-RX glue
        ; (undefined code @0a4a46) when a CRO arrives on the CCP message object.
CCP_Cmd_Entry:
        MOV [-R0],R12
        CMP R12,#00H
        JMPR cc_EQ,L_A5F56
        CMP R12,#01H
        JMPR cc_EQ,L_A5F68
        JMPR cc_UC,L_A5F78
L_A5F56:                 ; 0xa5f56
        MOVB RL4,#DATA16 0002CH
        MOVB ccp_d770,RL4
        MOV R12,#DATA16 0D770H
        CALLS 00AH,CCP_Cmd_StateMachine
        JMPR cc_UC,L_A5F78
L_A5F68:                 ; 0xa5f68
        MOVB RL4,#DATA16 0002DH
        MOVB ccp_d770,RL4
        MOV R12,#DATA16 0D770H
        CALLS 00AH,CCP_Cmd_StateMachine
L_A5F78:                 ; 0xa5f78
        ADD R0,#02H
        RETS

; ======== CCP_Cmd_StateMachine  (@0xa5f7c) ========
        ; CCP_Cmd_StateMachine(cmdBufPtr): main CCP command dispatcher / session state machine. State in
        ; ccp_session_state (0=idle, 0x10=connected, 0x20=cal-active, 0x30=program). cmdBuf[0] command codes:
        ; 0x2c=connect/start, 0x2d=disconnect, 0x16=program (sub 0x03=prog,0x50=end), 0x2f=select-cal-page
        ; (sub 0x8c), 0x2a=cal-page/status (sub 0x67/0x66/0x65/0x64/0x8c). Verifies station id vs const
        ; @0x0a2432. Dispatches to CCP_Cmd_Program(0a6532), CCP_Svc(0a6552), CCP_Exchange(0a659c), and
        ; CCP_Resp_Dispatch. Unknown cmd -> ccp_cmd_err_cnt++. engine flags in ccp_engine_flags (bit 0xa-0xe).
