; asw/comm/comm_flash_5.a66
; KWP flash-reprogramming commands 0x11-0x13.
; 0xCBF96-0xCC130  (410 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  KWP_Flash_Cmd17_arm, KWP_Flash_Cmd18_arm, KWP_Flash_Cmd19_arm
EXTERN  Calc_CatHeat_State:NEAR, Is_CCP_Active:NEAR, L_CC708:NEAR, RetC_1_142:NEAR
EXTERN  RetC_1_14c:NEAR, RetC_1_156:NEAR, Set_ADDRSEL2_15a:NEAR

S_CBF96 SECTION CODE AT 0CBF96H

; ======== KWP_Flash_Cmd17_arm  (@0xcbf96) ========
        ; ------------------------------------------------------------
        ; KWP flash-service dispatcher arm, command id 0x11 (kwp_cmd_id@d780) via
        ; KWP_Flash_Svc_jmptab@0xa0fa8.
        ; ------------------------------------------------------------
KWP_Flash_Cmd17_arm:
        MOVB RL4,kwp_sec_level
        CMPB RL4,#02H
        JMPR cc_C,L_CBFCC
        MOVB RL5,kwp_dl_mask
        ANDB RL5,#01H
        JMPR cc_EQ,L_CBFC0
        MOV R12,kwp_dl_addr
        MOV R13,kwp_dl_count
        CALLS 00BH,RetC_1_156
        CMP R4,#00H
        JMPR cc_EQ,L_CBFC0
        MOVB RL4,#03H
        MOVB kwp_resp_status,RL4
        JMPA cc_UC,L_CC708
L_CBFC0:                 ; 0xcbfc0
        MOVB RL4,#DATA16 00033H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708
L_CBFCC:                 ; 0xcbfcc
        MOVB RL4,#DATA16 00031H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708

; ======== KWP_Flash_Cmd18_arm  (@0xcbfd8) ========
        ; ------------------------------------------------------------
        ; KWP flash-service dispatcher arm, command id 0x12 (kwp_cmd_id@d780) via
        ; KWP_Flash_Svc_jmptab@0xa0fa8.
        ; ------------------------------------------------------------
KWP_Flash_Cmd18_arm:
        MOVB RL4,kwp_sec_level
        CMPB RL4,#02H
        JMPR cc_C,L_CC06A
        MOVB kwp_c369,ZEROS
        MOVBZ R8,kwp_dl_buf
        PRIOR R4,R8
        MOV R5,R8
        ROL R5,R4
        SHL R5,#01H
        JMPR cc_NE,L_CC05E
        MOVBZ R4,kwp_c368
        AND R4,R8
        JMPR cc_EQ,L_CC052
        MOVBZ R4,kwp_dl_mask
        AND R4,R8
        JMPR cc_EQ,L_CC010
        MOVB kwp_resp_status2,ZEROS
        MOV kwp_cec2,ZEROS
        MOV kwp_cec4,ZEROS
        JMPR cc_UC,L_CC022
L_CC010:                 ; 0xcc010
        MOVB RL4,#01H
        MOVB kwp_resp_status2,RL4
        CALLS 00BH,Calc_CatHeat_State
        MOV kwp_cec2,R4
        MOV kwp_cec4,R5
L_CC022:                 ; 0xcc022
        MOV R4,R8
        MOVB kwp_c369,RL4
        MOVB RL5,kwp_cec2
        MOVB kwp_resp_addr_lo,RL5
        MOVB RL3,kwp_cec3
        MOVB kwp_resp_addr_hi,RL3
        MOVB RL2,kwp_cec4
        MOVB kwp_resp_cnt_lo,RL2
        MOVB RL1,kwp_cec5
        MOVB kwp_resp_cnt_hi,RL1
        MOVB RL4,#08H
        MOVB kwp_resp_status,RL4
        JMPA cc_UC,L_CC708
L_CC052:                 ; 0xcc052
        MOVB RL4,#DATA16 00036H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708
L_CC05E:                 ; 0xcc05e
        MOVB RL4,#DATA16 00032H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708
L_CC06A:                 ; 0xcc06a
        MOVB RL4,#DATA16 00031H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708

; ======== KWP_Flash_Cmd19_arm  (@0xcc076) ========
        ; ------------------------------------------------------------
        ; KWP flash-service dispatcher arm, command id 0x13 (kwp_cmd_id@d780) via
        ; KWP_Flash_Svc_jmptab@0xa0fa8.
        ; ------------------------------------------------------------
KWP_Flash_Cmd19_arm:
        MOVB RL4,kwp_sec_level
        CMPB RL4,#06H
        JMPR cc_C,L_CC124
        MOVB RL5,kwp_dl_data3
        MOVB [R0+#07H],RL5
        MOVB RL3,kwp_dl_data2
        MOVB [R0+#06H],RL3
        MOVB RL2,kwp_dl_data1
        MOVB [R0+#05H],RL2
        MOVB RL1,kwp_dl_buf
        MOVB [R0+#04H],RL1
        MOVB RL4,kwp_c369
        CMPB RL4,#01H
        JMPR cc_EQ,L_CC0B2
        CMPB RL4,#02H
        JMPR cc_EQ,L_CC0CA
        CMPB RL4,#DATA16 00040H
        JMPR cc_EQ,L_CC0E2
        JMPR cc_UC,L_CC0FA
L_CC0B2:                 ; 0xcc0b2
        MOV R12,kwp_cec2
        MOV R13,kwp_cec4
        MOV R14,[R0+#04H]
        MOV R15,[R0+#06H]
        CALLS 00BH,Is_CCP_Active
        MOV R8,R4
        JMPR cc_UC,L_CC0FC
L_CC0CA:                 ; 0xcc0ca
        MOV R12,kwp_cec2
        MOV R13,kwp_cec4
        MOV R14,[R0+#04H]
        MOV R15,[R0+#06H]
        CALLS 00BH,RetC_1_142
        MOV R8,R4
        JMPR cc_UC,L_CC0FC
L_CC0E2:                 ; 0xcc0e2
        MOV R12,kwp_cec2
        MOV R13,kwp_cec4
        MOV R14,[R0+#04H]
        MOV R15,[R0+#06H]
        CALLS 00BH,RetC_1_14c
        MOV R8,R4
        JMPR cc_UC,L_CC0FC
L_CC0FA:                 ; 0xcc0fa
        MOV R8,#00H
L_CC0FC:                 ; 0xcc0fc
        CMP R8,#00H
        JMPR cc_EQ,L_CC112
        MOVB RL4,kwp_c369
        ORB kwp_dl_mask,RL4
        MOVBZ R4,RL4
        AND R4,#01H
        JMPR cc_EQ,L_CC112
        CALLS 00BH,Set_ADDRSEL2_15a
L_CC112:                 ; 0xcc112
        MOVB RL4,kwp_dl_mask
        MOVB kwp_resp_status2,RL4
        MOVB RL5,#04H
        MOVB kwp_resp_status,RL5
        JMPA cc_UC,L_CC708
L_CC124:                 ; 0xcc124
        MOVB RL4,#DATA16 00031H
        MOVB kwp_nrc_D78B,RL4
        JMPA cc_UC,L_CC708

S_CBF96 ENDS
        END
