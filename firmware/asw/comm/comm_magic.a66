        MOV DPP0:bl_cur_addr_lo,R4
        MOV DPP0:bl_cur_addr_hi,R5
        MOV bl_blk_addr_lo,ZEROS
        MOV bl_blk_addr_hi,ZEROS
        MOV bl_blk_cnt_lo,ZEROS
        MOV bl_blk_cnt_hi,ZEROS
        CALLS 00DH,BL_Validate_Setup
        JNB can_fd58.04H,L_DE66C
        EXTP #03H, #02H
        MOV R7,DPP0:bl_cur_addr_lo
        MOV R8,DPP0:bl_cur_addr_hi
