; ======== BL_Arm_Exec_Magic  (@0xde5d0) ========
        ; ------------------------------------------------------------
        ; OEM (verified by bl_/kwp_ output signals): Set bootloader-execute arm magic (bl_exec_arm_magic / _b1
        ; / _b2).
        ; ------------------------------------------------------------
BL_Arm_Exec_Magic:
        MOV [-R0],R13
        MOV [-R0],R12
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        BCLR can_fd58.00H
