        ; ------------------------------------------------------------
        ; OEM (verified by bl_/kwp_ output signals): Set bootloader mode-status flags bl_mode_status_flags.
        ; ------------------------------------------------------------
BL_Set_Mode_Status:
        BCLR PSW.0BH
        MOV R4,DPP1:0A046AH
        MOV R5,DPP1:0A046CH
        CALLS 00CH,Push_To_System_Stack
        MOV R12,#DATA16 0005CH
        MOV R13,#DATA16 00028H
        MOV R14,#DATA16 0AC53H
