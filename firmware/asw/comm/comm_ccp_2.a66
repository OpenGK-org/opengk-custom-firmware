        CALLS SEG CCP_Resp_Dispatch, SOF CCP_Resp_Dispatch
L_A5C12:                 ; 0xa5c12
        MOV R12,R7
        ADD R12,#06H
        CALLS SEG CCP_Lookup_DaqObject_Idx, SOF CCP_Lookup_DaqObject_Idx
        MOVB RL6,RL4
        MOVB RL4,#0FH
        MOVB ccp_e156,RL4
        MOVBZ R4,RL6
        SHL R4,#01H
        MOV R8,[R4+#0E18AH]
        MOV R9,[R8+#04H]
