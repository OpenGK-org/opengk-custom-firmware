S_COMM_CCP_2 SECTION CODE

; ======== CCP_Lookup_DaqObject_Idx  (@0xa5b7c) ========
CCP_Lookup_DaqObject_Idx:
        MOV [-R0],R6
        MOV R5,[R12]
        PRIOR R4,R5
        MOVB RL6,RL4
        EXTR #01H
        BCLR XP1IC.06H
        MOVBZ R4,RL6
        SHL R4,#01H
        MOV R5,[R4+#06358H]
        MOV R4,[R12]
        AND R4,R5
        MOV [R12],R4
        EXTR #01H
        BSET CC11IC.06H
        MOVB RL4,RL6
        MOV R6,[R0+]
        RETS

