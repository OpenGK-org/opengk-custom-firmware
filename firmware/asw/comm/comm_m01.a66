        MOV R12,maf_kgh_mes
        MOV R13,#DATA16 000DEH
        CALLS SEG Read_MulDiv_MD, SOF Read_MulDiv_MD
        MOV [R0+#04H],R4
        SHR R4,#08H
        MOV R5,R9
        ADD R9,#01H
        MOVB [R5],RL4
        MOVB RL4,[R0+#04H]
        MOVB [R9],RL4
        MOVB RL7,#02H
        JMPA cc_UC,L_E0940

; ======== OBD_M01_PID11_ThrottlePos  (@0xe0440) ========
        ; ------------------------------------------------------------
        ; OBD-II Mode 01 PID 0x11 handler arm. Dispatched from KWP_OBD_Svc01_ReadPID(0xe0000) via PID
        ; jump-table @0xa1afe (index=PID, bound<=0x4e). Named from OBD-II std + verified decompile.
        ; ------------------------------------------------------------
OBD_M01_PID11_ThrottlePos:
        MOVB [R9],tps_mes
        MOVB RL7,#01H
        JMPA cc_UC,L_E0940

S_COMM_M01 ENDS
        END
