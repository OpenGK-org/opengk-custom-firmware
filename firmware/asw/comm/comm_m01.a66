S_COMM_M01 SECTION CODE

; ======== KWP_OBD_Svc01_ReadPID  (@0xe0000) ========
        ; ------------------------------------------------------------
        ; OBD-II Service/Mode 01 (current data) reader+DISPATCHER. Reads PID byte, bounds-checks <=0x4e, jmpi
        ; through OBD_M01_PID_jmptab@0xa1afe (0x50 u16 offset entries, seg e). Each table target is a per-PID
        ; handler arm (OBD_M01_PIDxx_*); unmapped PIDs -> default FUN_0e0936 (returns 0xfe=not-supported).
        ; Gated by lv_conf_mis&0x10; !mode01 path tail-calls 0xe093c.
        ; ------------------------------------------------------------
        ; OBD-II Mode 01 (current data) PID reader. param_1 = KWP buffer ptr; first byte = PID.
        ; case0=supported-PID bitmask (01-20), case1=monitor status since DTC clear (MIL+readiness). Returns
        ; #bytes written. Invoked by KWP_App_Process_Records_0a2ffc (record fmt 1).
KWP_OBD_Svc01_ReadPID:
        MOV [-R0],R12
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        SUB R0,#06H
        JB lv_conf_mis.04H,L_E0014
        JMPA cc_UC,RetC_ff_93c
L_E0014:                 ; 0xe0014
        MOV R9,R12
        MOVB RL4,[R9+]
        CMPB RL4,#DATA16 0004EH
        JMPA cc_UGT,RetC_fe_936
        MOVBZ R4,RL4
        SHL R4,#01H
        ADD R4,#DATA16 05AFEH
        MOV R4,[R4]
        JMPI cc_UC,[R4]

; ======== OBD_M01_PID00_SupportedPID_01_20  (@0xe002c) ========
        ; ------------------------------------------------------------
        ; OBD-II Mode 01 PID 0x00 handler arm. Dispatched from KWP_OBD_Svc01_ReadPID(0xe0000) via PID
        ; jump-table @0xa1afe (index=PID, bound<=0x4e). Named from OBD-II std + verified decompile.
        ; ------------------------------------------------------------
OBD_M01_PID00_SupportedPID_01_20:
        MOVB RL6,#DATA16 000B8H
        JNB lv_conf_mis.00H,L_E0038
        MOVB RL6,#DATA16 000BEH
L_E0038:                 ; 0xe0038
        MOV R4,R9
        ADD R9,#01H
        MOVB [R4],RL6
        MOVB RL6,#DATA16 0001FH
        MOV R4,R9
        ADD R9,#01H
        MOVB [R4],RL6
        MOVB RL6,#DATA16 000A0H
        JNB lv_conf_mis.00H,L_E0054
        MOVB RL6,#DATA16 000B8H
L_E0054:                 ; 0xe0054
        MOV R4,R9
        ADD R9,#01H
        MOVB [R4],RL6
        MOVB RL6,#DATA16 00013H
        MOVB [R9],RL6
        MOVB RL7,#04H
        JMPA cc_UC,L_E0940

