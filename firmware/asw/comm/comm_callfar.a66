$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  KWP_Comms_Tick, KWP_Tx_Setup, Reset_kwp_req_ptr_e34, Tail_rt_callfar_via_r5r4_d22, Tail_rt_callfar_via_r5r4_d36, Tail_rt_callfar_via_r5r4_d4c
PUBLIC  Tail_rt_callfar_via_r5r4_d7a, Tail_rt_callfar_via_r5r4_e06, Tail_rt_callfar_via_r5r4_e1a

S_DED22 SECTION CODE AT 0DED22H

; ======== Tail_rt_callfar_via_r5r4_d22  (@0xded22) ========
Tail_rt_callfar_via_r5r4_d22:
        MOV R12,#00H
        EXTP #00H, #02H
        MOV R4,g_222
        MOV R5,g_224
        CALLS 000H,rt_callfar_via_r5r4
        RETS

