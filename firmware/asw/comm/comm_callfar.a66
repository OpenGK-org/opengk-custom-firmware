; ======== Reset_kwp_req_ptr_e34  (@0xdee34) ========
Reset_kwp_req_ptr_e34:
        MOV R4,#DATA16 0E559H
        MOV kwp_req_ptr,R4
        MOV R5,#DATA16 0E559H
        MOV kwp_buf_base,R5
        MOV R2,#DATA16 000FFH
        MOV kwp_buf_limit,R2
        MOV bl_prog_comm_flags,ZEROS
        RETS

S_DED22 ENDS
        END
