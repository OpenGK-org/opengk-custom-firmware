; ======== KWP_Tx_Setup  (@0xded60) ========
        ; ------------------------------------------------------------
        ; OEM (verified by bl_/kwp_ output signals): KWP transmit setup: kwp_commobj_handle_tx /
        ; kwp_prog_flags.
        ; ------------------------------------------------------------
KWP_Tx_Setup:
        MOVB kwp_commobj_handle_tx,ZEROS
        BCLR kwp_prog_flags.07H
        MOV R12,#01H
        EXTP #00H, #02H
        MOV R4,kwp_22a
        MOV R5,kwp_22c
        CALLS 000H,rt_callfar_via_r5r4
        RETS

; ======== Tail_rt_callfar_via_r5r4_d7a  (@0xded7a) ========
Tail_rt_callfar_via_r5r4_d7a:
        MOV R12,#01H
