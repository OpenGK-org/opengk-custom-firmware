        MOV R5,g_224
        CALLS 000H,rt_callfar_via_r5r4
        RETS

; ======== KWP_Comms_Tick  (@0xded8e) ========
        ; ------------------------------------------------------------
        ; OEM (verified by bl_/kwp_ output signals): KWP comms tick: kwp_comms_flags / kwp_timing_counter / tx
        ; handle.
        ; ------------------------------------------------------------
KWP_Comms_Tick:
        MOV [-R0],R6
        MOVB RL6,#00H
        JB kwp_prog_flags.0EH,L_DED9E
        JB kwp_prog_flags.09H,L_DED9E
        JNB kwp_comms_flags.0BH,L_DEDA2
L_DED9E:                 ; 0xded9e
        MOVB RL6,#01H
        JMPR cc_UC,L_DEDE6
L_DEDA2:                 ; 0xdeda2
        MOVB RL4,kwp_session_state
        JMPR cc_EQ,L_DEDB0
        MOVB RL4,kwp_session_state
        ANDB RL4,#02H
        JMPR cc_EQ,L_DEDE6
L_DEDB0:                 ; 0xdedb0
        MOV R12,#02H
        MOV R13,#DATA16 0E558H
        MOV R14,#DATA16 0E548H
        MOV R15,kwp_buf_limit
        CALLS 008H,CommObj_Tp_SubmitSegment
        MOV R4,kwp_msg_len
        CMP R4,#02H
        JMPR cc_NE,L_DEDE6
        MOVB RL4,bl_kwp_sid
        CMPB RL4,#DATA16 0003EH
        JMPR cc_NE,L_DEDE6
        MOVB RL4,bl_kwp_subfn
        CMPB RL4,#DATA16 00080H
        JMPR cc_NE,L_DEDE6
        MOVB RL6,#01H
        BSET kwp_comms_flags.09H
        MOV kwp_timing_counter,ZEROS
L_DEDE6:                 ; 0xdede6
        CMPB RL6,#00H
        JMPR cc_NE,L_DEE02
        MOVB kwp_commobj_handle_tx,ZEROS
        BSET kwp_prog_flags.07H
        MOV R12,#02H
        EXTP #00H, #02H
        MOV R4,kwp_22a
        MOV R5,kwp_22c
        CALLS 000H,rt_callfar_via_r5r4
L_DEE02:                 ; 0xdee02
        MOV R6,[R0+]
        RETS

; ======== Tail_rt_callfar_via_r5r4_e06  (@0xdee06) ========
Tail_rt_callfar_via_r5r4_e06:
        MOV R12,#02H
        EXTP #00H, #02H
        MOV R4,g_222
