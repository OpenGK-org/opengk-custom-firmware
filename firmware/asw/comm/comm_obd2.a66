; asw/comm/comm_obd2.a66
; 0xD444E-0xD450E  (192 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_LS_Up_OBD2_CycNr, Calc_LS_Up_OBD2_Freq, LS_Up_OBD2_Freq_Gated
EXTERN  Mul_U16_Hi:NEAR

S_D444E SECTION CODE AT 0D444EH

; ======== Calc_LS_Up_OBD2_CycNr  (@0xd444e) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by obd2/er output signals): Front-O2 OBD2 switching cycle bounds: vls_cycnr_max
        ; / vls_cycnr_min.
        ; ------------------------------------------------------------
Calc_LS_Up_OBD2_CycNr:
        MOV [-R0],R9
        MOV R4,lam_bank_1_ls_up_obd2_struct_ls_up_obd2_carrier
        JMPR cc_NE,L_D4486
        MOV R9,lam_bank_1_ls_up_vls_mmv_min
        MOV R12,lam_bank_1_ls_up_vls_mmv_max
        SUB R12,R9
        MOV R13,#DATA16 0E666H
        CALLS 00FH,Mul_U16_Hi
        ADD R4,R9
        SHR R4,#06H
        MOV lam_bank_1_ls_up_obd2_struct_vls_cycnr_max,R4
        MOV R12,lam_bank_1_ls_up_vls_mmv_max
        SUB R12,R9
        MOV R13,#DATA16 01999H
        CALLS 00FH,Mul_U16_Hi
        ADD R4,R9
        SHR R4,#06H
        MOV lam_bank_1_ls_up_obd2_struct_vls_cycnr_min,R4
L_D4486:                 ; 0xd4486
        MOV R9,[R0+]
        RETS

; ======== Calc_LS_Up_OBD2_Freq  (@0xd448a) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by obd2/er output signals): Front-O2 OBD2 switching-frequency diagnosis:
        ; ls_up_obd2_carrier / sum_cyc / t_ls_frq_diag.
        ; ------------------------------------------------------------
Calc_LS_Up_OBD2_Freq:
        BCLR state_cat_diag.01H
        BCLR lv_act_diagcps.0BH
        MOV lam_bank_1_ls_up_obd2_struct_t_ls_frq_diag,ZEROS
        MOVB obd_c8c4,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_ls_up_obd2_carrier,ZEROS
        MOVB obd_c896,ZEROS
        MOV obd_c898,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_sum_cyc,ZEROS
        MOVB lam_bank_1_ls_up_obd2_struct_vls_cyc_afl_ratio,ZEROS
        MOVB lam_bank_1_ls_up_obd2_struct_vls_cyc_afr_ratio,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_vls_cyc_afl_ratio_sum,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_vls_cyc_afr_ratio_sum,ZEROS
        MOVB lam_bank_1_ls_up_obd2_struct_vls_cyc_afl_ratio_mv,ZEROS
        MOVB lam_bank_1_ls_up_obd2_struct_vls_cyc_afr_ratio_mv,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_vls_cycnr_max,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_vls_cycnr_min,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_t_vls_cycnr,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_sum_cycnr_afl,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_sum_cycnr_afr,ZEROS
        MOVB lam_bank_1_ls_up_obd2_struct_vls_cycnr_afl_ratio,ZEROS
        MOVB lam_bank_1_ls_up_obd2_struct_vls_cycnr_afr_ratio,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_vls_cycnr_afl_ratio_sum,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_vls_cycnr_afr_ratio_sum,ZEROS
        MOVB lam_bank_1_ls_up_obd2_struct_vls_cycnr_afl_ratio_mv,ZEROS
        MOVB lam_bank_1_ls_up_obd2_struct_vls_cycnr_afr_ratio_mv,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_t_vls_afr_to_afl_sum,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_t_vls_afr_to_afl_sum_max,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_t_vls_afl_to_afr_sum,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_t_vls_afl_to_afr_sum_max,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_t_vls_cyc_afr_sum,ZEROS
        MOV lam_bank_1_ls_up_obd2_struct_t_vls_cyc_afr_sum_max,ZEROS
        RETS

; ======== LS_Up_OBD2_Freq_Gated  (@0xd4504) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
LS_Up_OBD2_Freq_Gated:
        JB obd_sf.0DH,L_D450C
        CALLS 00DH,Calc_LS_Up_OBD2_Freq
L_D450C:                 ; 0xd450c
        RETS

S_D444E ENDS
        END
