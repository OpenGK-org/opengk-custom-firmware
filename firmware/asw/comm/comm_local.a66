; ======== KWP_SID3B_WriteDataByLocalId  (@0xdfb0c) ========
        ; KWP2000 SID 0x3B WriteDataByLocalIdentifier. Only record 0x90 supported, gated by feature flag
        ; DAT_00fd58&0x200, requires msg_len 0x13 (19 bytes). Delegates to KWP_SID3B_WriteBlock90; NRC 0x40 on
        ; write failure.
KWP_SID3B_WriteDataByLocalId:
        MOV R4,kwp_req_ptr
        MOVB RL5,[R4]
        CMPB RL5,#DATA16 00090H
        JMPR cc_NE,L_DFB5E
        JNB can_fd58.09H,L_DFB54
        MOV R4,kwp_msg_len
        CMP R4,#DATA16 00013H
        JMPR cc_NE,L_DFB4A
        MOV R12,kwp_req_ptr
        ADD R12,#01H
        CALLS 00AH,KWP_SID3B_WriteBlock90
        JNB PSW.06H,L_DFB40
        MOV R4,#02H
        MOV kwp_msg_len,R4
        MOVB kwp_nrc,ZEROS
        RETS
L_DFB40:                 ; 0xdfb40
        MOVB RL4,#DATA16 00040H
        MOVB kwp_nrc,RL4
        RETS
L_DFB4A:                 ; 0xdfb4a
