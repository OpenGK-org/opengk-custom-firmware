; ======== KWP_OBD_Svc09_VehicleInfo  (@0xe2490) ========
        ; OBD-II Mode 09 (vehicle info) reader. case2=VIN (17 bytes, c_kwp_io_vin_* or DAT_003e1d.. if
        ; maf-trim variant), case4=Calibration ID (from s_OPENGK01OG0001... @0x4c), case6=CVN, case8=ECU
        ; serial/ID block (DAT_00c4d0..). Returns #bytes.
KWP_OBD_Svc09_VehicleInfo:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        MOV R9,R12
        JB lv_conf_mis.04H,L_E24A2
        JMPA cc_UC,RetC_ff_864
L_E24A2:                 ; 0xe24a2
        MOVB RL7,[R9+]
        MOVB RL4,RL7
        CMPB RL4,#DATA16 00008H
        JMPA cc_UGT,RetC_fe_85e
        MOVBZ R4,RL4
        SHL R4,#01H
        ADD R4,#DATA16 05B9CH
        MOV R4,[R4]
        JMPI cc_UC,[R4]

