; ======== CAN1_Init  (@0xd688c) ========
        ; CAN1_Init: powertrain/vehicle CAN (controller @0xEF00). Programs C1CSR/C1IR, bit timing
        ; C1BTR=0x3601, global masks=0xFFFF, then loads all 15 message objects (16B each) from ROM template
        ; @0x50b4 (DPP-windowed to 0x910b4), and defaults the received-signal variables via
        ; CAN1_SetDefault_TcuSignals/TcsSignals/WheelSpeeds. NOTE: CAN2 @0xEE00 is the separate CCP/DAQ
        ; controller.
CAN1_Init:
        MOV [-R0],R9                            ; HW (schematic + code): C167 TwinCAN part, two on-chip CAN nodes: CAN1=0xEF00 (this, powertrain), CAN2=0xEE00 (CCP/KWP diag). Retail board has ONE transceiver on P4.6=CAN_TxD(pin91)/P4.7=CAN_RxD(pin92); both nodes share it (same bitrate: C1BTR=0x3601 and C2BTR=0x2701 both = 12tq, prescaler/2). This node IS brought live (CAN1_Init clears INIT in C1CSR; called at startup 0xda6a4 + re-armed from CAN1_Periodic_Task). So powertrain + CCP + KWP all ride the single physical bus. Dev ECUs broke CAN2 out to its own connector; retail merges both onto one wire.
        MOV [-R0],R8
        MOV [-R0],R7
        MOV R4,#DATA16 00741H
        MOV C1CSR,R4
        MOV R4,#DATA16 00100H
        MOV C1IR,R4
        MOV R4,#DATA16 03601H
        MOV C1BTR,R4
        MOV C1GMS,ONES
        MOV C1UGML,ONES
        MOV C1LGML,ONES
        MOV C1UMLM,ONES
        MOV C1LMLM,ONES
        MOV R8,#DATA16 0EF10H                   ; First CAN msg obj register
        MOV R7,#DATA16 050B4H
        MOV R9,#00H
L_D68C8:                 ; 0xd68c8
        MOV [R8],[R7]
        ADD R8,#02H
        ADD R7,#02H
        ADD R9,#01H
        CMP R9,#DATA16 00078H
        JMPR cc_C,L_D68C8
        MOVB C1CSR,ZEROS
        MOVB RL4,DPP0:c_tq_stnd
        MOVB tq_stnd,RL4
        CALLS SEG CAN1_SetDefault_TcuSignals, SOF CAN1_SetDefault_TcuSignals
        CALLS SEG CAN1_SetDefault_TcsSignals, SOF CAN1_SetDefault_TcsSignals
        CALLS SEG CAN1_SetDefault_WheelSpeeds, SOF CAN1_SetDefault_WheelSpeeds
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== CAN1_Periodic_Task  (@0xd68f6) ========
        ; CAN1_Periodic_Task: periodic powertrain-CAN handler (CAN1 @0xEF00). Bus-off detect/recover
        ; (CAN1_Init) + CAN-timeout DTCs, then: RX via CAN1_Rx_ReadObject -> parse @0xf83c: obj0=TCU (tar_gc
        ; gear, tqi_tcu_can, toil_gb, n_tur_conv), obj2=TCS/ESP (tqi_asr_req/tqi_msr_req, arb C1AR3=0x602a),
        ; obj1=ABS (wheel_fl/fr/rl/rr_tcs, arb C1AR2=0x3e). TX: fill 0xf832 then CAN1_Tx_SendObject(idx):
        ; objD(DLC8) engine torque = flags,tqi_acor_can,n(RPM)<<2,tqi_can,tqfr_can,vs,ratio; objC(DLC7) engine
        ; status = mux/alive,tco,maf_fac_alti_mmv,MIL flags,tps_can; objB(DLC4) fuel/ambient =
        ; flags+amp_can,fco_word_1,vb; objA(DLC8) OBD readiness =
        ; tia,state_dc_rbm,ctr_igk_cyc_rbm,ctr_cdn_obd_rbm.
