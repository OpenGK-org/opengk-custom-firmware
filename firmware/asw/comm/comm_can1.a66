; ======== Calc_TI_AS  (@0xd6824) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): After-start injection time per cylinder: ti_as_0..3.
        ; ------------------------------------------------------------
Calc_TI_AS:
        JB lv_asr_req.03H,L_D687E
        MOVB RL4,DPP0:c_ti_as_0
