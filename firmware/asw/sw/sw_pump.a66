; asw/sw/sw_pump.a66
; 0xE5A86-0xE5B2C  (166 bytes, 4 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_t_efp                              EQU  0906E8H
c_t_max_ecu                          EQU  0906FAH
c_t_max_ecu_imob                     EQU  0906FCH

PUBLIC  Ctl_FuelPump, Set_FuelPump_Latch, Tail_f0a52cc_b26, c_t_max_ecu_sub
EXTERN  Diag_DTC_dd116:NEAR, Init_CC5_Output:NEAR, Output_CC12_P2_12_Disable:NEAR, Output_CC5_P2_5_Enable:NEAR
EXTERN  Read_Coding_Nibble:NEAR

S_E5A86 SECTION CODE AT 0E5A86H

; ======== c_t_max_ecu_sub  (@0xe5a86) ========
        ; ------------------------------------------------------------
        ; Library Function - Single Match
        ;  c_t_max_ecu_sub
        ;
        ; Library: c167_simk4x 0.0.1 alpha
        ; ------------------------------------------------------------
c_t_max_ecu_sub:
        CALLS 00AH,Output_CC5_P2_5_Enable
        CALLS 00AH,Output_CC12_P2_12_Disable
        MOVB RL4,lv_sched_diag_inh
        ANDB RL4,#01H
        JMPR cc_NE,L_E5AB2
        MOVB RL4,imob_ca2a
        CMPB RL4,#01H
        JMPR cc_NE,L_E5AA8
        MOV R4,DPP0:c_t_max_ecu_imob
        MOV sw_timer_c,R4
        JMPR cc_UC,L_E5AB8
L_E5AA8:                 ; 0xe5aa8
        MOV R4,DPP0:c_t_max_ecu
        MOV sw_timer_c,R4
        JMPR cc_UC,L_E5AB8
L_E5AB2:                 ; 0xe5ab2
        MOV R4,#01H
        MOV sw_timer_c,R4
L_E5AB8:                 ; 0xe5ab8
        MOVB RL4,lv_sched_diag_inh
        ANDB RL4,#01H
        JMPR cc_NE,L_E5ADA
        CALLS 00AH,Read_Coding_Nibble
        JNB state_out_fault.0DH,L_E5AD6
        MOV R4,sw_timer_b
        JMPR cc_NE,L_E5AD6
        MOV R5,DPP0:c_t_efp
        MOV sw_timer_b,R5
L_E5AD6:                 ; 0xe5ad6
        MOV crank_tim_13,ZEROS
L_E5ADA:                 ; 0xe5ada
        RETS

; ======== Set_FuelPump_Latch  (@0xe5adc) ========
        ; ------------------------------------------------------------
        ; OEM (verified by output/adapt signals): Fuel-pump output latch set: fd94/fd96 bit 0x2000 (gated by
        ; fd98.0x10) + Diag_DTC_dd116.
        ; ------------------------------------------------------------
Set_FuelPump_Latch:
        CALLS 00CH,Diag_DTC_dd116
        MOV sw_timer_b,ZEROS
        MOVB RL4,#DATA16 000FEH
        ANDB state_fuel_req,RL4
        MOVB RL4,state_fuel_req
        JMPR cc_NE,L_E5AFC
        BSET state_out_fault.0DH
        JB state_out_req.04H,L_E5B04
        BSET state_out_diag.0DH
        RETS
L_E5AFC:                 ; 0xe5afc
        BCLR state_out_fault.0DH
        JB state_out_req.04H,L_E5B04
        BCLR state_out_diag.0DH
L_E5B04:                 ; 0xe5b04
        RETS

; ======== Ctl_FuelPump  (@0xe5b06) ========
        ; ------------------------------------------------------------
        ; OEM (verified by output/adapt signals): Electric fuel-pump control: enables pump relay output
        ; (CC5/P2.5), disables CC12, arms run-on timer DAT_00f954=c_t_efp when fd96.0x2000 set.
        ; ------------------------------------------------------------
Ctl_FuelPump:
        CALLS 00AH,Output_CC5_P2_5_Enable
        CALLS 00AH,Output_CC12_P2_12_Disable
        JNB state_out_fault.0DH,L_E5B20
        MOV R4,sw_timer_b
        JMPR cc_NE,L_E5B20
        MOV R5,DPP0:c_t_efp
        MOV sw_timer_b,R5
L_E5B20:                 ; 0xe5b20
        CALLS 00AH,Init_CC5_Output
        RETS

; ======== Tail_f0a52cc_b26  (@0xe5b26) ========
Tail_f0a52cc_b26:
        CALLS 00AH,Init_CC5_Output
        RETS

S_E5A86 ENDS
        END
