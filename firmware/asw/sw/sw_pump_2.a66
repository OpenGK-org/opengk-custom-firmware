; asw/sw/sw_pump_2.a66
; 0xE5B2C-0xE5C38  (268 bytes, 7 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_t_efp                              EQU  0906E8H
c_t_max_ecu                          EQU  0906FAH
c_t_max_ecu_imob                     EQU  0906FCH

PUBLIC  FuelCut_TrailThrottle, FuelPump_Out_1, FuelPump_Out_2, FuelPump_Out_3, FuelPump_Out_4, FuelPump_Out_5
PUBLIC  Set_FuelPump_RunOn
EXTERN  Diag_DTC_dd116:NEAR, Diag_MAF_TPS_Ratio_d1be:NEAR, EngState_TrailThrottle:NEAR, Init_CC5_Output:NEAR
EXTERN  Output_CC12_P2_12_Disable:NEAR, Output_CC5_P2_5_Enable:NEAR, Read_Coding_Nibble:NEAR, Reset_Dfaae_b84:NEAR
EXTERN  Set_TCO_Stop:NEAR, Set_TOIL_Stop:NEAR

S_E5B2C SECTION CODE AT 0E5B2CH

; ======== FuelPump_Out_1  (@0xe5b2c) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay):
        ; Fuel-pump relay output handler (CC5/P2.5 enable, CC12/P2.12 disable).
        ; ------------------------------------------------------------
FuelPump_Out_1:
        CALLS 00AH,Output_CC5_P2_5_Enable
        CALLS 00AH,Output_CC12_P2_12_Disable
        CALLS 00AH,Init_CC5_Output
        RETS

; ======== FuelPump_Out_2  (@0xe5b3a) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay):
        ; Fuel-pump relay output handler (variant).
        ; ------------------------------------------------------------
FuelPump_Out_2:
        CALLS 00AH,Output_CC5_P2_5_Enable
        CALLS 00AH,Output_CC12_P2_12_Disable
        MOVB RL4,lv_sched_diag_inh
        ANDB RL4,#01H
        JMPR cc_NE,L_E5B66
        MOVB RL4,imob_ca2a
        CMPB RL4,#01H
        JMPR cc_NE,L_E5B5C
        MOV R4,DPP0:c_t_max_ecu_imob
        MOV sw_timer_c,R4
        JMPR cc_UC,L_E5B6C
L_E5B5C:                 ; 0xe5b5c
        MOV R4,DPP0:c_t_max_ecu
        MOV sw_timer_c,R4
        JMPR cc_UC,L_E5B6C
L_E5B66:                 ; 0xe5b66
        MOV R4,#01H
        MOV sw_timer_c,R4
L_E5B6C:                 ; 0xe5b6c
        CALLS 00AH,Read_Coding_Nibble
        MOV R4,DPP0:c_t_efp
        MOV sw_timer_b,R4
        MOV crank_tim_13,ZEROS
        CALLS 00BH,Set_TOIL_Stop
        CALLS 00CH,Set_TCO_Stop
        RETS

; ======== FuelCut_TrailThrottle  (@0xe5b86) ========
        ; ------------------------------------------------------------
        ; OEM (verified): Overrun/trailing-throttle fuel-cut entry: Diag_DTC_dd116 + EngState_TrailThrottle.
        ; ------------------------------------------------------------
FuelCut_TrailThrottle:
        CALLS 00CH,Diag_DTC_dd116
        CALLS 00DH,EngState_TrailThrottle
        RETS

; ======== FuelPump_Out_3  (@0xe5b90) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay):
        ; Fuel-pump relay output handler (variant).
        ; ------------------------------------------------------------
FuelPump_Out_3:
        CALLS 00AH,Output_CC5_P2_5_Enable
        CALLS 00AH,Output_CC12_P2_12_Disable
        CALLS 00DH,Diag_MAF_TPS_Ratio_d1be
        MOV R4,DPP0:c_t_efp
        MOV sw_timer_b,R4
        CALLS 00AH,Init_CC5_Output
        CALLS 00CH,Reset_Dfaae_b84
        CALLS 00BH,Set_TOIL_Stop
        CALLS 00CH,Set_TCO_Stop
        RETS

; ======== FuelPump_Out_4  (@0xe5bb6) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay):
        ; Fuel-pump relay output handler (fd96 0x2000 request).
        ; ------------------------------------------------------------
FuelPump_Out_4:
        CALLS 00AH,Output_CC5_P2_5_Enable
        CALLS 00AH,Output_CC12_P2_12_Disable
        CALLS 00DH,Diag_MAF_TPS_Ratio_d1be
        JNB state_out_fault.0DH,L_E5BD4
        MOV R4,sw_timer_b
        JMPR cc_NE,L_E5BD4
        MOV R5,DPP0:c_t_efp
        MOV sw_timer_b,R5
L_E5BD4:                 ; 0xe5bd4
        CALLS 00CH,Diag_DTC_dd116
        CALLS 00AH,Init_CC5_Output
        CALLS 00BH,Set_TOIL_Stop
        CALLS 00CH,Set_TCO_Stop
        RETS

; ======== Set_FuelPump_RunOn  (@0xe5be6) ========
        ; ------------------------------------------------------------
        ; OEM (verified): Arm fuel-pump run-on timer DAT_00f954 = c_t_efp.
        ; ------------------------------------------------------------
Set_FuelPump_RunOn:
        MOV R4,DPP0:c_t_efp
        MOV sw_timer_b,R4
        RETS

; ======== FuelPump_Out_5  (@0xe5bf0) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay):
        ; Fuel-pump relay output handler (variant).
        ; ------------------------------------------------------------
FuelPump_Out_5:
        CALLS 00AH,Output_CC5_P2_5_Enable
        CALLS 00AH,Output_CC12_P2_12_Disable
        MOVB RL4,lv_sched_diag_inh
        ANDB RL4,#01H
        JMPR cc_NE,L_E5C1C
        MOVB RL4,imob_ca2a
        CMPB RL4,#01H
        JMPR cc_NE,L_E5C12
        MOV R4,DPP0:c_t_max_ecu_imob
        MOV sw_timer_c,R4
        JMPR cc_UC,L_E5C22
L_E5C12:                 ; 0xe5c12
        MOV R4,DPP0:c_t_max_ecu
        MOV sw_timer_c,R4
        JMPR cc_UC,L_E5C22
L_E5C1C:                 ; 0xe5c1c
        MOV R4,#01H
        MOV sw_timer_c,R4
L_E5C22:                 ; 0xe5c22
        CALLS 00AH,Read_Coding_Nibble
        CALLS 00DH,Diag_MAF_TPS_Ratio_d1be
        MOV crank_tim_13,ZEROS
        CALLS 00BH,Set_TOIL_Stop
        CALLS 00CH,Set_TCO_Stop
        RETS

S_E5B2C ENDS
        END
