        MOV R2,R5
        SHL R2,#03H
        SUB R2,R5
        SHL R2,#01H
        ADD R4,R2
        MOVB RL5,[R4]
        ORB RL5,#DATA16 00020H
        MOVB [R4],RL5
        MOVBZ R4,RL7
        MOV R5,#DATA16 00016H
        MULU R4,R5
        MOV R4,0FE0EH
        MOVB RL5,[R4+#0522EH]
        MOVBZ R5,RL5
        AND R5,#DATA16 00060H
        JMPR cc_EQ,L_DC22A
        MOVBZ R12,RL7
        CALLS SEG Get_DTC_StatusBits, SOF Get_DTC_StatusBits
        MOVB RL6,RL4
        CMPB RL4,#04H
