Calc_Mis_Rate_FromFault:
        MOV [-R0],R12
        MOV [-R0],R6
        MOVB RL4,[R0+#02H]
        MOVBZ R12,RL4
        CALLS SEG Get_DTC_StatusBits, SOF Get_DTC_StatusBits
