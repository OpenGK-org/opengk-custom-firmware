; asw/knk/knk_iga_2.a66
; Knock adaptation (after-start switch, global retard), NVM storage and environment
; snapshot.
; 0xC3330-0xC3522  (498 bytes, 4 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_swi_ad_knk                         EQU  09030FH
c_t_knk_ad_ast                       EQU  09033AH

PUBLIC  Calc_IGA_Ad2_Knk, Calc_Knk_Ad_Ast, Env_IGA_Adj_Knk, Store_IGA_Knk_Ad_NVM
EXTERN  Clamp_IGA_Knk_Maps:NEAR, Elevated_Write_Routine_prg_zone_wrapper:NEAR, Init_IGA_Knk_Adapt:NEAR, xor_routine:NEAR

S_C3330 SECTION CODE AT 0C3330H

; ======== Calc_Knk_Ad_Ast  (@0xc3330) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Knock adaptation after-start-time switch
        ; (c_swi_ad_knk/c_t_knk_ad_ast)
        ; ------------------------------------------------------------
Calc_Knk_Ad_Ast:
        MOVB RL4,DPP0:c_swi_ad_knk
        JMPR cc_NE,L_C3354
        MOVBZ R4,DPP0:c_t_knk_ad_ast
        CMP R4,t_ast
        JMPR cc_ULE,L_C3350
        JB lv_cdn_diag_maf_dif_ch_int.0EH,L_C334C
        JB lv_pl.01H,L_C334C
        JNB lv_pl.02H,L_C3350
L_C334C:                 ; 0xc334c
        BCLR lv_cam_ad_avl_nvmy_ivvt.0EH
        RETS
L_C3350:                 ; 0xc3350
        BSET lv_cam_ad_avl_nvmy_ivvt.0EH
        RETS
L_C3354:                 ; 0xc3354
        BCLR lv_cam_ad_avl_nvmy_ivvt.0EH
        RETS

; ======== Calc_IGA_Ad2_Knk  (@0xc3358) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by knock output signals/NVM/DTC): Knock global ignition-retard adaptation:
        ; updates iga_ad2_knk (the bank-wide knock-learned spark offset).
        ; ------------------------------------------------------------
Calc_IGA_Ad2_Knk:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        JNB lv_pl.0CH,L_C336A
        MOVB RL4,conf_ad_rst
        JMPR cc_NE,L_C3426
L_C336A:                 ; 0xc336a
        JB can_fd58.02H,L_C3426
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 0000EH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#DATA16 000F2H
        CALLS SEG xor_routine, SOF xor_routine
        MOV R10,diag_f890
        MOV R11,diag_f892
        EXTP R11, #02H
        MOV R5,[R10+#0100H]
        NOP
        CMP R5,R4
        JMPR cc_NE,L_C3426
        MOV R9,#DATA16 0F395H
        MOV R6,R10
        MOV R7,R11
        ADD R6,#DATA16 0000EH
        MOV R4,R6
        MOV R5,R7
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R7
        SHR R5,#02H
        MOV R6,R4
        MOV R7,R5
        MOV R8,#00H
L_C33D2:                 ; 0xc33d2
        EXTS R7, #01H
        MOVB RL4,[R6]
        CMPB RL4,#DATA16 00080H
        JMPR cc_ULE,L_C33E4
        MOVB RL4,#DATA16 00080H
        MOVB [R9],RL4
        JMPR cc_UC,L_C33EA
L_C33E4:                 ; 0xc33e4
        EXTS R7, #01H
        MOVB RL4,[R6]
        MOVB [R9],RL4
L_C33EA:                 ; 0xc33ea
        ADD R6,#01H
        ADDC R7,#00H
        ADD R9,#01H
        ADD R8,#01H
        CMP R8,#DATA16 000F0H
        JMPR cc_C,L_C33D2
        MOV R4,diag_f890
        MOV R5,diag_f892
        EXTP R5, #02H
        MOVB RL3,[R4+#0FEH]
        NOP
        CMPB RL3,#DATA16 00080H
        JMPR cc_UGT,L_C341C
        EXTP R5, #02H
        MOVB RL3,[R4+#0FEH]
        NOP
        MOVB iga_ad2_knk,RL3
        JMPR cc_UC,L_C342A
L_C341C:                 ; 0xc341c
        MOVB RL4,#DATA16 00080H
        MOVB iga_ad2_knk,RL4
        JMPR cc_UC,L_C342A
L_C3426:                 ; 0xc3426
        CALLS SEG Init_IGA_Knk_Adapt, SOF Init_IGA_Knk_Adapt
L_C342A:                 ; 0xc342a
        MOV R6,[R0+]
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== Store_IGA_Knk_Ad_NVM  (@0xc3434) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by knock output signals/NVM/DTC): Clamp (Clamp_IGA_Knk_Maps) then persist
        ; iga_ad_0..3 knock ignition-adapt maps to NVM (@f890+0xe) with checksum.
        ; ------------------------------------------------------------
Store_IGA_Knk_Ad_NVM:
        SUB R0,#02H
        CALLS SEG Clamp_IGA_Knk_Maps, SOF Clamp_IGA_Knk_Maps
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 0000EH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F395H
        MOV R15,#DATA16 000F0H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 000FEH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F485H
        MOV R15,#01H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 0000EH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#DATA16 000F2H
        CALLS SEG xor_routine, SOF xor_routine
        MOV [R0],R4
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 00100H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,R0
        MOV R15,#02H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        ADD R0,#02H
        RETS

; ======== Env_IGA_Adj_Knk  (@0xc34e4) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (EMS31, verified): Environmental data snapshot (iga_adj_knk_0..3 freeze frame)
        ; ------------------------------------------------------------
Env_IGA_Adj_Knk:
        MOVB RL4,iga_adj_knk_0_
        SUBB RL4,#DATA16 00080H
        MOVB lv_iga_f487,RL4
        MOVB RL5,iga_adj_knk_1_
        SUBB RL5,#DATA16 00080H
        MOVB lv_iga_f488,RL5
        MOVB RL3,iga_adj_knk_2_
        SUBB RL3,#DATA16 00080H
        MOVB lv_iga_f489,RL3
        MOVB RL2,iga_adj_knk_3_
        SUBB RL2,#DATA16 00080H
        MOVB lv_iga_f48a,RL2
        MOVB RL1,iga_mv_adj_knk
        SUBB RL1,#DATA16 00080H
        MOVB lv_knk_f486,RL1
        RETS

S_C3330 ENDS
        END
