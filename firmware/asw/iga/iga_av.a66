; ======== Calc_IGA_Av  (@0xc0000) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by iga/igc/td output signals): Per-cylinder ignition-advance average iga_av_0..3
        ; + efficiency eff_iga_av.
        ; ------------------------------------------------------------
Calc_IGA_Av:
        MOVB RL4,DPP0:c_iga_ini
        MOVB iga_av_2,RL4
        MOVB iga_av_1,RL4
        MOVB iga_av_0,RL4
        MOVB RL5,DPP0:c_iga_ini
        MOVB iga_av_3,RL5
        MOV R12,#00H
L_C001A:                 ; 0xc001a
        MOVB RL4,DPP0:c_iga_ini
        CPLB RL4
        MOVB [R12+#0F5A8H],RL4
        CMPI1 R12,#03H
        JMPR cc_SLT,L_C001A
        MOV R4,#DATA16 08000H
        MOV eff_iga_av,R4
        MOVB RL4,DPP0:lc_iga_st_ena
        BMOVN lv_iga_tra_knk.00H,PSW.03H
        RETS

; ======== Reset_Dc2d1_03a  (@0xc003a) ========
Reset_Dc2d1_03a:
        MOVB RL4,iga_st
        MOVB lv_iga_c2d1,RL4
        MOVBZ R12,RL4
        MOV R13,#0AH
        CALLS SEG Mul_U16_Sat16, SOF Mul_U16_Sat16
        MOV lv_iga_caa6,R4
        MOV R12,#DATA16 04992H
        MOVBZ R13,tco
        CALLS SEG Get_IP_Byte_2D_Table_DWord_YByte, SOF Get_IP_Byte_2D_Table_DWord_YByte
        MOVB lv_iga_c2d2,RL4
        RETS

; ======== ClrBits_lv_ch_060  (@0xc0060) ========
ClrBits_lv_ch_060:
        BCLR lv_ch.0FH
        RETS

