; asw/frq.a66
; Front O2 switching frequency rate-based monitor (IUMPR).
; 0xD45BC-0xD466C  (176 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_RBM_VLS_Up_Frq, ClrBits_state_rbm_vls_up_frq_5c6, Reset_state_rbm_vls_up_frq_5bc
EXTERN  Div_U32_U16_Round32:NEAR

S_D45BC SECTION CODE AT 0D45BCH

; ======== Reset_state_rbm_vls_up_frq_5bc  (@0xd45bc) ========
Reset_state_rbm_vls_up_frq_5bc:
        MOVB state_rbm_vls_up_frq,ZEROS
        MOV rate_rbm_vls_up_frq,ONES
        RETS

; ======== ClrBits_state_rbm_vls_up_frq_5c6  (@0xd45c6) ========
ClrBits_state_rbm_vls_up_frq_5c6:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_vls_up_frq,RL4
        RETS

; ======== Calc_RBM_VLS_Up_Frq  (@0xd45d0) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for VLS Up
        ; Frq: updates state_rbm_vls_up_frq / rate_rbm_vls_up_frq (in-use completion ratio =
        ; numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_VLS_Up_Frq:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB obd_sf.0DH,L_D4666
        MOVB RL4,state_rbm_vls_up_frq
        ANDB RL4,#01H
        JMPR cc_NE,L_D45F2
        MOV R4,lam_bank_1_ls_up_obd2_struct_ls_up_obd2_carrier
        AND R4,#01H
        JMPR cc_EQ,L_D45F2
        JNB lv_act_diagcps.0BH,L_D45F2
        MOVB RL4,#01H
        ORB state_rbm_vls_up_frq,RL4
L_D45F2:                 ; 0xd45f2
        MOVB RL4,state_rbm_vls_up_frq
        ANDB RL4,#02H
        JMPR cc_NE,L_D4620
        JB lv_cat_diag_inh_1.05H,L_D461A
        JB lv_dur_igc_0_err.00H,L_D461A
        JB lv_dur_igc_0_err.01H,L_D461A
        JB lv_dur_igc_0_err.02H,L_D461A
        JB lv_dur_igc_0_err.03H,L_D461A
        JB lv_lam_lim_1_err.0BH,L_D461A
        JB lv_lam_lim_1_err.03H,L_D461A
        JNB lv_er_carb_b4.04H,L_D4620
L_D461A:                 ; 0xd461a
        MOVB RL4,#02H
        ORB state_rbm_vls_up_frq,RL4
L_D4620:                 ; 0xd4620
        MOVB RL4,state_rbm_vls_up_frq
        ANDB RL4,#04H
        JMPR cc_NE,L_D462E
        MOVB RL4,#04H
        ORB state_rbm_vls_up_frq,RL4
L_D462E:                 ; 0xd462e
        MOV R12,ctr_comp_rbm_vls_up_frq
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_vls_up_frq
        CALLS SEG Div_U32_U16_Round32, SOF Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_D4658
        CMP R8,#DATA16 0FFFFH
L_D4658:                 ; 0xd4658
        JMPR cc_C,L_D4660
        MOV rate_rbm_vls_up_frq,ONES
        JMPR cc_UC,L_D4666
L_D4660:                 ; 0xd4660
        MOV R4,R8
        MOV rate_rbm_vls_up_frq,R4
L_D4666:                 ; 0xd4666
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_D45BC ENDS
        END
