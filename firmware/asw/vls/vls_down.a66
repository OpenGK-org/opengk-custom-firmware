; ======== LS_Down_ReadyCheck  (@0xb631c) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signal): Downstream (rear) O2 sensor readiness monitor: debounces
        ; ls_down_carrier vs vls_down ready thresholds + cat temp; sets lv_cam_ad_di_ivvt.0x400.
        ; ------------------------------------------------------------
LS_Down_ReadyCheck:
        JNB lv_cdn_diag_maf_dif_ch_int.0BH,L_B632A
        BCLR diag_fd68.00H
        MOVB g_c244,ZEROS
        BCLR lv_cam_ad_di_ivvt.0AH
        JMPR cc_UC,L_B6340
L_B632A:                 ; 0xb632a
        JNB lv_pl.09H,L_B6340
        MOVB RL4,g_c244
        CMPB RL4,#DATA16 0000AH
        JMPR cc_ULE,L_B633C
        BSET lv_cam_ad_di_ivvt.0AH
        JMPR cc_UC,L_B6340
L_B633C:                 ; 0xb633c
        SUBB g_c244,ONES
L_B6340:                 ; 0xb6340
        JNB lv_cam_ad_di_ivvt.0AH,L_B636E
        MOV R4,lam_bank_1_ls_down_struct_ls_down_carrier
        AND R4,#01H
        JMPR cc_NE,L_B636E
        MOV R4,lam_bank_1_ls_down_struct_vls_down
        CMP R4,DPP0:c_vls_afr_ready
        JMPR cc_UGT,L_B6366
        CMP R4,DPP0:c_vls_afl_ready
        JMPR cc_C,L_B6366
        MOV R5,temp_cat_word
        CMP R5,DPP0:c_temp_cat_down_ls_ready
        JMPR cc_ULE,L_B636E
L_B6366:                 ; 0xb6366
        BSET diag_fd68.00H
        MOV R4,#01H
        OR lam_bank_1_ls_down_struct_ls_down_carrier,R4
L_B636E:                 ; 0xb636e
        MOV R4,lam_bank_1_ls_down_struct_ls_down_carrier
        AND R4,#01H
        JMPR cc_EQ,L_B637C
        MOV g_f960,ZEROS
        RETS
L_B637C:                 ; 0xb637c
        MOV R4,#01H
        MOV g_f960,R4
        RETS

