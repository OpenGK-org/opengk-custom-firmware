        CALLS SEG Get_Diag_Status_Bits, SOF Get_Diag_Status_Bits
        MOVB carb_cod_vls_frq_1,RL4
        MOV R12,#DATA16 00018H
        CALLS SEG Get_Diag_Status_Bits, SOF Get_Diag_Status_Bits
