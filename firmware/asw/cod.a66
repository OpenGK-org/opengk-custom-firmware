        MOV R12,#DATA16 0001EH
        CALLS SEG Get_Diag_Status_Bits, SOF Get_Diag_Status_Bits
        MOVB carb_cod_lsh_down_obd2_1,RL4
        MOV R12,#DATA16 00023H
        CALLS SEG Get_Diag_Status_Bits, SOF Get_Diag_Status_Bits
