; asw/cod.a66
; OBD readiness drive-cycle counter, fault-table init and MAF/TPS variant-coding
; plausibility.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_sum_dc_ready                       EQU  09030DH

PUBLIC  Calc_Ready_DC_Ctr, Diag_Coding_MAF_TPS_Plaus, Init_Fault_Table_1, Init_Fault_Table_2
EXTERN  Get_Diag_Status_Bits:NEAR, OBD_Build_DTC_List:NEAR

S_COD SECTION CODE

; ======== Init_Fault_Table_1  (@0xdb24e) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Init_Fault_Table_1:
        MOV [-R0],R6
        JNB lv_conf_mis.00H,L_DB29A
        JNB lv_conf_mis.01H,L_DB29A
        MOVB RL6,#00H
L_DB25A:                 ; 0xdb25a
        MOVBZ R4,RL6
        AND R4,#DATA16 0000FH
        MOV R5,#01H
        SHL R5,R4
        MOV R4,#DATA16 0F862H
        MOVBZ R2,RL6
        SHR R2,#04H
        SHL R2,#01H
        ADD R4,R2
        MOV R2,[R4]
        OR R2,R5
        MOV [R4],R2
        MOVBZ R4,RL6
        AND R4,#DATA16 0000FH
        MOV R5,#01H
        SHL R5,R4
        MOV R4,#DATA16 0F870H
        MOVBZ R2,RL6
        SHR R2,#04H
        SHL R2,#01H
        ADD R4,R2
        MOV R2,[R4]
        OR R2,R5
        MOV [R4],R2
        ADDB RL6,#01H
        CMPB RL6,#DATA16 00066H
        JMPR cc_C,L_DB25A
L_DB29A:                 ; 0xdb29a
        MOV R6,[R0+]
        RETS

; ======== Calc_Ready_DC_Ctr  (@0xdb29e) ========
        ; ------------------------------------------------------------
        ; OEM (verified by trt/ecu_diag/dtc output signals): OBD readiness drive-cycle counter ready_dc_ctr.
        ; ------------------------------------------------------------
Calc_Ready_DC_Ctr:
        MOV [-R0],R6
        JNB lv_conf_mis.00H,L_DB2D2
        JNB lv_conf_mis.01H,L_DB2D2
        MOVB RL6,#00H
L_DB2AA:                 ; 0xdb2aa
        MOVBZ R4,RL6
        AND R4,#DATA16 0000FH
        MOV R5,#01H
        SHL R5,R4
        MOV R4,#DATA16 0F854H
        MOVBZ R2,RL6
        SHR R2,#04H
        SHL R2,#01H
        ADD R4,R2
        MOV R2,[R4]
        OR R2,R5
        MOV [R4],R2
        ADDB RL6,#01H
        CMPB RL6,#DATA16 00066H
        JMPR cc_C,L_DB2AA
        MOVB ready_dc_ctr,ZEROS
L_DB2D2:                 ; 0xdb2d2
        JNB lv_pl.0FH,L_DB2DA
        MOV obd_rdy_cont,ONES
L_DB2DA:                 ; 0xdb2da
        MOV R6,[R0+]
        RETS

; ======== Init_Fault_Table_2  (@0xdb2de) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Init_Fault_Table_2:
        MOV [-R0],R6
        JNB lv_conf_mis.00H,L_DB30E
        JNB lv_conf_mis.01H,L_DB30E
        MOVB RL6,#00H
L_DB2EA:                 ; 0xdb2ea
        MOVBZ R4,RL6
        AND R4,#DATA16 0000FH
        MOV R5,#01H
        SHL R5,R4
        MOV R4,#DATA16 0D70AH
        MOVBZ R2,RL6
        SHR R2,#04H
        SHL R2,#01H
        ADD R4,R2
        MOV R2,[R4]
        OR R2,R5
        MOV [R4],R2
        ADDB RL6,#01H
        CMPB RL6,#DATA16 00066H
        JMPR cc_C,L_DB2EA
L_DB30E:                 ; 0xdb30e
        MOV R6,[R0+]
        RETS

