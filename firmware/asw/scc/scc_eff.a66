        MOV fac_iga_min_teg_iga_bas,R4
        JMPR cc_UC,L_C7480
L_C7478:                 ; 0xc7478
        MOV R4,DPP0:c_fac_iga_min_teg_iga_bas
        MOV fac_iga_min_teg_iga_bas,R4
L_C7480:                 ; 0xc7480
        MOVB RL4,DPP0:lc_tq_scc_ena_man
        JMPR cc_NE,L_C74D4
        JB lv_ast.07H,L_C74D4
        JB lv_ast.08H,L_C7498
        MOVB RL5,DPP0:lc_tq_scc_inh_man
        JMPR cc_NE,L_C7498
        JB lv_ast.09H,L_C74D4
L_C7498:                 ; 0xc7498
        JNB lv_asr_act.07H,L_C74A2
        MOVB RL4,DPP0:lc_inh_fcut_asr
        JMPR cc_EQ,L_C74D4
L_C74A2:                 ; 0xc74a2
        JNB lv_act_cle_slv_ivvt.02H,L_C74AC
        MOVB RL4,DPP0:lc_inh_fcut_n_max
        JMPR cc_EQ,L_C74D4
L_C74AC:                 ; 0xc74ac
        JNB lv_fcut_fast.00H,L_C74B6
        MOVB RL4,DPP0:lc_inh_fcut_fast
        JMPR cc_EQ,L_C74D4
L_C74B6:                 ; 0xc74b6
        JNB lv_fcut_fast.01H,L_C74C0
        MOVB RL4,DPP0:lc_inh_fcut_tra
        JMPR cc_EQ,L_C74D4
L_C74C0:                 ; 0xc74c0
        JNB lv_asr_req.05H,L_C74D8
        MOVB RL4,DPP0:lc_inh_fcut_gs
        JMPR cc_NE,L_C74D8
        JNB lv_lam_fd2c.09H,L_C74D4
        MOVB RL5,DPP0:lc_inh_fcut_gs_iga
        JMPR cc_EQ,L_C74D8
L_C74D4:                 ; 0xc74d4
        BSET lv_act_aj.09H
        JMPR cc_UC,L_C74DA
L_C74D8:                 ; 0xc74d8
        BCLR lv_act_aj.09H
L_C74DA:                 ; 0xc74da
        MOV R4,g_cdb0
        CMP R4,eff_iga_min_teg
        JMPR cc_NC,L_C74EA
        MOV R9,eff_iga_min_teg
        JMPR cc_UC,L_C7518
L_C74EA:                 ; 0xc74ea
        MOV R12,eff_iga_min_teg
        MOV R13,g_cdb4
        MOV R14,DPP0:c_min_dec_eff_iga_min_teg_1
        CALLS 00FH,Ramp_Down_U16
        MOV g_cdb4,R4
        MOV R12,R4
        MOV R13,eff_iga_min_teg
        CALLS 00FH,sub_r12_r13_rets_r4
        CMP R4,DPP0:c_hys_eff_iga_min_teg
        JMPR cc_C,L_C7514
        MOV R9,eff_iga_min_teg
        JMPR cc_UC,L_C7518
L_C7514:                 ; 0xc7514
        MOV R9,g_cdb4
L_C7518:                 ; 0xc7518
        MOV R12,R9
        MOV R13,g_cdb2
        MOV R14,DPP0:c_min_dec_eff_iga_min_teg_2
        CALLS 00FH,Ramp_Down_U16
        MOV g_cdb2,R4
        MOV R5,eff_iga_min_teg
        MOV g_cdb0,R5
        MOV R12,#DATA16 08000H
        MOV R13,fac_iga_min_teg_iga_bas
        CALLS 00FH,sub_r12_r13_rets_r4
        MOV R12,R4
        MOV R13,g_cdb2
        CALLS 00FH,Mul_Q15_Sat
        MOV R9,R4
        MOV R12,eff_iga_bas_cor
        MOV R13,fac_iga_min_teg_iga_bas
        CALLS 00FH,Mul_Q15_Sat
        MOV R12,R4
        MOV R13,R9
        CALLS 00FH,Add_r12_r13_Return_r4
        MOV eff_iga_min_scc,R4
        MOV R12,eff_egr_hom
        MOV R13,R4
        CALLS 00FH,Mul_Q15_Sat
        MOV R13,R4
        MOV R12,eff_lamb_bas_cor
        CALLS 00FH,Mul_Q15_Sat
        MOV R13,R4
        MOV R12,tqi_ref
        CALLS 00FH,Mul_Q15_Sat_Signed
        MOV tqi_ref_iga_min_scc,R4
        MOVB RL4,DPP0:lc_eff_scc_sp_man
        JMPR cc_EQ,L_C7594
        MOV R4,DPP0:c_eff_scc_sp_man
