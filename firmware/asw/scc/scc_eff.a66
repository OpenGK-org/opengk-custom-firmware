c_min_dec_eff_iga_min_teg_2          EQU  090616H

PUBLIC  Calc_Eff_SCC_Av, Calc_Eff_SCC_Pattern, Reset_Eff_SCC
EXTERN  Add_r12_r13_Return_r4:NEAR, Calc_Fcut_Fast:NEAR, Calc_Inj_Pattern:NEAR, Div_Frac_U16_Q16:NEAR
EXTERN  Get_Byte_2D_Table_DWord_YWord:NEAR, Mul_Q15_Sat:NEAR, Mul_Q15_Sat_Signed:NEAR, Ramp_Down_U16:NEAR
EXTERN  sub_r12_r13_rets_r4:NEAR

S_C73D8 SECTION CODE AT 0C73D8H

; ======== Reset_Eff_SCC  (@0xc73d8) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Torque based Pattern Calculation (eff_scc_* reset)
        ; ------------------------------------------------------------
Reset_Eff_SCC:
        MOV R4,#DATA16 08000H
        MOV eff_scc_bas,R4
        MOV R5,#DATA16 08000H
        MOV eff_scc_sp,R5
        MOV R2,#DATA16 08000H
        MOV eff_scc_sp_hys,R2
        RETS

; ======== Calc_Eff_SCC_Av  (@0xc73f2) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by scc/acc output signals): Scavenging/secondary-combustion efficiency average:
        ; eff_scc_av / nr_pat_scc.
        ; ------------------------------------------------------------
Calc_Eff_SCC_Av:
        MOV eff_scc_av,ZEROS
        MOVB nr_pat_scc,ZEROS
        BCLR lv_act_aj.0AH
        CALLS 00CH,Calc_Inj_Pattern
        RETS

; ======== Calc_Eff_SCC_Pattern  (@0xc7402) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (EMS31, verified): Torque based Pattern Calculation (eff_scc_bas)
        ; ------------------------------------------------------------
Calc_Eff_SCC_Pattern:
        MOV [-R0],R9
        CALLS 00BH,Calc_Fcut_Fast
        MOVB RL4,DPP0:lc_ena_eff_scc_bas_man
        JMPR cc_EQ,L_C7418
        MOV R4,DPP0:c_eff_scc_bas_man
        MOV eff_scc_bas,R4
        JMPR cc_UC,L_C742E
L_C7418:                 ; 0xc7418
        JNB lv_lam_fd2c.0EH,L_C7426
        MOV R4,lv_lam_f758
        MOV eff_scc_bas,R4
        JMPR cc_UC,L_C742E
L_C7426:                 ; 0xc7426
        MOV R4,#DATA16 08000H
        MOV eff_scc_bas,R4
L_C742E:                 ; 0xc742e
        MOV R4,eff_scc_bas
        CMP R4,#DATA16 08000H
        JMPR cc_C,L_C746E
        JNB lv_asr_req.05H,L_C7446
        MOVB RL4,DPP0:lc_ena_fcut_tot_gs
        JMPR cc_EQ,L_C7446
        JB lv_lam_fd2c.0DH,L_C746E
L_C7446:                 ; 0xc7446
        JNB lv_asr_act.07H,L_C7450
        MOVB RL4,DPP0:lc_ena_fcut_tot_asr
        JMPR cc_NE,L_C746E
L_C7450:                 ; 0xc7450
        JNB lv_fcut_fast.00H,L_C745A
        MOVB RL4,DPP0:lc_ena_fcut_tot_fast
        JMPR cc_NE,L_C746E
L_C745A:                 ; 0xc745a
        JNB lv_fcut_fast.01H,L_C7464
        MOVB RL4,DPP0:lc_ena_fcut_tot_tra
        JMPR cc_NE,L_C746E
L_C7464:                 ; 0xc7464
        JNB lv_act_cle_slv_ivvt.02H,L_C7478
        MOVB RL4,DPP0:lc_ena_fcut_tot_n_max
        JMPR cc_EQ,L_C7478
L_C746E:                 ; 0xc746e
