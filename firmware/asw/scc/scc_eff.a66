        JMPR cc_UC,L_C75C8
L_C7594:                 ; 0xc7594
        JNB lv_act_aj.09H,L_C75C0
        MOV R4,tqi_ref_iga_min_scc
        CMP R4,tqi_req_fast
        JMPR cc_SGT,L_C75AC
        MOV R5,#DATA16 08000H
        MOV eff_scc_sp,R5
        JMPR cc_UC,L_C75C8
L_C75AC:                 ; 0xc75ac
        MOV R12,tqi_req_fast
        MOV R13,tqi_ref_iga_min_scc
        CALLS 00FH,Div_Frac_U16_Q16
        SHR R4,#01H
        MOV eff_scc_sp,R4
        JMPR cc_UC,L_C75C8
L_C75C0:                 ; 0xc75c0
        MOV R4,#DATA16 08000H
        MOV eff_scc_sp,R4
L_C75C8:                 ; 0xc75c8
        MOV R12,eff_scc_sp
        MOV R13,eff_scc_sp_hys
        CALLS 00FH,sub_r12_r13_rets_r4
        CMP R4,DPP0:c_eff_scc_sp_hys
        JMPR cc_UGT,L_C75F2
        MOV R4,#DATA16 08000H
        SUB R4,DPP0:c_eff_scc_sp_hys
        CMP R4,eff_scc_sp
        JMPR cc_ULE,L_C75F2
        MOV R4,eff_scc_sp
        CMP R4,eff_scc_sp_hys
        JMPR cc_NC,L_C75FA
L_C75F2:                 ; 0xc75f2
        MOV R4,eff_scc_sp
        MOV eff_scc_sp_hys,R4
L_C75FA:                 ; 0xc75fa
        MOV R12,#DATA16 04C36H
        MOV R13,eff_scc_sp_hys
        CALLS 00FH,Get_Byte_2D_Table_DWord_YWord
        MOVB nr_pat_scc,RL4
        CALLS 00CH,Calc_Inj_Pattern
        MOV R9,[R0+]
        RETS

S_C73D8 ENDS
        END
