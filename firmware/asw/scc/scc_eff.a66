; asw/scc/scc_eff.a66
; Torque pattern efficiency (eff_scc): reset, base and average.
; 0xC73D8-0xC7612  (570 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
lc_eff_scc_sp_man                    EQU  09045AH
lc_ena_eff_scc_bas_man               EQU  09045EH
