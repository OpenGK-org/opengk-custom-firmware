; asw/imob/imob_cipher.a66
; SMARTRA cipher (shift register clock, output S-box) and response compare.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  SMARTRA_cipher_clock_bit, SMARTRA_cipher_output_sbox, SMARTRA_load_response_compare

S_IMOB_CIPHER SECTION CODE

; ======== SMARTRA_load_response_compare  (@0xbdf20) ========
        ; Loads expected challenge/response compare bytes from the RAM mirror @0x90000 (offsets from
        ; param_1/param_2) into the cipher state ca5e:ca60:ca62 (48-bit shift register), seeds DAT_00c2a4=0x80
        ; (bit counter), clears c2a6 and lv_er_carb_b4&4 (phase flag). Primes SMARTRA_cipher_clock_bit /
        ; SMARTRA_cipher_output_sbox.
SMARTRA_load_response_compare:
        MOV imob_ca66,R14
        MOV imob_ca64,R12
        MOVB imob_ca5f,[R13]
        MOVB RL4,[R13+#01H]
        MOVB imob_ca5e,RL4
        MOVB RL5,[R13+#02H]
        MOVB imob_ca61,RL5
        MOVB RL3,[R13+#03H]
        MOVB imob_ca60,RL3
        MOV R4,imob_ca64
        MOVB RL2,[R4+#04H]
        MOVB imob_ca63,RL2
        MOVB RL1,[R4+#05H]
        MOVB imob_ca62,RL1
        MOVB RL4,#DATA16 00080H
        MOVB imob_c2a4,RL4
        MOVB imob_c2a5,ZEROS
        BCLR lv_er_carb_b4.02H
        MOVB imob_c2a6,ZEROS
        RETS

; ======== SMARTRA_cipher_clock_bit  (@0xbdf6c) ========
        ; SMARTRA cipher clock (one step). 48-bit Fibonacci-style shift register across ca5e:ca60:ca62,
        ; feedback tap masks 0xB380 / 0x8322 / 0x0073, nonlinear mixing via PSW carry/parity and S-box lookup
        ; @0xA08E8. Processes 4 bytes x 8 bits (DAT_00c2a4 = bit ctr, DAT_00c2a5 = byte ctr <4);
        ; lv_er_carb_b4&4 selects the second phase. Core SMARTRA2 transponder crypto primitive; output feeds
        ; the response verified in SMARTRA_runtime_auth_sm s5.
SMARTRA_cipher_clock_bit:
        MOV [-R0],R9
        CALLS SEG SMARTRA_cipher_output_sbox, SOF SMARTRA_cipher_output_sbox
        MOVB imob_c2a6,RL4
        JNB lv_er_carb_b4.02H,L_BDFA8
        MOV R9,imob_ca5e
        AND R9,#DATA16 0B380H
        MOV R4,imob_ca60
        AND R4,#DATA16 08322H
        XOR R9,R4
        MOV R4,imob_ca62
        AND R4,#DATA16 00073H
        XOR R9,R4
        MOV R4,#DATA16 000FFH
        AND R4,R9
        MOV R5,R9
        SHR R5,#08H
        AND R5,#DATA16 000FFH
        XOR R4,R5
        MOV R9,R4
L_BDFA8:                 ; 0xbdfa8
        MOV R4,imob_ca5e
        SHL R4,#01H
        MOV imob_ca5e,R4
        MOV R5,imob_ca60
        SHR R5,#0FH
        AND R5,#01H
        MOV R2,imob_ca5e
        AND R2,#DATA16 0FFFEH
        OR R2,R5
        MOV imob_ca5e,R2
        MOV R5,imob_ca60
        SHL R5,#01H
        MOV imob_ca60,R5
        MOV R3,imob_ca62
        SHR R3,#0FH
        AND R3,#01H
        MOV R1,imob_ca60
        AND R1,#DATA16 0FFFEH
        OR R1,R3
        MOV imob_ca60,R1
        MOV R3,imob_ca62
        SHL R3,#01H
        MOV imob_ca62,R3
        JB lv_er_carb_b4.02H,L_BE060
        MOV R2,imob_ca66
        MOVBZ R3,imob_c2a5
        ADD R2,R3
        MOVB RL4,[R2]
        MOVBZ R4,RL4
        MOVBZ R2,imob_c2a4
        AND R2,R4
        MOV R3,imob_ca64
        MOVBZ R4,imob_c2a5
        ADD R3,R4
        MOVB RL4,[R3]
        MOVBZ R4,RL4
        MOVBZ R3,imob_c2a4
        AND R3,R4
        XOR R2,R3
        BMOVN PSW.06H,PSW.03H
        MOV R4,#00H
        BMOV R4.00H,PSW.06H
        MOVBZ R2,imob_c2a6
        XOR R4,R2
        JMPR cc_EQ,L_BE038
        MOV R4,#01H
        OR imob_ca62,R4
L_BE038:                 ; 0xbe038
        MOVBZ R4,imob_c2a4
        SHR R4,#01H
        MOVB imob_c2a4,RL4
        CMPB RL4,#00H
        JMPR cc_NE,L_BE08A
        SUBB imob_c2a5,ONES
        MOVB RL5,imob_c2a5
        CMPB RL5,#04H
        JMPR cc_NC,L_BE05C
        MOVB RL3,#DATA16 00080H
        MOVB imob_c2a4,RL3
        JMPR cc_UC,L_BE08A
L_BE05C:                 ; 0xbe05c
        BSET lv_er_carb_b4.02H
        JMPR cc_UC,L_BE08A
L_BE060:                 ; 0xbe060
        MOV R4,#DATA16 00010H
        MOV R5,R9
        MOV 0FE0EH,R5
        DIVU R4
        MOV R5,MDH_FE0C
        MOVB RL4,[R5+#048E8H]
        MOVBZ R4,RL4
        MOV R2,R9
        SHR R2,#04H
        MOVB RL5,[R2+#048E8H]
        MOVBZ R5,RL5
        XOR R4,R5
        JMPR cc_EQ,L_BE08A
        MOV R4,#01H
        OR imob_ca62,R4
L_BE08A:                 ; 0xbe08a
        MOV R9,[R0+]
        RETS

; ======== SMARTRA_cipher_output_sbox  (@0xbe08e) ========
        ; SMARTRA cipher nonlinear output tap. Selects bits from the 48-bit register (ca5e/ca60/ca62) via
        ; one-hot masks 0x9E34 / 0x8E66, assembles a 4-bit index and returns the S-box byte @0xA08C8. Called
        ; each step by SMARTRA_cipher_clock_bit.
SMARTRA_cipher_output_sbox:
        MOV [-R0],R7
        MOV [-R0],R6
        MOVB RL7,#00H
        MOVB RL6,#00H
        MOV R4,imob_ca62
        SHR R4,#01H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca62
        SHR R4,#03H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca62
        SHR R4,#04H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca62
        SHR R4,#0DH
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R4,RL6
        MOV R5,#DATA16 08000H
        SHR R5,R4
        AND R5,#DATA16 09E34H
        JMPR cc_EQ,L_BE0DA
        ADDB RL7,#01H
L_BE0DA:                 ; 0xbe0da
        MOVBZ R7,RL7
        SHL R7,#01H
        MOVB RL6,#00H
        MOV R4,imob_ca62
        SHR R4,#0EH
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca60
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca60
        SHR R4,#02H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca60
        SHR R4,#03H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R4,RL6
        MOV R5,#DATA16 08000H
        SHR R5,R4
        AND R5,#DATA16 08E66H
        JMPR cc_EQ,L_BE122
        ADDB RL7,#01H
L_BE122:                 ; 0xbe122
        MOVBZ R7,RL7
        SHL R7,#01H
        MOVB RL6,#00H
        MOV R4,imob_ca60
        SHR R4,#05H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca60
        SHR R4,#08H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca60
        SHR R4,#0AH
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca60
        SHR R4,#0EH
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R4,RL6
        MOV R5,#DATA16 08000H
        SHR R5,R4
        AND R5,#DATA16 08E66H
        JMPR cc_EQ,L_BE16C
        ADDB RL7,#01H
L_BE16C:                 ; 0xbe16c
        MOVBZ R7,RL7
        SHL R7,#01H
        MOVB RL6,#00H
        MOV R4,imob_ca5e
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca5e
        SHR R4,#01H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca5e
        SHR R4,#03H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca5e
        SHR R4,#07H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R4,RL6
        MOV R5,#DATA16 08000H
        SHR R5,R4
        AND R5,#DATA16 08E66H
        JMPR cc_EQ,L_BE1B4
        ADDB RL7,#01H
L_BE1B4:                 ; 0xbe1b4
        MOVBZ R7,RL7
        SHL R7,#01H
        MOVB RL6,#00H
        MOV R4,imob_ca5e
        SHR R4,#09H
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca5e
        SHR R4,#0AH
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca5e
        SHR R4,#0CH
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R6,RL6
        SHL R6,#01H
        MOV R4,imob_ca5e
        SHR R4,#0DH
        AND R4,#01H
        ORB RL6,RL4
        MOVBZ R4,RL6
        MOV R5,#DATA16 08000H
        SHR R5,R4
        AND R5,#DATA16 09E34H
        JMPR cc_EQ,L_BE1FE
        ADDB RL7,#01H
L_BE1FE:                 ; 0xbe1fe
        MOVBZ R4,RL7
        MOV R5,R4
        MOVB RL4,[R5+#048C8H]
        MOV R6,[R0+]
        MOV R7,[R0+]
        RETS

S_IMOB_CIPHER ENDS
        END
