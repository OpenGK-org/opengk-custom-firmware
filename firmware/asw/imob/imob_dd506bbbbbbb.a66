        BCLR imob_bw.09H
        MOVB RL4,#06H
        MOVB smartra_cmd,RL4
        JMPA cc_UC,L_BCF16

; ======== SMARTRA_cmd_Arm  (@0xbcd2e) ========
        ; ------------------------------------------------------------
        ; OEM (verified by imob/smartra output signals): SMARTRA cmd arm: smartra_cmd / imob_bw /
