; ======== SMARTRA_runtime_cmd_sm  (@0xbcc08) ========
        ; ------------------------------------------------------------
        ; SMARTRA immobilizer RUN-TIME command state machine. switch(smartra_cmd) 0-7: 0=idle; 1=send init
        ; query(0x06)->2; 2=SMARTRA_runtime_auth_sm(); 3=success: clear immob DTCs->6; 4=fail/anti-tamper->6;
        ; 5=reset->0; 6=finalize warn-lamp+DTC->0; 7=err subcode->DTC->1. Tail enforces timeout/no-response ->
        ; fmy|0x800,cmd=4. Runtime arms: SMARTRA_rt_VerifyResp, SMARTRA_rt_SetCmdFail.
        ; ------------------------------------------------------------
SMARTRA_runtime_cmd_sm:
        BCLR lv_fmy_imob.02H
        BCLR lv_fmy_imob.01H
        BCLR imob_bw.01H
        BSET imob_bw.08H
L_BCC10:                 ; 0xbcc10
        MOVB RL4,imob_data_ram_state_imob
        CMPB RL4,#01H
        JMPR cc_NE,L_BCC22
        JNB lv_fmy_imob.01H,L_BCC22
        MOVB RL5,#05H
        MOVB smartra_cmd,RL5
L_BCC22:                 ; 0xbcc22
        MOVB RL4,smartra_send_state
        CMPB RL4,#01H
        JMPR cc_NE,L_BCC50
        MOVB RL5,imob_c28f
        CMPB RL5,#01H
        JMPR cc_ULE,L_BCC50
        JB smartra_comms_status.0DH,L_BCC42
        JB smartra_comms_status.0EH,L_BCC42
        JB smartra_comms_status.0FH,L_BCC42
        JNB lv_err_com_resp_imob.00H,L_BCC50
L_BCC42:                 ; 0xbcc42
        ADDB imob_c28f,ONES
        CALLS SEG SMARTRA_clear_comms_timeout_flags, SOF SMARTRA_clear_comms_timeout_flags
        MOVB RL4,#01H
        MOVB smartra_cmd,RL4
L_BCC50:                 ; 0xbcc50
        JB can_fd58.09H,L_BCC64
        MOVB RL4,smartra_cmd
        JMPR cc_EQ,L_BCC64
        MOVB smartra_cmd,ZEROS
        JB imob_bw.02H,L_BCC64
        BSET imob_bw.08H
L_BCC64:                 ; 0xbcc64
        MOVB RL4,smartra_cmd
        CMPB RL4,#07H
        JMPA cc_UGT,L_BCF10
        MOVBZ R4,RL4
        SHL R4,#01H
        ADD R4,#DATA16 04918H
        MOV R4,[R4]
        JMPI cc_UC,[R4]

; ======== SMARTRA_cmd_Init  (@0xbcc7a) ========
        ; ------------------------------------------------------------
        ; OEM (verified by imob/smartra output signals): SMARTRA runtime cmd arm: init query (smartra_cmd,
        ; flush RX, lv_fmy_imob).
        ; ------------------------------------------------------------
SMARTRA_cmd_Init:
        BCLR lv_fmy_imob.00H
        JB smartra_comms_status.0CH,L_BCC84
        JMPA cc_UC,L_BCF16
L_BCC84:                 ; 0xbcc84
        MOVB RL4,#02H
        MOVB smartra_frame_buf,RL4
        MOVB RL4,#06H
        MOVB smartra_tx_cmd,RL4

; ======== SMARTRA_eval_comms_result  (@0xbcc90) ========
SMARTRA_eval_comms_result:
        CALLS SEG SMARTRA_flush_RX_buffers, SOF SMARTRA_flush_RX_buffers
        MOVB RL4,#02H
        MOVB smartra_cmd,RL4
        MOVB RL5,#01H
        MOVB smartra_send_state,RL5
        JMPA cc_UC,L_BCF16

; ======== SMARTRA_cmd_RuntimeAuth  (@0xbcca4) ========
        ; ------------------------------------------------------------
        ; OEM (verified by imob/smartra output signals): SMARTRA runtime cmd arm: calls
        ; SMARTRA_runtime_auth_sm; sets ans_err_com_imob.
        ; ------------------------------------------------------------
SMARTRA_cmd_RuntimeAuth:
        CALLS SEG SMARTRA_runtime_auth_sm, SOF SMARTRA_runtime_auth_sm      ; -> SMARTRA_runtime_auth_sm (run-time immobilizer auth dispatched from here)
        JMPA cc_UC,L_BCF16

S_BC8E8 ENDS
        END
