        BCLR lv_fmy_imob.0FH
        BCLR lv_er_carb_b4.00H
        MOVB RL4,ctr_imob_nvm_2
        CMPB RL4,#03H
        JMPR cc_NC,L_BCAFC
        MOV R4,diag_ca48
        CMP R4,imob_sdr_b5
        JMPR cc_NE,L_BCAFC
        BSET lv_fmy_imob.01H
