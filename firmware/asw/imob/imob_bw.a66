S_IMOB_BW SECTION CODE

; ======== Imob_Init  (@0xbc2f0) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Immobilizer interface init/reset (smartra_proto_step=1)
        ; ------------------------------------------------------------
Imob_Init:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        SUB R0,#DATA16 00008H
        BCLR lv_fmy_imob.02H
        BCLR lv_fmy_imob.01H
        MOVB diag_c283,ZEROS
        MOVB imob_new_key0,ZEROS
        MOVB imob_new_key1,ZEROS
        MOVB imob_new_key2,ZEROS
        MOVB imob_new_key3,ZEROS
        BCLR lv_fmy_imob.00H
        MOVB RL4,DPP0:c_ign_dly_imob
        MOVB t_ign_dly_imob,RL4
        BCLR lv_fmy_imob.0EH
        JB state_out_req.0AH,L_BC33A
        MOV R4,imob_pwm_base
        MOV R2,#00H
        MULU R4,R2
        MOV R5,MDH_FE0C
        MOV R4,R5
