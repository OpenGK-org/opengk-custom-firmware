        MOV imob_f9de,R4
L_BC33A:                 ; 0xbc33a
        BCLR lv_fmy_imob.08H
        MOVB key_state_imob,ZEROS
        MOVB RL4,#01H
        MOVB smartra_proto_step,RL4
        MOV R4,#01H
        MOV lv_imob_init_done,R4
        MOV R5,#DATA16 0CA08H
        MOV R4,R5
        CALLS SEG Read_DPP_Reg, SOF Read_DPP_Reg
        MOV [R0+#02H],R4
        MOV [R0+#04H],R5
        MOVB RL4,#00H
        MOVB [R0],RL4
        MOVB RL6,#00H
L_BC364:                 ; 0xbc364
        MOV R4,diag_f890
        MOV R5,diag_f892
        ADD R4,#DATA16 00102H
        MOVBZ R2,RL6
        ADD R4,R2
        EXTP R5, #01H
        MOVB RL3,[R4]
        CMPB RL3,#DATA16 000FFH
        JMPR cc_EQ,L_BC382
        MOVB RL4,#01H
        MOVB [R0],RL4
L_BC382:                 ; 0xbc382
        ADDB RL6,#01H
        MOVBZ R4,RL6
        CMP R4,#DATA16 00035H
        JMPR cc_SLT,L_BC364
        MOVB RL6,#00H
L_BC38E:                 ; 0xbc38e
        MOV R4,diag_f890
        MOV R5,diag_f892
        ADD R4,#DATA16 00138H
        MOVBZ R2,RL6
        ADD R4,R2
        EXTP R5, #01H
        MOVB RL3,[R4]
        CMPB RL3,#DATA16 000FFH
        JMPR cc_EQ,L_BC3AC
        MOVB RL4,#01H
        MOVB [R0],RL4
L_BC3AC:                 ; 0xbc3ac
        ADDB RL6,#01H
        MOVBZ R4,RL6
        CMP R4,#DATA16 00035H
        JMPR cc_SLT,L_BC38E
        MOVB RL4,[R0]
        CMPB RL4,#01H
        JMPA cc_NE,L_BC554
        JB can_fd58.00H,L_BC3C6
        JMPA cc_UC,L_BC554
L_BC3C6:                 ; 0xbc3c6
        MOVB RL6,#00H
        MOVB RL7,#00H
        JMPR cc_UC,L_BC47C
L_BC3CC:                 ; 0xbc3cc
        CMPB RL7,#03H
        JMPR cc_NC,L_BC47A
        MOVB RL7,#00H
        MOV R4,diag_f890
        MOV R5,diag_f892
        ADD R4,#DATA16 00102H
        MOVBZ R2,RL6
        ADD R4,R2
        EXTP R5, #01H
        MOVB RL3,[R4]
        MOV R8,R3
        MOV R4,diag_f890
        MOV R5,diag_f892
        ADD R4,#DATA16 00138H
        MOVBZ R2,RL6
        ADD R4,R2
        EXTP R5, #01H
        MOVB RL3,[R4]
        MOV R9,R3
        MOV R4,diag_f890
        MOV R5,diag_f892
        ADD R4,#DATA16 0016EH
        MOVBZ R2,RL6
        ADD R4,R2
        EXTP R5, #01H
        MOVB RL3,[R4]
        MOVB [R0+#06H],RL3
        MOV R4,R8
        MOV R5,R9
        CMPB RL4,RL5
        JMPR cc_NE,L_BC432
        MOV R4,R8
        MOV R10,[R0+#02H]
        MOV R11,[R0+#04H]
        MOVBZ R5,RL6
        ADD R10,R5
        EXTP R11, #01H
        MOVB [R10],RL4
        JMPR cc_UC,L_BC436
L_BC432:                 ; 0xbc432
        MOVB RL7,#01H
        BSET lv_fmy_imob.04H
L_BC436:                 ; 0xbc436
        MOVB RL4,[R0+#06H]
        MOV R5,R9
        CMPB RL5,RL4
        JMPR cc_NE,L_BC454
        MOV R5,R9
        MOV R10,[R0+#02H]
        MOV R11,[R0+#04H]
        MOVBZ R4,RL6
        ADD R10,R4
        EXTP R11, #01H
        MOVB [R10],RL5
        JMPR cc_UC,L_BC458
L_BC454:                 ; 0xbc454
        ADDB RL7,#01H
        BSET lv_fmy_imob.04H
L_BC458:                 ; 0xbc458
        MOVB RL4,[R0+#06H]
        MOV R5,R8
        CMPB RL5,RL4
        JMPR cc_NE,L_BC476
        MOV R5,R8
        MOV R10,[R0+#02H]
        MOV R11,[R0+#04H]
        MOVBZ R4,RL6
        ADD R10,R4
        EXTP R11, #01H
        MOVB [R10],RL5
        JMPR cc_UC,L_BC47A
L_BC476:                 ; 0xbc476
        ADDB RL7,#01H
        BSET lv_fmy_imob.04H
L_BC47A:                 ; 0xbc47a
        ADDB RL6,#01H
L_BC47C:                 ; 0xbc47c
        MOVBZ R4,RL6
        CMP R4,#DATA16 00035H
        JMPR cc_SLT,L_BC3CC
        CMPB RL7,#03H
        JMPR cc_EQ,L_BC498
        MOVB RL4,imob_eeprom_block_sig
        CMPB RL4,#DATA16 00039H
        JMPR cc_EQ,L_BC4A8
        CMPB RL4,#DATA16 000ACH
        JMPR cc_EQ,L_BC4A8
L_BC498:                 ; 0xbc498
        MOVB imob_data_ram_state_imob,ZEROS
        BSET imob_bw.08H
        BSET lv_conf_mis.08H
        BSET bl_mode_status_flags.04H
        BSET lv_fmy_imob.04H
        JMPA cc_UC,L_BC5F2
L_BC4A8:                 ; 0xbc4a8
        MOV R12,#DATA16 0E7E2H
        MOV R13,#DATA16 00000H
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#08H
        CALLS SEG xor_routine, SOF xor_routine
        CMP R4,cks_imob_nvm
        JMPR cc_NE,L_BC50E
        MOV R4,cks_imob_nvm
        JMPR cc_EQ,L_BC50E
        MOV R5,bw_imob_nvm
        MOV imob_bw,R5
        MOVB RL4,key_nr_learn_dflt_imob
        CMPB RL4,imob_data_ctl_key_nr_learn_imob
        JMPR cc_ULE,L_BC4E6
        MOVB imob_data_ctl_key_nr_learn_imob,RL4
L_BC4E6:                 ; 0xbc4e6
        MOVB RL4,ctr_dflt_imob_1
        CMPB RL4,ctr_imob_nvm_1
        JMPR cc_ULE,L_BC4F4
        MOVB ctr_imob_nvm_1,RL4
L_BC4F4:                 ; 0xbc4f4
        MOVB RL4,ctr_dflt_imob_2
        CMPB RL4,ctr_imob_nvm_2
        JMPR cc_ULE,L_BC502
        MOVB ctr_imob_nvm_2,RL4
L_BC502:                 ; 0xbc502
        JB imob_bw.01H,L_BC544
        JB imob_bw.02H,L_BC544
        BSET imob_bw.09H
        JMPR cc_UC,L_BC544
L_BC50E:                 ; 0xbc50e
        MOV R4,bw_imob_dflt
        MOV imob_bw,R4
        BCLR imob_bw.00H
        BCLR imob_bw.01H
        BCLR imob_bw.02H
        BCLR imob_bw.04H
        BCLR lv_fmy_imob.09H
        BCLR imob_bw.03H
        BCLR imob_bw.08H
        MOVB imob_data_ctl_n_32_imob,ZEROS
        MOVB imob_data_ctl_vs_imob,ZEROS
        MOVB RL4,key_nr_learn_dflt_imob
        MOVB imob_data_ctl_key_nr_learn_imob,RL4
        MOVB RL5,ctr_dflt_imob_1
        MOVB ctr_imob_nvm_1,RL5
        MOVB RL3,ctr_dflt_imob_2
        MOVB ctr_imob_nvm_2,RL3
L_BC544:                 ; 0xbc544
        MOVB RL4,imob_eeprom_block_sig
        CMPB RL4,#DATA16 000ACH
        JMPR cc_NE,L_BC5F2
        BSET lv_conf_mis.08H
        BSET bl_mode_status_flags.04H
        JMPR cc_UC,L_BC5F2
L_BC554:                 ; 0xbc554
        BCLR lv_fmy_imob.04H
        MOVB RL4,#02H
        MOVB imob_data_ram_state_imob,RL4
        MOVB RL5,#DATA16 00039H
        MOVB imob_eeprom_block_sig,RL5
        MOVB imob_data_ram_ctr_key_fast_imob,ZEROS
        CALLS SEG SMARTRA_disable, SOF SMARTRA_disable
        BCLR imob_bw.09H
        MOV imob_data_ram_ctr_sdr_1_imob,ZEROS
        MOV imob_data_ram_ctr_sdr_2_imob,ZEROS
        MOV imob_data_ram_ctr_sdr_3_imob,ZEROS
        MOV imob_data_ram_ctr_sdr_4_imob,ZEROS
        MOVB q_imob_seed_material,ZEROS
        MOVB imob_sdr_b0,ZEROS
        MOVB imob_sdr_b1,ZEROS
        MOVB imob_sdr_b2,ZEROS
        MOVB imob_sdr_b3,ZEROS
        MOVB imob_sdr_b4,ZEROS
        MOVB q_imob_resp_key,ZEROS
        MOVB imob_ca25,ZEROS
        MOVB imob_ca26,ZEROS
        MOV imob_sdr_b5,ZEROS
        MOVB RL4,#05H
        MOVB imob_sdr_ctr,RL4
        MOVB imob_ca2a,ZEROS
        MOVB imob_data_ram_ctr_lih_imob,ZEROS
        MOVB ctr_dflt_imob_1,ZEROS
        MOVB ctr_imob_nvm_1,ZEROS
        MOVB key_nr_learn_dflt_imob,ZEROS
        MOVB imob_data_ctl_key_nr_learn_imob,ZEROS
        MOVB ctr_dflt_imob_2,ZEROS
        MOVB ctr_imob_nvm_2,ZEROS
        MOVB imob_auth_state,ZEROS
        MOV R4,#DATA16 0A69AH
        MOV R5,#DATA16 0C359H
        MOV smartra_lcg_seed,R4
        MOV smartra_lcg_const,R5
        BCLR imob_bw.00H
        BCLR imob_bw.01H
        BCLR imob_bw.02H
        BCLR imob_bw.03H
        BCLR imob_bw.04H
        BCLR lv_fmy_imob.09H
        MOVB diag_ca3c,ZEROS
        BCLR imob_bw.0BH
L_BC5F2:                 ; 0xbc5f2
        JNB lv_conf_mis.08H,Imob_BW_Update_2
        MOV R4,imob_key_table
        MOV R5,imob_key_tab_c
        MOV key_imob_1,R4
        MOV imob_ca50,R5
        MOV R4,imob_ca10
        MOV R5,imob_ca12
        MOV key_imob_2,R4
        MOV imob_ca54,R5
        MOV R4,imob_ca14
        MOV R5,imob_ca16
        MOV key_imob_3,R4
        MOV imob_ca58,R5
        MOV R4,imob_ca18
        MOV R5,imob_ca1a
        MOV key_imob_4,R4
        MOV imob_ca5c,R5
        MOV R2,#01H
        MOV req_imob_a,R2
        MOV R3,#01H
        MOV req_imob_b,R3
        MOV R1,#01H
        MOV req_imob_c,R1
        MOVB RL4,imob_data_ram_state_imob
        CMPB RL4,#04H
        JMPR cc_UGT,Imob_SetFmy
        MOVBZ R4,RL4
        SHL R4,#01H
        ADD R4,#DATA16 048F8H
        MOV R4,[R4]
        JMPI cc_UC,[R4]

; ======== Imob_SecuritySpeedCheck  (@0xbc65c) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Immobilizer: security speed/rpm check (c_vs/n_secu_imob)
        ; ------------------------------------------------------------
Imob_SecuritySpeedCheck:
        MOVB RL4,imob_data_ctl_vs_imob
        CMPB RL4,DPP0:c_vs_secu_1_imob
        JMPR cc_ULE,L_BC67C
        JB imob_bw.00H,L_BC67C
        MOVB RL5,imob_data_ctl_n_32_imob
        CMPB RL5,DPP0:c_n_secu_1_imob
        JMPR cc_ULE,L_BC67C
        JNB imob_bw.01H,L_BC67C
        BSET lv_fmy_imob.0CH
        JMPR cc_UC,L_BC68E
L_BC67C:                 ; 0xbc67c
        BCLR lv_fmy_imob.0CH
        JMPR cc_UC,L_BC68E

; ======== Imob_BW_Update  (@0xbc680) ========
        ; ------------------------------------------------------------
        ; OEM (verified by imob/smartra output signals): Immobilizer status word imob_bw update +
        ; Imob_DTC_update_comms.
        ; ------------------------------------------------------------
Imob_BW_Update:
        BSET imob_bw.08H
        JMPR cc_UC,L_BC68E

; ======== Imob_SetFmy  (@0xbc684) ========
        ; ------------------------------------------------------------
        ; OEM (verified by imob/smartra output signals): Set immobilizer family/learn flag lv_fmy_imob + DTC
        ; update.
        ; ------------------------------------------------------------
Imob_SetFmy:
        BSET lv_fmy_imob.0EH
        JMPR cc_UC,L_BC68E

; ======== Imob_BW_Update_2  (@0xbc688) ========
        ; ------------------------------------------------------------
        ; OEM (verified by imob/smartra output signals): Immobilizer status word imob_bw update (variant).
        ; ------------------------------------------------------------
Imob_BW_Update_2:
        BCLR imob_bw.08H
        MOVB imob_ca2a,ZEROS
L_BC68E:                 ; 0xbc68e
        CALLS SEG Imob_DTC_update_comms, SOF Imob_DTC_update_comms
        ADD R0,#DATA16 00008H
        MOV R6,[R0+]
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_IMOB_BW ENDS
        END
