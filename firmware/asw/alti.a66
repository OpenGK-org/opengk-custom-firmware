; asw/alti.a66
; Altitude correction factor for the MAF signal.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_MAF_Alti_Cor, Calc_maf_fac_alti_mmv
EXTERN  Div_U32_U16_Round:NEAR

S_ALTI SECTION CODE

; ======== Calc_maf_fac_alti_mmv  (@0xc36e0) ========
        ; ------------------------------------------------------------
        ; Named from single dominant output signal (auto-derived, lower confidence than hand-verified).
        ; ------------------------------------------------------------
Calc_maf_fac_alti_mmv:
        MOV R12,amp_ad
        MOV R13,#00H
        MOV R4,R12
        SHL R12,#08H
        SHL R13,#08H
        SHR R4,#08H
        OR R13,R4
        MOV R14,#DATA16 02FADH
        CALLS SEG Div_U32_U16_Round, SOF Div_U32_U16_Round
        SHR R4,#01H
        MOV tmp32_lo,R4
        MOV R4,tmp32_lo
        CMP R4,#DATA16 000FFH
        JMPR cc_ULE,L_C370E
        MOVB maf_fac_alti_mmv,ONES
        RETS
L_C370E:                 ; 0xc370e
        MOVB RL4,tmp32_lo
        MOVB maf_fac_alti_mmv,RL4
        RETS

; ======== Calc_MAF_Alti_Cor  (@0xc3718) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by maf/tps output signals + DTC): MAF altitude correction factor maf_alti_cor.
        ; ------------------------------------------------------------
Calc_MAF_Alti_Cor:
        MOV R12,maf_word
        MOV R13,#00H
        MOVBZ R14,maf_fac_alti_mmv
        CALLS SEG Div_U32_U16_Round, SOF Div_U32_U16_Round
        SHR R4,#01H
        MOV tmp32_lo,R4
        MOV R4,tmp32_lo
        CMP R4,#DATA16 000FFH
        JMPR cc_ULE,L_C373C
        MOVB maf_alti_cor,ONES
        RETS
L_C373C:                 ; 0xc373c
        MOVB RL4,tmp32_lo
        MOVB maf_alti_cor,RL4
        RETS

S_ALTI ENDS
        END
