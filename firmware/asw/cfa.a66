; ======== Set_Out_Latch_Clr  (@0xd7cf2) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay):
        ; Output-latch driver: clears fd94/fd96 output channel bits per fd98 state.
        ; ------------------------------------------------------------
Set_Out_Latch_Clr:
        BCLR state_out_fault.0AH
        JB state_out_req.01H,L_D7CFA
        BCLR state_out_diag.0AH
L_D7CFA:                 ; 0xd7cfa
        BCLR state_out_fault.08H
        JB state_out_req.05H,L_D7D02
        BCLR state_out_diag.08H
L_D7D02:                 ; 0xd7d02
        BCLR state_out_fault.09H
        JB state_out_req.03H,L_D7D72
        BCLR state_out_diag.09H
        JMPR cc_UC,L_D7D72

; ======== Set_Out_Latch_B2  (@0xd7d0c) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay):
        ; Output-latch driver: fd94 bit 0x400 channel.
        ; ------------------------------------------------------------
Set_Out_Latch_B2:
        BSET state_out_fault.0AH
        JB state_out_req.01H,L_D7D14
        BSET state_out_diag.0AH
L_D7D14:                 ; 0xd7d14
        BCLR state_out_fault.08H
        JB state_out_req.05H,L_D7D1C
        BCLR state_out_diag.08H
L_D7D1C:                 ; 0xd7d1c
        BCLR state_out_fault.09H
