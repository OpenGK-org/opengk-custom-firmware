        CALLS SEG Reset_Dc788_c76, SOF Reset_Dc788_c76
        CALLS SEG Calc_LSH_Up_PWM, SOF Calc_LSH_Up_PWM
        CALLS SEG Reset_temp_dif_lsh_up_obd2_66c, SOF Reset_temp_dif_lsh_up_obd2_66c
        CALLS SEG Calc_LS_Cur_Up, SOF Calc_LS_Cur_Up
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B5FFC
        CALLS SEG Calc_Lam_Dly_CatFac, SOF Calc_Lam_Dly_CatFac
        CALLS SEG Init_LS_Down, SOF Init_LS_Down
        CALLS SEG Calc_LSH_Down_Ctl, SOF Calc_LSH_Down_Ctl
        CALLS SEG Reset_temp_dif_lsh_down_obd2_08e, SOF Reset_temp_dif_lsh_down_obd2_08e
        CALLS SEG Calc_LS_Cur_Down, SOF Calc_LS_Cur_Down
L_B5FFC:                 ; 0xb5ffc
        RETS

; ======== Reset_LS_State_Group_4  (@0xb5ffe) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Reset_LS_State_Group_4:
        MOVB RL4,conf_lam
        JMPR cc_EQ,L_B6014
        CALLS SEG Reset_lam_bank_1_lam_up_ti_ad_ad_c6c, SOF Reset_lam_bank_1_lam_up_ti_ad_ad_c6c
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B6014
        CALLS SEG Reset_Dc79e_8fa, SOF Reset_Dc79e_8fa
L_B6014:                 ; 0xb6014
        RETS

; ======== Reset_LS_State_Group_3  (@0xb6016) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Reset_LS_State_Group_3:
        MOVB RL4,conf_lam
        JMPR cc_EQ,L_B603C
        CALLS SEG Reset_Dfd68_03e, SOF Reset_Dfd68_03e
        CALLS SEG Reset_Dfd66_c88, SOF Reset_Dfd66_c88
        CALLS SEG Calc_LSH_Up_PWM, SOF Calc_LSH_Up_PWM
        CALLS SEG Calc_LS_Cur_Up_2, SOF Calc_LS_Cur_Up_2
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B603C
        CALLS SEG Calc_LSH_Down_Ctl, SOF Calc_LSH_Down_Ctl
        CALLS SEG Calc_LS_Cur_Down_2, SOF Calc_LS_Cur_Down_2
L_B603C:                 ; 0xb603c
        RETS

; ======== Reset_Dfd68_03e  (@0xb603e) ========
Reset_Dfd68_03e:
        BCLR diag_fd68.00H
        MOVB g_c244,ZEROS
        BCLR lv_cam_ad_di_ivvt.0AH
        MOV lam_bank_1_ls_down_struct_ls_down_carrier,ZEROS
        MOV lv_lam_c744,ZEROS
        RETS

S_CONF_LS ENDS
        END
