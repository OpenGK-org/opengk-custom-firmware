; asw/conf/conf_ls.a66
; Lambda-sensor state reset groups.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Reset_Dfd68_03e, Reset_LS_State_Group_1, Reset_LS_State_Group_2, Reset_LS_State_Group_3, Reset_LS_State_Group_4
EXTERN  Calc_LSH_Down_Ctl:NEAR, Calc_LSH_Down_PWM:NEAR, Calc_LSH_Up_PWM:NEAR, Calc_LSH_Up_State:NEAR
EXTERN  Calc_LS_Cur_Down:NEAR, Calc_LS_Cur_Down_2:NEAR, Calc_LS_Cur_Up:NEAR, Calc_LS_Cur_Up_2:NEAR
EXTERN  Calc_Lam_Dly_CatFac:NEAR, Init_LS_Down:NEAR, Init_LS_Up_Struct:NEAR, Reset_Dc788_c76:NEAR
EXTERN  Reset_Dc79e_8fa:NEAR, Reset_Dfd66_c88:NEAR, Reset_Dfd68_050:NEAR, Reset_Dfd6a_070:NEAR
EXTERN  Reset_lam_bank_1_lam_up_ti_ad_ad_c6c:NEAR, Reset_temp_dif_lsh_down_obd2_08e:NEAR, Reset_temp_dif_lsh_up_obd2_66c:NEAR

S_CONF_LS SECTION CODE

; ======== Reset_LS_State_Group_1  (@0xb5fa2) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Reset_LS_State_Group_1:
        MOVB RL4,conf_lam
        JMPR cc_EQ,L_B5FC4
        CALLS SEG Reset_Dfd66_c88, SOF Reset_Dfd66_c88
        CALLS SEG Reset_Dfd6a_070, SOF Reset_Dfd6a_070
        CALLS SEG Calc_LSH_Up_State, SOF Calc_LSH_Up_State
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B5FC4
        CALLS SEG Reset_Dfd68_050, SOF Reset_Dfd68_050
        CALLS SEG Calc_LSH_Down_PWM, SOF Calc_LSH_Down_PWM
L_B5FC4:                 ; 0xb5fc4
        RETS

; ======== Reset_LS_State_Group_2  (@0xb5fc6) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Reset_LS_State_Group_2:
