; asw/accin/accin_ac.a66
; A/C compressor request input delay (accin delay 5 state and timer tick).
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_accin_dly_5                        EQU  09010AH
ldpm_n_32__accin_dly                        EQU  090AB6H
ip_accin_dly_2__n_32                 EQU  091E5CH

PUBLIC  AcComp_AccIn_Dly5, AcComp_AccIn_Tick
EXTERN  AccInDelay_SetIfLonger:NEAR, Get_IP_Byte_Y_Axis:NEAR, Get_IP_Word_2D_Table:NEAR

S_ACCIN_AC SECTION CODE

; ======== AcComp_AccIn_Dly5  (@0xc7a88) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): A/C compressor control (accin delay 5, state_acc_dly=4)
        ; ------------------------------------------------------------
AcComp_AccIn_Dly5:
        JB lv_act_aj.0EH,L_C7A94
        BCLR state_out_fault.0EH
        JB state_out_req.02H,L_C7A94
        BCLR state_out_diag.0EH
L_C7A94:                 ; 0xc7a94
        BCLR lv_act_aj.0BH
        MOVBZ R12,DPP0:c_accin_dly_5
        CALLS SEG AccInDelay_SetIfLonger, SOF AccInDelay_SetIfLonger
        JNB PSW.06H,L_C7AA8
        MOVB RL4,#04H
        MOVB state_acc_dly,RL4
L_C7AA8:                 ; 0xc7aa8
        RETS

; ======== AcComp_AccIn_Tick  (@0xc7aaa) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): A/C compressor control: accin delay timer tick
        ; (ip_accin_dly_2)
        ; ------------------------------------------------------------
AcComp_AccIn_Tick:
        ADD t_accin_dly,ONES
        MOV R4,t_accin_dly
        JMPR cc_EQ,L_C7ABC
        MOV R5,#01H
        MOV g_f962,R5
        RETS
L_C7ABC:                 ; 0xc7abc
        MOVB state_acc_dly,ZEROS
        JNB lv_im_acin.04H,L_C7AF6
        JNB imob_fda0.0FH,L_C7AF6
        JB lv_act_aj.0FH,L_C7AF6
        JB lv_crk_tooth_err.04H,L_C7AF6
        JB lv_crk_tooth_err.05H,L_C7AF6
        BSET lv_act_aj.0CH
        MOV R12,#DATA16 POF ldpm_n_32__accin_dly
        MOV R13,#DATA16 PAG ldpm_n_32__accin_dly
        MOVBZ R14,n_32
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_accin_dly_2__n_32
        MOV R13,#DATA16 PAG ip_accin_dly_2__n_32
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        MOV sw_timer_a,R4
L_C7AF6:                 ; 0xc7af6
        RETS

S_ACCIN_AC ENDS
        END
