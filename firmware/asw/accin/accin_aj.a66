; asw/accin/accin_aj.a66
; A/C compressor switch-off delay, accin delay setter, anti-jerk active flag and an output-
; latch driver.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  AcComp_OffDelay_Tick, AccInDelay_SetIfLonger, Clr_Out_AJ_2, Set_lv_act_aj_c7b0
EXTERN  Clr_Out_AJ:NEAR, Get_IP_Word_2D_Table_DWord_YByte:NEAR

S_ACCIN_AJ SECTION CODE

; ======== AcComp_OffDelay_Tick  (@0xc7af8) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): A/C compressor control (t_accin_off_dly countdown)
        ; ------------------------------------------------------------
AcComp_OffDelay_Tick:
        ADD t_accin_off_dly,ONES
        MOV R4,t_accin_off_dly
        JMPR cc_EQ,L_C7B08
        MOV R5,#01H
        MOV g_f964,R5
L_C7B08:                 ; 0xc7b08
        RETS

; ======== Set_lv_act_aj_c7b0  (@0xc7b0a) ========
        ; ------------------------------------------------------------
        ; Named from single dominant output signal (auto-derived, lower confidence than hand-verified).
        ; ------------------------------------------------------------
Set_lv_act_aj_c7b0:
        JB lv_cdn_diag_maf_dif_ch_int.0BH,L_C7B22
        BCLR lv_act_aj.0DH
        MOV R12,#DATA16 04C3EH
        MOVBZ R13,n_32
        CALLS SEG Get_IP_Word_2D_Table_DWord_YByte, SOF Get_IP_Word_2D_Table_DWord_YByte
        MOV g_f944,R4
        RETS
L_C7B22:                 ; 0xc7b22
        CALLS SEG Clr_Out_AJ, SOF Clr_Out_AJ
        RETS

; ======== Clr_Out_AJ_2  (@0xc7b28) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay):
        ; Clear output latch bit 0x4000 (variant).
        ; ------------------------------------------------------------
Clr_Out_AJ_2:
        BCLR lv_act_aj.0EH
        JB lv_act_aj.0BH,L_C7B36
        BCLR state_out_fault.0EH
        JB state_out_req.02H,L_C7B36
        BCLR state_out_diag.0EH
L_C7B36:                 ; 0xc7b36
        RETS

; ======== AccInDelay_SetIfLonger  (@0xc7b38) ========
        ; ?AccInDelay_SetIfLonger(val): guarded setter for t_accin_dly. If val < t_accin_dly or val==0 ->
        ; clear PSW carry (0x40) and return (reject). Else latch t_accin_dly=val (first-ever set side effect
        ; DAT_00f962=1); when DAT_00fda0 & 0x8000 is set, clears the 'active adjustment' state (lv_act_aj &=
        ; ~0x1000, conditionally &~0x4000 path via DAT_00fd94/96/98, DAT_00f93e/40=0); set PSW carry and
        ; return previous t_accin_dly. Name uncertain: 't_accin_dly' = accel/actuator-input delay timer.
AccInDelay_SetIfLonger:
        CMP R12,t_accin_dly
        JMPR cc_C,L_C7B70
        CMP R12,#00H
        JMPR cc_ULE,L_C7B70
        MOV R4,t_accin_dly
        JMPR cc_NE,L_C7B4E
        MOV R5,#01H
        MOV g_f962,R5
L_C7B4E:                 ; 0xc7b4e
        MOV t_accin_dly,R12
        JNB imob_fda0.0FH,L_C7B6C
        JB lv_act_aj.0EH,L_C7B62
        BCLR state_out_fault.0EH
        JB state_out_req.02H,L_C7B62
        BCLR state_out_diag.0EH
L_C7B62:                 ; 0xc7b62
        MOV lv_isc_f940,ZEROS
        MOV sw_timer_a,ZEROS
        BCLR lv_act_aj.0CH
L_C7B6C:                 ; 0xc7b6c
        BSET PSW.06H
        RETS
L_C7B70:                 ; 0xc7b70
        BCLR PSW.06H
        RETS

S_ACCIN_AJ ENDS
        END
