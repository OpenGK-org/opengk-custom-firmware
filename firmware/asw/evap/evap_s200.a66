; ======== Restore_Evap_Ctrs  (@0xd150c) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen signals, verified): EVAP diagnosis counters NVM restore (ctr_evap_*)
        ; ------------------------------------------------------------
Restore_Evap_Ctrs:
        JNB can_fd58.02H,L_D1514
        JMPA cc_UC,L_D1610
L_D1514:                 ; 0xd1514
        EXTP #03H, #02H
        MOV R12,DPP0:diag_f890
        MOV R13,DPP0:diag_f892
        ADD R12,#DATA16 00200H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#0EH
        CALLS SEG xor_routine, SOF xor_routine
        EXTP #03H, #02H
        MOV R10,DPP0:diag_f890
        MOV R11,DPP0:diag_f892
        EXTP R11, #02H
        MOV R5,[R10+#020EH]
        NOP
        CMP R5,R4
        JMPR cc_NE,L_D1610
        MOVB RL4,DPP0:lc_ctr_evap_rst
        JMPR cc_NE,L_D1610
        EXTP R11, #02H
        MOVB RL5,[R10+#0200H]
        NOP
        MOVB ctr_evap_t_is,RL5
        EXTP R11, #02H
        MOVB RL3,[R10+#0201H]
        NOP
        MOVB ctr_evap_t_dly_3,RL3
        EXTP R11, #02H
        MOVB RL2,[R10+#0202H]
        NOP
        MOVB ctr_evap_dtp_diag,RL2
        EXTP R11, #02H
        MOVB RL1,[R10+#0203H]
        NOP
        MOVB ctr_evap_diagcp_start,RL1
        EXTP R11, #02H
        MOVB RL4,[R10+#0204H]
        NOP
        MOVB ctr_evap_intr_diagcp,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#0205H]
        NOP
        MOVB ctr_evap_tco,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#0206H]
        NOP
        MOVB ctr_evap_t_ast,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#0207H]
        NOP
        MOVB ctr_evap_t_pl_diagcp,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#0208H]
        NOP
        MOVB ctr_evap_intr_6,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#0209H]
        NOP
        MOVB ctr_evap_intr_7,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#020AH]
        NOP
        MOVB ctr_evap_intr_8,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#020BH]
        NOP
        MOVB ctr_evap_intr_10,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#020CH]
        NOP
        MOVB ctr_evap_intr_11,RL4
        EXTP R11, #02H
        MOVB RL4,[R10+#020DH]
        NOP
        MOVB ctr_evap_intr_14,RL4
        RETS
L_D1610:                 ; 0xd1610
        MOVB ctr_evap_intr_14,ZEROS
        MOVB ctr_evap_intr_11,ZEROS
        MOVB ctr_evap_intr_10,ZEROS
        MOVB ctr_evap_intr_8,ZEROS
        MOVB ctr_evap_intr_7,ZEROS
        MOVB ctr_evap_intr_6,ZEROS
        MOVB ctr_evap_t_pl_diagcp,ZEROS
        MOVB ctr_evap_t_ast,ZEROS
        MOVB ctr_evap_tco,ZEROS
