; ======== DiagCP_Evap_Counters  (@0xd18fa) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by cp/evap/dtp/diagcp output signals + DTC): EVAP IUMPR evap-condition counters:
        ; ctr_evap_t_is/dtp_diag/diagcp_start/tco/t_ast/intr.
        ; ------------------------------------------------------------
DiagCP_Evap_Counters:
        JB obd_sf.0DH,L_D1902
        JMPA cc_UC,L_D1AC6
L_D1902:                 ; 0xd1902
        MOV R4,t_is
        CMP R4,lv_cp_d030
        JMPR cc_NC,L_D191C
        MOVB RL4,state_diagcp
        CMPB RL4,#DATA16 0000BH
        JMPR cc_NE,L_D191A
        BSET lv_diagcp_cdn_nok.0BH
        JMPR cc_UC,L_D191C
L_D191A:                 ; 0xd191a
        BCLR lv_diagcp_cdn_nok.0BH
L_D191C:                 ; 0xd191c
        MOVB RL4,state_diagcp
        CMPB RL4,#DATA16 0000DH
        JMPA cc_EQ,L_D1AC4
        MOV R4,t_is
        CMP R4,DPP0:c_t_is_rbm
        JMPA cc_ULE,L_D1AC4
