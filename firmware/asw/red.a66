; asw/red.a66
; Catalyst-heating torque reduction factor and DTC.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_abc_inc_vb                         EQU  0900CDH
c_abc_max_vb                         EQU  090102H
c_fac_ch_red_acin                    EQU  0901A2H
c_fac_ch_red_at                      EQU  0901A3H
c_fac_ch_red_dri                     EQU  0901A4H
c_fac_ch_red_lgrd                    EQU  0901A5H
c_vb_h_diag                          EQU  090403H
c_vb_l_diag                          EQU  090404H
c_vs_min_vb_diag                     EQU  090444H

PUBLIC  Calc_Fac_CH_Red, Diag_DTC_dd63a, Reset_fac_ch_red_fd6
EXTERN  DTC_Update_Debounced:NEAR, Get_IP_Byte_3D_Table_DWord_XWord_YByte:NEAR, Mul_U16_Sat16:NEAR, Sat_Add_U8:NEAR
EXTERN  Sat_HiByte_ff:NEAR, sub_r12_13_ret_r4:NEAR

S_RED SECTION CODE

; ======== Reset_fac_ch_red_fd6  (@0xbafd6) ========
Reset_fac_ch_red_fd6:
        MOVB RL4,#DATA16 00040H
        MOVB fac_ch_red,RL4
        MOVB RL5,#DATA16 00040H
        MOVB fac_ch_red_at,RL5
        MOVB RL3,#DATA16 00040H
        MOVB fac_ch_red_dri,RL3
        MOVB RL2,#DATA16 00040H
        MOVB fac_ch_red_cor,RL2
        MOVB RL1,#DATA16 00040H
        MOVB fac_ch_red_acin,RL1
        RETS

; ======== Calc_Fac_CH_Red  (@0xbb000) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen signals, verified): Catalyst-heating torque reduction factor (fac_ch_red)
        ; ------------------------------------------------------------
Calc_Fac_CH_Red:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB lv_ch.03H,L_BB0B4
        JNB abs_def.04H,L_BB042
        MOVB RL4,DPP0:c_fac_ch_red_at
        MOVB fac_ch_red_at,RL4
        JNB abs_def.02H,L_BB04A
        MOVBZ R12,fac_ch_red_dri
        MOVBZ R13,DPP0:c_fac_ch_red_lgrd
        CALLS SEG sub_r12_13_ret_r4, SOF sub_r12_13_ret_r4
        CMPB RL4,DPP0:c_fac_ch_red_dri
        JMPR cc_ULE,L_BB038
        MOVBZ R12,fac_ch_red_dri
        MOVBZ R13,DPP0:c_fac_ch_red_lgrd
        CALLS SEG sub_r12_13_ret_r4, SOF sub_r12_13_ret_r4
        JMPR cc_UC,L_BB03C
L_BB038:                 ; 0xbb038
        MOVB RL4,DPP0:c_fac_ch_red_dri
L_BB03C:                 ; 0xbb03c
        MOVB fac_ch_red_dri,RL4
        JMPR cc_UC,L_BB04A
L_BB042:                 ; 0xbb042
        MOVB RL4,#DATA16 00040H
        MOVB fac_ch_red_at,RL4
L_BB04A:                 ; 0xbb04a
        JNB state_out_fault.0EH,L_BB078
        MOVBZ R12,fac_ch_red_acin
        MOVBZ R13,DPP0:c_fac_ch_red_lgrd
        CALLS SEG sub_r12_13_ret_r4, SOF sub_r12_13_ret_r4
        CMPB RL4,DPP0:c_fac_ch_red_acin
        JMPR cc_ULE,L_BB06E
        MOVBZ R12,fac_ch_red_acin
        MOVBZ R13,DPP0:c_fac_ch_red_lgrd
        CALLS SEG sub_r12_13_ret_r4, SOF sub_r12_13_ret_r4
        JMPR cc_UC,L_BB072
L_BB06E:                 ; 0xbb06e
        MOVB RL4,DPP0:c_fac_ch_red_acin
L_BB072:                 ; 0xbb072
        MOVB fac_ch_red_acin,RL4
        JMPR cc_UC,L_BB0A0
L_BB078:                 ; 0xbb078
        MOVBZ R12,fac_ch_red_acin
        MOVBZ R13,DPP0:c_fac_ch_red_lgrd
        CALLS SEG Sat_Add_U8, SOF Sat_Add_U8
        CMPB RL4,#DATA16 00040H
        JMPR cc_NC,L_BB098
        MOVBZ R12,fac_ch_red_acin
        MOVBZ R13,DPP0:c_fac_ch_red_lgrd
        CALLS SEG Sat_Add_U8, SOF Sat_Add_U8
        JMPR cc_UC,L_BB09C
L_BB098:                 ; 0xbb098
        MOVB RL4,#DATA16 00040H
L_BB09C:                 ; 0xbb09c
        MOVB fac_ch_red_acin,RL4
L_BB0A0:                 ; 0xbb0a0
        MOV R12,#DATA16 04874H
        MOVBZ R13,tia
        MOV R14,amp
        CALLS SEG Get_IP_Byte_3D_Table_DWord_XWord_YByte, SOF Get_IP_Byte_3D_Table_DWord_XWord_YByte
        MOVB fac_ch_red_cor,RL4
L_BB0B4:                 ; 0xbb0b4
        MOVBZ R12,fac_ch_red_dri
        MOVBZ R13,fac_ch_red_cor
        CALLS SEG Mul_U16_Sat16, SOF Mul_U16_Sat16
        MOV R9,R4
        MOVBZ R12,fac_ch_red_acin
        MOVBZ R13,fac_ch_red_at
        CALLS SEG Mul_U16_Sat16, SOF Mul_U16_Sat16
        MOV R8,R4
        MOV R4,R9
        MULU R4,R8
        MOV R5,MDH_FE0C
        MOV R4,R5
        SHR R4,#02H
        MOV R5,0FF1CH
        MOV R12,R4
        CALLS SEG Sat_HiByte_ff, SOF Sat_HiByte_ff
        MOVB fac_ch_red,RL4
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== Diag_DTC_dd63a  (@0xbb0f0) ========
        ; ------------------------------------------------------------
        ; Per-fault DTC setter: sets dtc_test_result and updates the DTC at status-address 0xd63a. Name = DTC
        ; status RAM address (unique per fault).
        ; ------------------------------------------------------------
Diag_DTC_dd63a:
        JNB can_fd58.09H,L_BB18A
        JB lv_cdn_diag_maf_dif_ch_int.0BH,L_BB18A
        JB lv_pl.04H,L_BB18A
        JB lv_can_bus_off_err.04H,L_BB18A
        MOVB RL4,vs
        CMPB RL4,DPP0:c_vs_min_vb_diag
        JMPR cc_ULE,L_BB18A
        MOVB RL5,vb
        CMPB RL5,DPP0:c_vb_l_diag
        JMPR cc_NC,L_BB11C
        MOVB RL3,#02H
        MOVB dtc_test_result,RL3
        JMPR cc_UC,L_BB120
L_BB11C:                 ; 0xbb11c
        MOVB dtc_test_result,ZEROS
L_BB120:                 ; 0xbb120
        MOV R12,#DATA16 0D63AH
        MOV R13,#DATA16 05AB0H
        MOVBZ R14,DPP0:c_abc_inc_vb
        MOVBZ R15,DPP0:c_abc_max_vb
        CALLS SEG DTC_Update_Debounced, SOF DTC_Update_Debounced
        BMOV lv_acp_err.03H,dtc_status_work.06H
        MOVBZ R4,diag_d644
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_BB14A
        MOV R4,#DATA16 0FFF7H
        AND diag_f86e,R4
L_BB14A:                 ; 0xbb14a
        MOVB RL4,vb
        CMPB RL4,DPP0:c_vb_h_diag
        JMPR cc_ULE,L_BB15C
        MOVB RL5,#01H
        MOVB dtc_test_result,RL5
        JMPR cc_UC,L_BB160
L_BB15C:                 ; 0xbb15c
        MOVB dtc_test_result,ZEROS
L_BB160:                 ; 0xbb160
        MOV R12,#DATA16 0D648H
        MOV R13,#DATA16 05AC6H
        MOVBZ R14,DPP0:c_abc_inc_vb
        MOVBZ R15,DPP0:c_abc_max_vb
        CALLS SEG DTC_Update_Debounced, SOF DTC_Update_Debounced
        BMOV lv_acp_err.04H,dtc_status_work.06H
        MOVBZ R4,diag_d652
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_BB18A
        MOV R4,#DATA16 0FFEFH
        AND diag_f86e,R4
L_BB18A:                 ; 0xbb18a
        RETS

S_RED ENDS
        END
