; asw/toil/toil_s62e.a66
; Oil temperature acquisition, value at engine stop and NVM restore/save (block 0x62E).
; 0xB9E66-0xB9F4A  (228 bytes, 4 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
ldp_v_toil__ip_toil                    EQU  0918BCH
ip_toil__v_toil                      EQU  096ADAH

PUBLIC  Acq_TOIL, NVM_Restore_s62e, NVM_Save_s62e, Set_TOIL_Stop
EXTERN  Elevated_Write_Routine_prg_zone_wrapper:NEAR, Get_IP_Byte_2D_Table:NEAR, Get_IP_Word_Y_Axis:NEAR, xor_routine:NEAR

S_B9E66 SECTION CODE AT 0B9E66H

; ======== NVM_Restore_s62e  (@0xb9e66) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: restores <- validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Restore_s62e:
        JNB lv_pl.0CH,L_B9E70
        MOVB RL4,conf_ad_rst
        JMPR cc_NE,L_B9ECE
L_B9E70:                 ; 0xb9e70
        JB can_fd58.02H,L_B9ECE
        EXTP #03H, #02H
        MOV R12,DPP0:diag_f890
        MOV R13,DPP0:diag_f892
        ADD R12,#DATA16 0062EH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS 00DH,xor_routine
        EXTP #03H, #02H
        MOV R10,DPP0:diag_f890
        MOV R11,DPP0:diag_f892
        EXTP R11, #02H
        MOV R5,[R10+#0630H]
        NOP
        CMP R5,R4
        JMPR cc_NE,L_B9ECE
        EXTP R11, #02H
        MOVB RL4,[R10+#062EH]
        NOP
        MOVB toil_stop,RL4
        RETS
L_B9ECE:                 ; 0xb9ece
        MOVB toil_stop,ZEROS
        RETS

; ======== NVM_Save_s62e  (@0xb9ed4) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: saves RAM-> validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Save_s62e:
        EXTP #03H, #02H
        MOV R12,DPP0:diag_f890
        MOV R13,DPP0:diag_f892
        ADD R12,#DATA16 0062EH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0C26EH
        MOV R15,#01H
        CALLS 00DH,Elevated_Write_Routine_prg_zone_wrapper
        RETS

; ======== Acq_TOIL  (@0xb9f00) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by tam/toil/teg/th output signals): Oil-temperature sensor acquisition: v_toil /
        ; toil_mes / toil / toil_max.
        ; ------------------------------------------------------------
Acq_TOIL:
        MOV R4,g_fa76
        AND R4,#DATA16 003FFH
        MOV g_c97c,R4
        SHR R4,#02H
        MOVB v_toil,RL4
        MOV R12,#DATA16 POF ldp_v_toil__ip_toil
        MOV R13,#DATA16 PAG ldp_v_toil__ip_toil
        MOV R14,g_c97c
        CALLS 00FH,Get_IP_Word_Y_Axis
        MOV R12,#DATA16 POF ip_toil__v_toil
        MOV R13,#DATA16 PAG ip_toil__v_toil
        CALLS 00FH,Get_IP_Byte_2D_Table
        MOVB toil_mes,RL4
        MOVB toil,RL4
        MOVB toil_max,RL4
        MOVB g_c26f,ZEROS
        RETS

; ======== Set_TOIL_Stop  (@0xb9f40) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Oil Temperature TOIL (toil_stop=toil)
        ; ------------------------------------------------------------
Set_TOIL_Stop:
        MOVB RL4,toil
        MOVB toil_stop,RL4
        RETS

S_B9E66 ENDS
        END
