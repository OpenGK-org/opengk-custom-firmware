        CALLS 00BH,Init_GearRatio
        CALLS 00BH,Calc_ACP_State
        CALLS 00BH,Reset_RBM_Full
        CALLS 00DH,Diag_DTC_dd108
        MOVB RL4,#DATA16 000FEH
        ANDB state_fuel_req,RL4
        MOVB RL4,state_fuel_req
        JMPR cc_NE,L_DA82C
        BSET state_out_fault.0DH
        JB state_out_req.04H,L_DA834
        BSET state_out_diag.0DH
        JMPR cc_UC,L_DA834
L_DA82C:                 ; 0xda82c
