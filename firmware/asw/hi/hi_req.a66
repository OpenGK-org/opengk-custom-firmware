        CALLS 00BH,Init_ISC_State
        CALLS 00BH,Calc_Cyl_InjPhase
        CALLS 00CH,Init_TQ_Lamb_Defaults
        CALLS 00CH,Reset_Eff_SCC
        CALLS 00BH,Set_eff_tot_bas_21e
        CALLS 00BH,Reset_Eff_Lamb
        CALLS 00CH,Reset_tqi_gs_slow_dec_196
        CALLS 00CH,Reset_tqi_req_slow_2d6
        CALLS 00CH,Reset_t_acc_fast_862
        CALLS 00BH,Reset_fac_ch_red_fd6
        CALLS 00CH,Set_tqi_av_ems_7dc
        CALLS 00CH,Reset_tq_conv_036
        JNB lv_conf_mis.02H,L_DA790
        CALLS 00DH,Calc_ER_Seg_Ad
        CALLS 00BH,Init_Misfire_Counters
        CALLS 00BH,ClrBits_lv_er_carb_b4_c7c
L_DA790:                 ; 0xda790
        MOVB RL4,#DATA16 00014H
        MOVB lv_iga_c2e5,RL4
        CALLS 00CH,Tail_f0c5ec6_f48
        CALLS 00CH,Calc_TPS_ErrSubst
        CALLS 00BH,Calc_Fac_WF_VO_Fdout_B95A
        CALLS 00BH,Calc_WallFilm_Seg
        MOV R4,#DATA16 00168H
        MOV crank_tim_13,R4
        MOV R5,#01H
        MOV g_f968,R5
        CALLS 00DH,Reset_state_cfa_is_92a
        CALLS 00BH,Reset_Df380_408
        CALLS 00AH,Reset_Dfd62_8ca
        CALLS 00AH,Reset_Dfd62_830
        CALLS 00DH,Init_Fault_Table_1
        CALLS 00DH,Init_Fault_Table_2
        CALLS 00DH,Clamp_IGC_Dur_Min
        CALLS 00DH,Clamp_IGC_Dur_Min_2
        MOVB RL4,dbc_rly_efp
        CMPB RL4,#02H
        JMPR cc_UGT,L_DA7E4
        MOVB RL5,#02H
        MOVB dbc_rly_efp,RL5
L_DA7E4:                 ; 0xda7e4
        CALLS 00BH,Reset_Dc2b4_028
