S_DA6A0 SECTION CODE AT 0DA6A0H

; ======== CAN_Init_Task  (@0xda6a0) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
CAN_Init_Task:
        JNB lv_conf_mis.09H,L_DA6A8
        CALLS 00DH,CAN1_Init
L_DA6A8:                 ; 0xda6a8
        CALLS 00CH,KWP_Init_Resp
        MOVB RL4,lv_sched_diag_inh
        ANDB RL4,#01H
        JMPR cc_NE,L_DA6E6
        MOVB RL4,#0EH
        MOVBZ R5,tq_hi_wr
        MOVB [R5+#0F62EH],RL4
        MOVB RL4,tq_hi_wr
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_hi_wr,RL4
        MOVB RL4,tq_hi_wr
        CMPB RL4,tq_hi_rd
        JMPR cc_NE,L_DA6E6
        BSET sched_flags.01H
        MOVB RL4,tq_hi_rd
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_hi_rd,RL4
L_DA6E6:                 ; 0xda6e6
        RETS

; ======== Set_Out_FuelReq_3  (@0xda6e8) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay): Set
        ; output-request latch bit 0x2000 (variant) + Diag_DTC.
        ; ------------------------------------------------------------
Set_Out_FuelReq_3:
        CALLS 00CH,Reset_Df7e6_57e
        CALLS 00CH,Acq_TIA_TCO_Inputs
