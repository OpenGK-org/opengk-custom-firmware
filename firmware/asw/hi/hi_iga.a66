; ======== Calc_CDN_Diag_MAF_Cond  (@0xd6174) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by maf/tps output signals + DTC): Condition flags for MAF-based diag enable:
        ; lv_cdn_diag_maf_dif_ch_int + lv_err_tps_det.
        ; ------------------------------------------------------------
Calc_CDN_Diag_MAF_Cond:
        JB lv_cdn_diag_maf_dif_ch_int.0BH,L_D620C
        CALLS 00BH,Calc_Inh_IGC
        CALLS 00BH,Calc_Seg_Timing
        MOV eng_state_marker,ZEROS
        BMOV lv_pl.03H,lv_iga_tra_knk.01H
        CALLS 00CH,Calc_TPS_Seg
        JNB lv_err_tps_det.01H,L_D61B8
        CALLS 00CH,Calc_TPS_GRD_SAM
        MOVB RL4,n_32
        CMPB RL4,DPP0:c_n_max_inf
        JMPR cc_NC,L_D61B0
        MOVB RL5,DPP0:c_n_grd_min
        CMPB RL5,n_grd
        JMPR cc_SLE,L_D61B0
        JNB lv_ct.00H,L_D61B0
        BSET lv_cdn_diag_maf_dif_ch_int.0FH
        JMPR cc_UC,L_D61B2
L_D61B0:                 ; 0xd61b0
        BCLR lv_cdn_diag_maf_dif_ch_int.0FH
L_D61B2:                 ; 0xd61b2
        CALLS 00DH,Calc_MAF_Dif_CH_Cond
        BCLR lv_err_tps_det.01H
L_D61B8:                 ; 0xd61b8
        CALLS 00CH,Acq_MAF_Mes
        CALLS 00DH,Diag_MAF_Sensor
        CALLS 00CH,Calc_MAF_Variables
        CALLS 00DH,Calc_MAF_HB
        JB lv_pl.02H,L_D61E4
        MOV R4,cycnr_hys_pu
        JMPR cc_EQ,L_D61E4
        SUB R4,#01H
        MOV cycnr_hys_pu,R4
        CMP R4,#00H
        JMPR cc_NE,L_D61E4
        MOVB RL4,DPP0:c_n_hys_min_puc
        MOVB n_hys_pu,RL4
L_D61E4:                 ; 0xd61e4
        MOV R12,#DATA16 0D672H
        CALLS 00CH,Check_N_Window
        CALLS 00BH,Calc_IGA_Tra_Knk
        CALLS 00BH,SeqFuelCut_CylSel
        CALLS 00CH,Calc_Inj_Pattern
        CALLS 00CH,Set_state_iv
        CALLS 00CH,Calc_Eff_SCC_Upd
        CALLS 00BH,Calc_TI_CatHeat
        CALLS 00BH,Calc_TI_Cor_IVVT
        CALLS 00AH,Calc_ER_Std
L_D620C:                 ; 0xd620c
        CALLS 00CH,Dec_Dc346_SegCtr
        CALLS 00DH,Diag_MAF_Dif_CH
        RETS

