PUBLIC  Calc_Inj_Pattern, Diag_DTC_dd62c, Diag_IVVT_Elec_Slv, Diag_IVVT_Mec_Eval, Diag_IVVT_Trip_d62c
EXTERN  DTC_Update_Debounced:NEAR

S_C1090 SECTION CODE AT 0C1090H

; ======== Calc_Inj_Pattern  (@0xc1090) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): Injection firing pattern: nr_pat / pat_inh_iv (+
        ; lv_iga_tra_knk).
        ; ------------------------------------------------------------
Calc_Inj_Pattern:
        JB can_fd58.09H,L_C109C
        MOVB RL4,#08H
        MOVB nr_pat,RL4
        JMPR cc_UC,L_C10D6
L_C109C:                 ; 0xc109c
        MOVB RL4,nr_pat_sel_cyl
        CMPB RL4,nr_pat_eng_rev
        JMPR cc_ULE,L_C10AC
        MOVBZ R4,nr_pat_sel_cyl
        JMPR cc_UC,L_C10B0
L_C10AC:                 ; 0xc10ac
        MOVBZ R4,nr_pat_eng_rev
L_C10B0:                 ; 0xc10b0
        MOVBZ R5,nr_pat_scc
        CMP R5,R4
        JMPR cc_SLE,L_C10BE
        MOVB RL4,nr_pat_scc
        JMPR cc_UC,L_C10D2
L_C10BE:                 ; 0xc10be
        MOVB RL4,nr_pat_sel_cyl
        CMPB RL4,nr_pat_eng_rev
        JMPR cc_ULE,L_C10CE
        MOVB RL4,nr_pat_sel_cyl
        JMPR cc_UC,L_C10D2
L_C10CE:                 ; 0xc10ce
        MOVB RL4,nr_pat_eng_rev
L_C10D2:                 ; 0xc10d2
        MOVB nr_pat,RL4
L_C10D6:                 ; 0xc10d6
        MOVB RL4,nr_pat
        CMPB RL4,pat_inh_iv
        JMPR cc_ULE,L_C10F2
        MOVBZ R4,RL4
        SHL R4,#01H
        MOV R5,[R4+#01D8AH]
        OR R5,#DATA16 08000H
        MOV lv_inj_pattern,R5
        JMPR cc_UC,L_C110C
L_C10F2:                 ; 0xc10f2
        MOVBZ R4,nr_pat
        SHL R4,#01H
        MOV R5,[R4+#01D8AH]
        XOR R5,lv_inj_pattern
        AND R5,#DATA16 07FFFH
        XOR R5,lv_inj_pattern
        MOV lv_inj_pattern,R5
L_C110C:                 ; 0xc110c
        MOVB RL4,nr_pat
        MOVB pat_inh_iv,RL4
        JB lv_pl.02H,L_C112A
        BCLR lv_iga_tra_knk.0EH
        CMPB RL4,#00H
        JMPR cc_NE,L_C1124
        BCLR lv_iga_tra_knk.0CH
        BCLR lv_iga_tra_knk.0DH
        RETS
L_C1124:                 ; 0xc1124
        BSET lv_iga_tra_knk.0CH
        BSET lv_iga_tra_knk.0DH
        RETS
L_C112A:                 ; 0xc112a
        BSET lv_iga_tra_knk.0CH
        BSET lv_iga_tra_knk.0DH
        MOVB RL4,pat_inh_iv
        CMPB RL4,#DATA16 00008H
        JMPR cc_NE,L_C113C
        BSET lv_iga_tra_knk.0EH
        RETS
L_C113C:                 ; 0xc113c
        BCLR lv_iga_tra_knk.0EH
        RETS

; ======== Diag_IVVT_Elec_Slv  (@0xc1140) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): IVVT electrical (OCV) slave diagnosis counter:
        ; ctr_diag_slv_ivvt.
        ; ------------------------------------------------------------
Diag_IVVT_Elec_Slv:
        MOV [-R0],R6
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_C11CA
        SUBB ivvt_in_1_struct_diag_el_ivvt_ctr_diag_slv_ivvt,ONES
        MOVB RL5,g_f5fd
        JMPR cc_NE,L_C11B2
        MOVB RL3,vb
        CMPB RL3,DPP0:c_vb_diag_ivvt
        JMPR cc_ULE,L_C11A4
        JB lv_diag_trip_avl_ivvt.00H,L_C11A4
        MOVB RL2,ivvt_in_1_struct_ctl_ivvt_lv_inh_ctl_diag_slv_ivvt
        JMPR cc_NE,L_C11A4
        MOVB RL6,#DATA16 00010H
        MOV R4,lv_ivvt_fba6
        AND R4,#DATA16 08000H
        JMPR cc_EQ,L_C11A6
        MOV R4,dtc_cond_s1
        AND R4,#DATA16 08000H
        JMPR cc_EQ,L_C1184
        MOVB RL6,#DATA16 00011H
        JMPR cc_UC,L_C11A6
L_C1184:                 ; 0xc1184
        MOV R4,dtc_cond_s2
        AND R4,#DATA16 08000H
        JMPR cc_EQ,L_C1194
        MOVB RL6,#DATA16 00012H
        JMPR cc_UC,L_C11A6
L_C1194:                 ; 0xc1194
        MOV R4,dtc_cond_s3
        AND R4,#DATA16 08000H
        JMPR cc_EQ,L_C11A6
        MOVB RL6,#DATA16 00014H
        JMPR cc_UC,L_C11A6
L_C11A4:                 ; 0xc11a4
        MOVB RL6,#00H
L_C11A6:                 ; 0xc11a6
        MOVBZ R12,RL6
        CALLS 00CH,Diag_DTC_dd62c
        BMOV lv_iga_tra_knk.0FH,PSW.06H
        JMPR cc_UC,L_C11B6
L_C11B2:                 ; 0xc11b2
        ADDB g_f5fd,ONES
L_C11B6:                 ; 0xc11b6
        MOV R4,#DATA16 07FFFH
        AND dtc_cond_s1,R4
        AND dtc_cond_s2,R4
        AND dtc_cond_s3,R4
        AND lv_ivvt_fba6,R4
L_C11CA:                 ; 0xc11ca
        MOV R6,[R0+]
        RETS

; ======== Diag_IVVT_Trip_d62c  (@0xc11ce) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by ivvt/cam output signals + DTC): IVVT short-trip diagnosis (DTC 0xd62c):
        ; lv_diag_trip_avl_ivvt / t_dly_diag_ivvt.
        ; ------------------------------------------------------------
Diag_IVVT_Trip_d62c:
        BCLR lv_diag_trip_avl_ivvt.01H
        BSET lv_diag_trip_avl_ivvt.00H
        MOVB t_dly_diag_ivvt,ZEROS
        MOVB RL4,#01H
        MOVB lv_ivvt_d62d,RL4
        MOV R12,#DATA16 0D62CH
        MOV R13,#DATA16 05A9AH
        MOVBZ R14,DPP0:c_abc_inc_slv_ivvt
        MOVBZ R15,DPP0:c_abc_max_slv_ivvt
        CALLS 00DH,DTC_Update_Debounced
        BMOV lv_acp_err.02H,dtc_status_work.06H
        MOVBZ R4,g_d636
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_C1206
        MOV R4,#DATA16 0FFFBH
        AND diag_f86e,R4
L_C1206:                 ; 0xc1206
        BCLR lv_diag_trip_avl_ivvt.03H
        BCLR lv_diag_trip_avl_ivvt.04H
        BCLR lv_diag_trip_avl_ivvt.05H
        RETS

; ======== Diag_DTC_dd62c  (@0xc120e) ========
        ; ------------------------------------------------------------
        ; Per-fault DTC setter: sets dtc_test_result and updates the DTC at status-address 0xd62c. Name = DTC
        ; status RAM address (unique per fault).
        ; ------------------------------------------------------------
Diag_DTC_dd62c:
        MOV [-R0],R6
        MOV R6,R12
        CMPB RL6,#00H
        JMPR cc_EQ,L_C12E0
        MOVB RL4,t_dly_diag_ivvt
        CMPB RL4,DPP0:c_dly_diag_slv_ivvt
        JMPR cc_C,L_C12D8
        MOVBZ R4,RL6
        AND R4,#01H
        JMPR cc_EQ,L_C122E
        MOVB RL4,#01H
        MOVB dtc_test_result,RL4
        JMPR cc_UC,L_C124E
L_C122E:                 ; 0xc122e
        MOVBZ R4,RL6
        AND R4,#02H
        JMPR cc_EQ,L_C123C
        MOVB RL4,#02H
        MOVB dtc_test_result,RL4
        JMPR cc_UC,L_C124E
L_C123C:                 ; 0xc123c
        MOVBZ R4,RL6
        AND R4,#04H
        JMPR cc_EQ,L_C124A
        MOVB RL4,#04H
        MOVB dtc_test_result,RL4
        JMPR cc_UC,L_C124E
L_C124A:                 ; 0xc124a
        MOVB dtc_test_result,ZEROS
L_C124E:                 ; 0xc124e
        MOV R12,#DATA16 0D62CH
        MOV R13,#DATA16 05A9AH
        MOVBZ R14,DPP0:c_abc_inc_slv_ivvt
        MOVBZ R15,DPP0:c_abc_max_slv_ivvt
        CALLS 00DH,DTC_Update_Debounced
        BMOV lv_acp_err.02H,dtc_status_work.06H
        MOVBZ R4,g_d636
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_C1278
        MOV R4,#DATA16 0FFFBH
        AND diag_f86e,R4
L_C1278:                 ; 0xc1278
        JNB lv_acp_err.02H,L_C12A4
        MOVBZ R4,diag_d62c
        AND R4,#01H
        JMPR cc_EQ,L_C128C
        BSET lv_diag_trip_avl_ivvt.03H
        BCLR lv_diag_trip_avl_ivvt.04H
        BCLR lv_diag_trip_avl_ivvt.05H
        JMPR cc_UC,L_C12AA
L_C128C:                 ; 0xc128c
        MOVBZ R4,diag_d62c
        AND R4,#02H
        JMPR cc_EQ,L_C129C
        BSET lv_diag_trip_avl_ivvt.04H
        BCLR lv_diag_trip_avl_ivvt.03H
        BCLR lv_diag_trip_avl_ivvt.05H
        JMPR cc_UC,L_C12AA
L_C129C:                 ; 0xc129c
        BSET lv_diag_trip_avl_ivvt.05H
        BCLR lv_diag_trip_avl_ivvt.03H
        BCLR lv_diag_trip_avl_ivvt.04H
        JMPR cc_UC,L_C12AA
L_C12A4:                 ; 0xc12a4
        BCLR lv_diag_trip_avl_ivvt.03H
        BCLR lv_diag_trip_avl_ivvt.04H
        BCLR lv_diag_trip_avl_ivvt.05H
L_C12AA:                 ; 0xc12aa
        MOVB RL4,diag_d62c
        ANDB RL4,#02H
        JMPR cc_EQ,L_C12D4
        MOVB RL4,lv_ivvt_d62d
        CMPB RL4,DPP0:c_abc_min_slv_ivvt_scg_lih
        JMPR cc_C,L_C12D4
        MOVB RL5,tco
        CMPB RL5,DPP0:c_tco_min_slv_ivvt_scg_lih
        JMPR cc_C,L_C12D4
        MOVB RL3,vs
        CMPB RL3,DPP0:c_vs_max_slv_ivvt_scg_lih
        JMPR cc_UGT,L_C12D4
        BSET lv_diag_trip_avl_ivvt.02H
        JMPR cc_UC,L_C12E2
L_C12D4:                 ; 0xc12d4
        BCLR lv_diag_trip_avl_ivvt.02H
        JMPR cc_UC,L_C12E2
L_C12D8:                 ; 0xc12d8
        SUBB t_dly_diag_ivvt,ONES
        BCLR lv_diag_trip_avl_ivvt.02H
        JMPR cc_UC,L_C12E2
L_C12E0:                 ; 0xc12e0
        BCLR lv_diag_trip_avl_ivvt.02H
L_C12E2:                 ; 0xc12e2
        BMOV PSW.06H,lv_acp_err.02H
        MOV R6,[R0+]
        RETS

; ======== Diag_IVVT_Mec_Eval  (@0xc12ea) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by ivvt/cam output signals + DTC): IVVT mechanical diagnosis: lv_err_ad_mec_ref
        ; / lv_err_cam_dif / lv_err_tooth_off + ocv_diag_es.
        ; ------------------------------------------------------------
Diag_IVVT_Mec_Eval:
        JNB can_fd58.09H,L_C1308
        JNB can_fd58.0BH,L_C1308
        MOVB RL4,DPP0:lc_ocv_diag_es
        JMPR cc_NE,L_C1304
        CMPB RL4,#00H
        JMPR cc_NE,L_C1308
        JB lv_cdn_diag_maf_dif_ch_int.0BH,L_C1308
        JB lv_pl.04H,L_C1308
L_C1304:                 ; 0xc1304
        BCLR lv_diag_trip_avl_ivvt.00H
        JMPR cc_UC,L_C130A
L_C1308:                 ; 0xc1308
        BSET lv_diag_trip_avl_ivvt.00H
L_C130A:                 ; 0xc130a
        JNB lv_cam_err.05H,L_C1318
        MOVBZ R4,DPP0:c_t_ast_inh_lih_ivvt
        CMP R4,t_ast
        JMPR cc_C,L_C1332
L_C1318:                 ; 0xc1318
        JB lv_cam_err.06H,L_C1332
        MOVB RL4,ivvt_in_1_struct_diag_mec_ivvt_lv_err_ad_mec_ref_ivvt
        JMPR cc_NE,L_C1332
        MOVB RL5,ivvt_in_1_struct_diag_mec_ivvt_lv_err_cam_dif_ivvt
        JMPR cc_NE,L_C1332
        MOVB RL3,ivvt_in_1_struct_diag_mec_ivvt_lv_err_tooth_off
        JMPR cc_NE,L_C1332
        JNB lv_iga_tra_knk.0FH,L_C1336
L_C1332:                 ; 0xc1332
        BSET lv_diag_trip_avl_ivvt.01H
        RETS
L_C1336:                 ; 0xc1336
        BCLR lv_diag_trip_avl_ivvt.01H
        RETS

S_C1090 ENDS
        END
