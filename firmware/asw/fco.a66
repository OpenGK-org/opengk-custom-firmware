; asw/fco.a66
; Fuel cut-off, refuel injection time, MAF trim flag and altitude-correction lookup.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_fco_fac                            EQU  090556H
ldp_maf_fac_alti_mmv_ip_ti_fac    EQU  090EB2H
ldp_amp_map_dif_ip_ti_rfu             EQU  0918AAH
ip_ti_rfu__amp_map_dif               EQU  0943A4H
ip_ti_fac_alti__maf_fac_alti_mm      EQU  0968ACH

PUBLIC  Calc_FCO, Calc_TI_RFU, Lookup_Alti_Cor_MMV, Reset_tco_rest_6ba, Set_lv_maf_trim
EXTERN  Calc_CtrlModule_Voltage:NEAR, Div_U32_U16_Round32:NEAR, Get_IP_Byte_2D_Table:NEAR, Get_IP_Byte_Y_Axis:NEAR
EXTERN  Get_IP_Word_2D_Table:NEAR, Get_IP_Word_Y_Axis:NEAR, MulAdd_U32_Sat:NEAR, Sat_Add_U32:NEAR
EXTERN  Set_Output_CC29:NEAR, sub_r12_r13_rets_r4:NEAR

S_FCO SECTION CODE

; ======== Reset_tco_rest_6ba  (@0xdd6ba) ========
Reset_tco_rest_6ba:
        MOVB tco_rest,ONES
        BCLR lv_maf_trim.05H
        RETS

; ======== Set_lv_maf_trim  (@0xdd6c2) ========
        ; ------------------------------------------------------------
        ; Named from single dominant output signal (auto-derived, lower confidence than hand-verified).
        ; ------------------------------------------------------------
Set_lv_maf_trim:
        BCLR lv_maf_trim.02H
        BCLR lv_maf_trim.06H
        MOV maf_wf_init,ZEROS
        MOVB RL4,pwl_dly_ctr
        JMPR cc_EQ,L_DD6D6
        SUBB RL4,#01H
        MOVB pwl_dly_ctr,RL4
L_DD6D6:                 ; 0xdd6d6
        RETS

; ======== Lookup_Alti_Cor_MMV  (@0xdd6d8) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signal): Altitude correction-factor lookup: maf_fac_alti_mmv -> 2D
        ; table byte, used by the TI base calc.
        ; ------------------------------------------------------------
Lookup_Alti_Cor_MMV:
        MOV R12,#DATA16 POF ldp_maf_fac_alti_mmv_ip_ti_fac
        MOV R13,#DATA16 PAG ldp_maf_fac_alti_mmv_ip_ti_fac
        MOVBZ R14,maf_fac_alti_mmv
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_ti_fac_alti__maf_fac_alti_mm
        MOV R13,#DATA16 PAG ip_ti_fac_alti__maf_fac_alti_mm
        CALLS SEG Get_IP_Byte_2D_Table, SOF Get_IP_Byte_2D_Table
        RETS

; ======== Calc_FCO  (@0xdd6f6) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by dominant output signals): Fuel cut-off computation: fco_nr / fco_word.
        ; ------------------------------------------------------------
Calc_FCO:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        SUB R0,#02H
        CALLS SEG Calc_TI_RFU, SOF Calc_TI_RFU
L_DD704:                 ; 0xdd704
        MOVB RL6,inj_cc_3
        MOVB RL4,#01H
        ANDB RL4,RL6
        MOVB [R0],RL4
        MOVBZ R4,RL4
        SHL R4,#02H
        MOV R8,[R4+#0FA28H]
        MOV R9,[R4+#0FA2AH]
        CMPB RL6,inj_cc_3
        JMPR cc_NE,L_DD704
        SUB R8,fco_acc_lo
        SUBC R9,fco_acc_hi
        CMP R9,#00H
        JMPR cc_NE,L_DD730
        CMP R8,#DATA16 0FFFFH
L_DD730:                 ; 0xdd730
        JMPR cc_ULE,L_DD738
        MOV R8,#DATA16 0FFFFH
        MOV R9,#00H
L_DD738:                 ; 0xdd738
        MOV R7,R8
        ADD fco_acc_lo,R8
        ADDC fco_acc_hi,R9
        CMP R7,#DATA16 0BFFFH
        JMPR cc_UGT,L_DD766
        MOV R4,R7
        MOV R2,#DATA16 0AAAAH
        MULU R4,R2
        MOV R5,MDH_FE0C
        MOV R4,0FE0EH
        MOV R2,R5
        SHR R4,#0FH
        SHR R5,#0FH
        SHL R2,#01H
        OR R4,R2
        MOV R7,R4
        JMPR cc_UC,L_DD76A
L_DD766:                 ; 0xdd766
        MOV R7,#DATA16 0FFFFH
L_DD76A:                 ; 0xdd76a
        MOV R12,DPP0:c_fco_fac
        MOV R13,#00H
        MOV R4,R12
        SHL R12,#0FH
        SHL R13,#0FH
        SHR R4,#01H
        OR R13,R4
        MOV R14,ti_rfu
        CALLS SEG Div_U32_U16_Round32, SOF Div_U32_U16_Round32
        MOV R12,R4
        MOV R13,R5
        MOV R4,R13
        SHR R12,#02H
        SHR R13,#02H
        SHL R4,#0EH
        OR R12,R4
        MOV R14,R7
        CALLS SEG MulAdd_U32_Sat, SOF MulAdd_U32_Sat
        MOV R14,R4
        MOV R15,R5
        MOV R12,lv_ti_f8b6
        MOV R13,lv_ti_f8b8
        CALLS SEG Sat_Add_U32, SOF Sat_Add_U32
        MOV lv_ti_f89c,R4
        MOV fco_word_1_,R5
        MOV R4,fco_word_1_
        CMP R4,#DATA16 00271H
        JMPR cc_NC,L_DD7CE
        MOV R4,lv_ti_f89c
        MOV R5,fco_word_1_
        MOV lv_ti_f8b6,R4
        MOV lv_ti_f8b8,R5
        MOVB fco_nr,ZEROS
        JMPR cc_UC,L_DD826
L_DD7CE:                 ; 0xdd7ce
        MOV R4,lv_ti_f89c
        MOV R5,fco_word_1_
        MOV R10,#00H
        MOV R11,#DATA16 00271H
        CALLS SEG Calc_CtrlModule_Voltage, SOF Calc_CtrlModule_Voltage
        MOV R7,R4
        CMP R7,#05H
        JMPR cc_ULE,L_DD7EE
        MOVB RL4,#05H
        MOVB fco_nr,RL4
        JMPR cc_UC,L_DD7F4
L_DD7EE:                 ; 0xdd7ee
        MOV R4,R7
        MOVB fco_nr,RL4
L_DD7F4:                 ; 0xdd7f4
        MOVBZ R12,fco_nr
        CALLS SEG Set_Output_CC29, SOF Set_Output_CC29
        MOV R4,lv_ti_f89c
        MOV R5,fco_word_1_
        MOVBZ R2,fco_nr
        MOV R3,#DATA16 00271H
        MULU R2,R3
        MOV R2,0FE0EH
        MOV R3,#00H
        MOV R3,R2
        MOV R2,0FF1CH
        SUB R4,R2
        SUBC R5,R3
        MOV lv_ti_f8b6,R4
        MOV lv_ti_f8b8,R5
L_DD826:                 ; 0xdd826
        ADD R0,#02H
        MOV R6,[R0+]
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== Calc_TI_RFU  (@0xdd832) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signal): Refuel/restore injection: ti_rfu from (amp - map_fg_pred) 2D
        ; map (manifold-fill recovery).
        ; ------------------------------------------------------------
Calc_TI_RFU:
        MOV R12,amp
        MOV R13,map_fg_pred
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV amp_map_dif,R4
        MOV R12,#DATA16 POF ldp_amp_map_dif_ip_ti_rfu
        MOV R13,#DATA16 PAG ldp_amp_map_dif_ip_ti_rfu
        MOV R14,R4
        CALLS SEG Get_IP_Word_Y_Axis, SOF Get_IP_Word_Y_Axis
        MOV R12,#DATA16 POF ip_ti_rfu__amp_map_dif
        MOV R13,#DATA16 PAG ip_ti_rfu__amp_map_dif
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        MOV ti_rfu,R4
        RETS

S_FCO ENDS
        END
