; ======== Calc_AirCharge_Model  (@0xc3de4) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (ThetaII, verified): physical air model: maf_cyl (vol eff eff_vol_slop/ofs), maf_egr,
        ; egr_ratio, maf_thr
        ; (was FUN_0c3de4)
        ; ------------------------------------------------------------
Calc_AirCharge_Model:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV R12,map
        MOV R13,eff_vol_slop
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,R4
        MOV R13,eff_vol_ofs
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV maf_cyl,R4
        MOV R12,R4
        MOV R13,#DATA16 0C000H
        MOV R14,n_C93C
        SHL R14,#02H
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        MOV maf_cyl_stk,R4
        MOV R12,maf_fac_slop_egr
        MOV R13,pq_egr
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R13,R4
        MOV R12,maf_fac_ofs_egr
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV R9,R4
        MOV R12,g_cc70
        MOV R13,R9
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,R4
        MOV R13,prs_ex
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV maf_egr,R4
        MOV R12,R4
        MOV R13,maf_cyl
        CALLS SEG Div_Frac_U16_Q16, SOF Div_Frac_U16_Q16
        MOV egr_ratio,R4
        MOV R5,map_drv1
        MOV lv_maf_cc6a,R5
        MOV R2,pq
        CMP R2,DPP0:c_pq_thd
        JMPR cc_UGT,L_C3EBA
        MOV R12,maf_fac_slop
        MOV R13,R2
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R13,R4
        MOV R12,maf_fac_ofs
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV R9,R4
        MOV R12,g_cc6e
        MOV R13,R9
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,R4
        MOV R13,prs_up_thr
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV maf_thr,R4
        MOV R12,R4
        SUB R12,maf_cyl
        ADD R12,maf_egr
        MOV R13,maf_mdl_con_0
        MOV R14,#0EH
        CALLS SEG Mul_Shift_S16, SOF Mul_Shift_S16
        MOV map_drv1,R4
        JMPR cc_UC,L_C3ECE
L_C3EBA:                 ; 0xc3eba
        MOV R12,maf_cyl
        MOV R13,maf_egr
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV maf_thr,R4
        MOV map_drv1,ZEROS
L_C3ECE:                 ; 0xc3ece
        MOV R12,eff_vol_slop
        MOV R13,g_cc6c
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R9,R4
        ADD R9,#DATA16 00800H
        MOV R12,g_cc6c
        MOV R13,maf_egr
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R12,R4
        ADD R12,map_egr
        MOV R13,#DATA16 00801H
        MOV R14,R9
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        MOV map_egr,R4
        MOV R5,map
        SUB R5,map_egr
        MOV map_fg,R5
        MOV R2,pq
        CMP R2,DPP0:c_pq_thd
        JMPR cc_UGT,L_C3F38
        MOV R12,R4
        MOV R13,eff_vol_slop
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,maf_egr
        SUB R12,R4
        SHL R12,#01H
        MOV R13,maf_mdl_con_0
        SHL R13,#01H
        CALLS SEG Mul_S16_Hi, SOF Mul_S16_Hi
        MOV R9,R4
        JMPR cc_UC,L_C3F3A
L_C3F38:                 ; 0xc3f38
        MOV R9,#00H
L_C3F3A:                 ; 0xc3f3a
        MOV R12,eff_vol_slop
        MOV R13,map_fg
        MOV R14,#0BH                    ;@reloc-ok constant
        CALLS SEG Mul_Shift_U16_Sat32, SOF Mul_Shift_U16_Sat32
        MOV R12,R4
        MOV R13,eff_vol_ofs
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV maf_fg_cyl,R4
        MOV R12,R4
        MOV R13,#DATA16 0C000H
        MOV R14,n_C93C
        SHL R14,#02H
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        MOV maf_fg_cyl_stk,R4
        MOV R12,t_seg_av
        MOVBZ R13,g_c322
        SHL R13,#05H
        CALLS SEG Mul_Frac_U16_Sat, SOF Mul_Frac_U16_Sat
        MOV R8,R4
        MOV R12,map_egr_drv1
        ADD R12,R9
        MOV R13,R8
        CALLS SEG Mul_S16_Hi, SOF Mul_S16_Hi
        ADD R4,map_egr
        MOV map_egr_pred,R4
        MOV map_egr_drv1,R9
        MOV R12,map_drv1
        MOV R13,lv_maf_cc6a
        CALLS SEG Sat_Add_S16, SOF Sat_Add_S16
        MOV R12,R4
        MOV R13,R8
        CALLS SEG Mul_S16_Hi, SOF Mul_S16_Hi
        MOV R13,R4
        MOV R12,map
        CALLS SEG Sat_Add_S16_v2, SOF Sat_Add_S16_v2
        MOV R9,R4
        CMP R9,prs_up_thr
        JMPR cc_ULE,L_C3FBE
        MOV R9,prs_up_thr
        SUB R9,#01H
L_C3FBE:                 ; 0xc3fbe
        MOV map_pred,R9
        SUB R9,map_egr_pred
        MOV map_fg_pred,R9
        MOV R12,eff_vol_slop
        MOV R13,R8
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R7,R4
        MOV R12,map_drv1
        MOV R13,lv_maf_cc6a
        CALLS SEG Sat_Add_S16, SOF Sat_Add_S16
        MOV R12,R4
        MOV R13,R7
        MOV R14,#0BH                    ;@reloc-ok constant
        CALLS SEG Mul_Shift_S16, SOF Mul_Shift_S16
        MOV maf_pred_kgh,R4
        MOV R12,#DATA16 0C000H
        MOV R13,R4
        MOV R14,n_C93C
        SHL R14,#02H
        CALLS SEG MulDiv_Round_S16, SOF MulDiv_Round_S16
        MOV maf_pred,R4
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RET

S_C3BA4 ENDS
        END
