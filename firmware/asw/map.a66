; asw/map.a66
; Ambient pressure acquisition and cylinder air charge model.
; 0xC3BA4-0xC400C  (1128 bytes, 2 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_pq_thd                             EQU  09067AH

PUBLIC  Acq_AMP_Mes, Calc_AirCharge_Model
EXTERN  Div_Frac_U16_Q16:NEAR, MulDiv_Round_S16:NEAR, Mul_Frac_U16_Sat:NEAR, Mul_S16_Hi:NEAR
EXTERN  Mul_Shift_S16:NEAR, Mul_Shift_U16_Sat:NEAR, Mul_Shift_U16_Sat32:NEAR, Mul_U16_Hi:NEAR
EXTERN  Sat_Add3_U16:NEAR, Sat_Add_S16:NEAR, Sat_Add_S16_v2:NEAR, Sat_Add_U16:NEAR
EXTERN  multipied_r12_r13_UGT_r14_rets_r4:NEAR, sub_r12_r13_rets_r4:NEAR

S_C3BA4 SECTION CODE AT 0C3BA4H

; ======== Acq_AMP_Mes  (@0xc3ba4) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (EMS31, verified): Ambient pressure acquisition (AMP_MES)
        ; ------------------------------------------------------------
Acq_AMP_Mes:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        MOV R12,ar_red
        MOV R13,maf_mdl_con_1
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
