        MOV R12,g_cc6e
        MOV R13,maf_fac_slop
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,R4
        MOV R13,R8
        MOV R14,eff_vol_slop
        CALLS SEG Sat_Add3_U16, SOF Sat_Add3_U16
        MOV R9,R4
        MOV R12,t_seg_av
        MOV R13,maf_mdl_con_0
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV g_cc6c,R4
        MOV R8,R4
        SHR R8,#01H
        ADD R9,#01H
        JMPR cc_EQ,L_C3CD6
        MOV R5,R7
        CPL R5
        CMP R5,R6
        JMPR cc_C,L_C3CD6
        MOV R12,R6
        MOV R13,prs_up_thr
        MOV R14,#0FH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R6,R4
        MOV R12,R7
