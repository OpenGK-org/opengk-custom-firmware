        MOV R14,#0FH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,R4
        MOV R13,R6
        MOV R14,eff_vol_ofs
        SHR R14,#04H
        CALLS SEG Sat_Add3_U16, SOF Sat_Add3_U16
        MOV R7,R4
        MOV R12,R8
        MOV R13,R9
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R6,R4
        ADD R6,#DATA16 00800H
        MOV R12,R7
        MOV R13,R8
        MOV R14,R6
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        SHR R4,#01H
        MOV R8,R4
        MOV R12,map_drv1
        MOV R13,t_seg_av
        MOV R14,#0EH
        CALLS SEG Mul_Shift_S16, SOF Mul_Shift_S16
        MOV R13,R4
        MOV R12,map
        CALLS SEG Sat_Add_U16, SOF Sat_Add_U16
        MOV R13,R4
        MOV R12,#DATA16 00801H
        MOV R14,R6
        CALLS SEG MulDiv_Round_S16, SOF MulDiv_Round_S16
        MOV R6,R4
        MOV R12,R8
        MOV R13,R6
        CALLS SEG Sat_Add_S16_v2, SOF Sat_Add_S16_v2
        MOV R6,R4
        MOV R8,prs_up_thr
        MOV R12,DPP0:c_pq_thd
        MOV R13,R8
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        CMP R6,R4
        JMPR cc_C,L_C3CCC
        JB lv_pl.04H,L_C3CCC
        MOV R12,R7
        MOV R13,R9
        CALLS SEG Div_Frac_U16_Q16, SOF Div_Frac_U16_Q16
        MOV R6,R4
        SHR R6,#01H
L_C3CCC:                 ; 0xc3ccc
        CMP R6,R8
        JMPR cc_C,L_C3DBC
        MOV R6,R8
        SUB R6,#01H
        JMPR cc_UC,L_C3DBC
L_C3CD6:                 ; 0xc3cd6
        MOV R12,g_cc70
        MOV R13,maf_fac_slop_egr
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R6,R4
        MOV R12,g_cc6e
        MOV R13,maf_fac_slop
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R12,R4
        MOV R13,R6
        MOV R14,eff_vol_slop
        SHR R14,#05H
        CALLS SEG Sat_Add3_U16, SOF Sat_Add3_U16
        MOV R9,R4
        MOV R12,g_cc6e
        MOV R13,maf_fac_ofs
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R13,R4
        MOV R12,prs_up_thr
        MOV R14,#0EH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R6,R4
        MOV R12,g_cc70
        MOV R13,maf_fac_ofs_egr
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        MOV R13,R4
        MOV R12,prs_ex
        MOV R14,#0EH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,R4
        MOV R13,R6
        MOV R14,eff_vol_ofs
        SHR R14,#08H
        CALLS SEG Sat_Add3_U16, SOF Sat_Add3_U16
        MOV R7,R4
        MOV R12,R8
        MOV R13,R9
        MOV R14,#0DH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R6,R4
        ADD R6,#DATA16 00200H
        MOV R12,R7
        MOV R13,R8
        SHL R13,#01H
        MOV R14,R6
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        MOV R8,R4
        MOV R12,map_drv1
        MOV R13,t_seg_av
        MOV R14,#0EH
        CALLS SEG Mul_Shift_S16, SOF Mul_Shift_S16
        MOV R13,R4
        MOV R12,map
        CALLS SEG Sat_Add_U16, SOF Sat_Add_U16
        MOV R13,R4
        MOV R12,#DATA16 00200H
        MOV R14,R6
        CALLS SEG MulDiv_Round_S16, SOF MulDiv_Round_S16
        MOV R6,R4
        MOV R12,R8
        MOV R13,R6
        CALLS SEG Sat_Add_S16_v2, SOF Sat_Add_S16_v2
        MOV R6,R4
        MOV R8,prs_up_thr
        MOV R12,DPP0:c_pq_thd
        MOV R13,R8
        CALLS SEG Mul_U16_Hi, SOF Mul_U16_Hi
        CMP R6,R4
        JMPR cc_C,L_C3DB4
        JB lv_pl.04H,L_C3DB4
        MOV R12,R7
        MOV R13,#DATA16 04001H
        MOV R14,R9
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        MOV R6,R4
L_C3DB4:                 ; 0xc3db4
        CMP R6,R8
        JMPR cc_C,L_C3DBC
        MOV R6,R8
        SUB R6,#01H
L_C3DBC:                 ; 0xc3dbc
        MOV map,R6
        MOV R12,R6
        MOV R13,R8
        CALLS SEG Div_Frac_U16_Q16, SOF Div_Frac_U16_Q16
        MOV pq,R4
        MOV R12,R6
        MOV R13,prs_ex
        CALLS SEG Div_Frac_U16_Q16, SOF Div_Frac_U16_Q16
        MOV pq_egr,R4
        MOV R6,[R0+]
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
