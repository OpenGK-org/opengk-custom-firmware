; asw/plaus/plaus_tia.a66
; Intake air temperature plausibility rate-based monitor (IUMPR).
; 0xC916E-0xC9216  (168 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_RBM_TIA_Plaus, ClrBits_state_rbm_tia_plaus_178, Reset_state_rbm_tia_plaus_16e
EXTERN  Div_U32_U16_Round32:NEAR

S_C916E SECTION CODE AT 0C916EH

; ======== Reset_state_rbm_tia_plaus_16e  (@0xc916e) ========
Reset_state_rbm_tia_plaus_16e:
        MOVB state_rbm_tia_plaus,ZEROS
        MOV rate_rbm_tia_plaus,ONES
        RETS

; ======== ClrBits_state_rbm_tia_plaus_178  (@0xc9178) ========
ClrBits_state_rbm_tia_plaus_178:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_tia_plaus,RL4
        RETS

; ======== Calc_RBM_TIA_Plaus  (@0xc9182) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for TIA Plaus:
        ; updates state_rbm_tia_plaus / rate_rbm_tia_plaus (in-use completion ratio = numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_TIA_Plaus:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB obd_sf.0DH,L_C9210
        MOVB RL4,state_rbm_tia_plaus
        ANDB RL4,#01H
        JMPR cc_NE,L_C919C
        JNB lv_n_max_isa_err.0BH,L_C919C
        MOVB RL4,#01H
        ORB state_rbm_tia_plaus,RL4
L_C919C:                 ; 0xc919c
        MOVB RL4,state_rbm_tia_plaus
        ANDB RL4,#02H
        JMPR cc_NE,L_C91CA
        JB lv_cam_err.0AH,L_C91C4
        JB lv_cam_err.07H,L_C91C4
        JB lv_cam_err.08H,L_C91C4
        JB lv_cam_err.0CH,L_C91C4
        JB lv_lam_lim_1_err.01H,L_C91C4
        JB lv_cam_err.0DH,L_C91C4
        JB lv_cam_err.0EH,L_C91C4
        JNB lv_lam_lim_1_err.00H,L_C91CA
L_C91C4:                 ; 0xc91c4
        MOVB RL4,#02H
        ORB state_rbm_tia_plaus,RL4
L_C91CA:                 ; 0xc91ca
        MOVB RL4,state_rbm_tia_plaus
        ANDB RL4,#04H
        JMPR cc_NE,L_C91D8
        MOVB RL4,#04H
        ORB state_rbm_tia_plaus,RL4
L_C91D8:                 ; 0xc91d8
        MOV R12,ctr_comp_rbm_tia_plaus
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_tia_plaus
        CALLS 00FH,Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_C9202
        CMP R8,#DATA16 0FFFFH
L_C9202:                 ; 0xc9202
        JMPR cc_C,L_C920A
        MOV rate_rbm_tia_plaus,ONES
        JMPR cc_UC,L_C9210
L_C920A:                 ; 0xc920a
        MOV R4,R8
        MOV rate_rbm_tia_plaus,R4
L_C9210:                 ; 0xc9210
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_C916E ENDS
        END
