; asw/plaus/plaus_vls.a66
; Front O2 voltage plausibility rate-based monitor (IUMPR).
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_RBM_VLS_Up_Plaus, ClrBits_state_rbm_vls_up_plaus_5b2, Reset_state_rbm_vls_up_plaus_50e
EXTERN  Div_U32_U16_Round32:NEAR

S_PLAUS_VLS SECTION CODE

; ======== Reset_state_rbm_vls_up_plaus_50e  (@0xd450e) ========
Reset_state_rbm_vls_up_plaus_50e:
        MOVB state_rbm_vls_up_plaus,ZEROS
        MOV rate_rbm_vls_up_plaus,ONES
        RETS

; ======== Calc_RBM_VLS_Up_Plaus  (@0xd4518) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for VLS Up
        ; Plaus: updates state_rbm_vls_up_plaus / rate_rbm_vls_up_plaus (in-use completion ratio =
        ; numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_VLS_Up_Plaus:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB obd_sf.0DH,L_D45AC
        MOVB RL4,state_rbm_vls_up_plaus
        ANDB RL4,#01H
        JMPR cc_NE,L_D4538
        MOV R4,diag_f864
        AND R4,#DATA16 00010H
        JMPR cc_NE,L_D4538
        MOVB RL4,#01H
        ORB state_rbm_vls_up_plaus,RL4
L_D4538:                 ; 0xd4538
        MOVB RL4,state_rbm_vls_up_plaus
        ANDB RL4,#02H
        JMPR cc_NE,L_D4566
        JB lv_cat_diag_inh_1.05H,L_D4560
        JB lv_dur_igc_0_err.00H,L_D4560
        JB lv_dur_igc_0_err.01H,L_D4560
        JB lv_dur_igc_0_err.02H,L_D4560
        JB lv_dur_igc_0_err.03H,L_D4560
        JB lv_lam_lim_1_err.0BH,L_D4560
        JB lv_lam_lim_1_err.03H,L_D4560
        JNB lv_er_carb_b4.04H,L_D4566
L_D4560:                 ; 0xd4560
        MOVB RL4,#02H
        ORB state_rbm_vls_up_plaus,RL4
L_D4566:                 ; 0xd4566
        MOVB RL4,state_rbm_vls_up_plaus
        ANDB RL4,#04H
        JMPR cc_NE,L_D4574
        MOVB RL4,#04H
        ORB state_rbm_vls_up_plaus,RL4
L_D4574:                 ; 0xd4574
        MOV R12,ctr_comp_rbm_vls_up_plaus
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_vls_up_plaus
        CALLS SEG Div_U32_U16_Round32, SOF Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_D459E
        CMP R8,#DATA16 0FFFFH
L_D459E:                 ; 0xd459e
        JMPR cc_C,L_D45A6
        MOV rate_rbm_vls_up_plaus,ONES
        JMPR cc_UC,L_D45AC
L_D45A6:                 ; 0xd45a6
        MOV R4,R8
        MOV rate_rbm_vls_up_plaus,R4
L_D45AC:                 ; 0xd45ac
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== ClrBits_state_rbm_vls_up_plaus_5b2  (@0xd45b2) ========
ClrBits_state_rbm_vls_up_plaus_5b2:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_vls_up_plaus,RL4
        RETS

S_PLAUS_VLS ENDS
        END
