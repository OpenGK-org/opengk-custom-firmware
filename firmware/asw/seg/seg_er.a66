L_D4A80:                 ; 0xd4a80
        RETS

; ======== Calc_Mis_Ctr_Voltage  (@0xd4a82) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Calc_Mis_Ctr_Voltage:
        MOV [-R0],R6
        MOVB RL6,#00H
L_D4A86:                 ; 0xd4a86
        MOVBZ R4,RL6
        SHL R4,#01H
        MOV R5,[R4+#0D096H]
        MOVBZ R4,RL6
        SHL R4,#01H
        MOV R2,[R4+#0D09EH]
        MOV R4,R2
        SHL R4,#03H
        ADD R4,R2
        ADD R4,R5
        MOV R5,#00H
        MOV R12,R4
        MOV R13,R5
        MOV R10,#0AH
        MOV R11,#00H
        MOV R4,R12
        MOV R5,R13
        CALLS 00DH,Calc_CtrlModule_Voltage
        MOV R12,R4
        MOV R13,R5
        MOV R4,R12
        MOVBZ R5,RL6
        SHL R5,#01H
        MOV [R5+#0D09EH],R4
        MOV R4,#00H
        MOVBZ R5,RL6
        SHL R5,#01H
        MOV [R5+#0D096H],R4
        ADDB RL6,#01H
        CMPB RL6,#04H
        JMPR cc_C,L_D4A86
        MOV ctr_mis_tot_dc,ZEROS
        MOV R6,[R0+]
        RETS

S_D4900 ENDS
        END
