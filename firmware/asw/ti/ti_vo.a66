; ======== Calc_Fac_WF_VO_Fdout  (@0xbb95a) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): Wall-film VO fade-out factor fac_wf_vo_fdout.
        ; ------------------------------------------------------------
Calc_Fac_WF_VO_Fdout_B95A:
        MOVB RL4,#DATA16 00080H
        MOVB fac_wf_vo_fdout,RL4
        BCLR lv_carb_err.06H
        MOV vo_fast_wf_z0,ZEROS
        MOV vo_fast_wf_z1,ZEROS
        MOV vo_fast_wf_z2,ZEROS
        MOV vo_fast_wf_z3,ZEROS
        MOV vo_slow_wf_z0,ZEROS
        MOV vo_slow_wf_z1,ZEROS
        MOV vo_slow_wf_z2,ZEROS
        MOV vo_slow_wf_z3,ZEROS
        RETS

; ======== Calc_Fac_WF_VO  (@0xbb986) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Compensation of VO influence on wall film
        ; (fac_tco_st_cor_wf_vo)
        ; ------------------------------------------------------------
Calc_Fac_WF_VO:
        MOV R12,#DATA16 04880H
        MOVBZ R13,tco_st
        CALLS 00FH,Get_IP_Word_2D_Table_DWord_YByte
        MOV fac_tco_st_cor_wf_pos_vo,R4
        MOV R12,#DATA16 04888H
        MOVBZ R13,tco_st
        CALLS 00FH,Get_IP_Word_2D_Table_DWord_YByte
        MOV fac_tco_st_cor_wf_neg_vo,R4
        RETS

