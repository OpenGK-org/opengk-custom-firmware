; ======== Calc_FAC_WF_VO_Fdout  (@0xbbc20) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (ThetaII, verified): wall-film VO fade-out factor fac_wf_vo_fdout = IP(tco,tib) /
        ; IP(tib_int,tco_st)
        ; (was FUN_0bbc20)
        ; ------------------------------------------------------------
Calc_FAC_WF_VO_Fdout:
        MOVB RL4,DPP0:lc_tib_int_fdout_ena
        JMPR cc_NE,L_BBC3C
        MOV R12,#DATA16 0489CH
        MOVBZ R13,tco
        MOV R14,tib
        CALLS 00FH,Get_IP_Byte_3D_Table_DWord_XWord_YByte
        MOVB fac_wf_vo_fdout,RL4
        RETS
L_BBC3C:                 ; 0xbbc3c
        MOV R12,#DATA16 04890H
        MOV R13,tib_int
        MOVBZ R14,tco_st
        CALLS 00FH,Get_IP_Byte_3D_Table_DWord_XByte_YWord
        MOVB fac_wf_vo_fdout,RL4
        RETS

