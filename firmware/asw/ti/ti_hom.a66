S_TI_HOM SECTION CODE

; ======== Calc_TI_Hom_Base  (@0xdce40) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by dominant output signals): Homogeneous base injection per cylinder: ti_hom_bas
        ; / ti_cyl_sam / ti_fac_cor / tco_rest.
        ; ------------------------------------------------------------
Calc_TI_Hom_Base:
        MOV R12,#DATA16 00032H                    ;@reloc-ok constant
        MOV R4,R12
        MOV R2,#DATA16 06000H
        MULU R4,R2
        MOV R5,MDH_FE0C
        MOV R4,0FE0EH
        MOV R2,R5
        SHR R4,#0FH
        SHR R5,#0FH
        SHL R2,#01H
        OR R4,R2
        MOV ti_inj_min_pw,R4
        MOVB RL4,tco
        CMPB RL4,DPP0:c_tco_max_tipr_seq
        JMPR cc_ULE,L_DCE72
        MOVB lv_ti_f588,ZEROS
        JMPR cc_UC,L_DCE78
L_DCE72:                 ; 0xdce72
        MOVB RL4,#01H
        MOVB lv_ti_f588,RL4
L_DCE78:                 ; 0xdce78
        MOVB RL4,DPP0:c_tipr_end
        JMPR cc_EQ,L_DCE86
        MOVB RL5,#01H
        MOVB lv_ti_f589,RL5
        JMPR cc_UC,L_DCE8A
L_DCE86:                 ; 0xdce86
        MOVB lv_ti_f589,ZEROS
L_DCE8A:                 ; 0xdce8a
        MOV R4,t_max_rest
        JMPR cc_EQ,L_DCE9C
        MOV t_max_rest,ZEROS
        MOVB RL4,tco
        MOVB tco_rest,RL4
L_DCE9C:                 ; 0xdce9c
        MOVB RL4,tco
        MOVB lv_ti_f4a6,RL4
        MOV ti_cyl_sam,ZEROS
        MOV ti1,ZEROS
        MOV R4,#DATA16 06000H
        MOV R2,#00H
        MULU R4,R2
        MOV R5,MDH_FE0C
        MOV R4,0FE0EH
        MOV R2,R5
        SHR R4,#0FH
        SHR R5,#0FH
        SHL R2,#01H
        OR R4,R2
        MOV ti_hom_bas_1,R4
        MOV lv_ti_f8bc,ZEROS
        MOVB soi,ZEROS
        MOVB RL4,#DATA16 00028H
        MOVB eoi,RL4
        MOV R4,#DATA16 01000H
        MOV ti_fac_cor,R4
        MOV cycnr_st_ast,ZEROS
        MOV ti_cast,ZEROS
        BCLR lv_ast.01H
        BCLR lv_ast.02H
        BCLR lv_ast.03H
        BCLR lv_ast.04H
        BCLR lv_ast.00H
        MOV R5,#DATA16 01000H
        MOV ti_wup,R5
        MOV tib,ZEROS
        MOV ti_fl,ZEROS
        MOV ti_cop,ZEROS
        BCLR lv_iga_dif_max_er.0BH
        BCLR lv_iga_dif_max_er.0DH
        BCLR lv_iga_dif_max_er.0CH
        MOVB RL4,iga_bas_temp_cor
        ADDB RL4,#DATA16 00080H
        MOVB iga_cop,RL4
        MOVB fco_nr,ZEROS
        MOV lv_ti_f89c,ZEROS
        MOV fco_word_1_,ZEROS
        MOV lv_ti_f8b6,ZEROS
        MOV lv_ti_f8b8,ZEROS
        RETS

; ======== Calc_AST_Enrich  (@0xdcf30) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Calc_AST_Enrich:
        BSET lv_ast.00H
        MOV R12,#DATA16 POF sstm_tkw_4_4
        MOV R13,#DATA16 PAG sstm_tkw_4_4
        MOVBZ R14,tco
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF sst_tkw_st_ti_tkw_wl
        MOV R13,#DATA16 PAG sst_tkw_st_ti_tkw_wl
        MOVBZ R14,tco_st
        CALLS SEG Get_IP_Byte_X_Axis, SOF Get_IP_Byte_X_Axis
        JNB lv_conf_mis.0AH,L_DCF68
        MOV R12,#DATA16 POF ip_ti_tco_wup_at__tco__tco_st
        MOV R13,#DATA16 PAG ip_ti_tco_wup_at__tco__tco_st
        CALLS SEG Get_IP_Byte_3D_Table, SOF Get_IP_Byte_3D_Table
        MOVB lv_ti_f490,RL4
        JMPR cc_UC,L_DCF78
L_DCF68:                 ; 0xdcf68
        MOV R12,#DATA16 POF ip_ti_tco_wup__tco__tco_st
        MOV R13,#DATA16 PAG ip_ti_tco_wup__tco__tco_st
        CALLS SEG Get_IP_Byte_3D_Table, SOF Get_IP_Byte_3D_Table
        MOVB lv_ti_f490,RL4
L_DCF78:                 ; 0xdcf78
        MOV R12,#DATA16 POF ldp_tco_ip_ti_tco_wup_asr
        MOV R13,#DATA16 PAG ldp_tco_ip_ti_tco_wup_asr
        MOVBZ R14,tco
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ldp_tco_st_ip_ti_tco_wup_asr
        MOV R13,#DATA16 PAG ldp_tco_st_ip_ti_tco_wup_asr
        MOVBZ R14,tco_st
        CALLS SEG Get_IP_Byte_X_Axis, SOF Get_IP_Byte_X_Axis
        MOV R12,#DATA16 POF ip_ti_tco_wup_asr__tco__tco_st
        MOV R13,#DATA16 PAG ip_ti_tco_wup_asr__tco__tco_st
        CALLS SEG Get_IP_Byte_3D_Table, SOF Get_IP_Byte_3D_Table
        MOVB lv_ti_f491,RL4
        JNB lv_maf_trim.02H,L_DCFC0
        MOV lv_ti_f94e,ZEROS
        BCLR lv_maf_trim.02H
        MOVB RL5,pwl_dly_ctr
        JMPR cc_EQ,L_DCFC4
        SUBB RL5,#01H
        MOVB pwl_dly_ctr,RL5
        RETS
L_DCFC0:                 ; 0xdcfc0
        MOV maf_wf_init,ZEROS
L_DCFC4:                 ; 0xdcfc4
        RETS

