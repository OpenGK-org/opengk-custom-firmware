; ======== Set_Out_FuelReq  (@0xc83ec) ========
        ; ------------------------------------------------------------
        ; Digital-output-latch driver (fd94=request/fd96=state, fd98=feedback; CC5/P2.5=fuel-pump relay): Set
        ; output-request latch fd94/fd96 bit 0x2000 (fuel-pump request).
        ; ------------------------------------------------------------
Set_Out_FuelReq:
        MOVB RL4,#01H
        ORB state_fuel_req,RL4
        MOVB RL4,state_fuel_req
        JMPR cc_NE,L_C8402
        BSET state_out_fault.0DH
        JB state_out_req.04H,L_C840A
        BSET state_out_diag.0DH
        RETS
L_C8402:                 ; 0xc8402
        BCLR state_out_fault.0DH
        JB state_out_req.04H,L_C840A
        BCLR state_out_diag.0DH
L_C840A:                 ; 0xc840a
        RETS

