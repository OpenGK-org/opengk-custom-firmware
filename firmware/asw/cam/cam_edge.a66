        MOV diag_cdc2,R4
        RET

; ======== Calc_Crank_Tooth_Pattern  (@0xc82f2) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by tco/tia/crank output signals): Crank tooth-pattern / engine-rev detection:
        ; lv_crk_tooth_err / nr_pat_eng_rev.
        ; ------------------------------------------------------------
Calc_Crank_Tooth_Pattern:
        MOV [-R0],R6
        MOV R4,cam_1_psn_av
        SHR R4,#04H
        MOVB RL6,RL4
        MOVBZ R12,DPP0:c_cam_1_edge_tooth_neg
        MOVBZ R13,DPP0:c_cam_eng_rev
        CALLS 00FH,sub_r12_13_ret_r4
        MOVBZ R13,RL4
        MOV R12,#DATA16 00078H
        CALLS 00FH,sub_r12_13_ret_r4
