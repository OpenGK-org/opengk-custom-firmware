; asw/cat/cat_rbm.a66
; 0xB8404-0xB84D0  (204 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_sum_min_cat_diag                   EQU  0906B2H
c_temp_min_ls_up                     EQU  09077AH

PUBLIC  Calc_RBM_Cat_Diag, Set_RBM_Cat_Diag_State, Set_RBM_Cat_Diag_State_2
EXTERN  Div_U32_U16_Round32:NEAR

S_B8404 SECTION CODE AT 0B8404H

; ======== Set_RBM_Cat_Diag_State  (@0xb8404) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by fsd/rbm/obd2 output signals): Set catalyst-diag RBM state bit
        ; state_rbm_cat_diag.
        ; ------------------------------------------------------------
Set_RBM_Cat_Diag_State:
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B8410
        MOVB state_rbm_cat_diag,ZEROS
L_B8410:                 ; 0xb8410
        RETS

; ======== Set_RBM_Cat_Diag_State_2  (@0xb8412) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by fsd/rbm/obd2 output signals): Set catalyst-diag RBM state bit (variant).
        ; ------------------------------------------------------------
Set_RBM_Cat_Diag_State_2:
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B8422
        MOVB RL5,#DATA16 000FDH
        ANDB state_rbm_cat_diag,RL5
L_B8422:                 ; 0xb8422
        RETS

; ======== Calc_RBM_Cat_Diag  (@0xb8424) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified: DTC codes / state vars / output signals): Catalyst-diagnosis ratio-monitor
        ; (IUMPR): accumulates state_rbm_cat_diag enable conditions and computes completion rate_rbm_cat_diag
        ; = ctr_comp/ctr_cdn (gated conf_cat_eff & obd_sf).
        ; ------------------------------------------------------------
Calc_RBM_Cat_Diag:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV R7,p_lam_bank1
        MOVB RL4,conf_cat_eff
        CMPB RL4,#01H
        JMPR cc_NE,L_B84C8
        JNB obd_sf.0DH,L_B84C8
        MOVB RL5,state_rbm_cat_diag
        ANDB RL5,#01H
        JMPR cc_NE,L_B8452
        MOV R4,[R7+#0142H]
        CMP R4,DPP0:c_sum_min_cat_diag
        JMPR cc_ULE,L_B8452
        MOVB RL4,#01H
        ORB state_rbm_cat_diag,RL4
L_B8452:                 ; 0xb8452
        MOVB RL4,state_rbm_cat_diag
        ANDB RL4,#02H
        JMPR cc_NE,L_B848A
        JB lv_cat_diag_inh_1.03H,L_B8484
        JB lv_er_carb_b4.04H,L_B8484
        JB lv_dur_igc_0_err.00H,L_B8484
        JB lv_dur_igc_0_err.01H,L_B8484
        JB lv_dur_igc_0_err.02H,L_B8484
        JB lv_dur_igc_0_err.03H,L_B8484
        JB lv_lam_lim_1_err.03H,L_B8484
        JNB lv_lam_lim_1_err.0BH,L_B848A
        MOV R4,teg_dyn
        CMP R4,DPP0:c_temp_min_ls_up
        JMPR cc_NC,L_B848A
L_B8484:                 ; 0xb8484
        MOVB RL4,#02H
        ORB state_rbm_cat_diag,RL4
L_B848A:                 ; 0xb848a
        MOVB RL4,#04H
        ORB state_rbm_cat_diag,RL4
        MOV R12,ctr_comp_rbm_cat_diag
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_cat_diag
        CALLS 00FH,Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_B84BA
        CMP R8,#DATA16 0FFFFH
L_B84BA:                 ; 0xb84ba
        JMPR cc_C,L_B84C2
        MOV rate_rbm_cat_diag,ONES
        JMPR cc_UC,L_B84C8
L_B84C2:                 ; 0xb84c2
        MOV R4,R8
        MOV rate_rbm_cat_diag,R4
L_B84C8:                 ; 0xb84c8
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_B8404 ENDS
        END
