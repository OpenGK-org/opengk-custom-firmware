; asw/mecha.a66
; Canister purge solenoid mechanical rate-based monitor (IUMPR).
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Calc_RBM_CPS_Mecha, ClrBits_state_rbm_cps_mecha_352, Set_state_rbm_cps_mecha_34c
EXTERN  Div_U32_U16_Round32:NEAR

S_MECHA SECTION CODE

; ======== Set_state_rbm_cps_mecha_34c  (@0xd134c) ========
Set_state_rbm_cps_mecha_34c:
        MOVB state_rbm_cps_mecha,ZEROS
        RETS

; ======== ClrBits_state_rbm_cps_mecha_352  (@0xd1352) ========
ClrBits_state_rbm_cps_mecha_352:
        MOVB RL4,#DATA16 000FDH
        ANDB state_rbm_cps_mecha,RL4
        RETS

; ======== Calc_RBM_CPS_Mecha  (@0xd135c) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by state_rbm_/rate_rbm_ output signals): IUMPR rate-based monitor for CPS Mecha:
        ; updates state_rbm_cps_mecha / rate_rbm_cps_mecha (in-use completion ratio = numerator/denominator).
        ; ------------------------------------------------------------
Calc_RBM_CPS_Mecha:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB obd_sf.0DH,L_D13CA
        MOVB RL4,state_rbm_cps_mecha
        ANDB RL4,#01H
        JMPR cc_NE,L_D137A
        JB lv_diagcp_cdn_nok.0DH,L_D1374
        JNB lv_diagcp_cdn_nok.0EH,L_D137A
L_D1374:                 ; 0xd1374
        MOVB RL4,#01H
        ORB state_rbm_cps_mecha,RL4
L_D137A:                 ; 0xd137a
        MOVB RL4,state_rbm_cps_mecha
        ANDB RL4,#02H
        JMPR cc_NE,L_D138C
        JNB lv_err_maf_tps_ratio_2.0DH,L_D138C
        MOVB RL4,#02H
        ORB state_rbm_cps_mecha,RL4
L_D138C:                 ; 0xd138c
        MOVB RL4,#04H
        ORB state_rbm_cps_mecha,RL4
        MOV R12,ctr_comp_rbm_cps_mecha
        MOV R13,#00H
        MOV R13,R12
        MOV R12,0FF1CH
        MOV R14,ctr_cdn_rbm_cps_mecha
        CALLS SEG Div_U32_U16_Round32, SOF Div_U32_U16_Round32
        MOV R8,R4
        MOV R9,R5
        MOV R4,R9
        SHR R8,#03H
        SHR R9,#03H
        SHL R4,#0DH
        OR R8,R4
        CMP R9,#00H
        JMPR cc_NE,L_D13BC
        CMP R8,#DATA16 0FFFFH
L_D13BC:                 ; 0xd13bc
        JMPR cc_C,L_D13C4
        MOV rate_rbm_cps_mecha,ONES
        JMPR cc_UC,L_D13CA
L_D13C4:                 ; 0xd13c4
        MOV R4,R8
        MOV rate_rbm_cps_mecha,R4
L_D13CA:                 ; 0xd13ca
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_MECHA ENDS
        END
