; asw/diag/diag_s5ce.a66
; NVM restore/save of block 0x5CE (ambient-pressure adaptation reset flag).
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  ClrBits_lv_amp_ad_rst_d76, NVM_Restore_s5ce, NVM_Save_s5ce
EXTERN  Elevated_Write_Routine_prg_zone_wrapper:NEAR, xor_routine:NEAR

S_DIAG_S5CE SECTION CODE

; ======== NVM_Restore_s5ce  (@0xd0cfe) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: restores <- validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Restore_s5ce:
        JB lv_pl.0CH,L_D0D70
        JB can_fd58.02H,L_D0D70
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005CEH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS SEG xor_routine, SOF xor_routine
        MOV R10,diag_f890
        MOV R11,diag_f892
        EXTP R11, #02H
        MOV R5,[R10+#05D0H]
        NOP
        CMP R5,R4
        JMPR cc_NE,L_D0D70
        EXTP R11, #02H
        MOVB RL4,[R10+#05CEH]
        NOP
        CMPB RL4,#00H
        BMOVN PSW.06H,PSW.03H
        BMOV lv_amp_ad_rst.0CH,PSW.06H
        EXTP R11, #02H
        MOVB RL4,[R10+#05CFH]
        NOP
        CMPB RL4,#00H
        BMOVN PSW.06H,PSW.03H
        BMOV lv_amp_ad_rst.0DH,PSW.06H
        RETS
L_D0D70:                 ; 0xd0d70
        CALLS SEG ClrBits_lv_amp_ad_rst_d76, SOF ClrBits_lv_amp_ad_rst_d76
        RETS

; ======== ClrBits_lv_amp_ad_rst_d76  (@0xd0d76) ========
ClrBits_lv_amp_ad_rst_d76:
        BCLR lv_amp_ad_rst.0DH
        BCLR lv_amp_ad_rst.0CH
        RETS

; ======== NVM_Save_s5ce  (@0xd0d7c) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: saves RAM-> validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Save_s5ce:
        SUB R0,#02H
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005CEH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0C385H
        MOV R15,#01H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005CFH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0C386H
        MOV R15,#01H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005CEH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS SEG xor_routine, SOF xor_routine
        MOV [R0],R4
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 005D0H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,R0
        MOV R15,#02H
        CALLS SEG Elevated_Write_Routine_prg_zone_wrapper, SOF Elevated_Write_Routine_prg_zone_wrapper
        ADD R0,#02H
        RETS

S_DIAG_S5CE ENDS
        END
