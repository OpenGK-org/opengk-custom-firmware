; asw/diag/diag_s1a4.a66
; NVM restore/save of block 0x1A4 (MAF altitude factor).
; 0xC3746-0xC3832  (236 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  NVM_Restore_s1a4, NVM_Save_s1a4, Set_maf_fac_alti_mmv_7a6
EXTERN  Elevated_Write_Routine_prg_zone_wrapper:NEAR, xor_routine:NEAR

S_C3746 SECTION CODE AT 0C3746H

; ======== NVM_Restore_s1a4  (@0xc3746) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: restores <- validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Restore_s1a4:
        JB lv_pl.0CH,L_C37A0
        JB can_fd58.02H,L_C37A0
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 001A4H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS 00DH,xor_routine
        MOV R10,diag_f890
        MOV R11,diag_f892
        EXTP R11, #02H
        MOV R5,[R10+#01A6H]
        NOP
        CMP R5,R4
        JMPR cc_NE,L_C37A0
        EXTP R11, #02H
        MOVB RL4,[R10+#01A4H]
        NOP
        MOVB maf_fac_alti_mmv,RL4
        RETS
L_C37A0:                 ; 0xc37a0
        CALLS 00CH,Set_maf_fac_alti_mmv_7a6
        RETS

; ======== Set_maf_fac_alti_mmv_7a6  (@0xc37a6) ========
Set_maf_fac_alti_mmv_7a6:
        MOVB RL4,#DATA16 00080H
        MOVB maf_fac_alti_mmv,RL4
        RETS

; ======== NVM_Save_s1a4  (@0xc37b0) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: saves RAM-> validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Save_s1a4:
        SUB R0,#02H
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 001A4H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0C320H
        MOV R15,#01H
        CALLS 00DH,Elevated_Write_Routine_prg_zone_wrapper
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 001A4H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS 00DH,xor_routine
        MOV [R0],R4
        MOV R12,diag_f890
        MOV R13,diag_f892
        ADD R12,#DATA16 001A6H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,R0
        MOV R15,#02H
        CALLS 00DH,Elevated_Write_Routine_prg_zone_wrapper
        ADD R0,#02H
        RETS

S_C3746 ENDS
        END
