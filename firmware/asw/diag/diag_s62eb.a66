; asw/diag/diag_s62eb.a66
; NVM restore/save of block 0x62EB; coolant temperature latched at engine stop.
; 0xC8F28-0xC9032  (266 bytes, 3 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  NVM_Restore_s62eb, NVM_Save_s62eb, Set_TCO_Stop
EXTERN  Elevated_Write_Routine_prg_zone_wrapper:NEAR, xor_routine:NEAR

S_C8F28 SECTION CODE AT 0C8F28H

; ======== NVM_Restore_s62eb  (@0xc8f28) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: restores <- validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Restore_s62eb:
        JNB lv_pl.0CH,L_C8F36
        MOVB RL4,conf_ad_rst
        JMPR cc_EQ,L_C8F36
        CMPB RL4,#02H
        JMPR cc_NE,L_C8F94
L_C8F36:                 ; 0xc8f36
        JB can_fd58.02H,L_C8F94
        EXTP #03H, #02H
        MOV R12,DPP0:diag_f890
        MOV R13,DPP0:diag_f892
        ADD R12,#DATA16 0062EH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS 00DH,xor_routine
        EXTP #03H, #02H
        MOV R10,DPP0:diag_f890
        MOV R11,DPP0:diag_f892
        EXTP R11, #02H
        MOV R5,[R10+#0630H]
        NOP
        CMP R5,R4
        JMPR cc_NE,L_C8F94
        EXTP R11, #02H
        MOVB RL4,[R10+#062FH]
        NOP
        MOVB tco_stop,RL4
        RETS
L_C8F94:                 ; 0xc8f94
        MOVB tco_stop,ZEROS
        RETS

; ======== NVM_Save_s62eb  (@0xc8f9a) ========
        ; ------------------------------------------------------------
        ; NVM adaptation I/O: saves RAM-> validated NVM block (DAT_00f890 base) section; xor_routine checksum.
        ; Section offset in name.
        ; ------------------------------------------------------------
NVM_Save_s62eb:
        SUB R0,#02H
        EXTP #03H, #02H
        MOV R12,DPP0:diag_f890
        MOV R13,DPP0:diag_f892
        ADD R12,#DATA16 0062FH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,#DATA16 0F4AAH
        MOV R15,#01H
        CALLS 00DH,Elevated_Write_Routine_prg_zone_wrapper
        EXTP #03H, #02H
        MOV R12,DPP0:diag_f890
        MOV R13,DPP0:diag_f892
        ADD R12,#DATA16 0062EH
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV [-R0],R12
        SHR R12,#0EH
        SHL R13,#02H
        OR R13,R12
        MOV R12,[R0+]
        AND R12,#DATA16 03FFFH
        MOV R14,#02H
        CALLS 00DH,xor_routine
        MOV [R0],R4
        EXTP #03H, #02H
        MOV R12,DPP0:diag_f890
        MOV R13,DPP0:diag_f892
        ADD R12,#DATA16 00630H
        MOV R4,R12
        MOV R5,R13
        SHL R5,#0EH
        OR R4,R5
        MOV R5,R13
        SHR R5,#02H
        MOV R12,R4
        MOV R13,R5
        MOV R14,R0
        MOV R15,#02H
        CALLS 00DH,Elevated_Write_Routine_prg_zone_wrapper
        ADD R0,#02H
        RETS

; ======== Set_TCO_Stop  (@0xc9028) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by tco/tia/crank output signals): Latch engine-stop coolant temperature
        ; tco_stop.
        ; ------------------------------------------------------------
Set_TCO_Stop:
        MOVB RL4,tco
        MOVB tco_stop,RL4
        RETS

S_C8F28 ENDS
        END
