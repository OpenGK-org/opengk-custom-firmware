; ======== Calc_LS_Down_OBD2_Mod6  (@0xe2d12) ========
        ; ------------------------------------------------------------
        ; OEM (verified by bl_/kwp_ output signals): Rear-O2 OBD2 switching ratio (modulo-6 cycle):
        ; cycnr_ratio_vls_down_mod_6 + cat_diag.
        ; ------------------------------------------------------------
Calc_LS_Down_OBD2_Mod6:
        MOV [-R0],R6
        MOVB obd_c8c7,ZEROS
        MOVB obd_c8c6,ZEROS
        MOVB obd_c8c5,ZEROS
        MOVB lam_bank_1_ls_down_obd2_struct_cycnr_ratio_vls_down_mod_6,ZEROS
        MOV R4,#DATA16 003FFH
        MOV lam_bank_1_ls_down_obd2_struct_vls_diag_pue_ls_down_mod_6,R4
        MOVB lam_bank_1_cat_eff_struct_cat_diag,ZEROS
        MOV R5,#DATA16 08000H
        MOV dtp_mv_mod_6_sword,R5
        MOVB diagcp_dia_mod_6,ZEROS
        MOV dtp_dif_cor_mod_6_sword,ZEROS
        MOV obd_c8f2,ZEROS
        MOV obd_c900,ZEROS
        MOV ctr_mis_tot_nvmy,ZEROS
        MOV ctr_mis_tot_hi,ZEROS
        MOV ctr_mis_tot_dc,ZEROS
        MOVB RL6,#00H
L_E2D56:                 ; 0xe2d56
