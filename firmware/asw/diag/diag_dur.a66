        ; status RAM address (unique per fault).
        ; ------------------------------------------------------------
Diag_DTC_dd426:
        JB can_fd58.09H,L_D5CD0
        JMPA cc_UC,L_D5E12
L_D5CD0:                 ; 0xd5cd0
        JB can_fd58.0BH,L_D5CD8
        JMPA cc_UC,L_D5E12
L_D5CD8:                 ; 0xd5cd8
        MOV R12,#DATA16 05094H
        MOVBZ R13,vb
        CALLS 00FH,Get_IP_Word_2D_Table_DWord_YByte
        CMP R4,isapwm_isa
        JMPA cc_NC,L_D5DDE
        MOV R12,#DATA16 0509CH
        MOVBZ R13,vb
        CALLS 00FH,Get_IP_Word_2D_Table_DWord_YByte
        CMP R4,isapwm_isa
        JMPA cc_ULE,L_D5DDE
        MOVB RL4,g_f5fb
        JMPR cc_NE,L_D5D6A
        JNB dtc_cond_s1.08H,L_D5D16
        MOVB RL5,#01H
        MOVB dtc_test_result,RL5
        MOVB g_f4c3,RL5
        JMPR cc_UC,L_D5D3E
L_D5D16:                 ; 0xd5d16
        JNB dtc_cond_s2.08H,L_D5D26
        MOVB RL4,#02H
        MOVB dtc_test_result,RL4
        MOVB g_f4c3,RL4
        JMPR cc_UC,L_D5D3E
L_D5D26:                 ; 0xd5d26
        JNB dtc_cond_s3.08H,L_D5D36
        MOVB RL4,#04H
        MOVB dtc_test_result,RL4
        MOVB g_f4c3,RL4
        JMPR cc_UC,L_D5D3E
L_D5D36:                 ; 0xd5d36
        MOVB dtc_test_result,ZEROS
        MOVB g_f4c3,ZEROS
L_D5D3E:                 ; 0xd5d3e
        MOV R12,#DATA16 0D426H
        MOV R13,#DATA16 0576CH
        MOVBZ R14,DPP0:c_abc_inc_isa_1
        MOVBZ R15,DPP0:c_abc_max_isa_1
        CALLS 00DH,DTC_Update_Debounced
        BMOV lv_dur_igc_0_err.0DH,dtc_status_work.06H
        MOVBZ R4,diag_d430
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_D5D6E
        MOV R4,#DATA16 0DFFFH
        AND dtc_st_grp_igc,R4
        JMPR cc_UC,L_D5D6E
L_D5D6A:                 ; 0xd5d6a
        ADDB g_f5fb,ONES
L_D5D6E:                 ; 0xd5d6e
        MOVB RL4,g_f5fc
        JMPR cc_NE,L_D5DD8
        JNB dtc_cond_s1.0AH,L_D5D84
        MOVB RL5,#01H
        MOVB dtc_test_result,RL5
        MOVB g_f4c4,RL5
        JMPR cc_UC,L_D5DAC
L_D5D84:                 ; 0xd5d84
        JNB dtc_cond_s2.0AH,L_D5D94
        MOVB RL4,#02H
        MOVB dtc_test_result,RL4
        MOVB g_f4c4,RL4
        JMPR cc_UC,L_D5DAC
L_D5D94:                 ; 0xd5d94
        JNB dtc_cond_s3.0AH,L_D5DA4
        MOVB RL4,#04H
        MOVB dtc_test_result,RL4
        MOVB g_f4c4,RL4
        JMPR cc_UC,L_D5DAC
L_D5DA4:                 ; 0xd5da4
        MOVB dtc_test_result,ZEROS
        MOVB g_f4c4,ZEROS
L_D5DAC:                 ; 0xd5dac
        MOV R12,#DATA16 0D434H
        MOV R13,#DATA16 05782H
        MOVBZ R14,DPP0:c_abc_inc_isa_2
        MOVBZ R15,DPP0:c_abc_max_isa_2
        CALLS 00DH,DTC_Update_Debounced
        BMOV lv_dur_igc_0_err.0EH,dtc_status_work.06H
        MOVBZ R4,diag_d43e
        AND R4,#DATA16 00020H
        JMPR cc_EQ,L_D5E12
        MOV R4,#DATA16 0BFFFH
        AND dtc_st_grp_igc,R4
        JMPR cc_UC,L_D5E12
L_D5DD8:                 ; 0xd5dd8
        ADDB g_f5fc,ONES
        JMPR cc_UC,L_D5E12
L_D5DDE:                 ; 0xd5dde
        MOVB RL4,g_f5fb
        EXTP #024H, #01H
        CMPB RL4,DPP0:c_t_dly_psd_isa
        JMPR cc_UGT,L_D5DF8
        EXTP #024H, #01H
        MOVB RL5,DPP0:c_t_dly_psd_isa
        MOVB g_f5fb,RL5
L_D5DF8:                 ; 0xd5df8
        MOVB RL4,g_f5fc
        EXTP #024H, #01H
        CMPB RL4,DPP0:c_t_dly_psd_isa
        JMPR cc_UGT,L_D5E12
        EXTP #024H, #01H
        MOVB RL5,DPP0:c_t_dly_psd_isa
        MOVB g_f5fc,RL5
L_D5E12:                 ; 0xd5e12
        BCLR dtc_cond_s3.08H
        BCLR dtc_cond_s2.08H
        BCLR dtc_cond_s1.08H
        BCLR dtc_cond_s3.0AH
        BCLR dtc_cond_s2.0AH
        BCLR dtc_cond_s1.0AH
        RETS

; ======== Reset_Df4c3_e20  (@0xd5e20) ========
Reset_Df4c3_e20:
        MOVB g_f4c3,ZEROS
        MOVB g_f4c4,ZEROS
        RETS

S_D51BA ENDS
        END
