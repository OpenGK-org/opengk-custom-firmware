        MOV R4,[R0]
        MOV R5,[R0+#02H]
        MOV bl_exec_addr_lo,R4
        MOV bl_exec_addr_hi,R5
        MOV bl_exec_len,R9
        MOV R2,#DATA16 0E558H
        MOV bl_exec_src_ptr,R2
        EXTP #00H, #02H
        MOV R4,kwp_286
        MOV R5,kwp_288
        CALLS SEG Push_To_System_Stack, SOF Push_To_System_Stack
        MOV R4,R9
        MOV R5,#00H
        MOV R10,[R0]
        MOV R11,[R0+#02H]
        ADD R10,R4
        ADDC R11,R5
        MOV [R0],R10
        MOV [R0+#02H],R11
        MOV R4,R7
        MOV R5,R8
        MOV R10,#DATA16 0FFEFH
        MOV R11,#09H
        SUB R4,R10
        SUBC R5,R11
        JMPR cc_UGT,L_A6BAE
        JB bl_mode_status_flags.07H,L_A6B2C
L_A6BAE:                 ; 0xa6bae
        JNB bl_mode_status_flags.07H,L_A6BFE
        MOVB RL4,#DATA16 00042H
        MOVB bl_kwp_sid,RL4
        MOVB RL4,#DATA16 00024H
        MOVB bl_kwp_subfn,RL4
        MOVB RL4,#DATA16 00048H
        MOVB g_e55a,RL4
        MOVB RL4,#DATA16 00090H
        MOVB g_e55b,RL4
        MOV R4,#DATA16 0FFF0H
        MOV R5,#09H
        MOV bl_exec_addr_lo,R4
        MOV bl_exec_addr_hi,R5
        MOV R2,#04H
        MOV bl_exec_len,R2
        MOV R3,#DATA16 0E558H
        MOV bl_exec_src_ptr,R3
        EXTP #00H, #02H
        MOV R4,kwp_286
        MOV R5,kwp_288
        CALLS SEG Push_To_System_Stack, SOF Push_To_System_Stack
L_A6BFE:                 ; 0xa6bfe
        MOVB bl_exec_magic_b3,ZEROS
