S_A6A44 SECTION CODE AT 0A6A44H

; ======== CCP_Validate_Program  (@0xa6a44) ========
        ; ------------------------------------------------------------
        ; Seg-A ISR helper (verified by SFR/CCP usage): CCP program/flash validation (calls _BL_validate_...;
        ; verifies flashed block).
        ; ------------------------------------------------------------
CCP_Validate_Program:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        SUB R0,#04H
        MOV R9,#00H
        MOV R4,#DATA16 08000H
        MOV R5,#08H
