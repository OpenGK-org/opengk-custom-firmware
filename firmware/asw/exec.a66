        MOV R2,[R4]
        CMP R2,#DATA16 0FFFFH
        JMPR cc_EQ,L_A6AA2
        MOV R8,#DATA16 04F7AH
        JMPR cc_UC,L_A6A6E
L_A6A66:                 ; 0xa6a66
        MOV R4,[R8+#02H]
        ADD R9,R4
        ADD R8,#04H
L_A6A6E:                 ; 0xa6a6e
        MOV R4,[R8]
        JMPR cc_NE,L_A6A66
        MOV R4,#DATA16 08000H
        MOV R5,#08H
        EXTS R5, #01H
        MOV R2,[R4]
        CMP R9,R2
        JMPR cc_NE,L_A6AA0
        MOV R12,#04H
        MOV R13,#DATA16 00022H
        MOV R14,R9
        CALLS SEG xor_routine, SOF xor_routine
        MOV R6,R4
        MOV R4,#DATA16 08002H
        MOV R5,#08H
        EXTS R5, #01H
        MOV R2,[R4]
        CMP R6,R2
        JMPR cc_EQ,L_A6AA2
        MOV R9,#00H
        JMPR cc_UC,L_A6AA2
L_A6AA0:                 ; 0xa6aa0
        MOV R9,#00H
L_A6AA2:                 ; 0xa6aa2
        CMP R9,#00H
        JMPR cc_EQ,L_A6AEA
        MOV R4,#DATA16 08004H
        MOV R5,#08H
        MOV [R0],R4
        MOV [R0+#02H],R5
        MOV R8,#DATA16 04F7AH
        JMPR cc_UC,L_A6AE6
L_A6AB8:                 ; 0xa6ab8
        MOV R7,[R8]
        MOV R9,[R8+#02H]
        JMPR cc_UC,L_A6AE0
L_A6AC0:                 ; 0xa6ac0
        MOV R4,[R0]
        MOV R5,[R0+#02H]
        EXTS R5, #01H
        MOVB RL3,[R4]
        MOVB [R7],RL3
        ADD R7,#01H
        MOV R4,[R0]
        MOV R5,[R0+#02H]
        ADD R4,#01H
        ADDC R5,#00H
        MOV [R0],R4
        MOV [R0+#02H],R5
        SUB R9,#01H
L_A6AE0:                 ; 0xa6ae0
        CMP R9,#00H
        JMPR cc_NE,L_A6AC0
        ADD R8,#04H
L_A6AE6:                 ; 0xa6ae6
        MOV R4,[R8]
        JMPR cc_NE,L_A6AB8
L_A6AEA:                 ; 0xa6aea
        ADD R0,#04H
        MOV R6,[R0+]
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== BL_Set_ExecMagic_Full  (@0xa6af6) ========
        ; ------------------------------------------------------------
