; ======== CanPurge_Reset  (@0xb2874) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen signals, verified): Evaporative Emission Control: canister purge reset
        ; ------------------------------------------------------------
CanPurge_Reset:
        CALLS SEG Init_CPS_CPPWM, SOF Init_CPS_CPPWM
        MOV fuel_flow_cp,ZEROS
        MOV rel_flow_cps,ZEROS
        MOV rel_flow_cps_old,ZEROS
        MOV rel_flow_cps_old_min,ZEROS
        MOV maf_cyl_dly,ZEROS
        MOV maf_dly_mmv,ZEROS
        MOV R4,DPP0:c_cl_st_cp
        MOV cl,R4
        MOV R5,DPP0:c_cl_st_cp
        MOV cl_mmv,R5
        MOV cl_mmv_old,ZEROS
        MOV cl_mmv_di,ZEROS
        BCLR lv_fcut_fast.07H
        BCLR lv_fcut_fast.09H
        BCLR lv_fcut_fast.08H
        BCLR lv_fcut_fast.0BH
        BCLR lv_fcut_fast.0AH
        MOV R2,maf_cyl
        MOV maf_cyl_old,R2
        MOV R3,maf_cyl
        MOV maf_cyl_old2,R3
        MOV R1,maf_cyl
        MOV maf_cyl_dly_old,R1
        MOV ti_lam_cp_1,ZEROS
        BCLR lv_fcut_fast.06H
        BCLR lv_fcut_fast.0CH
        MOVB lam_p_sum_cp,ZEROS
        MOV t_di_max_cp,ZEROS
        MOV t_di_ramp_open_cp,ZEROS
        MOV t_wait_ramp_open,ZEROS
        MOV cp_norm_deac_state,ZEROS
        MOV state_cp_ctl,ZEROS
        RET

; ======== CanPurge_Calc_PWM_Prs  (@0xb28ec) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by cp/evap/dtp/diagcp output signals + DTC): Purge-valve PWM duty cppwm_cps +
        ; line pressure prs_cps.
        ; ------------------------------------------------------------
CanPurge_Calc_PWM_Prs:
        MOV [-R0],R9
        MOVB RL4,conf_cp
        JMPR cc_EQ,L_B299A
        BXOR lv_fcut_fast.0EH,ONES.00H
        JMPR cc_NN,L_B299A
        MOV R12,amp
        MOV R13,map
        CALLS SEG Sat_Sub_S16_v2, SOF Sat_Sub_S16_v2
        MOV prs_cps,R4
        JNB lv_cp_act.05H,L_B293A
        JB lv_act_diagcps.03H,L_B291A
        MOV R5,rel_flow_cps
        CMP R5,#00H
        JMPR cc_ULE,L_B2924
L_B291A:                 ; 0xb291a
        CALLA cc_UC,CanPurge_Calc_PWM
        CALLA cc_UC,CPS_CPPWM_Control
        JMPR cc_UC,L_B2928
L_B2924:                 ; 0xb2924
        CALLS SEG Init_CPS_CPPWM, SOF Init_CPS_CPPWM
L_B2928:                 ; 0xb2928
        MOV R12,cppwm
        MOV R13,DPP0:c_cppwm_as
        ASHR R13,#01H
        CALLS SEG Sat_Add_S16_v2, SOF Sat_Add_S16_v2
        MOV R9,R4
        JMPR cc_UC,L_B2942
L_B293A:                 ; 0xb293a
        CALLS SEG Init_CPS_CPPWM, SOF Init_CPS_CPPWM
        MOV R9,#DATA16 0024DH
L_B2942:                 ; 0xb2942
        JNB state_out_act.0BH,L_B294C
        MOVBZ R9,lv_cp_f561
        SHL R9,#07H
L_B294C:                 ; 0xb294c
        CMP R9,#DATA16 07DB2H
        JMPR cc_ULE,L_B295C
        MOV R4,#DATA16 07DB2H
        MOV cppwm_cps,R4
        JMPR cc_UC,L_B2970
L_B295C:                 ; 0xb295c
        CMP R9,#DATA16 0024DH
        JMPR cc_NC,L_B296C
        MOV R4,#DATA16 0024DH
        MOV cppwm_cps,R4
        JMPR cc_UC,L_B2970
L_B296C:                 ; 0xb296c
        MOV cppwm_cps,R9
L_B2970:                 ; 0xb2970
        JB state_out_req.08H,L_B298E
        MOV R4,cps_pwm_base
        MOV R2,cppwm_cps
        SHL R2,#01H
        MULU R4,R2
        MOV R5,MDH_FE0C
        MOV R4,R5
        MOV R5,0FF1CH
        MOV cps_pwm_cmp,R4
L_B298E:                 ; 0xb298e
        MOV R4,cppwm
        JMPR cc_NE,L_B2998
        BCLR lv_fcut_fast.0DH
        JMPR cc_UC,L_B299A
L_B2998:                 ; 0xb2998
        BSET lv_fcut_fast.0DH
L_B299A:                 ; 0xb299a
        MOV R9,[R0+]
        RETS

; ======== Tail_f0b28ec_99e  (@0xb299e) ========
Tail_f0b28ec_99e:
        CALLS SEG CanPurge_Calc_PWM_Prs, SOF CanPurge_Calc_PWM_Prs
        RETS

; ======== Init_CPS_CPPWM  (@0xb29a4) ========
        ; ------------------------------------------------------------
