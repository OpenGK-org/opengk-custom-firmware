; ======== CanPurgeSol_Adapt  (@0xb2d46) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (ThetaII, verified): canister purge solenoid adaptation state machine (cps_ad_step_ctr,
        ; cppwm_add_ad)
        ; (was FUN_0b2d46)
        ; ------------------------------------------------------------
CanPurgeSol_Adapt:
        MOV [-R0],R9
        MOVB RL4,conf_cp
        JMPA cc_EQ,L_B2E64
        MOVB RL5,DPP0:lc_cps_ad_ena
        JMPA cc_EQ,L_B2E64
        JNB lv_cdn_diag_maf_dif_ch_int.0EH,L_B2E10
        MOV R4,cp_state
        CMP R4,#04H
        JMPR cc_NE,L_B2E10
