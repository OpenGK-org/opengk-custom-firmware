; asw/tipr/tipr_ti.a66
; 0xB09F0-0xB0B9C  (428 bytes, 4 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_cyl_tipr_first_cam_high            EQU  090182H
c_cyl_tipr_first_cam_low             EQU  090183H
c_tooth_nr_tipr_first                EQU  0903D6H
c_tooth_nr_tipr_fol_ofs              EQU  0903D7H
ldp_n_32_ip_lamb_ch              EQU  090CB2H
ldp_tco_ip_lamb_ch_fac         EQU  090CBBH
ldp_n_32_ip_lamb_ch_is           EQU  090CC4H
ldp_maf_ip_lamb_ch              EQU  09159EH
ldp_t_ast_ip_lamb_ch_fac         EQU  0915B0H
ldp_maf_ip_lamb_ch_is           EQU  0915C2H
ip_lamb_ch__maf__n_32                EQU  092BECH
ip_lamb_ch_fac__tco__t_ast           EQU  092C6CH
ip_lamb_ch_is__maf__n_32             EQU  092CECH

PUBLIC  Calc_Cyl_InjPhase, Calc_TI_CatHeat, Reset_TI_CH, Reset_ti_ch_9f0
EXTERN  Div_Frac_U16_Q16:NEAR, Get_IP_Byte_X_Axis:NEAR, Get_IP_Byte_Y_Axis:NEAR, Get_IP_Word_3D_Table:NEAR
EXTERN  Get_IP_Word_X_Axis:NEAR, Get_IP_Word_Y_Axis:NEAR, Mul_U16_Hi:NEAR, Sat_Add_U8:NEAR

S_B09F0 SECTION CODE AT 0B09F0H

; ======== Reset_ti_ch_9f0  (@0xb09f0) ========
Reset_ti_ch_9f0:
        MOV R4,#DATA16 08000H
        MOV ti_ch,R4
        BCLR lv_act_cle_slv_ivvt.08H
        RETS

; ======== Reset_TI_CH  (@0xb09fc) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Calculation of injection time correction (ti_ch reset)
        ; ------------------------------------------------------------
Reset_TI_CH:
        MOV R4,#DATA16 08000H
        MOV ti_ch,R4
        RETS

; ======== Calc_TI_CatHeat  (@0xb0a06) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): Injection for catalyst heating: ti_ch + lamb_ch_av (+
        ; lv_act_cle_slv_ivvt).
        ; ------------------------------------------------------------
Calc_TI_CatHeat:
        MOV [-R0],R9
        JNB lv_ch.04H,L_B0AE0
        JB lv_err_tps_det.02H,L_B0A14
        JNB lv_iga_dif_max_er.0BH,L_B0A20
L_B0A14:                 ; 0xb0a14
        BSET lv_act_cle_slv_ivvt.08H
        MOV R4,#DATA16 00400H
        MOV lamb_ch_av,R4
        JMPR cc_UC,L_B0ABC
L_B0A20:                 ; 0xb0a20
        BCLR lv_act_cle_slv_ivvt.08H
        JB lv_cdn_diag_maf_dif_ch_int.0EH,L_B0A56
        MOV R12,#DATA16 POF ldp_maf_ip_lamb_ch
        MOV R13,#DATA16 PAG ldp_maf_ip_lamb_ch
        MOV R14,maf_word
        CALLS 00FH,Get_IP_Word_Y_Axis
        MOV R12,#DATA16 POF ldp_n_32_ip_lamb_ch
        MOV R13,#DATA16 PAG ldp_n_32_ip_lamb_ch
        MOVBZ R14,n_32
        CALLS 00FH,Get_IP_Byte_X_Axis
        MOV R12,#DATA16 POF ip_lamb_ch__maf__n_32
        MOV R13,#DATA16 PAG ip_lamb_ch__maf__n_32
        CALLS 00FH,Get_IP_Word_3D_Table
        MOV R9,R4
        JMPR cc_UC,L_B0A84
L_B0A56:                 ; 0xb0a56
        MOV R12,#DATA16 POF ldp_maf_ip_lamb_ch_is
        MOV R13,#DATA16 PAG ldp_maf_ip_lamb_ch_is
        MOV R14,maf_word
        CALLS 00FH,Get_IP_Word_Y_Axis
        MOV R12,#DATA16 POF ldp_n_32_ip_lamb_ch_is
        MOV R13,#DATA16 PAG ldp_n_32_ip_lamb_ch_is
        MOVBZ R14,n_32
        CALLS 00FH,Get_IP_Byte_X_Axis
        MOV R12,#DATA16 POF ip_lamb_ch_is__maf__n_32
        MOV R13,#DATA16 PAG ip_lamb_ch_is__maf__n_32
        CALLS 00FH,Get_IP_Word_3D_Table
        MOV R9,R4
L_B0A84:                 ; 0xb0a84
        MOV R12,#DATA16 POF ldp_tco_ip_lamb_ch_fac
        MOV R13,#DATA16 PAG ldp_tco_ip_lamb_ch_fac
        MOVBZ R14,tco
        CALLS 00FH,Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ldp_t_ast_ip_lamb_ch_fac
        MOV R13,#DATA16 PAG ldp_t_ast_ip_lamb_ch_fac
        MOV R14,t_ast
        CALLS 00FH,Get_IP_Word_X_Axis
        MOV R12,#DATA16 POF ip_lamb_ch_fac__tco__t_ast
        MOV R13,#DATA16 PAG ip_lamb_ch_fac__tco__t_ast
        CALLS 00FH,Get_IP_Word_3D_Table
        MOV R13,R4
        MOV R12,R9
        CALLS 00FH,Mul_U16_Hi
        MOV lamb_ch_av,R4
L_B0ABC:                 ; 0xb0abc
        MOV R4,lamb_ch_av
        CMP R4,#DATA16 00400H
        JMPR cc_EQ,L_B0AD6
        MOV R12,#DATA16 00200H
        MOV R13,R4
        CALLS 00FH,Div_Frac_U16_Q16
        MOV ti_ch,R4
        JMPR cc_UC,L_B0AEA
L_B0AD6:                 ; 0xb0ad6
        MOV R4,#DATA16 08000H
        MOV ti_ch,R4
        JMPR cc_UC,L_B0AEA
L_B0AE0:                 ; 0xb0ae0
        MOV R4,#DATA16 08000H
        MOV ti_ch,R4
        BCLR lv_act_cle_slv_ivvt.08H
L_B0AEA:                 ; 0xb0aea
        MOV R9,[R0+]
        RETS

; ======== Calc_Cyl_InjPhase  (@0xb0aee) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): Per-cylinder injection timing vs cam phase:
        ; cyl_tipr_first/fol_cam_high/low.
        ; ------------------------------------------------------------
Calc_Cyl_InjPhase:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV [-R0],R6
        MOVBZ R12,DPP0:c_tooth_nr_tipr_fol_ofs
        MOVBZ R13,DPP0:c_tooth_nr_tipr_first
        CALLS 00FH,Sat_Add_U8
        MOVB tooth_nr_tipr_fol,RL4
        MOVB RL4,DPP0:c_tooth_nr_tipr_first
        MOVB tooth_nr_tipr_first,RL4
        MOVB RL6,DPP0:c_cyl_tipr_first_cam_high
        MOVBZ R4,RL6
        SHR R4,#04H
        CMPB RL4,#00H
        JMPR cc_NE,L_B0B48
        CMPB RL6,#00H
        JMPR cc_EQ,L_B0B48
        MOVB RL4,RL6
        MOVB cyl_tipr_first_cam_high,RL4
        MOV R8,#00H
        MOV R9,#08H
        JMPR cc_UC,L_B0B2E
L_B0B2A:                 ; 0xb0b2a
        ADD R8,#01H
        SHR R9,#01H
L_B0B2E:                 ; 0xb0b2e
        MOVBZ R4,RL6
        AND R4,R9
        JMPR cc_EQ,L_B0B2A
        CMP R8,#00H
        JMPR cc_EQ,L_B0B42
        MOV R4,#04H
        SUB R4,R8
        MOVB cyl_tipr_fol_cam_high,RL4
        JMPR cc_UC,L_B0B50
L_B0B42:                 ; 0xb0b42
        MOVB cyl_tipr_fol_cam_high,ZEROS
        JMPR cc_UC,L_B0B50
L_B0B48:                 ; 0xb0b48
        MOVB cyl_tipr_first_cam_high,ZEROS
        MOVB cyl_tipr_fol_cam_high,ONES
L_B0B50:                 ; 0xb0b50
        MOVB RL7,DPP0:c_cyl_tipr_first_cam_low
        MOVBZ R4,RL7
        SHR R4,#04H
        CMPB RL4,#00H
        JMPR cc_NE,L_B0B8A
        CMPB RL7,#00H
        JMPR cc_EQ,L_B0B8A
        MOVB RL4,RL7
        MOVB cyl_tipr_first_cam_low,RL4
        MOV R8,#00H
        MOV R9,#08H
        JMPR cc_UC,L_B0B70
L_B0B6C:                 ; 0xb0b6c
        ADD R8,#01H
        SHR R9,#01H
L_B0B70:                 ; 0xb0b70
        MOVBZ R4,RL7
        AND R4,R9
        JMPR cc_EQ,L_B0B6C
        CMP R8,#00H
        JMPR cc_EQ,L_B0B84
        MOV R4,#04H
        SUB R4,R8
        MOVB cyl_tipr_fol_cam_low,RL4
        JMPR cc_UC,L_B0B92
L_B0B84:                 ; 0xb0b84
        MOVB cyl_tipr_fol_cam_low,ZEROS
        JMPR cc_UC,L_B0B92
L_B0B8A:                 ; 0xb0b8a
        MOVB cyl_tipr_first_cam_low,ZEROS
        MOVB cyl_tipr_fol_cam_low,ONES
L_B0B92:                 ; 0xb0b92
        MOV R6,[R0+]
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

S_B09F0 ENDS
        END
