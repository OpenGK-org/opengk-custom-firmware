; asw/maf/maf_variables.a66
; MAF master signal selection and filtering, air model constants and ambient-pressure
; prediction.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
c_crlc_maf_mes_fil                   EQU  090168H
c_maf_mmv_dif_crlc                   EQU  090236H
lc_maf_mes_im_mdl                    EQU  09047EH
c_maf_dif_min_ch_cssm                EQU  0905C4H
c_maf_mes_fil_cssm_lgrd              EQU  0905FCH
c_maf_mmv_hys                        EQU  090608H
c_ra_vol_im                          EQU  090692H
c_t_min_ast_ch_maf_mes_fil           EQU  090704H
ldpm_tia_maf_mdl_con_1                   EQU  090D0BH
ldpm_n_32_ar_red                             EQU  090D43H
ldpm_n_32_maf_tps_diag                    EQU  090D5BH
ldpm_pq_estim_id_maf_fac_ofs                       EQU  0910BEH
ldp_teg_egr_maf_egr_con_1                   EQU  091600H
id_maf_fac_ofs                       EQU  091B4AH
id_maf_fac_slop                      EQU  091B6AH
ip_maf_egr_con_1                     EQU  092E10H
ip_maf_mdl_con_1                     EQU  092E5CH
ip_maf_tps_diag                      EQU  093118H
ip_pred_fac                          EQU  096128H

PUBLIC  Calc_AMP_Pred, Calc_MAF_Model_Const, Calc_MAF_Variables, Calc_Map_Drv1, Set_lv_maf_puls
EXTERN  Abs_Diff_U16:NEAR, Acq_AMP_Mes:NEAR, Add_r12_r13_Return_r4:NEAR, Calc_AMP_Adapt:NEAR
EXTERN  Calc_AMP_Model_PI:NEAR, Calc_AR_Red:NEAR, Calc_AirCharge_Model:NEAR, Calc_HFM_TimeConst:NEAR
EXTERN  Calc_Prs_Up_Thr:NEAR, Diag_MAF_TPS_Ratio:NEAR, Div_Frac_U16_Q16:NEAR, Get_IP_Byte_2D_Table:NEAR
EXTERN  Get_IP_Byte_Y_Axis:NEAR, Get_IP_Word_2D_Table:NEAR, Get_IP_Word_Y_Axis:NEAR, Get_Word_Y_Axis:NEAR
EXTERN  Interp_U16:NEAR, Mul_Shift_S16:NEAR, Mul_Shift_U16_Sat:NEAR, Read_Word_Far:NEAR
EXTERN  ReducedArea_Adapt:NEAR, Reset_amp_mdl_026:NEAR, Reset_uVar1_082:NEAR, Sat_Add_S16:NEAR
EXTERN  Sat_Add_S16_v2:NEAR, Set_lv_cp_set_close_d074:NEAR, multipied_r12_r13_UGT_r14_rets_r4:NEAR, sub_r12_r13_rets_r4:NEAR

S_MAF_VARIABLES SECTION CODE

; ======== Set_lv_maf_puls  (@0xc3832) ========
        ; ------------------------------------------------------------
        ; Named from single dominant output signal (auto-derived, lower confidence than hand-verified).
        ; ------------------------------------------------------------
Set_lv_maf_puls:
        CALLS SEG Calc_MAF_Model_Const, SOF Calc_MAF_Model_Const
        CALLS SEG Reset_amp_mdl_026, SOF Reset_amp_mdl_026
        MOV R4,amp
        MOV map,R4
        MOV map_egr_drv1,ZEROS
        MOV lv_maf_cc6a,ZEROS
        MOV map_drv1,ZEROS
        BCLR lv_maf_puls.01H
        BCLR lv_maf_puls.02H
        RETS

; ======== Calc_MAF_Variables  (@0xc3854) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (MS42, verified): MAF master: selects maf_word, maf_mes_fil (c_crlc_maf_mes_fil),
        ; intake-manifold model
        ; (was FUN_0c3854)
        ; ------------------------------------------------------------
Calc_MAF_Variables:
        MOV [-R0],R9
        MOV [-R0],R8
        JNB lv_cp_set_close.0EH,L_C3862
        MOV R9,maf_kgh_mes
        JMPR cc_UC,L_C3866
L_C3862:                 ; 0xc3862
        MOV R9,maf_mdl_mv
L_C3866:                 ; 0xc3866
        MOV R4,maf_kgh
        MOV lv_maf_cc54,R4
        MOV maf_kgh,R9
        CALLS SEG Calc_Prs_Up_Thr, SOF Calc_Prs_Up_Thr
        CALLS SEG Reset_uVar1_082, SOF Reset_uVar1_082
        CALLS SEG Calc_AR_Red, SOF Calc_AR_Red
        CALLS SEG Calc_AMP_Adapt, SOF Calc_AMP_Adapt
        CALLS SEG Calc_AMP_Model_PI, SOF Calc_AMP_Model_PI
        CALLA cc_UC,Calc_Map_Drv1
        CALLA cc_UC,Acq_AMP_Mes
        CALLA cc_UC,Calc_AirCharge_Model
        CALLS SEG Diag_MAF_TPS_Ratio, SOF Diag_MAF_TPS_Ratio
        MOV R8,maf_word
        JB lv_cdn_diag_maf_dif_ch_int.0BH,L_C38BA
        JB lv_pl.04H,L_C38BA
        MOV R12,maf_mes_fil
        MOV R13,maf_mes
        MOVBZ R14,DPP0:c_crlc_maf_mes_fil
        SHL R14,#08H
        CALLS SEG Interp_U16, SOF Interp_U16
        MOV maf_mes_fil,R4
        JMPR cc_UC,L_C38EA
L_C38BA:                 ; 0xc38ba
        MOV R12,eff_vol_slop
        MOV R13,map_fg_pred
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,R4
        MOV R13,eff_vol_ofs
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV maf_mes_fil,R4
        MOV R12,R4
        MOV R13,#DATA16 0C000H
        MOV R14,n_C93C
        SHL R14,#02H
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        MOV maf_mes_fil,R4
L_C38EA:                 ; 0xc38ea
        JB lv_err_tps_det.04H,L_C38FA
        JB lv_amp_ad_rst.0DH,L_C38FA
        JB lv_cat_diag_inh_1.0FH,L_C38FA
        JNB lv_err_tps_det.0AH,L_C394A
L_C38FA:                 ; 0xc38fa
        JNB lv_amp_ad_rst.0BH,L_C3936
        MOV R12,#DATA16 POF ldpm_n_32_maf_tps_diag
        MOV R13,#DATA16 PAG ldpm_n_32_maf_tps_diag
        MOVBZ R14,n_32
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_maf_tps_diag
        MOV R13,#DATA16 PAG ip_maf_tps_diag
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        MOV maf_kgh_clc,R4
        MOV R12,R4
        MOV R13,#DATA16 0C000H
        MOV R14,n_C93C
        SHL R14,#02H
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        MOV maf_word,R4
        JMPA cc_UC,L_C3A38
L_C3936:                 ; 0xc3936
        MOV R4,maf_kgh_mes
        MOV maf_kgh_clc,R4
        MOV R5,maf_mes_fil
        MOV maf_word,R5
        JMPA cc_UC,L_C3A38
L_C394A:                 ; 0xc394a
        MOV R12,eff_vol_slop
        MOV R13,map_fg_pred
        MOV R14,#0BH
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV R12,R4
        MOV R13,eff_vol_ofs
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV maf_kgh_clc,R4
        MOV R12,R4
        MOV R13,#DATA16 0C000H
        MOV R14,n_C93C
        SHL R14,#02H
        CALLS SEG multipied_r12_r13_UGT_r14_rets_r4, SOF multipied_r12_r13_UGT_r14_rets_r4
        MOV maf_im_mdl,R4
        JB lv_maf_puls.01H,L_C3990
        MOV R12,R4
        MOV R13,maf_mes_fil
        CALLS SEG Abs_Diff_U16, SOF Abs_Diff_U16
        CMP R4,DPP0:c_maf_dif_min_ch_cssm
        JMPR cc_UGT,L_C3990
        BSET lv_maf_puls.01H
L_C3990:                 ; 0xc3990
        MOVB RL4,DPP0:lc_maf_mes_im_mdl
        JMPR cc_EQ,L_C3A30
        JNB lv_pl.09H,L_C3A30
        JNB lv_ch.03H,L_C3A30
        JNB lv_ct.00H,L_C3A30
        JB abs_def.02H,L_C3A30
        MOV R4,t_ast
        CMP R4,DPP0:c_t_min_ast_ch_maf_mes_fil
        JMPR cc_C,L_C3A30
        JNB lv_maf_puls.01H,L_C3A30
        JNB lv_cp_set_close.0EH,L_C3A30
        JB lv_maf_puls.02H,L_C3A26
        MOV R5,maf_word
        CMP R5,maf_mes_fil
        JMPR cc_ULE,L_C39F6
        MOV R12,maf_word
        MOV R13,maf_mes_fil
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        CMP R4,DPP0:c_maf_mes_fil_cssm_lgrd
        JMPR cc_ULE,L_C39EA
        MOV R12,maf_word
        MOV R13,DPP0:c_maf_mes_fil_cssm_lgrd
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        MOV maf_word,R4
        JMPR cc_UC,L_C3A38
L_C39EA:                 ; 0xc39ea
        MOV R4,maf_mes_fil
        MOV maf_word,R4
        BSET lv_maf_puls.02H
        JMPR cc_UC,L_C3A38
L_C39F6:                 ; 0xc39f6
        MOV R12,maf_mes_fil
        MOV R13,maf_word
        CALLS SEG sub_r12_r13_rets_r4, SOF sub_r12_r13_rets_r4
        CMP R4,DPP0:c_maf_mes_fil_cssm_lgrd
        JMPR cc_ULE,L_C3A1A
        MOV R12,maf_word
        MOV R13,DPP0:c_maf_mes_fil_cssm_lgrd
        CALLS SEG Add_r12_r13_Return_r4, SOF Add_r12_r13_Return_r4
        MOV maf_word,R4
        JMPR cc_UC,L_C3A38
L_C3A1A:                 ; 0xc3a1a
        MOV R4,maf_mes_fil
        MOV maf_word,R4
        BSET lv_maf_puls.02H
        JMPR cc_UC,L_C3A38
L_C3A26:                 ; 0xc3a26
        MOV R4,maf_mes_fil
        MOV maf_word,R4
        JMPR cc_UC,L_C3A38
L_C3A30:                 ; 0xc3a30
        MOV R4,maf_im_mdl
        MOV maf_word,R4
L_C3A38:                 ; 0xc3a38
        MOV R4,maf_word
        SUB R4,R8
        MOV maf_dif,R4
        MOV R5,DPP0:c_maf_mmv_hys
        CMP R5,maf_dif
        JMPR cc_SGE,L_C3A56
        MOV R2,maf_word
        MOV maf_mmv,R2
        JMPR cc_UC,L_C3A6C
L_C3A56:                 ; 0xc3a56
        MOV R12,maf_mmv
        MOV R13,maf_word
        MOVBZ R14,DPP0:c_maf_mmv_dif_crlc
        SHL R14,#08H
        CALLS SEG Interp_U16, SOF Interp_U16
        MOV maf_mmv,R4
L_C3A6C:                 ; 0xc3a6c
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

; ======== Calc_MAF_Model_Const  (@0xc3a72) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Calc_MAF_Model_Const:
        MOV R12,DPP0:c_ra_vol_im
        MOVBZ R13,tia
        ADD R13,#DATA16 0012CH
        MOV R14,#09H
        CALLS SEG Mul_Shift_U16_Sat, SOF Mul_Shift_U16_Sat
        MOV maf_mdl_con_0,R4
        MOV R12,#DATA16 POF ldpm_tia_maf_mdl_con_1
        MOV R13,#DATA16 PAG ldpm_tia_maf_mdl_con_1
        MOVBZ R14,tia
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_maf_mdl_con_1
        MOV R13,#DATA16 PAG ip_maf_mdl_con_1
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        MOV maf_mdl_con_1,R4
        MOV R12,#DATA16 POF ldp_teg_egr_maf_egr_con_1
        MOV R13,#DATA16 PAG ldp_teg_egr_maf_egr_con_1
        MOV R14,#00H
        CALLS SEG Get_IP_Word_Y_Axis, SOF Get_IP_Word_Y_Axis
        MOV R12,#DATA16 POF ip_maf_egr_con_1
        MOV R13,#DATA16 PAG ip_maf_egr_con_1
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        MOV lv_maf_cc36,R4
        CALLS SEG ReducedArea_Adapt, SOF ReducedArea_Adapt
        RETS

; ======== Calc_AMP_Pred  (@0xc3acc) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): Ambient pressure acquisition (ip_pred_fac prediction driver)
        ; ------------------------------------------------------------
Calc_AMP_Pred:
        MOV R12,#DATA16 POF ldpm_n_32_ar_red
        MOV R13,#DATA16 PAG ldpm_n_32_ar_red
        MOVBZ R14,n_32
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_pred_fac
        MOV R13,#DATA16 PAG ip_pred_fac
        CALLS SEG Get_IP_Byte_2D_Table, SOF Get_IP_Byte_2D_Table
        MOVB g_c322,RL4
        CALLS SEG Set_lv_cp_set_close_d074, SOF Set_lv_cp_set_close_d074
        CALLS SEG Calc_HFM_TimeConst, SOF Calc_HFM_TimeConst
        RETS

; ======== Calc_Map_Drv1  (@0xc3af6) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
Calc_Map_Drv1:
        MOV [-R0],R9
        MOV R12,map_drv1
        MOV R13,lv_maf_cc6a
        CALLS SEG Sat_Add_S16, SOF Sat_Add_S16
        MOV R12,R4
        MOV R13,t_seg_av
        MOV R14,#0EH
        CALLS SEG Mul_Shift_S16, SOF Mul_Shift_S16
        MOV R13,R4
        MOV R12,map
        CALLS SEG Sat_Add_S16_v2, SOF Sat_Add_S16_v2
        MOV R9,R4
        CMP R9,prs_up_thr
        JMPR cc_C,L_C3B28
        MOV R9,prs_up_thr
        SUB R9,#01H
L_C3B28:                 ; 0xc3b28
        MOV R12,R9
        MOV R13,prs_up_thr
        CALLS SEG Div_Frac_U16_Q16, SOF Div_Frac_U16_Q16
        MOV pq_estim,R4
        MOV R12,#DATA16 POF ldpm_pq_estim_id_maf_fac_ofs
        MOV R13,#DATA16 PAG ldpm_pq_estim_id_maf_fac_ofs
        MOV R14,R4
        CALLS SEG Get_Word_Y_Axis, SOF Get_Word_Y_Axis
        MOV R12,#DATA16 POF id_maf_fac_ofs
        MOV R13,#DATA16 PAG id_maf_fac_ofs
        CALLS SEG Read_Word_Far, SOF Read_Word_Far
        MOV maf_fac_ofs,R4
        MOV R12,#DATA16 POF id_maf_fac_slop
        MOV R13,#DATA16 PAG id_maf_fac_slop
        CALLS SEG Read_Word_Far, SOF Read_Word_Far
        MOV maf_fac_slop,R4
        MOV R12,R9
        MOV R13,prs_ex
        CALLS SEG Div_Frac_U16_Q16, SOF Div_Frac_U16_Q16
        MOV pq_egr_estim,R4
        MOV R12,#DATA16 POF ldpm_pq_estim_id_maf_fac_ofs
        MOV R13,#DATA16 PAG ldpm_pq_estim_id_maf_fac_ofs
        MOV R14,R4
        CALLS SEG Get_Word_Y_Axis, SOF Get_Word_Y_Axis
        MOV R12,#DATA16 POF id_maf_fac_ofs
        MOV R13,#DATA16 PAG id_maf_fac_ofs
        CALLS SEG Read_Word_Far, SOF Read_Word_Far
        MOV maf_fac_ofs_egr,R4
        MOV R12,#DATA16 POF id_maf_fac_slop
        MOV R13,#DATA16 PAG id_maf_fac_slop
        CALLS SEG Read_Word_Far, SOF Read_Word_Far
        MOV maf_fac_slop_egr,R4
        MOV R9,[R0+]
        RET

S_MAF_VARIABLES ENDS
        END
