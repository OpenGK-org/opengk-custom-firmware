KWP_CommObj_SetPending:
        MOV [-R0],R14
        MOV [-R0],R13
        MOV [-R0],R12
        CMP R12,#00H
        JMPR cc_EQ,L_DFBF2
        CMP R12,#01H
        JMPR cc_EQ,L_DFBAE
        CMP R12,#02H
