; asw/rt/rt_xbyte.a66
; Runtime: 3D byte-table interpolation, byte X / byte Y axes.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Get_IP_Byte_3D_Table_DWord_XByte_YByte

S_RT_XBYTE SECTION CODE

; ======== Get_IP_Byte_3D_Table_DWord_XByte_YByte  (@0xff2f0) ========
Get_IP_Byte_3D_Table_DWord_XByte_YByte:
        MOV R10,[R12]
        MOV R2,[R12+#04H]
        MOV R3,[R12+#08H]
        MOV R5,[R12+#06H]
        MOV R11,[R12+#0AH]
        MOV R12,[R12+#02H]
        MOV DPP0_FE00,R5
        MOV R4,R13
        MOVB RL1,[R2]
        MOVBZ R1,RL1
        ADD R1,R2
        ADD R2,#01H
        CMPB RL4,[R1]
        JMPR cc_NC,L_FF340
        CMPB RL4,[R2]
        JMPR cc_ULE,L_FF33E
L_FF31C:                 ; 0xff31c
        SUB R1,#01H
        CMPB RL4,[R1]
        JMPR cc_C,L_FF31C
        JMPR cc_EQ,L_FF340
        SUBB RL4,[R1]
        MOVBZ MDH_FE0C,RL4
        MOV MDL,#DATA16 00000H
        MOVB RL4,[R1+#01H]
        SUBB RL4,[R1]
        MOVBZ R4,RL4
        DIVLU R4
        MOV R13,0FE0EH
        JMPR cc_UC,L_FF342
L_FF33E:                 ; 0xff33e
        MOV R1,R2
L_FF340:                 ; 0xff340
        XOR R13,R13
L_FF342:                 ; 0xff342
        MOV DPP0_FE00,R11
        SUB R1,R2
        MOVB RL5,[R3]
        MOVBZ R15,RL5
        MULU R1,R15
        ADD R10,0FE0EH
        MOV R5,R14
        MOV R1,R15
        ADD R1,R3
        ADD R3,#01H
        CMPB RL5,[R1]
        JMPR cc_NC,L_FF3DC
        CMPB RL5,[R3]
        JMPR cc_ULE,L_FF3DA
L_FF362:                 ; 0xff362
        SUB R1,#01H
        CMPB RL5,[R1]
        JMPR cc_C,L_FF362
        JMPR cc_EQ,L_FF3DC
        SUBB RL5,[R1]
        MOVBZ MDH_FE0C,RL5
        MOV MDL,#DATA16 00000H
        MOVB RL5,[R1+#01H]
        SUBB RL5,[R1]
        MOVBZ R5,RL5
        DIVLU R5
        MOV R14,0FE0EH
        MOV DPP0,#DATA16 00024H
        SUB R1,R3
        ADD R1,R10
        EXTP R12, #03H
        MOVB RL4,[R1]
        MOVB RL5,[R1+#01H]
        SUB R5,R4
        JMPR cc_NC,L_FF3A4
        NEG R5
        MULU R5,R14
        ADD MDL,0FE0EH
        SUBC R4,MDH_FE0C
        JMPR cc_UC,L_FF3AE
L_FF3A4:                 ; 0xff3a4
        MULU R5,R14
        ADD MDL,0FE0EH
        ADDC R4,MDH_FE0C
L_FF3AE:                 ; 0xff3ae
        OR R13,R13
        JMPR cc_EQ,L_FF402
        ADD R1,R15
        EXTP R12, #02H
        MOVB RL5,[R1+]
        MOVB RL2,[R1]
        MOVBZ R2,RL2
        SUB R2,R5
        JMPR cc_NC,L_FF3CE
        NEG R2
        MULU R2,R14
        ADD MDL,0FE0EH
        SUBC R5,MDH_FE0C
        JMPR cc_UC,L_FF3F0
L_FF3CE:                 ; 0xff3ce
        MULU R2,R14
        ADD MDL,0FE0EH
        ADDC R5,MDH_FE0C
        JMPR cc_UC,L_FF3F0
L_FF3DA:                 ; 0xff3da
        MOV R1,R3
L_FF3DC:                 ; 0xff3dc
        MOV DPP0,#DATA16 00024H
        SUB R1,R3
        ADD R1,R10
        OR R13,R13
        JMPR cc_EQ,L_FF40E
        ADD R15,R1
        EXTP R12, #02H
        MOVB RL4,[R1]
        MOVB RL5,[R15]
L_FF3F0:                 ; 0xff3f0
        SUB R5,R4
        JMPR cc_NC,L_FF402
        NEG R5
        MULU R5,R13
        ADD MDL,0FE0EH
        SUBC R4,MDH_FE0C
        RETS
L_FF402:                 ; 0xff402
        MULU R5,R13
        ADD MDL,0FE0EH
        ADDC R4,MDH_FE0C
