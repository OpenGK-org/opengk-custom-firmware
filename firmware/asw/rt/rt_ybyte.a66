; asw/rt/rt_ybyte.a66
; Runtime: 2D byte-table interpolation, byte axis.
; 0xFF414-0xFF49E  (138 bytes, 1 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Get_IP_Byte_2D_Table_DWord_YByte

S_FF414 SECTION CODE AT 0FF414H

; ======== Get_IP_Byte_2D_Table_DWord_YByte  (@0xff414) ========
Get_IP_Byte_2D_Table_DWord_YByte:
        MOV R10,[R12]
        MOV R2,[R12+#04H]
        MOV R5,[R12+#06H]
        MOV R12,[R12+#02H]
        MOV DPP0_FE00,R5
        MOV R4,R13
        MOVB RL1,[R2]
        MOVBZ R1,RL1
        ADD R1,R2
        ADD R2,#01H
        CMPB RL4,[R1]
        JMPR cc_NC,L_FF490
        CMPB RL4,[R2]
        JMPR cc_ULE,L_FF486
L_FF438:                 ; 0xff438
        SUB R1,#01H
        CMPB RL4,[R1]
        JMPR cc_C,L_FF438
        JMPR cc_EQ,L_FF490
        SUBB RL4,[R1]
        MOVBZ MDH_FE0C,RL4
        XOR MDL,0FE0EH
        MOVB RL4,[R1+#01H]
        SUBB RL4,[R1]
        MOVBZ R4,RL4
        DIVLU R4
        MOV R13,0FE0EH
        MOV DPP0,#DATA16 00024H
        SUB R1,R2
        ADD R1,R10
        EXTP R12, #02H
        MOVB RL4,[R1+]
        MOVB RL5,[R1]
        MOVBZ R5,RL5
        SUB R5,R4
        JMPR cc_NC,L_FF47A
        NEG R5
        MULU R5,R13
        ADD MDL,0FE0EH
        SUBC R4,MDH_FE0C
        RETS
L_FF47A:                 ; 0xff47a
        MULU R5,R13
        ADD MDL,0FE0EH
        ADDC R4,MDH_FE0C
        RETS
L_FF486:                 ; 0xff486
        EXTP R12, #01H
        MOVB RL4,[R10]
        MOV DPP0,#DATA16 00024H
        RETS
L_FF490:                 ; 0xff490
        SUB R1,R2
        ADD R1,R10
        EXTP R12, #01H
        MOVB RL4,[R1]
        MOV DPP0,#DATA16 00024H
        RETS

S_FF414 ENDS
        END
