; asw/rt/rt_ybyte_2.a66
; Runtime: 2D word-table interpolation, byte axis.
; 0xFFAD4-0xFFB60  (140 bytes, 1 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Get_IP_Word_2D_Table_DWord_YByte

S_FFAD4 SECTION CODE AT 0FFAD4H

; ======== Get_IP_Word_2D_Table_DWord_YByte  (@0xffad4) ========
Get_IP_Word_2D_Table_DWord_YByte:
        MOV R10,[R12]
        MOV R2,[R12+#04H]
        MOV R5,[R12+#06H]
        MOV R12,[R12+#02H]
        MOV DPP0_FE00,R5
        MOV R4,R13
        MOVB RL1,[R2]
        MOVBZ R1,RL1
        ADD R1,R2
        ADD R2,#01H
        CMPB RL4,[R1]
        JMPR cc_NC,L_FFB50
        CMPB RL4,[R2]
        JMPR cc_ULE,L_FFB46
L_FFAF8:                 ; 0xffaf8
        SUB R1,#01H
        CMPB RL4,[R1]
        JMPR cc_C,L_FFAF8
        JMPR cc_EQ,L_FFB50
        SUBB RL4,[R1]
        MOVBZ MDH_FE0C,RL4
        XOR MDL,0FE0EH
        MOVB RL4,[R1+#01H]
        SUBB RL4,[R1]
        MOVBZ R4,RL4
        DIVLU R4
        MOV R13,0FE0EH
        MOV DPP0,#DATA16 00024H
        SUB R1,R2
        SHL R1,#01H
        ADD R1,R10
        EXTP R12, #02H
        MOV R4,[R1+]
        MOV R5,[R1]
        SUB R5,R4
        JMPR cc_NC,L_FFB3A
        NEG R5
        MULU R5,R13
        ADD MDL,0FE0EH
        SUBC R4,MDH_FE0C
        RETS
L_FFB3A:                 ; 0xffb3a
        MULU R5,R13
        ADD MDL,0FE0EH
        ADDC R4,MDH_FE0C
        RETS
L_FFB46:                 ; 0xffb46
        EXTP R12, #01H
        MOV R4,[R10]
        MOV DPP0,#DATA16 00024H
        RETS
L_FFB50:                 ; 0xffb50
        SUB R1,R2
        SHL R1,#01H
        ADD R1,R10
        EXTP R12, #01H
        MOV R4,[R1]
        MOV DPP0,#DATA16 00024H
        RETS

S_FFAD4 ENDS
        END
