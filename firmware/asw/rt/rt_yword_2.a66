; asw/rt/rt_yword_2.a66
; Runtime: 2D byte-table interpolation, word axis.
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

PUBLIC  Get_IP_Byte_2D_Table_DWord_YWord

S_RT_YWORD_2 SECTION CODE

; ======== Get_IP_Byte_2D_Table_DWord_YWord  (@0xffb60) ========
Get_IP_Byte_2D_Table_DWord_YWord:
        MOV R10,[R12]
        MOV R2,[R12+#04H]
        MOV R5,[R12+#06H]
        MOV R12,[R12+#02H]
        MOV DPP0_FE00,R5
        MOV R1,R2
        ADD R1,[R2]
        ADD R1,[R2+]
        CMP R13,[R1]
        JMPR cc_NC,L_FFBDA
        CMP R13,[R2]
        JMPR cc_ULE,L_FFBD0
L_FFB80:                 ; 0xffb80
        SUB R1,#02H
        CMP R13,[R1]
        JMPR cc_C,L_FFB80
        JMPR cc_EQ,L_FFBDA
        SUB R13,[R1]
        MOV MDH_FE0C,R13
        XOR MDL,0FE0EH
        MOV R4,[R1+#02H]
        SUB R4,[R1]
        DIVLU R4
        MOV R13,0FE0EH
        MOV DPP0,#DATA16 00024H
        SUB R1,R2
        SHR R1,#01H
        ADD R1,R10
        EXTP R12, #02H
        MOVB RL4,[R1+]
        MOVB RL5,[R1]
        MOVBZ R4,RL4
        MOVBZ R5,RL5
        SUB R5,R4
        JMPR cc_NC,L_FFBC4
        NEG R5
        MULU R5,R13
        ADD MDL,0FE0EH
        SUBC R4,MDH_FE0C
        RETS
L_FFBC4:                 ; 0xffbc4
        MULU R5,R13
        ADD MDL,0FE0EH
        ADDC R4,MDH_FE0C
        RETS
L_FFBD0:                 ; 0xffbd0
        EXTP R12, #01H
        MOVB RL4,[R10]
        MOV DPP0,#DATA16 00024H
        RETS
L_FFBDA:                 ; 0xffbda
        SUB R1,R2
        SHR R1,#01H
        ADD R1,R10
        EXTP R12, #01H
        MOVB RL4,[R1]
        MOV DPP0,#DATA16 00024H
        RETS

S_RT_YWORD_2 ENDS
        END
