        MOV R12,#DATA16 POF ip_cam_sp_add_ch_pl_ivvt_in
        MOV R13,#DATA16 PAG ip_cam_sp_add_ch_pl_ivvt_in
        CALLS 00FH,Get_IP_Word_2D_Table
        SUB R4,#DATA16 000A0H
        MOV lv_ivvt_cbe6,R4
L_B55A6:                 ; 0xb55a6
        RETS

