        ; cam_sp_value_ivvt + lv_cam_sp_add.
        ; ------------------------------------------------------------
Calc_Cam_Sp_Add:
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_B5566
        MOVB RL5,#01H
        MOVB ivvt_in_struct_sp_add_ivvt_lv_cam_sp_add_ivvt,RL5
        MOV ivvt_in_struct_sp_add_ivvt_cam_sp_add_ivvt,ZEROS
        MOVB ivvt_in_struct_sp_add_ivvt_cam_sp_value_ivvt,ZEROS
L_B5566:                 ; 0xb5566
        RETS

; ======== Calc_IVVT_CamSp_Add  (@0xb5568) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): IVVT Setpoint for Homogeneous Stoich (cam_sp_add)
