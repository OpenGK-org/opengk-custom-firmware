Calc_IVVT_CamSp_Add:
        MOV R12,#DATA16 POF ldpm_tco_st_1_ivvt
        MOV R13,#DATA16 PAG ldpm_tco_st_1_ivvt
        MOVBZ R14,tco_st
        CALLS 00FH,Get_IP_Byte_Y_Axis
