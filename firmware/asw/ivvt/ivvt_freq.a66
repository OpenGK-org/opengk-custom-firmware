; ======== Calc_IVVT_PWM_Freq  (@0xb01ba) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by ivvt/cam output signals + DTC): OCV PWM frequency from Vbat: ivvthpwm_frq /
        ; ivvtepwm_frq + fac_cor_ivvtpwm (magnet-temp comp).
        ; ------------------------------------------------------------
Calc_IVVT_PWM_Freq:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV [-R0],R7
        MOV R7,R12
        MOV R8,p_ivvt_cam_m
        MOV R9,p_ivvt_cam_s
        MOV R4,#DATA16 08000H
        MOV [R8+#0D6H],R4
        MOV R12,#DATA16 POF ldpm_vb_ivvtpwm
        MOV R13,#DATA16 PAG ldpm_vb_ivvtpwm
        MOVBZ R14,vb
        CALLS 00FH,Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_frq_ivvthpwm
        MOV R13,#DATA16 PAG ip_frq_ivvthpwm
        CALLS 00FH,Get_IP_Word_2D_Table
        MOV ivvthpwm_frq,R4
        MOV R12,#DATA16 POF ip_frq_ivvtpwm
        MOV R13,#DATA16 PAG ip_frq_ivvtpwm
        CALLS 00FH,Get_IP_Word_2D_Table
        MOV ivvtepwm_frq,R4
        MOV R12,#DATA16 045BEH
        MOVBZ R13,tmag_ivvt
        CALLS 00FH,Get_IP_Byte_2D_Table_DWord_YByte
        MOVBZ R4,RL4
        MOV [-R0],R4
        MOV R12,#DATA16 POF ip_fac_vb_ivvtpwm
        MOV R13,#DATA16 PAG ip_fac_vb_ivvtpwm
        CALLS 00FH,Get_IP_Byte_2D_Table
        MOVBZ R12,RL4
        MOV R13,[R0+]
        CALLS 00FH,Mul_S16_Q7_Sat
        MOVB fac_cor_ivvtpwm,RL4
        MOV R4,[R7+#04H]
        MOVB RL5,[R4]
        MOVB [R9+#012H],RL5
        MOV R4,[R7+#06H]
        MOVB RL5,[R4]
        MOVB [R9+#013H],RL5
        CMP R9,#DATA16 0CBCAH
        JMPR cc_NE,L_B0252
        MOV R4,[R7+#04H]
        MOVB RL5,[R4]
        MOVBZ R4,RL5
        SHL R4,#08H
        MOV [R8+#0D4H],R4
L_B0252:                 ; 0xb0252
        MOV R7,[R0+]
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

