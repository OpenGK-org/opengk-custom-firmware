; ======== Set_IVVT_Trip_Avl  (@0xc14c2) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by output signals): Set IVVT diagnosis trip-available flag
        ; lv_diag_trip_avl_ivvt.
        ; ------------------------------------------------------------
Set_IVVT_Trip_Avl:
        MOV R4,R12
        CMPB RL4,#00H
        JMPR cc_EQ,L_C14D8
        MOV R4,R12
        MOVBZ R4,RL4
        AND R4,#DATA16 0000FH
        JMPR cc_NE,L_C14D6
        BCLR lv_diag_trip_avl_ivvt.0AH
        JMPR cc_UC,L_C14D8
L_C14D6:                 ; 0xc14d6
        BSET lv_diag_trip_avl_ivvt.0AH
L_C14D8:                 ; 0xc14d8
        BMOV PSW.06H,lv_diag_trip_avl_ivvt.0AH
        RETS

; ======== Diag_IVVT_ShortTrip  (@0xc14de) ========
        ; ------------------------------------------------------------
        ; OEM-MATCH (Funktionsrahmen, verified): IVVT Short Trip forced diagnosis (lv_diag_trip_avl_ivvt)
