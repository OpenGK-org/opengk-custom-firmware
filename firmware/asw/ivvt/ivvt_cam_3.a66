; asw/ivvt/ivvt_cam_3.a66
; IVVT task groups: cam set point, diagnosis and measurement ticks.
; 0xC1DEC-0xC2026  (570 bytes, 9 functions)
$MOD167
$SEGMENTED
$INCLUDE (REG167.INC)
$INCLUDE (zone_syms.inc)

; calibration labels used here (documented in cal/cal.inc)
lc_ena_dly_mes_clc_ivvt              EQU  09045DH

PUBLIC  IVVT_CamSp_Group, IVVT_Diag_Group, IVVT_MesStep_Start, IVVT_MesStep_Tick, IVVT_Reset_CamSp, IVVT_Rev_Clc_Tick
PUBLIC  IVVT_Save_CamDif, IVVT_Task_Group_1, IVVT_Task_Group_2
EXTERN  Calc_Cam_Dif:NEAR, Calc_Cam_Sp_AFL:NEAR, Calc_Cam_Sp_Add:NEAR, Calc_Cam_Sp_Add_2:NEAR
EXTERN  Calc_Cam_Sp_Clc:NEAR, Calc_Cam_Sp_Ctl:NEAR, Calc_IVVT_CamAd_Hold:NEAR, Calc_IVVT_CamAd_Pos:NEAR
EXTERN  Calc_IVVT_CamSp_Add:NEAR, Calc_IVVT_CamSp_Clc_2:NEAR, Calc_IVVT_CamSp_Fac:NEAR, Calc_IVVT_Delay:NEAR
EXTERN  Calc_IVVT_HPWM_Adapt:NEAR, Calc_IVVT_HPWM_Base:NEAR, Calc_IVVT_HPWM_Freq:NEAR, Calc_IVVT_PWM_Freq:NEAR
EXTERN  Calc_IVVT_PWM_Freq_2:NEAR, Calc_RBM_CamDif_IVVT:NEAR, Calc_TMag_IVVT:NEAR, Calc_TMag_IVVT_Slv:NEAR
EXTERN  Calc_fac_vvt_1:NEAR, Ctl_IVVT_OCV_PWM:NEAR, Diag_DTC_dd610:NEAR, Diag_IVVT_CamDif_Inci:NEAR
EXTERN  Diag_IVVT_Elec_Slv:NEAR, Diag_IVVT_Mec_Eval:NEAR, Diag_IVVT_ShortTrip:NEAR, Get_Byte_2D_Table_DWord_YByte:NEAR
EXTERN  IVVT_CamAd_State:NEAR, IVVT_CamMeas_Dispatch:NEAR, IVVT_MesStep_a:NEAR, IVVT_MesStep_b:NEAR
EXTERN  IVVT_MesStep_c:NEAR, IVVT_MesStep_d:NEAR, IVVT_MesStep_e:NEAR, IVVT_OCV_CleanSlv:NEAR
EXTERN  IVVT_OCV_Meas_1:NEAR, IVVT_OCV_Meas_2:NEAR, IVVT_Set_Inhibit:NEAR, IVVT_Set_RamPtr_1:NEAR
EXTERN  IVVT_Set_RamPtr_2:NEAR, IVVT_Set_RamPtr_3:NEAR, IVVT_Set_RamPtrs:NEAR, IVVT_State_Transition:NEAR
EXTERN  Nop_aef6c:NEAR, Nop_b4872:NEAR, Nop_c1650:NEAR, Nop_c1652:NEAR
EXTERN  Reset_sVar1_874:NEAR, Reset_state_ivvt_4c0:NEAR, Reset_uVar1_4a2:NEAR, Set_IVVT_PWM_State:NEAR
EXTERN  Set_Idx_Cam_Ad:NEAR, Set_cam_dif_int_save_ivvt_in_1_07e:NEAR, Set_ctr_cyc_cle_slv_ivvt_f22:NEAR, Set_lv_cam_ad_avl_nvmy_ivvt:NEAR
EXTERN  Snapshot_MAF_IVVT:NEAR

S_C1DEC SECTION CODE AT 0C1DECH

; ======== IVVT_Task_Group_1  (@0xc1dec) ========
        ; ------------------------------------------------------------
        ; See ivvt_cam_t (/ems). Sets p_ivvt_cam_m=0xcada, p_ivvt_cam_s=0xcbca then runs per-cam workers.
        ; Fields via (base+off & 0x3fff)+0x90000.
        ; ------------------------------------------------------------
IVVT_Task_Group_1:
        CALLS SEG IVVT_Set_Inhibit, SOF IVVT_Set_Inhibit
        CALLS SEG Calc_TMag_IVVT, SOF Calc_TMag_IVVT
        CALLS SEG Diag_IVVT_CamDif_Inci, SOF Diag_IVVT_CamDif_Inci
        CALLS SEG Set_ctr_cyc_cle_slv_ivvt_f22, SOF Set_ctr_cyc_cle_slv_ivvt_f22
        CALLS SEG Calc_Cam_Sp_Add, SOF Calc_Cam_Sp_Add
        CALLS SEG Calc_Cam_Sp_Clc, SOF Calc_Cam_Sp_Clc
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_C1E46
        MOV R4,#DATA16 0CBCAH
        MOV p_ivvt_cam_s,R4
        MOV R5,#DATA16 0CADAH
        MOV p_ivvt_cam_m,R5
        CALLS SEG IVVT_MesStep_d, SOF IVVT_MesStep_d
        CALLS SEG IVVT_MesStep_c, SOF IVVT_MesStep_c
        CALLS SEG IVVT_MesStep_a, SOF IVVT_MesStep_a
        MOV R12,#DATA16 04574H
        CALLS SEG Nop_aef6c, SOF Nop_aef6c
        MOV R12,#DATA16 045B4H
        CALLS SEG Calc_IVVT_PWM_Freq, SOF Calc_IVVT_PWM_Freq
        CALLS SEG IVVT_Set_RamPtr_2, SOF IVVT_Set_RamPtr_2
        MOV R12,#DATA16 04778H
        CALLS SEG Set_Idx_Cam_Ad, SOF Set_Idx_Cam_Ad
        CALLS SEG IVVT_Set_RamPtr_3, SOF IVVT_Set_RamPtr_3
L_C1E46:                 ; 0xc1e46
        RETS

; ======== IVVT_CamSp_Group  (@0xc1e48) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_CamSp_Group:
        CALLS SEG Reset_uVar1_4a2, SOF Reset_uVar1_4a2
        CALLS SEG Nop_b4872, SOF Nop_b4872
        CALLS SEG Calc_IVVT_CamSp_Add, SOF Calc_IVVT_CamSp_Add
        RETS

; ======== IVVT_Reset_CamSp  (@0xc1e56) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_Reset_CamSp:
        MOVB ctr_rev_clc_ivvt,ZEROS
        MOV t_dly_mes_ivvt,ZEROS
        CALLS SEG Reset_state_ivvt_4c0, SOF Reset_state_ivvt_4c0
        CALLS SEG Calc_IVVT_CamSp_Clc_2, SOF Calc_IVVT_CamSp_Clc_2
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_C1E8C
        MOV R4,#DATA16 0CBCAH
        MOV p_ivvt_cam_s,R4
        MOV R5,#DATA16 0CADAH
        MOV p_ivvt_cam_m,R5
        CALLS SEG IVVT_MesStep_e, SOF IVVT_MesStep_e
        CALLS SEG Set_IVVT_PWM_State, SOF Set_IVVT_PWM_State
        CALLS SEG IVVT_MesStep_b, SOF IVVT_MesStep_b
        CALLS SEG Reset_sVar1_874, SOF Reset_sVar1_874
L_C1E8C:                 ; 0xc1e8c
        RETS

; ======== IVVT_Save_CamDif  (@0xc1e8e) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_Save_CamDif:
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_C1EB0
        MOV R4,#DATA16 0CBCAH
        MOV p_ivvt_cam_s,R4
        MOV R5,#DATA16 0CADAH
        MOV p_ivvt_cam_m,R5
        CALLS SEG IVVT_Set_RamPtr_1, SOF IVVT_Set_RamPtr_1
        MOV R12,#DATA16 04778H
        CALLS SEG IVVT_Set_RamPtrs, SOF IVVT_Set_RamPtrs
L_C1EB0:                 ; 0xc1eb0
        CALLS SEG Set_cam_dif_int_save_ivvt_in_1_07e, SOF Set_cam_dif_int_save_ivvt_in_1_07e
        RETS

; ======== IVVT_Task_Group_2  (@0xc1eb6) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_Task_Group_2:
        CALLS SEG Calc_IVVT_CamSp_Fac, SOF Calc_IVVT_CamSp_Fac
        CALLS SEG Calc_IVVT_HPWM_Base, SOF Calc_IVVT_HPWM_Base
        CALLS SEG Calc_TMag_IVVT_Slv, SOF Calc_TMag_IVVT_Slv
        CALLS SEG Nop_c1652, SOF Nop_c1652
        CALLS SEG Calc_RBM_CamDif_IVVT, SOF Calc_RBM_CamDif_IVVT
        RETS

; ======== IVVT_MesStep_Tick  (@0xc1ecc) ========
        ; ------------------------------------------------------------
        ; Named from single dominant output signal (auto-derived, lower confidence than hand-verified).
        ; ------------------------------------------------------------
IVVT_MesStep_Tick:
        SUB t_dly_mes_ivvt,ONES
        CALLS SEG IVVT_OCV_CleanSlv, SOF IVVT_OCV_CleanSlv
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_C1EEE
        MOV R4,#DATA16 0CBCAH
        MOV p_ivvt_cam_s,R4
        MOV R5,#DATA16 0CADAH
        MOV p_ivvt_cam_m,R5
        CALLS SEG Calc_IVVT_HPWM_Freq, SOF Calc_IVVT_HPWM_Freq
L_C1EEE:                 ; 0xc1eee
        RETS

; ======== IVVT_Diag_Group  (@0xc1ef0) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_Diag_Group:
        CALLS SEG Diag_IVVT_Mec_Eval, SOF Diag_IVVT_Mec_Eval
        CALLS SEG Diag_IVVT_Elec_Slv, SOF Diag_IVVT_Elec_Slv
        CALLS SEG Nop_c1650, SOF Nop_c1650
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_C1F22
        MOV R4,#DATA16 0CADAH
        MOV p_ivvt_cam_m,R4
        MOV R12,#DATA16 04794H
        CALLS SEG Diag_DTC_dd610, SOF Diag_DTC_dd610
        MOV R4,#DATA16 0CBCAH
        MOV p_ivvt_cam_s,R4
        MOV R12,#DATA16 045B4H
        CALLS SEG Calc_IVVT_PWM_Freq_2, SOF Calc_IVVT_PWM_Freq_2
L_C1F22:                 ; 0xc1f22
        RETS

; ======== IVVT_Rev_Clc_Tick  (@0xc1f24) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by ivvt/cam output signals + DTC): Per-rev IVVT clc tick: ctr_rev_clc_ivvt
        ; counter -> sets lv_cam_ad_avl_nvmy_ivvt when due; triggers cam-ad NVM.
        ; ------------------------------------------------------------
IVVT_Rev_Clc_Tick:
        SUBB ctr_rev_clc_ivvt,ONES
        MOV R12,#DATA16 04A12H
        MOVBZ R13,n_32
        CALLS SEG Get_Byte_2D_Table_DWord_YByte, SOF Get_Byte_2D_Table_DWord_YByte
        CMPB RL4,ctr_rev_clc_ivvt
        JMPR cc_UGT,L_C1F42
        BSET lv_cam_ad_avl_nvmy_ivvt.04H
        MOVB ctr_rev_clc_ivvt,ZEROS
        JMPR cc_UC,L_C1F44
L_C1F42:                 ; 0xc1f42
        BCLR lv_cam_ad_avl_nvmy_ivvt.04H
L_C1F44:                 ; 0xc1f44
        JNB lv_cam_ad_avl_nvmy_ivvt.04H,L_C1F4C
        CALLS SEG Snapshot_MAF_IVVT, SOF Snapshot_MAF_IVVT
L_C1F4C:                 ; 0xc1f4c
        CALLS SEG IVVT_State_Transition, SOF IVVT_State_Transition
        JNB lv_cam_ad_avl_nvmy_ivvt.04H,L_C1F68
        CALLS SEG Calc_Cam_Sp_AFL, SOF Calc_Cam_Sp_AFL
        CALLS SEG Calc_Cam_Sp_Add_2, SOF Calc_Cam_Sp_Add_2
        CALLS SEG Calc_Cam_Sp_Ctl, SOF Calc_Cam_Sp_Ctl
        CALLS SEG Calc_IVVT_Delay, SOF Calc_IVVT_Delay
        CALLS SEG Calc_Cam_Dif, SOF Calc_Cam_Dif
L_C1F68:                 ; 0xc1f68
        CALLS SEG Diag_IVVT_ShortTrip, SOF Diag_IVVT_ShortTrip
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_C1F8A
        MOV R4,#DATA16 0CBCAH
        MOV p_ivvt_cam_s,R4
        MOV R5,#DATA16 0CADAH
        MOV p_ivvt_cam_m,R5
        MOV R12,#DATA16 04794H
        CALLS SEG IVVT_CamMeas_Dispatch, SOF IVVT_CamMeas_Dispatch
L_C1F8A:                 ; 0xc1f8a
        MOV R4,state_ivvt
        CMP R4,#03H
        JMPR cc_NE,L_C1FCA
        JNB lv_diag_trip_avl_ivvt.0FH,L_C1FCA
        MOVB RL4,#DATA16 00042H
        MOVBZ R5,tq_mid_wr
        MOVB [R5+#0F64EH],RL4
        MOVB RL4,tq_mid_wr
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_mid_wr,RL4
        MOVB RL4,tq_mid_wr
        CMPB RL4,tq_mid_rd
        JMPR cc_NE,L_C1FCA
        BSET sched_flags.02H
        MOVB RL4,tq_mid_rd
        ADDB RL4,#01H
        ANDB RL4,#DATA16 0001FH
        MOVB tq_mid_rd,RL4
L_C1FCA:                 ; 0xc1fca
        RETS

; ======== IVVT_MesStep_Start  (@0xc1fcc) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_MesStep_Start:
        MOVB RL4,ivvt_in_1_struct_ivvt_lv_inh_ivvt
        JMPR cc_NE,L_C2024
        MOV R4,#DATA16 0CBCAH
        MOV p_ivvt_cam_s,R4
        MOV R5,#DATA16 0CADAH
        MOV p_ivvt_cam_m,R5
        MOV R12,#DATA16 04778H
        CALLS SEG Calc_IVVT_CamAd_Pos, SOF Calc_IVVT_CamAd_Pos
        CALLS SEG Set_lv_cam_ad_avl_nvmy_ivvt, SOF Set_lv_cam_ad_avl_nvmy_ivvt
        MOV R12,#DATA16 04588H
        CALLS SEG Ctl_IVVT_OCV_PWM, SOF Ctl_IVVT_OCV_PWM
        MOV R12,#DATA16 0454CH
        CALLS SEG Calc_IVVT_CamAd_Hold, SOF Calc_IVVT_CamAd_Hold
        MOV R12,#DATA16 04574H
        CALLS SEG Calc_IVVT_HPWM_Adapt, SOF Calc_IVVT_HPWM_Adapt
        CALLS SEG IVVT_CamAd_State, SOF IVVT_CamAd_State
        MOV R12,#DATA16 045B4H
        CALLS SEG IVVT_OCV_Meas_2, SOF IVVT_OCV_Meas_2
        CALLS SEG Calc_fac_vvt_1, SOF Calc_fac_vvt_1
        MOVB RL4,DPP0:lc_ena_dly_mes_clc_ivvt
        JMPR cc_EQ,L_C2024
        MOV R12,#DATA16 045B0H
        CALLS SEG IVVT_OCV_Meas_1, SOF IVVT_OCV_Meas_1
L_C2024:                 ; 0xc2024
        RETS

S_C1DEC ENDS
        END
