S_IVVT_HOLD SECTION CODE

; ======== IVVT_MesStep_a  (@0xaeb0c) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_MesStep_a:
        MOV R12,p_ivvt_cam_m
        MOVB RL4,#01H
        MOVB [R12+#0BBH],RL4
        MOVB [R12+#0BAH],RL4
        MOV R4,#DATA16 0FFFFH
        MOV [R12+#0B0H],R4
        RETS

; ======== IVVT_MesStep_b  (@0xaeb24) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_MesStep_b:
        MOV R12,p_ivvt_cam_m
        MOVB RL4,#01H
        MOVB [R12+#0BBH],RL4
        MOVB [R12+#0BAH],RL4
        MOV R4,#00H
        MOV [R12+#0B8H],R4
        MOV [R12+#0B4H],R4
        MOV R4,#DATA16 0FFFFH
        MOV [R12+#0B0H],R4
        RETS

