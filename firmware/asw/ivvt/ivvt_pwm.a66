; ======== IVVT_MesStep_c  (@0xaf1fe) ========
        ; ------------------------------------------------------------
        ; Named by caller-context + body analysis (push to 100pct).
        ; ------------------------------------------------------------
IVVT_MesStep_c:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV R8,p_ivvt_cam_m
        MOV R9,p_ivvt_cam_s
        CMP R9,#DATA16 0CBCAH
