L_CDF46:                 ; 0xcdf46
        BCLR state_lam_ctl.0BH
L_CDF48:                 ; 0xcdf48
        JB state_lam_ctl.0BH,L_CDF50
        JMPA cc_UC,L_CE0D8
L_CDF50:                 ; 0xcdf50
