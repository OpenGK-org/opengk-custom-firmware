        MOV lam_bank_1_lam_up_lam,ZEROS
        BCLR lv_cp_set_close.02H
        BCLR lv_cp_set_close.03H
        RETS

; ======== CanPurge_Set_Close_2  (@0xcdcb8) ========
        ; ------------------------------------------------------------
        ; OEM-chain (verified by cp/cat_diag/isa output signals): Set purge-valve close request
        ; lv_cp_set_close (variant).
        ; ------------------------------------------------------------
CanPurge_Set_Close_2:
        MOV [-R0],R6
        MOVB RL4,conf_lam
        JMPR cc_EQ,L_CDD22
        JB lv_cdn_diag_maf_dif_ch_int.0BH,L_CDD22
        JB lv_pl.04H,L_CDD22
        JNB lv_cdn_diag_maf_dif_ch_int.0EH,L_CDCF8
        JB lv_cp_set_close.03H,L_CDD22
        MOV R12,#DATA16 POF sstm_tkw_1_8
        MOV R13,#DATA16 PAG sstm_tkw_1_8
        MOVBZ R14,tco_st
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_tco_lam_min_is__tco_st
        MOV R13,#DATA16 PAG ip_tco_lam_min_is__tco_st
        CALLS SEG Get_IP_Byte_2D_Table, SOF Get_IP_Byte_2D_Table
        MOVB RL6,RL4
        CMPB RL6,tco
        JMPR cc_NC,L_CDD22
        BSET lv_cp_set_close.03H
        JMPR cc_UC,L_CDD22
L_CDCF8:                 ; 0xcdcf8
        JB lv_cp_set_close.02H,L_CDD22
        MOV R12,#DATA16 POF sstm_tkw_1_8
        MOV R13,#DATA16 PAG sstm_tkw_1_8
        MOVBZ R14,tco_st
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R12,#DATA16 POF ip_tco_lam_min__tco_st
        MOV R13,#DATA16 PAG ip_tco_lam_min__tco_st
        CALLS SEG Get_IP_Byte_2D_Table, SOF Get_IP_Byte_2D_Table
        MOVB RL6,RL4
        CMPB RL6,tco
        JMPR cc_NC,L_CDD22
        BSET lv_cp_set_close.02H
L_CDD22:                 ; 0xcdd22
        MOV R6,[R0+]
        RETS

; ======== Calc_Lam_Ctl_Limits  (@0xcdd26) ========
        ; ------------------------------------------------------------
        ; lam_bank_t field map (base=p_lam_bank1; bank1 inst ptr=0xc74c). Fields at base+off:
        ; +00 lamb_sp  +0a ti_lam_dflt  +0c ti_lam_prev  +10 p_out
        ; +12 lam_min  +14 lam_max  +16 lam_corr(vls)
        ; +22 cyc_cnt  +23 cyc_cnt_ref  +26 cyc_cnt_latch
        ; +28 t_dly_pos +2a t_dly_pos_tab +2c t_dly_neg +2e t_dly_neg_tab
        ; +30/32 maf_snap_a/b  +34 phase(0=I,1=P,2=hold)
        ; +36 t_lim_diag  +38 t_cps_close
        ; +40 ti_lam(out)  +42 ti_lam_av  +44 ti_lam_mv_lpf  +48 maf_in  +62 in_62
        ; NOTE: accessed as (base+off & 0x3fff)+0x90000 (C167 RAM window) - Ghidra struct typing
        ; cannot self-name these; type lam_bank_t in /ems documents the layout.
        ; ------------------------------------------------------------
Calc_Lam_Ctl_Limits:
        MOV [-R0],R9
        MOV [-R0],R8
        MOV R8,p_lam_bank1
        JB state_lam_ctl2.08H,L_CDD3A
        JNB state_lam_ctl.00H,L_CDD3A
        BSET state_lam_ctl.07H
        JMPR cc_UC,L_CDD3C
L_CDD3A:                 ; 0xcdd3a
        BCLR state_lam_ctl.07H
L_CDD3C:                 ; 0xcdd3c
        JNB state_lam_ctl.07H,L_CDD4A
        JNB state_lam_ctl2.0AH,L_CDD4A
        JB state_lam_ctl2.09H,L_CDD4A
        BCLR state_lam_ctl.07H
L_CDD4A:                 ; 0xcdd4a
        MOV R12,#DATA16 POF ldp_tco_ip_lam_min
        MOV R13,#DATA16 PAG ldp_tco_ip_lam_min
        MOVBZ R14,tco
        CALLS SEG Get_IP_Byte_Y_Axis, SOF Get_IP_Byte_Y_Axis
        MOV R4,[R8+#016H]
        JMPR cc_NE,L_CDD94
        JNB state_lam_ctl.07H,L_CDD76
        MOV R4,DPP0:c_lam_ini_min
        MOV [R8+#012H],R4
        MOV R4,DPP0:c_lam_ini_max
        MOV [R8+#014H],R4
        JMPR cc_UC,L_CDE34
L_CDD76:                 ; 0xcdd76
        MOV R12,#DATA16 POF ip_lam_min__tco
        MOV R13,#DATA16 PAG ip_lam_min__tco
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        ADD R4,#DATA16 08000H
        MOV [R8+#012H],R4
        MOV R4,DPP0:c_lam_max
        MOV [R8+#014H],R4
        JMPR cc_UC,L_CDE34
L_CDD94:                 ; 0xcdd94
        MOV R4,[R8+#016H]
        CMP R4,#00H
        JMPR cc_SLE,L_CDDE0
        JNB state_lam_ctl.07H,L_CDDBA
        MOV R4,DPP0:c_lam_ini_min
        MOV [R8+#012H],R4
        MOV R12,DPP0:c_lam_ini_max
        MOV R13,[R8+#016H]
        CALLS SEG Sat_Sub_S16, SOF Sat_Sub_S16
        MOV [R8+#014H],R4
        JMPR cc_UC,L_CDE34
L_CDDBA:                 ; 0xcddba
        MOV R12,#DATA16 POF ip_lam_min__tco
        MOV R13,#DATA16 PAG ip_lam_min__tco
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        ADD R4,#DATA16 08000H
        MOV [R8+#012H],R4
        MOV R12,DPP0:c_lam_max
        MOV R13,[R8+#016H]
        CALLS SEG Sat_Sub_S16, SOF Sat_Sub_S16
        MOV [R8+#014H],R4
        JMPR cc_UC,L_CDE34
L_CDDE0:                 ; 0xcdde0
        JNB state_lam_ctl.07H,L_CDDFE
        MOV R12,DPP0:c_lam_ini_min
        MOV R13,[R8+#016H]
        CALLS SEG Sat_Sub_S16, SOF Sat_Sub_S16
        MOV [R8+#012H],R4
        MOV R4,DPP0:c_lam_ini_max
        MOV [R8+#014H],R4
        JMPR cc_UC,L_CDE34
L_CDDFE:                 ; 0xcddfe
        MOV R12,#DATA16 POF ip_lam_min__tco
        MOV R13,#DATA16 PAG ip_lam_min__tco
        CALLS SEG Get_IP_Word_2D_Table, SOF Get_IP_Word_2D_Table
        MOV R12,R4
        ADD R12,#DATA16 08000H
        MOV R13,[R8+#016H]
        CALLS SEG Sat_Sub_S16, SOF Sat_Sub_S16
        MOV R9,R4
        CMP R9,DPP0:c_lam_min
        JMPR cc_SLE,L_CDE26
        MOV R4,DPP0:c_lam_min
        JMPR cc_UC,L_CDE28
L_CDE26:                 ; 0xcde26
        MOV R4,R9
L_CDE28:                 ; 0xcde28
        MOV [R8+#012H],R4
        MOV R4,DPP0:c_lam_max
        MOV [R8+#014H],R4
L_CDE34:                 ; 0xcde34
        JNB state_lam_ctl.00H,L_CDE40
        MOV R12,R8
        CALLS SEG LamCtl_Regulation, SOF LamCtl_Regulation
        JMPR cc_UC,L_CDE46
L_CDE40:                 ; 0xcde40
        MOV R12,R8
        CALLA cc_UC,Set_lv_cp_set_close
L_CDE46:                 ; 0xcde46
        MOVB RL4,[R8+#034H]
        CMPB RL4,#01H
        JMPR cc_NE,L_CDE52
        CALLS SEG Calc_Lam_MV_Dyw, SOF Calc_Lam_MV_Dyw
L_CDE52:                 ; 0xcde52
        MOVB RL4,[R8+#034H]
        JMPR cc_EQ,L_CDE64
        MOV R4,R8
        ADD R4,#DATA16 00034H
        MOVB RL5,[R4]
        SUBB RL5,#01H
        MOVB [R4],RL5
L_CDE64:                 ; 0xcde64
        MOV R8,[R0+]
        MOV R9,[R0+]
        RETS

