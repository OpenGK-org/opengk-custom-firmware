        MOV g_c788,R4
        MOV R5,lam_bank_1_lam_up_ti_ad_add_mmv
        MOV g_c78a,R5
        RETS

; ======== Reset_Dfd66_c88  (@0xcdc88) ========
Reset_Dfd66_c88:
